{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "core": {
      "type": "object",
      "properties": {
        "mihomo": {
          "$ref": "#/$defs/BinaryRef"
        },
        "gost": {
          "$ref": "#/$defs/BinaryRef"
        }
      },
      "required": [
        "mihomo"
      ],
      "additionalProperties": false
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "source": {
            "$ref": "#/$defs/Source"
          },
          "update_hours": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source",
          "update_hours"
        ],
        "additionalProperties": false
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "active_subscription": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "active_subscription"
      ],
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "mode": {
            "enum": [
              "managed",
              "inherit",
              "direct"
            ]
          },
          "metering": {
            "type": "boolean"
          },
          "bypass": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "mode",
          "metering",
          "bypass"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "metering": {
                  "const": true
                }
              },
              "required": [
                "metering"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "managed"
                }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "match": {
            "$ref": "#/$defs/Predicate"
          },
          "target": {
            "$ref": "#/$defs/Target"
          }
        },
        "required": [
          "id",
          "match",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "default_target": {
      "$ref": "#/$defs/Target"
    },
    "retention": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 30
        }
      },
      "required": [
        "enabled",
        "days"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "core",
    "subscriptions",
    "selection",
    "groups",
    "apps",
    "rules",
    "default_target"
  ],
  "additionalProperties": false,
  "title": "Hoopa local intent v1 (planned)",
  "$comment": "Semantic validation additionally requires max predicate depth 16, unique IDs, valid refs/capabilities, usable core/providers/groups, URL/CIDR correctness. Defaults are annotations: absent retention means disabled/days30. No apps.route; ordered rules are authoritative.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "BinaryRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "https"
            },
            "url_secret_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "url_secret_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GroupSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "active"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "subscription"
            },
            "subscription_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "subscription_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Probe": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tolerance_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "interval_seconds",
        "timeout_ms",
        "tolerance_ms"
      ],
      "additionalProperties": false
    },
    "Group": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "required": {
              "type": "boolean"
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "strategy": {
              "const": "manual"
            },
            "source": {
              "$ref": "#/$defs/GroupSource"
            },
            "selected_node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "id",
            "required",
            "strategy",
            "source",
            "selected_node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "required": {
              "type": "boolean"
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "strategy": {
              "const": "auto"
            },
            "source": {
              "$ref": "#/$defs/GroupSource"
            },
            "probe": {
              "$ref": "#/$defs/Probe"
            }
          },
          "required": [
            "id",
            "required",
            "strategy",
            "source",
            "probe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "required": {
              "type": "boolean"
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "strategy": {
              "const": "follow"
            },
            "follows": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "id",
            "required",
            "strategy",
            "follows"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "group_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "node"
            },
            "subscription_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "subscription_id",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reject"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "app"
            },
            "app_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "app_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "process_instance"
            },
            "process_instance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "process_instance_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "process_name"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "process_path"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ip_cidr"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "domain"
            },
            "operator": {
              "enum": [
                "exact",
                "suffix"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "all"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "conditions"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
