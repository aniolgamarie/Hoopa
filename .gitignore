# Experiment run outputs stay local. Keep source, fixtures, approved core
# identities, build manifests and final acceptance/decision records in Git.
/experiments/*/*-validation.json
/experiments/mihomo-events/control-bind-diagnostic.json
/experiments/mihomo-events/source5-persistence-checkpoint-preparation.json
/experiments/gost-mihomo/us2-launch-test-definition.json
