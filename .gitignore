# Spec Kit installation receipts, not the shared workflow configuration.
/.specify/integrations/*.manifest.json
/.specify/memory/.constitution-template.json

# Synthetic output fixtures override the Go output pattern above.
# YAML/JSON/source fixtures, go.mod and future go.sum remain visible.
