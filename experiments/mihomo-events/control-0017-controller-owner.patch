+
+const ownerTestBoot = "12345678-1234-1234-1234-123456789abc"
+
+func ownerTestInstance() ControlInstance {
+	return ControlInstance{PID: 123, BootID: ownerTestBoot, StartTicks: "42", Nonce: strings.Repeat("a", 32), Generation: "gen:owner-test", BundleDigest: strings.Repeat("b", 64)}
+}
+func ownerTestTable(local, remote, state, inode string) []byte {
+	return []byte("  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt uid timeout inode\n   0: " + local + " " + remote + " " + state + " 00000000:00000000 00:00000000 00000000 0 0 " + inode + " 1 0 100 0 0 10 0\n")
+}
+func ownerTestAddresses() (*net.TCPAddr, *net.TCPAddr) {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 18994}, &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 34567}
+}
+
+type ownerFakeConn struct {
+	writes        atomic.Int32
+	closed        atomic.Int32
+	once          sync.Once
+	done          chan struct{}
+	local, remote *net.TCPAddr
+}
+
+func ownerTestConn() *ownerFakeConn {
+	s, c := ownerTestAddresses()
+	return &ownerFakeConn{done: make(chan struct{}), local: c, remote: s}
+}
+func (c *ownerFakeConn) Read([]byte) (int, error)    { return 0, io.EOF }
+func (c *ownerFakeConn) Write(p []byte) (int, error) { c.writes.Add(int32(len(p))); return len(p), nil }
+func (c *ownerFakeConn) Close() error {
+	c.closed.Add(1)
+	c.once.Do(func() { close(c.done) })
+	return nil
+}
+func (c *ownerFakeConn) LocalAddr() net.Addr              { return c.local }
+func (c *ownerFakeConn) RemoteAddr() net.Addr             { return c.remote }
+func (c *ownerFakeConn) SetDeadline(time.Time) error      { return nil }
+func (c *ownerFakeConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *ownerFakeConn) SetWriteDeadline(time.Time) error { return nil }
+func ownerTestOps(conn *ownerFakeConn) linuxControlOwnerOps {
+	s, c := ownerTestAddresses()
+	return linuxControlOwnerOps{dial: func(ctx context.Context, network, address string) (net.Conn, error) {
+		if ctx.Err() != nil || network != "tcp4" || address != "127.0.0.1:18994" {
+			return nil, ErrLinuxControlRuntime
+		}
+		return conn, nil
+	}, readFile: func(path string, limit int) ([]byte, error) {
+		switch path {
+		case "/proc/sys/kernel/random/boot_id":
+			return []byte(ownerTestBoot + "\n"), nil
+		case "/proc/123/stat":
+			return linuxRuntimeStat(123, "42", "S"), nil
+		case "/proc/123/net/tcp":
+			return ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "01", "456"), nil
+		}
+		return nil, os.ErrNotExist
+	}, readFDs: func(path string, limit int) ([]string, error) {
+		if path != "/proc/123/fd" || limit != 4096 {
+			return nil, ErrLinuxControlRuntime
+		}
+		return []string{"3", "4"}, nil
+	}, readlink: func(path string) (string, error) {
+		if path == "/proc/123/fd/3" {
+			return "socket:[456]", nil
+		}
+		return "anon_inode:[eventpoll]", nil
+	}, alive: func(fd int) error {
+		if fd != 200 {
+			return ErrLinuxControlRuntime
+		}
+		return nil
+	}}
+}
+func TestLinuxControlOwnerParse(t *testing.T) {
+	s, c := ownerTestAddresses()
+	valid := ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "01", "456")
+	inode, err := linuxControlOwnerInode(valid, s, c)
+	if err != nil || inode != "456" {
+		t.Fatalf("valid %q %v", inode, err)
+	}
+	for name, raw := range map[string][]byte{"duplicate": append(append([]byte(nil), valid...), append(bytes.Split(valid, []byte("\n"))[1], '\n')...), "wrong-state": ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "0A", "456"), "bad-inode": ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "01", "0456"), "bad-header": []byte("bad\n"), "too-large": bytes.Repeat([]byte("x"), (1<<20)+1), "bad-address": ownerTestTable("GG00007F:4A32", linuxControlOwnerProcAddress(c), "01", "456")} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := linuxControlOwnerInode(raw, s, c); err == nil {
+				t.Fatal("invalid accepted")
+			}
+		})
+	}
+	zero := ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "01", "0")
+	if inode, err := linuxControlOwnerInode(zero, s, c); err != nil || inode != "" {
+		t.Fatal("zero inode must remain unproved", inode, err)
+	}
+	reversed := ownerTestTable(linuxControlOwnerProcAddress(c), linuxControlOwnerProcAddress(s), "01", "456")
+	if inode, err := linuxControlOwnerInode(reversed, s, c); err != nil || inode != "" {
+		t.Fatal("client inode accepted", inode, err)
+	}
+	for _, raw := range []string{"localhost:18994", "[::1]:18994", "127.0.0.2:18994", "127.0.0.1:018994", "127.0.0.1:0", "127.0.0.1:65536"} {
+		if _, err := linuxControlOwnerEndpoint(raw); err == nil {
+			t.Fatal(raw)
+		}
+	}
+}
+func TestLinuxControlOwnerFakeSuccessAndEveryDial(t *testing.T) {
+	conn := ownerTestConn()
+	ops := ownerTestOps(conn)
+	var dials, proofs int
+	base := ops.readFile
+	ops.dial = func(context.Context, string, string) (net.Conn, error) { dials++; return conn, nil }
+	ops.readFile = func(path string, limit int) ([]byte, error) {
+		if strings.HasSuffix(path, "/net/tcp") {
+			proofs++
+		}
+		return base(path, limit)
+	}
+	dial := linuxControlOwnerDial(context.Background(), "127.0.0.1:18994", 200, ownerTestInstance(), ops)
+	for j := 0; j < 2; j++ {
+		conn = ownerTestConn()
+		out, err := dial(context.Background(), "tcp", "127.0.0.1:18994")
+		if err != nil || out != conn || conn.writes.Load() != 0 || conn.closed.Load() != 0 {
+			t.Fatal("same unmodified verified connection", err)
+		}
+		out.Close()
+	}
+	if dials != 2 || proofs != 2 {
+		t.Fatal("each repeated transport dial must prove ownership", dials, proofs)
+	}
+}
+func TestLinuxControlOwnerFakeRefusalClosesNoBytes(t *testing.T) {
+	cases := map[string]func(*linuxControlOwnerOps, *ControlInstance){
+		"wrong-start": func(o *linuxControlOwnerOps, i *ControlInstance) { i.StartTicks = "43" },
+		"dead-pidfd": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			o.alive = func(int) error { return ErrLinuxControlRuntime }
+		},
+		"missing-fd": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			o.readFDs = func(string, int) ([]string, error) { return []string{}, nil }
+		},
+		"proc-error": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			o.readFile = func(string, int) ([]byte, error) { return nil, os.ErrPermission }
+		},
+		"fd-link-error": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			o.readlink = func(string) (string, error) { return "", os.ErrPermission }
+		},
+		"oversized-fd-list": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			o.readFDs = func(string, int) ([]string, error) { return make([]string, 4097), nil }
+		},
+		"wrong-instance": func(o *linuxControlOwnerOps, i *ControlInstance) { i.PID = 124 },
+		"wrong-boot":     func(o *linuxControlOwnerOps, i *ControlInstance) { i.BootID = "22345678-1234-1234-1234-123456789abc" },
+		"state-not-established": func(o *linuxControlOwnerOps, i *ControlInstance) {
+			base := o.readFile
+			o.readFile = func(p string, l int) ([]byte, error) {
+				if strings.HasSuffix(p, "/net/tcp") {
+					s, c := ownerTestAddresses()
+					return ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "0A", "456"), nil
+				}
+				return base(p, l)
+			}
+		},
+	}
+	for _, mode := range []string{"zero-inode", "duplicate-tuple", "missing-tuple"} {
+		mode := mode
+		cases[mode] = func(o *linuxControlOwnerOps, i *ControlInstance) {
+			base := o.readFile
+			o.readFile = func(path string, limit int) ([]byte, error) {
+				raw, err := base(path, limit)
+				if !strings.HasSuffix(path, "/net/tcp") {
+					return raw, err
+				}
+				s, c := ownerTestAddresses()
+				switch mode {
+				case "zero-inode":
+					return ownerTestTable(linuxControlOwnerProcAddress(s), linuxControlOwnerProcAddress(c), "01", "0"), nil
+				case "duplicate-tuple":
+					return append(raw, append(bytes.Split(raw, []byte("\n"))[1], '\n')...), nil
+				default:
+					return []byte(" sl local_address rem_address st\n"), nil
+				}
+			}
+		}
+	}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
+			conn := ownerTestConn()
+			ops := ownerTestOps(conn)
+			instance := ownerTestInstance()
+			change(&ops, &instance)
+			dial := linuxControlOwnerDial(context.Background(), "127.0.0.1:18994", 200, instance, ops)
+			out, err := dial(context.Background(), "tcp", "127.0.0.1:18994")
+			if err == nil || out != nil || conn.closed.Load() != 1 || conn.writes.Load() != 0 {
+				t.Fatal("refusal leaked", err, conn.closed.Load(), conn.writes.Load())
+			}
+		})
+	}
+}
