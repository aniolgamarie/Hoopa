+}
+func TestLinuxControlOwnerNativeReplacementCannotSteal(t *testing.T) {
+	child := ownerStartChild(t, "replacement")
+	instance, fd := ownerClaimChild(t, child)
+	ops := newLinuxControlOwnerOps()
+	base := ops.readFile
+	proved := make(chan struct{})
+	resume := make(chan struct{})
+	var resumeOnce sync.Once
+	release := func() { resumeOnce.Do(func() { close(resume) }) }
+	defer release()
+	var stats atomic.Int32
+	// Observe the exact native reversed tuple inode; the gate must follow its
+	// actual FD link, not merely an unrelated socket in the child process.
+	dialBase := ops.dial
+	var captured net.Conn
+	var expectedInode atomic.Value
+	ops.dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := dialBase(ctx, network, address)
+		if err == nil {
+			captured = conn
+		}
+		return conn, err
+	}
+	var fdSeen atomic.Bool
+	links := ops.readlink
+	ops.readlink = func(path string) (string, error) {
+		link, err := links(path)
+		wanted, _ := expectedInode.Load().(string)
+		if err == nil && wanted != "" && link == "socket:["+wanted+"]" {
+			fdSeen.Store(true)
+		}
+		return link, err
+	}
+	var gated atomic.Bool
+	ops.readFile = func(path string, l int) ([]byte, error) {
+		raw, err := base(path, l)
+		if err == nil && strings.HasSuffix(path, "/net/tcp") && captured != nil {
+			server, e := linuxControlOwnerAddress(captured.RemoteAddr())
+			client, e2 := linuxControlOwnerAddress(captured.LocalAddr())
+			if e == nil && e2 == nil {
+				inode, e := linuxControlOwnerInode(raw, server, client)
+				if e == nil && inode != "" {
+					expectedInode.Store(inode)
+				}
+			}
+		}
+		if strings.HasSuffix(path, "/stat") && stats.Add(1) >= 2 && fdSeen.Load() && gated.CompareAndSwap(false, true) {
+			close(proved)
+			<-resume
+		}
+		return raw, err
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, err := linuxControlHTTPStatusOwner(context.Background(), capabilityprofile.Config{Controller: child.ready.Address, Secret: "owner-fixture"}, fd, instance, ops)
+		done <- err
+	}()
+	select {
+	case <-proved:
+	case <-time.After(time.Second):
+		t.Fatal("native ownership proof barrier missing")
+	}
+	io.WriteString(child.input, "replace\n")
+	var replaced ownerChildResult
+	ownerReadJSON(t, child, &replaced)
+	if !replaced.Replaced {
+		t.Fatal("replacement not bound")
+	}
+	release()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("same-connection status timeout")
+	}
+	var result ownerChildResult
+	ownerReadJSON(t, child, &result)
+	ownerChildWait(t, child)
+	if result.Auth != "Bearer owner-fixture" || result.Bytes <= 0 || result.Error != "" || result.ReplacementConnections != 0 {
+		t.Fatal("replacement stole established traffic", result)
+	}
+	t.Logf("same verified established connection retained across owned listener replacement PID %d; old bytes=%d replacement connections=0", instance.PID, result.Bytes)
+}
