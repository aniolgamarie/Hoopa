+//go:build linux && amd64
+
+package mihomoevents
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"hoopa/experiments/mihomo-events/capabilityprofile"
+)
+
+// Native operations are per invocation. Tests inject only owned/fake operations;
+// there is no global hook or process-wide transport mutation.
+type linuxControlOwnerOps struct {
+	dial     func(context.Context, string, string) (net.Conn, error)
+	readFile func(string, int) ([]byte, error)
+	readFDs  func(string, int) ([]string, error)
+	readlink func(string) (string, error)
+	alive    func(int) error
+}
+
+func newLinuxControlOwnerOps() linuxControlOwnerOps {
+	return linuxControlOwnerOps{dial: (&net.Dialer{Timeout: 500 * time.Millisecond}).DialContext, readFile: linuxControlReadFile, readFDs: linuxControlOwnerFDs, readlink: os.Readlink, alive: linuxControlOwnerAlive}
+}
+func linuxControlOwnerAlive(fd int) error {
+	if fd < 0 || fd > 2147483647 {
+		return ErrLinuxControlRuntime
+	}
+	p := linuxControlPollFD{FD: int32(fd), Events: 1}
+	_, _, err := syscall.Syscall(syscall.SYS_POLL, uintptr(unsafe.Pointer(&p)), 1, 0)
+	if err != 0 || p.Revents != 0 {
+		return ErrLinuxControlRuntime
+	}
+	return nil
+}
+func linuxControlOwnerFDs(path string, limit int) ([]string, error) {
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, err
+	}
+	names, err := f.Readdirnames(limit + 1)
+	closed := f.Close()
+	if err != nil && !errors.Is(err, io.EOF) {
+		return nil, err
+	}
+	if closed != nil || len(names) > limit {
+		return nil, ErrLinuxControlRuntime
+	}
+	return names, nil
+}
+func linuxControlOwnerEndpoint(raw string) (*net.TCPAddr, error) {
+	host, port, err := net.SplitHostPort(raw)
+	n, e := strconv.Atoi(port)
+	if err != nil || e != nil || host != "127.0.0.1" || n < 1 || n > 65535 || strconv.Itoa(n) != port {
+		return nil, ErrLinuxControlRuntime
+	}
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: n}, nil
+}
+func linuxControlOwnerAddress(a net.Addr) (*net.TCPAddr, error) {
+	v, ok := a.(*net.TCPAddr)
+	if !ok || v == nil || v.Zone != "" || !v.IP.Equal(net.IPv4(127, 0, 0, 1)) || v.Port < 1 || v.Port > 65535 {
+		return nil, ErrLinuxControlRuntime
+	}
+	return v, nil
+}
+func linuxControlOwnerProcAddress(a *net.TCPAddr) string {
+	return fmt.Sprintf("%08X:%04X", binary.LittleEndian.Uint32(a.IP.To4()), a.Port)
+}
+
+// The TCP table is namespace-wide. Its inode is never accepted as PID ownership
+// without the separate exact process FD intersection below.
+func linuxControlOwnerInode(raw []byte, server, client *net.TCPAddr) (string, error) {
+	if len(raw) == 0 || len(raw) > 1<<20 || raw[len(raw)-1] != '\n' || strings.ContainsRune(string(raw), '\x00') {
+		return "", ErrLinuxControlRuntime
+	}
+	lines := strings.Split(strings.TrimSuffix(string(raw), "\n"), "\n")
+	header := strings.Fields(lines[0])
+	if len(header) < 4 || header[0] != "sl" || header[1] != "local_address" || header[2] != "rem_address" || header[3] != "st" {
+		return "", ErrLinuxControlRuntime
+	}
+	wantedLocal, wantedRemote := linuxControlOwnerProcAddress(server), linuxControlOwnerProcAddress(client)
+	inode := ""
+	matches := 0
+	for _, line := range lines[1:] {
+		fields := strings.Fields(line)
+		if len(fields) < 10 {
+			return "", ErrLinuxControlRuntime
+		}
+		for _, address := range fields[1:3] {
+			if len(address) != 13 || address[8] != ':' {
+				return "", ErrLinuxControlRuntime
+			}
+			ip, e := strconv.ParseUint(address[:8], 16, 32)
+			if e != nil || fmt.Sprintf("%08X", ip) != address[:8] {
+				return "", ErrLinuxControlRuntime
+			}
+			port, e := strconv.ParseUint(address[9:], 16, 16)
+			if e != nil || fmt.Sprintf("%04X", port) != address[9:] {
+				return "", ErrLinuxControlRuntime
+			}
+		}
+		if fields[1] != wantedLocal || fields[2] != wantedRemote {
+			continue
+		}
+		matches++
+		if matches != 1 || fields[3] != "01" {
+			return "", ErrLinuxControlRuntime
+		}
+		n, e := strconv.ParseUint(fields[9], 10, 64)
+		if e != nil || strconv.FormatUint(n, 10) != fields[9] {
+			return "", ErrLinuxControlRuntime
+		}
+		// An established socket can appear before accept installs its process FD.
+		// Zero is never proof; retry only within the bounded owner-appearance wait.
+		if n != 0 {
+			inode = fields[9]
+		}
+	}
+	return inode, nil
+}
+func linuxControlOwnerInstance(ctx context.Context, fd int, i ControlInstance, ops linuxControlOwnerOps) error {
+	if ctx.Err() != nil || fd < 0 || i.PID < 1 || i.PID > 2147483647 || !controlBootID.MatchString(i.BootID) || !controlTicks.MatchString(i.StartTicks) {
+		return ErrLinuxControlRuntime
+	}
+	if _, err := strconv.ParseUint(i.StartTicks, 10, 64); err != nil {
+		return ErrLinuxControlRuntime
+	}
+	if ops.alive(fd) != nil || ctx.Err() != nil {
+		return ErrLinuxControlRuntime
+	}
+	boot, err := ops.readFile("/proc/sys/kernel/random/boot_id", 64)
+	if err != nil || ctx.Err() != nil || strings.TrimSpace(string(boot)) != i.BootID {
+		return ErrLinuxControlRuntime
+	}
+	raw, err := ops.readFile("/proc/"+strconv.Itoa(i.PID)+"/stat", 4096)
+	if err != nil || ctx.Err() != nil {
+		return ErrLinuxControlRuntime
+	}
+	s, err := linuxParseStat(raw)
+	if err != nil || s.PID != i.PID || s.StartTicks != i.StartTicks || s.State == 'Z' || s.State == 'X' {
+		return ErrLinuxControlRuntime
+	}
+	return nil
+}
+func linuxControlOwnerProof(ctx context.Context, conn net.Conn, fd int, i ControlInstance, ops linuxControlOwnerOps) error {
+	local, err := linuxControlOwnerAddress(conn.LocalAddr())
+	if err != nil {
+		return err
+	}
+	remote, err := linuxControlOwnerAddress(conn.RemoteAddr())
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 250*time.Millisecond)
+	defer cancel()
+	proc := "/proc/" + strconv.Itoa(i.PID)
+	for {
+		if linuxControlOwnerInstance(ctx, fd, i, ops) != nil {
+			return ErrLinuxControlRuntime
+		}
+		if ctx.Err() != nil {
+			return ErrLinuxControlRuntime
+		}
+		raw, err := ops.readFile(proc+"/net/tcp", 1<<20)
+		if err != nil || ctx.Err() != nil {
+			return ErrLinuxControlRuntime
+		}
+		inode, err := linuxControlOwnerInode(raw, remote, local)
+		if err != nil {
+			return err
+		}
+		found := false
+		if inode != "" {
+			if ctx.Err() != nil {
+				return ErrLinuxControlRuntime
+			}
+			names, err := ops.readFDs(proc+"/fd", 4096)
+			if err != nil || len(names) > 4096 || ctx.Err() != nil {
+				return ErrLinuxControlRuntime
+			}
+			for _, name := range names {
+				if ctx.Err() != nil {
+					return ErrLinuxControlRuntime
+				}
+				n, err := strconv.ParseUint(name, 10, 31)
+				if err != nil || strconv.FormatUint(n, 10) != name {
+					return ErrLinuxControlRuntime
+				}
+				link, err := ops.readlink(proc + "/fd/" + name)
+				if err != nil || ctx.Err() != nil {
+					return ErrLinuxControlRuntime
+				}
+				if link == "socket:["+inode+"]" {
+					found = true
+				}
+			}
+		}
+		if linuxControlOwnerInstance(ctx, fd, i, ops) != nil {
+			return ErrLinuxControlRuntime
+		}
+		if found && ctx.Err() == nil {
+			return nil
+		}
+		timer := time.NewTimer(2 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ErrLinuxControlRuntime
+		case <-timer.C:
+		}
+	}
+}
+
+// Capture original request ctx: Go Transport deliberately detaches cancellation
+// from the ctx it passes to DialContext. Both cancellation sources must stop us.
+func linuxControlOwnerDial(original context.Context, controller string, fd int, i ControlInstance, ops linuxControlOwnerOps) func(context.Context, string, string) (net.Conn, error) {
+	return func(dialCtx context.Context, network, address string) (net.Conn, error) {
+		ctx, cancel := context.WithCancel(original)
+		stop := context.AfterFunc(dialCtx, cancel)
+		defer stop()
+		defer cancel()
+		if original.Err() != nil || dialCtx.Err() != nil || ctx.Err() != nil {
+			return nil, ErrLinuxControlRuntime
+		}
+		expected, err := linuxControlOwnerEndpoint(controller)
+		if err != nil || address != controller || (network != "tcp" && network != "tcp4") {
+			return nil, ErrLinuxControlRuntime
+		}
+		conn, err := ops.dial(ctx, "tcp4", address)
+		if err != nil {
+			if conn != nil {
+				conn.Close()
+			}
+			return nil, ErrLinuxControlRuntime
+		}
+		if conn == nil {
+			return nil, ErrLinuxControlRuntime
+		}
+		success := false
+		defer func() {
+			if !success {
+				conn.Close()
+			}
+		}()
+		remote, err := linuxControlOwnerAddress(conn.RemoteAddr())
+		if err != nil || !remote.IP.Equal(expected.IP) || remote.Port != expected.Port || ctx.Err() != nil || dialCtx.Err() != nil {
+			return nil, ErrLinuxControlRuntime
+		}
+		if linuxControlOwnerProof(ctx, conn, fd, i, ops) != nil || ctx.Err() != nil || dialCtx.Err() != nil {
+			return nil, ErrLinuxControlRuntime
+		}
+		success = true
+		return conn, nil
+	}
+}
+func linuxControlHTTPStatusOwner(ctx context.Context, c capabilityprofile.Config, pidfd int, instance ControlInstance, ops linuxControlOwnerOps) (linuxControlStatus, error) {
+	var s linuxControlStatus
+	ctx, cancel := context.WithTimeout(ctx, time.Second)
+	defer cancel()
+	tr := &http.Transport{Proxy: nil, DialContext: linuxControlOwnerDial(ctx, c.Controller, pidfd, instance, ops), DisableKeepAlives: true}
+	defer tr.CloseIdleConnections()
+	client := &http.Client{Transport: tr, Timeout: time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	request, err := http.NewRequestWithContext(ctx, "GET", "http://"+c.Controller+"/hoopa/status", nil)
+	if err != nil {
+		return s, ErrLinuxControlRuntime
+	}
+	request.Header.Set("Authorization", "Bearer "+c.Secret)
+	response, err := client.Do(request)
+	if err != nil {
+		return s, ErrLinuxControlRuntime
+	}
+	defer response.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(raw) > 8192 || response.StatusCode != 200 || response.Header.Get("Content-Type") != "application/json" || controlDecode(raw, &s) != nil {
+		return s, ErrLinuxControlRuntime
+	}
+	return s, nil
+}
