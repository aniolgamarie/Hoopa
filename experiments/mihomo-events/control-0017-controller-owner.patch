+// Child body is executed only by explicitly owned test subprocesses. The normal
+// suite's empty-env invocation has no sockets or side effects and does not skip.
+func TestLinuxControlOwnerNativeChild(t *testing.T) {
+	mode := os.Getenv("HOOPA_CONTROL_OWNER_TEST_CHILD")
+	if mode == "" {
+		return
+	}
+	os.Exit(ownerNativeChild(mode))
+}
+func ownerNativeChild(mode string) int {
+	pid := os.Getpid()
+	raw, err := linuxControlReadFile(fmt.Sprintf("/proc/%d/stat", pid), 4096)
+	if err != nil {
+		return 2
+	}
+	stat, err := linuxParseStat(raw)
+	if err != nil {
+		return 2
+	}
+	boot, err := linuxControlReadFile("/proc/sys/kernel/random/boot_id", 64)
+	if err != nil {
+		return 2
+	}
+	ready := ownerChildReady{PID: pid, StartTicks: stat.StartTicks, BootID: strings.TrimSpace(string(boot))}
+	encoder := json.NewEncoder(os.Stdout)
+	input := bufio.NewReader(os.Stdin)
+	if mode == "standby" {
+		encoder.Encode(ready)
+		line, err := input.ReadString('\n')
+		if err != nil || line != "stop\n" {
+			return 3
+		}
+		return 0
+	}
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		return 4
+	}
+	defer ln.Close()
+	ready.Address = ln.Addr().String()
+	encoder.Encode(ready)
+	ln.(*net.TCPListener).SetDeadline(time.Now().Add(3 * time.Second))
+	conn, err := ln.Accept()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		return 5
+	}
+	defer conn.Close()
+	var replacement net.Listener
+	if mode == "replacement" {
+		line, err := input.ReadString('\n')
+		if err != nil || line != "replace\n" {
+			return 6
+		}
+		ln.Close()
+		replacement, err = net.Listen("tcp4", ready.Address)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			return 7
+		}
+		defer replacement.Close()
+		encoder.Encode(ownerChildResult{Replaced: true})
+	}
+	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	counter := &ownerCountingReader{reader: conn}
+	first := make([]byte, 1)
+	n, err := counter.Read(first)
+	result := ownerChildResult{Bytes: n}
+	if err == io.EOF && n == 0 {
+		encoder.Encode(result)
+		return 0
+	}
+	if err != nil || n != 1 {
+		result.Error = fmt.Sprint(err)
+		encoder.Encode(result)
+		return 8
+	}
+	request, err := http.ReadRequest(bufio.NewReader(io.MultiReader(bytes.NewReader(first), counter)))
+	if err != nil {
+		result.Error = err.Error()
+		encoder.Encode(result)
+		return 9
+	}
+	request.Body.Close()
+	result.Auth = request.Header.Get("Authorization")
+	result.Bytes = counter.bytes
+	body := `{"schema_version":1,"config_generation":"gen:owner","config_sha256":"hash","state":"running","identity_instance":false,"identity_name":false,"identity_path":false,"accepted_tcp_connections":0,"experimental_admission":{"admitted":0,"rejected":0,"revoked":false}}`
+	_, err = io.WriteString(conn, fmt.Sprintf("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", len(body), body))
+	conn.Close()
+	if err != nil {
+		result.Error = err.Error()
+	}
+	if replacement != nil {
+		replacement.(*net.TCPListener).SetDeadline(time.Now().Add(40 * time.Millisecond))
+		other, e := replacement.Accept()
+		if other != nil {
+			result.ReplacementConnections++
+			other.Close()
+		}
+		if timeout, ok := e.(net.Error); !ok || !timeout.Timeout() {
+			result.Error = fmt.Sprint(e)
+		}
+	}
+	encoder.Encode(result)
+	if result.Error != "" || result.ReplacementConnections != 0 {
+		return 10
+	}
+	return 0
+}
+
+type ownerCountingReader struct {
+	reader io.Reader
+	bytes  int
+}
+
+func (r *ownerCountingReader) Read(p []byte) (int, error) {
+	n, err := r.reader.Read(p)
+	r.bytes += n
+	return n, err
+}
