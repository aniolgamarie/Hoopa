+func TestLinuxControlOwnerFakeCancelDuringProofDetachedDial(t *testing.T) {
+	original, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	conn := ownerTestConn()
+	ops := ownerTestOps(conn)
+	entered := make(chan struct{})
+	base := ops.readFile
+	var tcpReads, fdReads atomic.Int32
+	ops.readFile = func(path string, limit int) ([]byte, error) {
+		if strings.HasSuffix(path, "/net/tcp") {
+			tcpReads.Add(1)
+			close(entered)
+			<-original.Done()
+			return []byte(" sl local_address rem_address st\n"), nil
+		}
+		return base(path, limit)
+	}
+	ops.readFDs = func(string, int) ([]string, error) { fdReads.Add(1); return []string{}, nil }
+	done := make(chan error, 1)
+	dial := linuxControlOwnerDial(original, "127.0.0.1:18994", 200, ownerTestInstance(), ops)
+	go func() { _, err := dial(context.WithoutCancel(original), "tcp", "127.0.0.1:18994"); done <- err }()
+	<-entered
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("cancel accepted")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("detached proof survived original ctx")
+	}
+	if tcpReads.Load() != 1 || fdReads.Load() != 0 || conn.closed.Load() != 1 || conn.writes.Load() != 0 {
+		t.Fatal("post-cancel polling/bytes", tcpReads.Load(), fdReads.Load(), conn.writes.Load())
+	}
+}
