+type ownerChild struct {
+	cmd    *exec.Cmd
+	input  io.WriteCloser
+	output *bufio.Reader
+	stderr *bytes.Buffer
+	ready  ownerChildReady
+}
+type ownerChildReady struct {
+	PID        int    `json:"pid"`
+	StartTicks string `json:"start_ticks"`
+	BootID     string `json:"boot_id"`
+	Address    string `json:"address"`
+}
+type ownerChildResult struct {
+	Bytes                  int    `json:"bytes"`
+	Auth                   string `json:"auth"`
+	Error                  string `json:"error"`
+	Replaced               bool   `json:"replaced"`
+	ReplacementConnections int    `json:"replacement_connections"`
+}
+
+func ownerReadJSON(t *testing.T, child *ownerChild, value any) {
+	t.Helper()
+	line, err := child.output.ReadBytes('\n')
+	if err != nil || len(line) > 8192 || json.Unmarshal(line, value) != nil {
+		t.Fatalf("owned child output: %q %v %s", line, err, child.stderr.String())
+	}
+}
+func ownerStartChild(t *testing.T, mode string) *ownerChild {
+	t.Helper()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(exe, "-test.run=^TestLinuxControlOwnerNativeChild$")
+	cmd.Env = append(os.Environ(), "HOOPA_CONTROL_OWNER_TEST_CHILD="+mode)
+	input, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := &ownerChild{cmd: cmd, input: input, output: bufio.NewReader(output), stderr: &bytes.Buffer{}}
+	cmd.Stderr = child.stderr
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		input.Close()
+		if cmd.ProcessState == nil {
+			cmd.Process.Kill()
+			cmd.Wait()
+		}
+	})
+	ownerReadJSON(t, child, &child.ready)
+	if child.ready.PID != cmd.Process.Pid {
+		t.Fatal("child OS identity mismatch")
+	}
+	return child
+}
+func ownerClaimChild(t *testing.T, child *ownerChild) (ControlInstance, int) {
+	t.Helper()
+	pid := child.ready.PID
+	raw, err := linuxControlReadFile(fmt.Sprintf("/proc/%d/stat", pid), 4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stat, err := linuxParseStat(raw)
+	if err != nil || stat.PID != pid || stat.StartTicks != child.ready.StartTicks {
+		t.Fatal("independent child instance", err)
+	}
+	boot, err := linuxControlReadFile("/proc/sys/kernel/random/boot_id", 64)
+	if err != nil || strings.TrimSpace(string(boot)) != child.ready.BootID {
+		t.Fatal("independent child boot", err)
+	}
+	fd, err := linuxControlPidfdOpen(pid)
+	if err != nil {
+		t.Fatal("pidfd unavailable, not skipped", err)
+	}
+	t.Cleanup(func() { newLinuxControlOps().closeFD(fd) })
+	return ControlInstance{PID: pid, StartTicks: stat.StartTicks, BootID: child.ready.BootID}, fd
+}
+func ownerChildWait(t *testing.T, child *ownerChild) {
+	t.Helper()
+	if err := child.cmd.Wait(); err != nil {
+		t.Fatal("owned child exit", err, child.stderr.String())
+	}
+}
+func TestLinuxControlOwnerNativeLegitimateAuth(t *testing.T) {
+	child := ownerStartChild(t, "server")
+	instance, fd := ownerClaimChild(t, child)
+	status, err := linuxControlHTTPStatus(context.Background(), capabilityprofile.Config{Controller: child.ready.Address, Secret: "owner-fixture"}, fd, instance)
+	if err != nil || status.State != "running" {
