+}
+func TestLinuxControlOwnerNativeWrongOwner(t *testing.T) {
+	server := ownerStartChild(t, "server")
+	claimed := ownerStartChild(t, "standby")
+	instance, fd := ownerClaimChild(t, claimed)
+	_, err := linuxControlHTTPStatus(context.Background(), capabilityprofile.Config{Controller: server.ready.Address, Secret: "must-not-leak"}, fd, instance)
