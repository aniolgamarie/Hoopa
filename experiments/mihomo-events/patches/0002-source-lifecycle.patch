+func TestSourceLostACKAndReopenReplayOriginalBytes(t *testing.T) {
+	if os.Getenv("HOOPA_TRACE_NETWORK_TEST") != "1" {
+		t.Skip("explicit loopback test only")
+	}
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	sink := filepath.Join(t.TempDir(), "received-event")
+	var mu sync.Mutex
+	var first []byte
+	var calls int
+	var restarted bool
+	var handlerErr error
+	retried, replayed := make(chan struct{}), make(chan struct{})
+	var retryOnce, replayOnce sync.Once
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer test-secret" {
+			w.WriteHeader(403)
+			return
+		}
+		raw, err := io.ReadAll(io.LimitReader(r.Body, maxFrame+1))
+		mu.Lock()
+		defer mu.Unlock()
+		if err != nil {
+			handlerErr = err
+			w.WriteHeader(500)
+			return
+		}
+		calls++
+		if calls == 1 {
+			first = append([]byte(nil), raw...)
+			file, e := os.OpenFile(sink, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+			if e == nil {
+				_, e = file.Write(raw)
+				if e == nil {
+					e = file.Sync()
+				}
+				_ = file.Close()
+			}
+			if e != nil {
+				handlerErr = e
+				w.WriteHeader(500)
+				return
+			}
+			// The receiver has a synced copy, but the sender gets no response.
+			conn, _, e := w.(http.Hijacker).Hijack()
+			if e != nil {
+				handlerErr = e
+				return
+			}
+			_ = conn.Close()
+			return
+		}
+		if !bytes.Equal(first, raw) {
+			handlerErr = ErrSource
+			w.WriteHeader(409)
+			return
+		}
+		w.WriteHeader(204)
+		if restarted {
+			replayOnce.Do(func() { close(replayed) })
+		} else {
+			retryOnce.Do(func() { close(retried) })
+		}
+	}))
+	defer server.Close()
+	s, err := openSource(dir, "test-generation", server.URL, "test-secret", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(s.close)
+	if _, err := s.begin(nil, nil, "example.test", "", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	finished := make(chan struct{})
+	go func() { defer close(finished); s.send() }()
+	select {
+	case <-retried:
+	case <-time.After(5 * time.Second):
+		t.Fatal("lost ACK did not replay")
+	}
+	s.close()
+	select {
+	case <-finished:
+	case <-time.After(3 * time.Second):
+		t.Fatal("sender did not stop")
+	}
+	mu.Lock()
+	restarted = true
+	mu.Unlock()
+	reopened, err := openSource(dir, "test-generation", server.URL, "test-secret", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.close()
+	finishedAgain := make(chan struct{})
+	go func() { defer close(finishedAgain); reopened.send() }()
+	select {
+	case <-replayed:
+	case <-time.After(5 * time.Second):
+		t.Fatal("old epoch did not replay after reopen")
+	}
+	reopened.close()
+	select {
+	case <-finishedAgain:
+	case <-time.After(3 * time.Second):
+		t.Fatal("reopened sender did not stop")
+	}
+	saved, err := os.ReadFile(sink)
+	mu.Lock()
+	defer mu.Unlock()
+	if err != nil || handlerErr != nil || !bytes.Equal(saved, first) || calls < 3 {
+		t.Fatal("durable receiver bytes or stable replay changed", err, handlerErr)
+	}
