+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"strconv"
+	"time"
+)
+
+const epochBudget int64 = maxFrame + 36
+
+// Shutdown is only the normal core shutdown hook. If no opt-in source has
+// initialized, consuming once prevents a concurrent Begin from opening one.
+// A missing durable epoch_closed remains missing; failure never fabricates it.
+func Shutdown() {
+	global.once.Do(func() { global.err = ErrSource })
+	if global.s != nil {
+		_ = global.s.shutdown()
+	}
+}
+
+func (s *source) startCheckpoints() {
+	s.checkpointStop = make(chan struct{})
+	s.checkpointDone = make(chan struct{})
+	go func() {
+		defer close(s.checkpointDone)
+		ticker := time.NewTicker(time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-s.checkpointStop:
+				return
+			case <-ticker.C:
+				s.mu.Lock()
+				flows := make([]*Flow, 0, len(s.flows))
+				for _, f := range s.flows {
+					flows = append(flows, f)
+				}
+				s.mu.Unlock()
+				for _, f := range flows {
+					select {
+					case <-s.checkpointStop:
+						return
+					default:
+					}
+					_ = f.Checkpoint()
+				}
+			}
+		}
+	}()
+}
+
+// Joining never holds a flow/source mutex: the worker follows f -> s order.
+func (s *source) stopCheckpoints() {
+	if s.checkpointStop == nil {
+		return
+	}
+	s.checkpointOnce.Do(func() { close(s.checkpointStop) })
+	<-s.checkpointDone
+}
+
+// Checkpoint saves cumulative bytes, never an additive delta. Terminal/gap
+// headroom remains independent; exhausted window quota does not invalidate an
+// otherwise known final counter or change forwarding.
+func (f *Flow) Checkpoint() error {
+	if f == nil {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.s.mu.Lock()
+	stopped := f.s.stopping || f.s.rawClosed || f.s.epochClosed
+	f.s.mu.Unlock()
+	if f.terminal || stopped {
+		return ErrSource
+	}
+	if f.counterInvalid {
+		f.windowGap = true
+		return ErrSource
+	}
+	if err := f.s.append(f, "bytes_checkpoint", f.attemptID(), map[string]any{"upload_bytes": strconv.FormatUint(f.up, 10), "download_bytes": strconv.FormatUint(f.down, 10)}); err != nil {
+		f.windowGap = true
+		return err
+	}
+	return nil
+}
+
+func (s *source) shutdown() error {
+	s.shutdownOnce.Do(func() {
+		s.mu.Lock()
+		s.stopping = true
+		// Replay-only capacity mode has no current epoch to terminate.
+		if s.readOnly && s.file == nil {
+			s.mu.Unlock()
+			s.stopCheckpoints()
+			return
+		}
+		flows := make([]*Flow, 0, len(s.flows))
+		for _, f := range s.flows {
+			flows = append(flows, f)
+		}
+		s.mu.Unlock()
+		s.stopCheckpoints()
+		unfinished := uint64(0)
+		for _, f := range flows {
+			f.mu.Lock()
+			s.mu.Lock()
+			registered := s.flows[f.id] == f
+			s.mu.Unlock()
+			// A concurrent Begin may have released a prewrite-failed reservation
+			// after the snapshot; it was never admitted and needs no gap.
+			if f.terminal || !registered {
+				f.mu.Unlock()
+				continue
+			}
+			// Normal core shutdown does not quiesce the network. No cumulative
+			// final is inferred from this snapshot; all future event writes stop.
+			f.terminal = true
+			unfinished++
+			err := s.append(f, "gap", f.attemptID(), map[string]any{"reason": "source_shutdown_before_final", "dimensions": []string{"bytes", "route_or_setup", "window_checkpoints"}, "upload_bytes": nil, "download_bytes": nil, "connection_id": f.connection})
+			if err == nil {
+				s.mu.Lock()
+				s.reserved -= f.reserved
+				f.reserved = 0
+				delete(s.flows, f.id)
+				s.mu.Unlock()
+			}
+			f.mu.Unlock()
+			if err != nil {
+				s.shutdownErr = err
+				return
+			}
+		}
+		finality := "complete"
+		if unfinished != 0 {
+			finality = "incomplete"
+		}
+		s.shutdownErr = s.append(nil, "epoch_closed", "", map[string]any{"reason": "core_shutdown", "unfinished_flows": strconv.FormatUint(unfinished, 10), "finality": finality})
+	})
+	return s.shutdownErr
+}
