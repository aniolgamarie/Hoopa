+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"encoding/json"
+	"io"
+	"sync"
+	"testing"
+	"time"
+)
+
+func lifecycleRows(t *testing.T, s *source) []map[string]json.RawMessage {
+	t.Helper()
+	var out []map[string]json.RawMessage
+	for _, raw := range frames(t, s) {
+		var m map[string]json.RawMessage
+		if json.Unmarshal(raw, &m) != nil {
+			t.Fatal("bad frame")
+		}
+		out = append(out, m)
+	}
+	return out
+}
+func TestSourceCheckpointExactCumulativeAndFinal(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	f.AddUpload(9007199254740993)
+	f.AddDownload(17)
+	if e = f.Checkpoint(); e != nil {
+		t.Fatal(e)
+	}
+	f.AddUpload(5)
+	f.Close()
+	if e = f.Checkpoint(); e == nil {
+		t.Fatal("checkpoint after final")
+	}
+	r := lifecycleRows(t, s)
+	if len(r) != 3 {
+		t.Fatalf("got %d frames", len(r))
+	}
+	if len(r[1]) != 13 || string(r[1]["kind"]) != `"bytes_checkpoint"` || string(r[1]["upload_bytes"]) != `"9007199254740993"` || string(r[2]["upload_bytes"]) != `"9007199254740998"` {
+		t.Fatal("cumulative profile lost precision or counted twice")
+	}
+}
+func TestSourceCheckpointQuotaPreservesFinalAndEpoch(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	for i := 0; i < 1000; i++ {
+		if f.Checkpoint() != nil {
+			break
+		}
+		if i == 999 {
+			t.Fatal("unbounded checkpoint quota")
+		}
+	}
+	f.AddUpload(42)
+	f.Close()
+	if e = s.shutdown(); e != nil {
+		t.Fatal(e)
+	}
+	r := lifecycleRows(t, s)
+	var closed, gaps int
+	for _, m := range r {
+		switch string(m["kind"]) {
+		case `"closed"`:
+			closed++
+			if string(m["upload_bytes"]) != `"42"` {
+				t.Fatal("lost known final")
+			}
+		case `"gap"`:
+			gaps++
+			if string(m["dimensions"]) != `["window_checkpoints"]` {
+				t.Fatal("window gap changed byte scope")
+			}
+		}
+	}
+	if closed != 1 || gaps != 1 || string(r[len(r)-1]["kind"]) != `"epoch_closed"` || s.reserved != 0 || s.epochReserved != 0 {
+		t.Fatal("terminal reserves lost")
+	}
+}
+func TestSourceNormalShutdownIncompleteAndNoLateEvents(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	f.AddUpload(12)
+	if e = s.shutdown(); e != nil {
+		t.Fatal(e)
+	}
+	r := lifecycleRows(t, s)
+	if len(r) != 3 {
+		t.Fatalf("unexpected lifecycle %d", len(r))
+	}
+	if string(r[1]["reason"]) != `"source_shutdown_before_final"` || string(r[1]["upload_bytes"]) != "null" {
+		t.Fatal("shutdown fabricated final")
+	}
+	last := r[2]
+	if string(last["flow_id"]) != "null" || string(last["attempt_id"]) != "null" || string(last["unfinished_flows"]) != `"1"` || string(last["finality"]) != `"incomplete"` {
+		t.Fatal("invalid epoch marker")
+	}
+	f.Close()
+	f.AddUpload(10)
+	f.NewAttempt().Finish(nil, nil, nil, true)
+	_ = f.Decide("MATCH", "", "DIRECT")
+	if e = f.Checkpoint(); e == nil {
+		t.Fatal("late checkpoint")
+	}
+	if len(lifecycleRows(t, s)) != 3 {
+		t.Fatal("events after epoch marker")
+	}
+	if _, e = s.begin(nil, nil, "example.test", "", time.Now()); e == nil {
+		t.Fatal("begin after shutdown")
+	}
+}
+func TestSourceConcurrentCloseShutdownOrdering(t *testing.T) {
+	for i := 0; i < 12; i++ {
+		s := testSource(t, defaultLimit)
+		f, e := s.begin(nil, nil, "example.test", "", time.Now())
+		if e != nil {
+			t.Fatal(e)
+		}
+		var w sync.WaitGroup
+		w.Add(3)
+		go func() { defer w.Done(); f.Close() }()
+		go func() { defer w.Done(); _ = f.Checkpoint() }()
+		go func() { defer w.Done(); _ = s.shutdown() }()
+		w.Wait()
+		r := lifecycleRows(t, s)
+		if string(r[len(r)-1]["kind"]) != `"epoch_closed"` {
+			t.Fatal("epoch not last")
+		}
+		terminal := 0
+		for _, m := range r {
+			if string(m["kind"]) == `"closed"` || string(m["reason"]) == `"source_shutdown_before_final"` {
+				terminal++
+			}
+		}
+		if terminal != 1 {
+			t.Fatal("duplicated finalization")
+		}
+	}
+}
+func TestSourceCheckpointWriteUncertainPoisons(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	seq := s.seq
+	s.file.Close()
+	if f.Checkpoint() == nil || !s.poisoned || s.seq != seq {
+		t.Fatal("uncertain checkpoint confirmed")
+	}
+	if s.shutdown() == nil || s.epochClosed {
+		t.Fatal("uncertain shutdown claimed complete")
+	}
+}
+func TestSourcePeriodicCheckpointWorkerStops(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	deadline := time.After(3 * time.Second)
+	for {
+		s.mu.Lock()
+		seq := s.seq
+		s.mu.Unlock()
+		if seq >= 2 {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("periodic checkpoint missing")
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+	if e = s.shutdown(); e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case <-s.checkpointDone:
+	default:
+		t.Fatal("worker still active")
+	}
+	if f.Checkpoint() == nil {
+		t.Fatal("checkpoint after stopped worker")
+	}
+}
+
+func TestSourceRawCloseStopsWorkerWithoutEpochMarker(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, e := s.begin(nil, nil, "example.test", "", time.Now())
+	if e != nil {
+		t.Fatal(e)
+	}
+	s.close()
+	select {
+	case <-s.checkpointDone:
+	default:
+		t.Fatal("raw close leaked worker")
+	}
+	if s.epochClosed || f.Checkpoint() == nil {
+		t.Fatal("raw close claimed epoch finality")
+	}
+	if _, e = s.begin(nil, nil, "example.test", "", time.Now()); e == nil {
+		t.Fatal("raw close allowed Begin")
+	}
+	if f.Decide("MATCH", "", "DIRECT") == nil {
+		t.Fatal("raw close allowed append")
+	}
+}
+
+func TestSourceEpochMarkerSyncUncertainNeverConfirmed(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	s.mu.Lock()
+	s.syncFrame = func() error {
+		if err := s.file.Sync(); err != nil {
+			return err
+		}
+		return io.ErrUnexpectedEOF
+	}
+	s.mu.Unlock()
+	if s.shutdown() == nil || !s.poisoned || !s.readOnly || s.epochClosed || s.seq != 0 {
+		t.Fatal("uncertain marker confirmed")
+	}
+	if len(frames(t, s)) != 1 {
+		t.Fatal("uncertain written marker silently removed")
+	}
+}
+
+func TestSourceNormalShutdownCompleteWithoutActiveFlow(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	if err := s.shutdown(); err != nil {
+		t.Fatal(err)
+	}
+	r := lifecycleRows(t, s)
+	if len(r) != 1 || string(r[0]["finality"]) != `"complete"` || string(r[0]["unfinished_flows"]) != `"0"` || string(r[0]["flow_id"]) != "null" {
+		t.Fatal("invalid complete epoch")
+	}
+	if err := s.shutdown(); err != nil || len(frames(t, s)) != 1 {
+		t.Fatal("duplicate epoch marker")
+	}
+}
