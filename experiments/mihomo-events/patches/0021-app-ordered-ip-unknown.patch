+package logic
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/rules/common"
+	"testing"
+)
+
+func TestHoopaANDIPUnknownDominance(t *testing.T) {
+	for _, sibling := range []int8{0, 1} {
+		for _, ipFirst := range []bool{false, true} {
+			ip, err := common.NewIPCIDR("127.0.0.0/8", "REJECT")
+			if err != nil {
+				t.Fatal(err)
+			}
+			rules := []C.Rule{ip, &triRule{state: sibling}}
+			if !ipFirst {
+				rules[0], rules[1] = rules[1], rules[0]
+			}
+			and := &Logic{ruleType: C.AND, adapter: "REJECT", rules: rules}
+			got, target := and.MatchHoopa(&C.Metadata{Host: "controlled.invalid"}, C.RuleMatchHelper{ResolveIP: func() {}})
+			want := int8(-1)
+			if sibling == 0 {
+				want = 0
+			}
+			if got != want || target != "REJECT" {
+				t.Fatalf("sibling=%d ipFirst=%v state=%d target=%q", sibling, ipFirst, got, target)
+			}
+		}
+	}
+}
