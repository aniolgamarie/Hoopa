+++ b/tunnel/hoopa_ordered_app_test.go
@@ -0,0 +1,34 @@
+package tunnel
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/rules/common"
+	"net/netip"
+	"testing"
+)
+
+func TestHoopaOrderedAppRulesWithoutTelemetryFlow(t *testing.T) {
+	oldRules, oldProxies, oldMode := rules, proxies, C.HoopaOrderedRules
+	defer func() { rules, proxies, C.HoopaOrderedRules = oldRules, oldProxies, oldMode }()
+	proxy := &hoopaProxyFake{}
+	proxies = map[string]C.Proxy{"DIRECT": proxy}
+	ip, _ := common.NewIPCIDR("127.0.0.0/8", "DIRECT")
+	rules = []C.Rule{ip, common.NewDomain("controlled.invalid", "DIRECT")}
+	m := &C.Metadata{Host: "controlled.invalid"}
+	C.HoopaOrderedRules = false
+	if got, rule, err := match(m, C.RuleMatchHelper{}); err != nil || got != proxy || rule != rules[1] {
+		t.Fatal("legacy bool path changed", err)
+	}
+	C.HoopaOrderedRules = true
+	if _, rule, err := match(m, C.RuleMatchHelper{}); err == nil || rule != rules[0] {
+		t.Fatal("app unknown must reject without FlowID", err)
+	}
+	m.DstIP = netip.MustParseAddr("192.0.2.1")
+	if got, rule, err := match(m, C.RuleMatchHelper{}); err != nil || got != proxy || rule != rules[1] {
+		t.Fatal("known miss cannot block", err)
+	}
+	m.DstIP = netip.MustParseAddr("127.0.0.2")
+	if got, rule, err := match(m, C.RuleMatchHelper{}); err != nil || got != proxy || rule != rules[0] {
+		t.Fatal("known match lost", err)
+	}
+}
