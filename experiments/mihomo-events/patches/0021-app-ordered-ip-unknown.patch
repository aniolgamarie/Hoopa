diff --git a/rules/common/hoopa_ipcidr_test.go b/rules/common/hoopa_ipcidr_test.go
new file mode 100644
--- /dev/null
+++ b/rules/common/hoopa_ipcidr_test.go
@@ -0,0 +1,61 @@
+package common
+
+import (
+	"net/netip"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestHoopaIPCIDRPreservesUnavailableAddress(t *testing.T) {
+	for _, tc := range []struct {
+		name, initial, resolved string
+		noResolve, source       bool
+		want                    int8
+		calls                   int
+	}{
+		{"failed-domain", "", "", false, false, -1, 1},
+		{"resolved-inside", "", "127.0.0.2", false, false, 1, 1},
+		{"resolved-outside", "", "192.0.2.1", false, false, 0, 1},
+		{"literal-outside", "192.0.2.1", "", false, false, 0, 1},
+		{"unavailable-no-resolve", "", "127.0.0.2", true, false, -1, 0},
+		{"known-no-resolve", "127.0.0.2", "", true, false, 1, 0},
+		{"source-unavailable", "", "127.0.0.2", false, true, -1, 0},
+		{"source-known", "127.0.0.2", "", false, true, 1, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rule, err := NewIPCIDR("127.0.0.0/8", "REJECT", WithIPCIDRNoResolve(tc.noResolve), WithIPCIDRSourceIP(tc.source))
+			if err != nil {
+				t.Fatal(err)
+			}
+			m := &C.Metadata{Host: "controlled.invalid"}
+			if tc.initial != "" {
+				if tc.source {
+					m.SrcIP = netip.MustParseAddr(tc.initial)
+				} else {
+					m.DstIP = netip.MustParseAddr(tc.initial)
+					m.Host = ""
+				}
+			}
+			calls := 0
+			helper := C.RuleMatchHelper{ResolveIP: func() {
+				calls++
+				if tc.resolved != "" {
+					m.DstIP = netip.MustParseAddr(tc.resolved)
+				}
+			}}
+			got, target := MatchHoopa(rule, m, helper)
+			if got != tc.want || target != "REJECT" || calls != tc.calls {
+				t.Fatalf("state=%d target=%q calls=%d", got, target, calls)
+			}
+		})
+	}
+	// Legacy callers keep the boolean result; no unavailable->true conversion.
+	rule, _ := NewIPCIDR("127.0.0.0/8", "DIRECT")
+	if ok, target := rule.Match(&C.Metadata{Host: "controlled.invalid"}, C.RuleMatchHelper{}); ok || target != "DIRECT" {
+		t.Fatal(ok, target)
+	}
+	if state, _ := MatchHoopa(rule, &C.Metadata{Host: "controlled.invalid"}, C.RuleMatchHelper{}); state != -1 {
+		t.Fatal("missing resolver is not known false", state)
+	}
+}
