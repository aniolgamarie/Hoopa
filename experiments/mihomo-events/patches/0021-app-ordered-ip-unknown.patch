 	return ip.IsValid() && i.ipnet.Contains(ip.WithZone("")), i.adapter
 }
 
+// MatchHoopa keeps unavailable address evidence distinct from a known prefix
+// miss. Only protected ordered routing calls this extension; ordinary Match
+// retains its upstream boolean behavior.
+func (i *IPCIDR) MatchHoopa(metadata *C.Metadata, helper C.RuleMatchHelper) (int8, string) {
+	if metadata == nil {
+		return -1, i.adapter
+	}
+	matched, target := i.Match(metadata, helper)
+	ip := metadata.DstIP
+	if i.isSourceIP {
+		ip = metadata.SrcIP
+	}
+	if !ip.IsValid() {
+		return -1, target
+	}
+	if matched {
+		return 1, target
+	}
+	return 0, target
+}
+
 func (i *IPCIDR) Adapter() string {
 	return i.adapter
 }
