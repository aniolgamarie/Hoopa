+func TestHoopaTCPCountsActualPartialIOAndBlocksFastPaths(t *testing.T) {
+	inner := &hoopaConnFake{closed: make(chan struct{})}
+	counter := &hoopaCounterFake{}
+	conn := NewHoopaTCPConn(inner, counter)
+	if _, ok := conn.(interface{ Upstream() any }); ok {
+		t.Fatal("upstream escape exposed")
+	}
+	if _, ok := conn.(interface {
+		UnwrapReader() (io.Reader, []N.CountFunc)
+	}); ok {
+		t.Fatal("reader escape exposed")
+	}
+	b := buf.New()
+	defer b.Release()
+	if err := conn.ReadBuffer(b); err != nil {
+		t.Fatal("n>0 with EOF lost buffered data", err)
+	}
+	if b.Len() != 3 || counter.download != 3 {
+		t.Fatal("read buffer counted initial contents", b.Len(), counter.download)
+	}
+	out := buf.As([]byte("12345"))
+	if err := conn.WriteBuffer(out); err == nil {
+		t.Fatal("partial write hidden")
+	}
+	if counter.upload != 2 {
+		t.Fatal("requested length was counted", counter.upload)
+	}
+	if conn.Chains()[0] != "node" || conn.ProviderChains()[0] != "provider" || conn.RemoteDestination() != "127.0.0.1:123" {
+		t.Fatal("connection metadata lost")
+	}
+	conn.Close()
+	conn.Close()
+	if counter.closed != 1 {
+		t.Fatal("multiple terminal counters")
+	}
+}
+func TestHoopaTCPCloseUnblocksThenWaitsForAccounting(t *testing.T) {
+	inner := &hoopaConnFake{closed: make(chan struct{}), started: make(chan struct{}), block: true}
+	counter := &hoopaCounterFake{}
+	conn := NewHoopaTCPConn(inner, counter)
+	finished := make(chan struct{})
+	go func() { defer close(finished); _, _ = conn.Read(make([]byte, 8)) }()
+	<-inner.started
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	<-finished
+	if counter.closed != 1 || counter.atClose != 3 {
+		t.Fatal("terminal fact preceded inflight accounting", counter.closed, counter.atClose)
+	}
+	if n, err := conn.Write([]byte("x")); n != 0 || !errors.Is(err, net.ErrClosed) {
+		t.Fatal("new IO admitted after close", n, err)
+	}
+}
