+
+func TestHoopaReadyNeverUsesEmptyLazyPeek(t *testing.T) {
+	for _, tc := range []struct {
+		before, after bool
+		n             int
+		err           error
+		want          bool
+	}{
+		{true, true, 0, nil, false}, {true, false, 0, nil, false}, {true, false, 1, nil, true}, {true, true, 1, nil, false}, {false, false, 0, nil, true}, {true, false, 1, errors.New("write failed"), false},
+	} {
+		if got := hoopaSetupReady(tc.before, tc.after, tc.n, tc.err); got != tc.want {
+			t.Fatal(tc, got)
+		}
+	}
+}
+func TestHoopaRuleOrderKeepsEarlierCertainMatch(t *testing.T) {
+	oldRules, oldProxies := rules, proxies
+	defer func() { rules, proxies = oldRules, oldProxies }()
+	proxy := &hoopaProxyFake{}
+	proxies = map[string]C.Proxy{"DIRECT": proxy}
+	processRule, _ := common.NewProcess("agent", "DIRECT", C.ProcessName)
+	rules = []C.Rule{common.NewDomain("early.test", "DIRECT"), processRule}
+	selected, rule, err := match(&C.Metadata{Host: "early.test", HoopaFlowID: "missing-flow"}, C.RuleMatchHelper{})
+	if err != nil || selected != proxy || rule != rules[0] {
+		t.Fatal("unknown identity bypassed earlier certain match", err)
+	}
+	if _, _, err := match(&C.Metadata{Host: "later.test", HoopaFlowID: "missing-flow"}, C.RuleMatchHelper{}); err == nil {
+		t.Fatal("encountered unknown fell through")
+	}
+}
+
+type hoopaProxyFake struct{ C.Proxy }
+
+func (*hoopaProxyFake) Name() string                     { return "DIRECT" }
+func (*hoopaProxyFake) Type() C.AdapterType              { return C.Direct }
+func (*hoopaProxyFake) Unwrap(*C.Metadata, bool) C.Proxy { return nil }
+
+type hoopaSourceConnFake struct {
+	net.Conn
+	peer, local net.Addr
+}
+
+func (c hoopaSourceConnFake) RemoteAddr() net.Addr { return c.peer }
+func (c hoopaSourceConnFake) LocalAddr() net.Addr  { return c.local }
+func TestHoopaHTTPSourceUsesRawSocketInsteadOfPipe(t *testing.T) {
+	peer := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32100}
+	local := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32101}
+	pipe := hoopaSourceConnFake{peer: &net.UnixAddr{Name: "internal-peer", Net: "unix"}, local: &net.UnixAddr{Name: "internal-local", Net: "unix"}}
+	gotPeer, gotLocal := hoopaSourceAddrs(&C.Metadata{RawSrcAddr: peer, RawDstAddr: local}, pipe)
+	if gotPeer != peer || gotLocal != local {
+		t.Fatal("HTTP pipe address replaced actual socket")
+	}
+	gotPeer, gotLocal = hoopaSourceAddrs(&C.Metadata{}, pipe)
+	if gotPeer != pipe.peer || gotLocal != pipe.local {
+		t.Fatal("socket fallback lost actual address")
+	}
+}
diff --git a/tunnel/statistic/hoopa_tcp.go b/tunnel/statistic/hoopa_tcp.go
new file mode 100644
--- /dev/null
+++ b/tunnel/statistic/hoopa_tcp.go
@@ -0,0 +1,117 @@
+package statistic
+
+import (
+	"io"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/common/buf"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// HoopaTCPCounter is the same-flow stream boundary, not wire/TLS byte accounting.
+type HoopaTCPCounter interface {
+	AddUpload(int)
+	AddDownload(int)
+	Close()
+}
+type hoopaTCPConn struct {
+	inner    C.Conn
+	counter  HoopaTCPCounter
+	mu       sync.Mutex
+	cond     *sync.Cond
+	active   int
+	closing  bool
+	once     sync.Once
+	closeErr error
+}
+
+// NewHoopaTCPConn deliberately does not embed C.Conn or expose upstream/unwrap,
+// syscall, cached, ReaderFrom or WriterTo paths that could skip actual n counts.
+func NewHoopaTCPConn(inner C.Conn, counter HoopaTCPCounter) C.Conn {
+	conn := &hoopaTCPConn{inner: inner, counter: counter}
+	conn.cond = sync.NewCond(&conn.mu)
+	return conn
+}
+func (c *hoopaTCPConn) begin() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closing {
+		return false
+	}
+	c.active++
+	return true
+}
+func (c *hoopaTCPConn) end() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.active--
+	if c.active == 0 {
+		c.cond.Broadcast()
+	}
+}
+func (c *hoopaTCPConn) Read(p []byte) (int, error) {
+	if !c.begin() {
+		return 0, net.ErrClosed
+	}
+	defer c.end()
+	n, err := c.inner.Read(p)
+	if n > 0 {
+		c.counter.AddDownload(n)
+	}
+	return n, err
+}
+func (c *hoopaTCPConn) Write(p []byte) (int, error) {
+	if !c.begin() {
+		return 0, net.ErrClosed
+	}
+	defer c.end()
+	n, err := c.inner.Write(p)
+	if n > 0 {
+		c.counter.AddUpload(n)
+	}
+	return n, err
+}
+func (c *hoopaTCPConn) ReadBuffer(buffer *buf.Buffer) error {
+	n, err := buffer.ReadOnceFrom(c)
+	if n > 0 && err == io.EOF {
+		return nil
+	}
+	return err
+}
+func (c *hoopaTCPConn) WriteBuffer(buffer *buf.Buffer) error {
+	defer buffer.Release()
+	size := buffer.Len()
+	n, err := c.Write(buffer.Bytes())
+	if err == nil && n != size {
+		return io.ErrShortWrite
+	}
+	return err
+}
+func (c *hoopaTCPConn) Close() error {
+	c.once.Do(func() {
+		c.mu.Lock()
+		c.closing = true
+		c.mu.Unlock()
+		c.closeErr = c.inner.Close() // terminate blocking IO without holding the mutex
+		c.mu.Lock()
+		for c.active != 0 {
+			c.cond.Wait()
+		}
+		c.mu.Unlock()
+		c.counter.Close()
+	})
+	return c.closeErr
+}
+func (c *hoopaTCPConn) LocalAddr() net.Addr                   { return c.inner.LocalAddr() }
+func (c *hoopaTCPConn) RemoteAddr() net.Addr                  { return c.inner.RemoteAddr() }
+func (c *hoopaTCPConn) SetDeadline(t time.Time) error         { return c.inner.SetDeadline(t) }
+func (c *hoopaTCPConn) SetReadDeadline(t time.Time) error     { return c.inner.SetReadDeadline(t) }
+func (c *hoopaTCPConn) SetWriteDeadline(t time.Time) error    { return c.inner.SetWriteDeadline(t) }
+func (c *hoopaTCPConn) Chains() C.Chain                       { return c.inner.Chains() }
+func (c *hoopaTCPConn) ProviderChains() C.Chain               { return c.inner.ProviderChains() }
+func (c *hoopaTCPConn) AppendToChains(adapter C.ProxyAdapter) { c.inner.AppendToChains(adapter) }
+func (c *hoopaTCPConn) RemoteDestination() string             { return c.inner.RemoteDestination() }
+
+var _ C.Conn = (*hoopaTCPConn)(nil)
