+}
+func TestHoopaTrackerDirectCloseFinalizesBeforeLeave(t *testing.T) {
+	manager := &Manager{}
+	counter := &hoopaTrackerCounterFake{hoopaCounterFake: &hoopaCounterFake{}, manager: manager}
+	inner := &hoopaConnFake{closed: make(chan struct{}), started: make(chan struct{}), block: true}
+	tracker := NewHoopaTCPTracker(inner, manager, &C.Metadata{}, nil, 0, 0, true, counter)
+	if !counter.boundBeforeJoin || counter.boundID != tracker.ID() || manager.Get(tracker.ID()) == nil {
+		t.Fatal("identity was not bound before active publication")
+	}
+	finished := make(chan struct{})
+	go func() { defer close(finished); _, _ = tracker.Read(make([]byte, 8)) }()
+	<-inner.started
+	// A controller closes the tracker obtained from the active manager, not an outer wrapper.
+	if err := manager.Get(tracker.ID()).Close(); err != nil {
+		t.Fatal(err)
+	}
+	<-finished
+	if !counter.activeAtFinal || counter.atClose != 3 || counter.closed != 1 {
+		t.Fatal("source final was not after IO and before Leave", counter.activeAtFinal, counter.atClose, counter.closed)
+	}
+	if manager.Get(tracker.ID()) != nil {
+		t.Fatal("closed tracker remained active")
+	}
+	tracker.Close()
+	if counter.closed != 1 {
+		t.Fatal("source finalized twice")
+	}
+}
+func TestHoopaTrackerFastCountersCannotBypassSource(t *testing.T) {
+	manager := &Manager{}
+	counter := &hoopaTrackerCounterFake{hoopaCounterFake: &hoopaCounterFake{}, manager: manager}
+	tracker := NewHoopaTCPTracker(&hoopaConnFake{closed: make(chan struct{})}, manager, &C.Metadata{}, nil, 7, 0, true, counter)
+	reader, readCounters := tracker.UnwrapReader()
+	n, _ := reader.Read(make([]byte, 8))
+	for _, count := range readCounters {
+		count(int64(n))
+	}
+	writer, writeCounters := tracker.UnwrapWriter()
+	n, _ = writer.Write([]byte("up"))
+	for _, count := range writeCounters {
+		count(int64(n))
+	}
+	buffer := buf.New()
+	defer buffer.Release()
+	if err := tracker.ReadBuffer(buffer); err != nil {
+		t.Fatal(err)
+	}
+	if err := tracker.WriteBuffer(buf.As([]byte("up"))); err != nil {
+		t.Fatal(err)
+	}
+	if counter.download != 6 || counter.upload != 4 {
+		t.Fatal("source counter bypassed or double-counted", counter.download, counter.upload)
+	}
+	if tracker.UploadTotal.Load() != 11 || tracker.DownloadTotal.Load() != 6 {
+		t.Fatal("tracker count functions changed or initial peek re-counted")
+	}
+	if _, ok := tracker.Upstream().(interface{ Upstream() any }); ok {
+		t.Fatal("source upstream escaped to raw conn")
+	}
+	tracker.Close()
+}
