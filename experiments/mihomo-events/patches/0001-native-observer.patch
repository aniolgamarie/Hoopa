+		if err != nil {
+			t.Fatal(i, err)
+		}
+		if i == 0 {
+			f, e := s.begin(nil, nil, "example.test", "", time.Now())
+			if e != nil {
+				t.Fatal(e)
+			}
+			_ = f
+			old = s.file.Name()
+		}
+		s.close()
+	}
+	s, err := openSource(dir, "test-generation", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal("old source replay disabled at epoch capacity", err)
+	}
+	defer s.close()
+	if _, err = s.begin(nil, nil, "example.test", "", time.Now()); err == nil {
+		t.Fatal("new flow admitted at epoch capacity")
+	}
+	f, err := os.Open(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	seq, err := readFrames(f, nil)
+	if err != nil || seq != 1 {
+		t.Fatal("old census unavailable")
+	}
+}
+func TestSourceWriteFailurePoisonsAndKeepsCensus(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, err := s.begin(nil, nil, "example.test", "", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.file.Close()
+	f.Close()
+	if !s.poisoned {
+		t.Fatal("failed terminal did not poison source")
+	}
+	if _, err = s.begin(nil, nil, "example.test", "", time.Now()); err == nil {
+		t.Fatal("admitted after uncertain source")
+	}
+	rows := frames(t, s)
+	if len(rows) != 1 || !bytes.Contains(rows[0], []byte(`"kind":"opened"`)) {
+		t.Fatal("lost opened census")
+	}
+}
+func TestSourceUnknownReadyAndErrorDoNotHaveSuccessDuration(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f, err := s.begin(nil, nil, "example.test", "", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.NewAttempt().Finish(nil, nil, nil, false)
+	f.NewAttempt().Finish(io.ErrUnexpectedEOF, nil, nil, false)
+	f.Close()
+	rows := frames(t, s)
+	for _, row := range rows[1:3] {
+		var m map[string]json.RawMessage
+		json.Unmarshal(row, &m)
+		if string(m["duration_ms"]) != "null" || string(m["flow_duration_ms"]) != "null" {
+			t.Fatal("unproven/failed ready presented as success")
+		}
+	}
+}
+func TestSourceUnsafeDirectoryOrReceiverRejected(t *testing.T) {
+	dir := t.TempDir()
+	os.Chmod(dir, 0755)
+	if s, err := openSource(dir, "test-generation", "", "", defaultLimit); err == nil {
+		s.close()
+		t.Fatal("public directory accepted")
+	}
+	os.Chmod(dir, 0700)
+	for _, receiver := range []string{"http://example.com:80/events", "https://127.0.0.1:80/events", "http://user:secret@127.0.0.1:80/events", "http://127.0.0.1:80/events?secret=x"} {
+		if s, err := openSource(dir, "test-generation", receiver, "secret", defaultLimit); err == nil {
+			s.close()
+			t.Fatal("unsafe receiver accepted")
+		}
+	}
+	if err := os.Symlink("/dev/null", filepath.Join(dir, "source.lock")); err != nil {
+		t.Fatal(err)
+	}
+	if s, err := openSource(dir, "test-generation", "", "", defaultLimit); err == nil {
+		s.close()
+		t.Fatal("symlink lock accepted")
+	}
+}
+func TestSourceSenderRetriesSamePersistedEvent(t *testing.T) {
+	if os.Getenv("HOOPA_TRACE_NETWORK_TEST") != "1" {
+		t.Skip("explicit loopback test only")
+	}
+	var mu sync.Mutex
+	var bodies [][]byte
+	done := make(chan struct{})
+	var once sync.Once
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer test-secret" {
+			w.WriteHeader(403)
+			return
+		}
+		b, _ := io.ReadAll(io.LimitReader(r.Body, maxFrame+1))
+		mu.Lock()
+		bodies = append(bodies, b)
+		n := len(bodies)
+		mu.Unlock()
+		if n == 1 {
+			w.WriteHeader(503)
+			return
+		}
+		w.WriteHeader(204)
+		once.Do(func() { close(done) })
+	}))
+	defer server.Close()
+	s := testSource(t, defaultLimit)
+	s.receiver = server.URL + "/events"
+	s.secret = "test-secret"
+	f, err := s.begin(nil, nil, "example.test", "", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	go s.send()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("source did not retransmit")
+	}
+	s.close()
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) < 2 || !bytes.Equal(bodies[0], bodies[1]) || !strings.Contains(string(bodies[0]), `"source_seq":"1"`) {
+		t.Fatal("retry changed event identity/raw frame")
+	}
+	_ = f
+}
