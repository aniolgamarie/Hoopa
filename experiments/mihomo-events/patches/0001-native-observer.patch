@@ -0,0 +1,50 @@
+package common
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"testing"
+)
+
+func TestHoopaProcessKeepsExactPatternAndUnknown(t *testing.T) {
+	p, _ := NewProcess("Agent", "DIRECT", C.ProcessName)
+	state, target := p.matchHoopa(func(field, pattern string) int8 {
+		if field != "name" || pattern != "Agent" {
+			t.Fatal(field, pattern)
+		}
+		return -1
+	})
+	if state != -1 || target != "DIRECT" {
+		t.Fatal(state, target)
+	}
+	if state, _ = p.MatchHoopa(&C.Metadata{HoopaFlowID: "missing-flow"}, C.RuleMatchHelper{}); state != -1 {
+		t.Fatal("missing flow must be unknown")
+	}
+	if matched, _ := p.Match(&C.Metadata{Process: "agent"}, C.RuleMatchHelper{}); !matched {
+		t.Fatal("legacy matching changed")
+	}
+	path, _ := NewProcess("/exact/Agent", "DIRECT", C.ProcessPath)
+	state, _ = path.matchHoopa(func(field, pattern string) int8 {
+		if field != "path" || pattern != "/exact/Agent" {
+			t.Fatal(field, pattern)
+		}
+		return 1
+	})
+	if state != 1 {
+		t.Fatal(state)
+	}
+	wildcard, _ := NewProcess("*", "DIRECT", C.ProcessNameWildcard)
+	if ValidateHoopaRules([]C.Rule{wildcard}) == nil {
+		t.Fatal("wildcard reported supported")
+	}
+	if state, _ = wildcard.matchHoopa(func(string, string) int8 { return 1 }); state != -1 {
+		t.Fatal("unsupported process matcher accepted")
+	}
+}
+func TestHoopaRuleCapabilityWhitelist(t *testing.T) {
+	if err := ValidateHoopaRules([]C.Rule{NewDomain("example.test", "DIRECT")}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := any(NewDomain("example.test", "DIRECT")).(C.Rule); !ok {
+		t.Fatal("bad fixture")
+	}
+}
diff --git a/rules/common/process.go b/rules/common/process.go
--- a/rules/common/process.go
+++ b/rules/common/process.go
@@ -1,6 +1,8 @@
 package common
 
 import (
+	"errors"
+	"github.com/metacubex/mihomo/component/hoopatrace"
 	"strings"
 
 	"github.com/metacubex/mihomo/component/wildcard"
@@ -72,3 +74,81 @@
 }
 
 var _ C.Rule = (*Process)(nil)
+
+// ValidateHoopaRules rejects unsupported candidate rule capabilities before a
+// trace flow begins. It does not perform configuration-loader validation.
+func ValidateHoopaRules(rules []C.Rule) error {
+	for _, rule := range rules {
+		if err := ValidateHoopaRule(rule); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func ValidateHoopaRule(rule C.Rule) error {
+	if wrapper, ok := rule.(C.RuleWrapper); ok {
+		return ValidateHoopaRule(wrapper.Unwrap())
+	}
+	if supported, ok := rule.(interface{ ValidateHoopa() error }); ok {
+		return supported.ValidateHoopa()
+	}
+	if rule != nil && hoopaAtomic(rule.RuleType()) {
+		return nil
+	}
+	return errors.New("unsupported Hoopa trace rule capability")
+}
+func hoopaAtomic(kind C.RuleType) bool {
+	switch kind {
+	case C.Domain, C.DomainSuffix, C.DomainKeyword, C.DomainRegex, C.DomainWildcard, C.GEOSITE, C.GEOIP, C.SrcGEOIP, C.IPASN, C.SrcIPASN, C.IPCIDR, C.SrcIPCIDR, C.IPSuffix, C.SrcIPSuffix, C.SrcPort, C.DstPort, C.InPort, C.DSCP, C.InUser, C.InName, C.InType, C.Network, C.MATCH:
+		return true
+	default:
+		return false
+	}
+}
+
+// MatchHoopa preserves ordered evaluation. Unknown is not boolean false: an
+// encountered unknown that can change the selected target must reject the flow.
+func MatchHoopa(rule C.Rule, metadata *C.Metadata, helper C.RuleMatchHelper) (int8, string) {
+	if wrapper, ok := rule.(C.RuleWrapper); ok {
+		if wrapper.IsDisabled() {
+			return 0, ""
+		}
+		return MatchHoopa(wrapper.Unwrap(), metadata, helper)
+	}
+	if matcher, ok := rule.(interface {
+		MatchHoopa(*C.Metadata, C.RuleMatchHelper) (int8, string)
+	}); ok {
+		return matcher.MatchHoopa(metadata, helper)
+	}
+	if rule == nil || !hoopaAtomic(rule.RuleType()) {
+		return -1, ""
+	}
+	matched, target := rule.Match(metadata, helper)
+	if matched {
+		return 1, target
+	}
+	return 0, target
+}
+func (ps *Process) ValidateHoopa() error {
+	if ps.ruleType != C.ProcessName && ps.ruleType != C.ProcessPath {
+		return errors.New("unsupported Hoopa process rule capability")
+	}
+	return nil
+}
+func (ps *Process) matchHoopa(match func(string, string) int8) (int8, string) {
+	if ps.ValidateHoopa() != nil {
+		return -1, ps.adapter
+	}
+	field := "name"
+	if ps.ruleType == C.ProcessPath {
+		field = "path"
+	}
+	return match(field, ps.pattern), ps.adapter
+}
+func (ps *Process) MatchHoopa(metadata *C.Metadata, _ C.RuleMatchHelper) (int8, string) {
+	flow := hoopatrace.Lookup(metadata.HoopaFlowID)
+	if flow == nil {
+		return -1, ps.adapter
+	}
+	return ps.matchHoopa(flow.MatchProcess)
+}
