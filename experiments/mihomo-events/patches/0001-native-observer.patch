+// Ordinary HTTP uses an internal pipe; its stored raw source addresses identify
+// the actual client socket. The trace unit is that upstream stream, not each
+// request later reused on the HTTP transport connection.
+func hoopaSourceAddrs(metadata *C.Metadata, conn net.Conn) (peer, local net.Addr) {
+	peer, local = metadata.RawSrcAddr, metadata.RawDstAddr
+	if peer == nil {
+		peer = conn.RemoteAddr()
+	}
+	if local == nil {
+		local = conn.LocalAddr()
+	}
