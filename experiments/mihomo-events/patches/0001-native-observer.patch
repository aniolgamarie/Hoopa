+type triRule struct {
+	common.Base
+	state int8
+}
+
+func (r triRule) RuleType() C.RuleType                                     { return C.Domain }
+func (r triRule) Match(*C.Metadata, C.RuleMatchHelper) (bool, string)      { return r.state == 1, "DIRECT" }
+func (r triRule) MatchHoopa(*C.Metadata, C.RuleMatchHelper) (int8, string) { return r.state, "DIRECT" }
+func (r triRule) Adapter() string                                          { return "DIRECT" }
+func (r triRule) Payload() string                                          { return "synthetic" }
+func TestHoopaANDFalseOverridesUnknown(t *testing.T) {
+	for _, tc := range []struct {
+		states []int8
+		want   int8
+	}{
+		{[]int8{-1, 0}, 0}, {[]int8{0, -1}, 0}, {[]int8{-1, 1}, -1}, {[]int8{1, 1}, 1}, {[]int8{-1, -1}, -1},
+	} {
+		logic := &Logic{ruleType: C.AND, adapter: "DIRECT"}
+		for _, s := range tc.states {
+			logic.rules = append(logic.rules, &triRule{state: s})
+		}
+		got, target := logic.MatchHoopa(&C.Metadata{}, C.RuleMatchHelper{})
+		if got != tc.want || target != "DIRECT" {
+			t.Fatal(tc.states, got, target)
+		}
+	}
+}
+func TestHoopaRejectsUnsupportedLogicAndRecursesCapability(t *testing.T) {
+	for _, kind := range []C.RuleType{C.OR, C.NOT, C.SubRules} {
+		rule := &Logic{ruleType: kind, rules: []C.Rule{&triRule{state: 1}}}
+		if common.ValidateHoopaRules([]C.Rule{rule}) == nil {
+			t.Fatal("unsupported logic accepted", kind)
+		}
+		if state, _ := rule.MatchHoopa(&C.Metadata{}, C.RuleMatchHelper{}); state != -1 {
+			t.Fatal("unsupported logic silently matched", kind)
+		}
+	}
+	unsupported := &Logic{ruleType: C.OR, rules: []C.Rule{&triRule{state: 1}}}
+	and := &Logic{ruleType: C.AND, rules: []C.Rule{&triRule{state: 1}, unsupported}}
+	if common.ValidateHoopaRules([]C.Rule{and}) == nil {
+		t.Fatal("nested unsupported logic passed")
+	}
+}
diff --git a/rules/logic/logic.go b/rules/logic/logic.go
--- a/rules/logic/logic.go
+++ b/rules/logic/logic.go
@@ -255,3 +255,31 @@
 }
 
 var _ C.Rule = (*Logic)(nil)
+
+// Only AND has candidate trace support. Unsupported combinations are rejected
+// by capability validation rather than being advertised as permanently false.
+func (logic *Logic) ValidateHoopa() error {
+	if logic.ruleType != C.AND || len(logic.rules) == 0 {
+		return fmt.Errorf("unsupported Hoopa logic rule capability")
+	}
+	return common.ValidateHoopaRules(logic.rules)
+}
+func (logic *Logic) MatchHoopa(metadata *C.Metadata, helper C.RuleMatchHelper) (int8, string) {
+	if logic.ruleType != C.AND || len(logic.rules) == 0 {
+		return -1, logic.adapter
+	}
+	unknown := false
+	for _, rule := range logic.rules {
+		state, _ := common.MatchHoopa(rule, metadata, helper)
+		if state == 0 {
+			return 0, logic.adapter
+		}
+		if state != 1 {
+			unknown = true
+		}
+	}
+	if unknown {
+		return -1, logic.adapter
+	}
+	return 1, logic.adapter
+}
