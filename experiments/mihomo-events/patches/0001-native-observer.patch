diff --git a/component/hoopatrace/identity_linux.go b/component/hoopatrace/identity_linux.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/identity_linux.go
@@ -0,0 +1,210 @@
+//go:build linux && amd64
+
+// This experimental Linux resolver originates in Hoopa (MIT).
+// It proves only the explicitly qualified held-socket scope; not FD-transfer safety.
+package hoopatrace
+
+import (
+	"errors"
+	"fmt"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+var (
+	ErrUnknown    = errors.New("source ownership unavailable")
+	ErrShared     = errors.New("socket shared by processes")
+	ErrVisibility = errors.New("process owner set not fully visible")
+)
+
+type Identity struct {
+	PID         int
+	Name        string
+	StartTicks  string
+	BootID      string
+	NetNS       string
+	SocketInode string
+}
+
+func procAddress(addr netip.AddrPort) (string, error) {
+	if !addr.Addr().Is4() || !addr.Addr().IsLoopback() || addr.Port() == 0 {
+		return "", ErrUnknown
+	}
+	b := addr.Addr().As4()
+	return fmt.Sprintf("%02X%02X%02X%02X:%04X", b[3], b[2], b[1], b[0], addr.Port()), nil
+}
+
+func socketInode(source, entry netip.AddrPort) (string, error) {
+	local, err := procAddress(source)
+	if err != nil {
+		return "", err
+	}
+	remote, err := procAddress(entry)
+	if err != nil {
+		return "", err
+	}
+	raw, err := os.ReadFile("/proc/self/net/tcp")
+	if err != nil {
+		return "", ErrUnknown
+	}
+	found := ""
+	for _, line := range strings.Split(string(raw), "\n") {
+		f := strings.Fields(line)
+		if len(f) < 10 || f[1] != local || f[2] != remote || f[3] != "01" {
+			continue
+		}
+		uid, err := strconv.Atoi(f[7])
+		if err != nil || uid != os.Geteuid() || f[9] == "0" || found != "" {
+			return "", ErrUnknown
+		}
+		if _, err := strconv.ParseUint(f[9], 10, 64); err != nil {
+			return "", ErrUnknown
+		}
+		found = f[9]
+	}
+	if found == "" {
+		return "", ErrUnknown
+	}
+	return found, nil
+}
+
+func processIdentity(pid int) (Identity, error) {
+	dir := filepath.Join("/proc", strconv.Itoa(pid))
+	raw, err := os.ReadFile(filepath.Join(dir, "stat"))
+	if err != nil {
+		return Identity{}, ErrUnknown
+	}
+	text := string(raw)
+	left, right := strings.IndexByte(text, '('), strings.LastIndexByte(text, ')')
+	if left < 1 || right <= left || strings.TrimSpace(text[:left]) != strconv.Itoa(pid) {
+		return Identity{}, ErrUnknown
+	}
+	f := strings.Fields(text[right+1:])
+	if len(f) < 20 || f[0] == "Z" {
+		return Identity{}, ErrUnknown
+	}
+	if _, err := strconv.ParseUint(f[19], 10, 64); err != nil {
+		return Identity{}, ErrUnknown
+	}
+	ns, err := os.Readlink(filepath.Join(dir, "ns/net"))
+	if err != nil {
+		return Identity{}, ErrUnknown
+	}
+	return Identity{PID: pid, Name: text[left+1 : right], StartTicks: f[19], NetNS: ns}, nil
+}
+
+func owns(pid int, inode string) (bool, error) {
+	dir := filepath.Join("/proc", strconv.Itoa(pid), "fd")
+	fds, err := os.ReadDir(dir)
+	if err != nil {
+		return false, err
+	}
+	for _, fd := range fds {
+		v, err := os.Readlink(filepath.Join(dir, fd.Name()))
+		if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return false, err
+		}
+		if v == "socket:["+inode+"]" {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// Resolve is deliberately limited to same-user, same-network-namespace IPv4
+// loopback sockets that remain ESTABLISHED while an entry holds admission.
+// /proc enumeration is not an atomic kernel ownership oracle: FD transfer races,
+// invisible processes and platform variants still need separate qualification.
+func Resolve(source, entry netip.AddrPort) (Identity, error) {
+	inode, err := socketInode(source, entry)
+	if err != nil {
+		return Identity{}, fmt.Errorf("source_socket: %w", err)
+	}
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return Identity{}, fmt.Errorf("boot_identity: %w", ErrUnknown)
+	}
+	ns, err := os.Readlink("/proc/self/ns/net")
+	if err != nil {
+		return Identity{}, fmt.Errorf("network_namespace: %w", ErrUnknown)
+	}
+	processes, err := os.ReadDir("/proc")
+	if err != nil {
+		return Identity{}, fmt.Errorf("process_listing: %w", ErrUnknown)
+	}
+	var owner Identity
+	inspected := 0
+	for _, p := range processes {
+		pid, err := strconv.Atoi(p.Name())
+		if err != nil || pid <= 0 {
+			continue
+		}
+		info, err := os.Stat(filepath.Join("/proc", p.Name()))
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return Identity{}, fmt.Errorf("process_stat: %w", ErrUnknown)
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok {
+			return Identity{}, fmt.Errorf("process_uid: %w", ErrUnknown)
+		}
+		if stat.Uid != uint32(os.Geteuid()) {
+			continue
+		}
+		inspected++
+		if inspected > 4096 {
+			return Identity{}, fmt.Errorf("process_limit: %w", ErrUnknown)
+		}
+		match, err := owns(pid, inode)
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			if errors.Is(err, os.ErrPermission) {
+				return Identity{}, fmt.Errorf("%w: %w", ErrUnknown, ErrVisibility)
+			}
+			return Identity{}, fmt.Errorf("descriptor_listing: %w", ErrUnknown)
+		}
+		if !match {
+			continue
+		}
+		// Unrelated zombies have no descriptors and need no live identity.
+		// Bookend a second descriptor check for each actual candidate owner.
+		before, err := processIdentity(pid)
+		if err != nil {
+			return Identity{}, fmt.Errorf("candidate_identity: %w", ErrUnknown)
+		}
+		if match, err := owns(pid, inode); err != nil || !match {
+			return Identity{}, fmt.Errorf("candidate_descriptor: %w", ErrUnknown)
+		}
+		after, err := processIdentity(pid)
+		if err != nil || before != after || after.NetNS != ns {
+			return Identity{}, fmt.Errorf("candidate_changed: %w", ErrUnknown)
+		}
+		if owner.PID != 0 {
+			return Identity{}, ErrShared
+		}
+		owner = after
+	}
+	if owner.PID == 0 {
+		return Identity{}, fmt.Errorf("no_owner: %w", ErrUnknown)
+	}
+	if current, err := socketInode(source, entry); err != nil || current != inode {
+		return Identity{}, fmt.Errorf("socket_changed: %w", ErrUnknown)
+	}
+	if match, err := owns(owner.PID, inode); err != nil || !match {
+		return Identity{}, fmt.Errorf("owner_descriptor_changed: %w", ErrUnknown)
+	}
+	if current, err := processIdentity(owner.PID); err != nil || current != owner {
+		return Identity{}, fmt.Errorf("owner_identity_changed: %w", ErrUnknown)
+	}
+	owner.BootID = strings.TrimSpace(string(boot))
+	owner.SocketInode = inode
+	return owner, nil
+}
diff --git a/component/hoopatrace/trace_linux.go b/component/hoopatrace/trace_linux.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/trace_linux.go
@@ -0,0 +1,768 @@
+//go:build linux && amd64
+
+// Package hoopatrace is an opt-in TCP source experiment, not a production API.
+// New code copyright Hoopa contributors, MIT; combined core remains subject to
+// upstream Mihomo's GNU GPL version 3. No payload, argv or environment is stored.
+package hoopatrace
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const maxFrame = 8192
+const flowBudget = 20 * (maxFrame + 36)
+const maxActive = 32
+const defaultLimit = 8 * 1024 * 1024
+
+var ErrSource = errors.New("experimental source unavailable")
+
+type ProcessEvidence struct {
+	Status      string `json:"status"`
+	Reason      string `json:"reason,omitempty"`
+	PID         int    `json:"pid,omitempty"`
+	Name        string `json:"name,omitempty"`
+	NameSource  string `json:"name_source,omitempty"`
+	StartTicks  string `json:"start_ticks,omitempty"`
+	BootID      string `json:"boot_id,omitempty"`
+	PIDNS       string `json:"pid_namespace,omitempty"`
+	NetNS       string `json:"network_namespace,omitempty"`
+	SocketInode string `json:"socket_inode,omitempty"`
+	Path        string `json:"path,omitempty"`
+}
+
+type source struct {
+	mu                    sync.Mutex
+	root                  *os.Root
+	lock, file            *os.File
+	epoch, generation     string
+	seq                   uint64
+	used, reserved, limit int64
+	poisoned              bool
+	readOnly              bool
+	flows                 map[string]*Flow
+	wake                  chan struct{}
+	done                  chan struct{}
+	closeOnce             sync.Once
+	receiver, secret      string
+}
+type Flow struct {
+	mu             sync.Mutex
+	once           sync.Once
+	s              *source
+	id             string
+	identity       ProcessEvidence
+	started        time.Time
+	attempt        int
+	connection     string
+	up, down       uint64
+	invalid        bool
+	counterInvalid bool
+	reserved       int64
+}
+type Attempt struct {
+	once    sync.Once
+	f       *Flow
+	id      string
+	started time.Time
+}
+
+var global struct {
+	once sync.Once
+	s    *source
+	err  error
+}
+
+func Enabled(inName string) bool {
+	name := os.Getenv("HOOPA_TRACE_INBOUND")
+	return name != "" && name == inName
+}
+func token(s string) bool {
+	if len(s) == 0 || len(s) > 128 {
+		return false
+	}
+	for i, c := range []byte(s) {
+		alpha := c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+		if !alpha && (i == 0 || c != '.' && c != '_' && c != ':' && c != '-') {
+			return false
+		}
+	}
+	return true
+}
+func randomID(prefix string) (string, error) {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", ErrSource
+	}
+	return prefix + hex.EncodeToString(b[:]), nil
+}
+func privateFile(root *os.Root, name string, flags int) (*os.File, error) {
+	if fi, err := root.Lstat(name); err == nil {
+		st, ok := fi.Sys().(*syscall.Stat_t)
+		if !ok || st.Uid != uint32(os.Geteuid()) || !fi.Mode().IsRegular() || fi.Mode().Perm() != 0600 {
+			return nil, ErrSource
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, ErrSource
+	}
+	f, err := root.OpenFile(name, flags|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, ErrSource
+	}
+	fi, err := f.Stat()
+	if err != nil {
+		f.Close()
+		return nil, ErrSource
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok || st.Uid != uint32(os.Geteuid()) || !fi.Mode().IsRegular() || fi.Mode().Perm() != 0600 {
+		f.Close()
+		return nil, ErrSource
+	}
+	return f, nil
+}
+func syncDir(root *os.Root) error {
+	f, err := root.Open(".")
+	if err != nil {
+		return ErrSource
+	}
+	defer f.Close()
+	if f.Sync() != nil {
+		return ErrSource
+	}
+	return nil
+}
+func openSource(dir, generation, receiver, secret string, limit int64) (*source, error) {
+	if !filepath.IsAbs(dir) || !token(generation) || limit < flowBudget || limit > defaultLimit {
+		return nil, ErrSource
+	}
+	fi, err := os.Lstat(dir)
+	if err != nil || !fi.IsDir() || fi.Mode().Perm() != 0700 {
+		return nil, ErrSource
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok || st.Uid != uint32(os.Geteuid()) {
+		return nil, ErrSource
+	}
+	if receiver != "" {
+		u, e := url.Parse(receiver)
+		if e != nil || u.Scheme != "http" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || secret == "" {
+			return nil, ErrSource
+		}
+		ip, e := netip.ParseAddr(u.Hostname())
+		if e != nil || !ip.IsLoopback() || u.Port() == "" {
+			return nil, ErrSource
+		}
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, ErrSource
+	}
+	lock, err := privateFile(root, "source.lock", os.O_CREATE|os.O_RDWR)
+	if err != nil {
+		root.Close()
+		return nil, err
+	}
+	if syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB) != nil {
+		lock.Close()
+		root.Close()
+		return nil, ErrSource
+	}
+	s := &source{root: root, lock: lock, generation: generation, limit: limit, flows: map[string]*Flow{}, wake: make(chan struct{}, 1), done: make(chan struct{}), receiver: receiver, secret: secret}
+	ok = false
+	defer func() {
+		if !ok {
+			s.close()
+		}
+	}()
+	entries, err := root.Open(".")
+	if err != nil {
+		return nil, ErrSource
+	}
+	names, err := entries.ReadDir(-1)
+	entries.Close()
+	if err != nil {
+		return nil, ErrSource
+	}
+	epochs := 0
+	for _, entry := range names {
+		if strings.HasPrefix(entry.Name(), "epoch-") && strings.HasSuffix(entry.Name(), ".source.json") {
+			f, e := privateFile(root, entry.Name(), os.O_RDONLY)
+			if e != nil {
+				return nil, e
+			}
+			info, e := f.Stat()
+			f.Close()
+			if e != nil || info.Size() > maxFrame {
+				return nil, ErrSource
+			}
+			s.used += info.Size()
+			if s.used > limit {
+				return nil, ErrSource
+			}
+			continue
+		}
+		if !strings.HasPrefix(entry.Name(), "epoch-") || !strings.HasSuffix(entry.Name(), ".frames") {
+			continue
+		}
+		epochs++
+		if epochs > 32 {
+			return nil, ErrSource
+		}
+		f, e := privateFile(root, entry.Name(), os.O_RDONLY)
+		if e != nil {
+			return nil, e
+		}
+		info, e := f.Stat()
+		if e != nil {
+			f.Close()
+			return nil, ErrSource
+		}
+		s.used += info.Size()
+		if s.used > limit {
+			f.Close()
+			return nil, ErrSource
+		}
+		expectedEpoch := "epoch:" + strings.TrimSuffix(strings.TrimPrefix(entry.Name(), "epoch-"), ".frames")
+		_, e = readFrames(f, func(raw []byte) error {
+			var m struct {
+				SourceEpoch string `json:"source_epoch"`
+			}
+			if json.Unmarshal(raw, &m) != nil || m.SourceEpoch != expectedEpoch {
+				return ErrSource
+			}
+			return nil
+		})
+		f.Close()
+		if e != nil {
+			return nil, e
+		}
+	}
+	// Capacity prevents new source epochs/flows, but never prevents replay of
+	// already durable records. This prototype deliberately performs no reclamation.
+	if epochs == 32 || s.used+flowBudget+maxFrame > limit {
+		s.readOnly = true
+		ok = true
+		return s, nil
+	}
+	self, err := processIdentity(os.Getpid())
+	if err != nil {
+		return nil, ErrSource
+	}
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return nil, ErrSource
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return nil, ErrSource
+	}
+	f, err := os.Open(exe)
+	if err != nil {
+		return nil, ErrSource
+	}
+	h := sha256.New()
+	_, err = io.Copy(h, f)
+	f.Close()
+	if err != nil {
+		return nil, ErrSource
+	}
+	nonce, err := randomID("")
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%s|%x|%s|%d|%s|%s", exe, h.Sum(nil), strings.TrimSpace(string(boot)), self.PID, self.StartTicks, nonce)))
+	s.epoch = "epoch:" + hex.EncodeToString(digest[:])
+	manifest, err := json.Marshal(map[string]any{"schema_version": 1, "source_epoch": s.epoch, "binary_path": exe, "binary_sha256": hex.EncodeToString(h.Sum(nil)), "boot_id": strings.TrimSpace(string(boot)), "pid": self.PID, "start_ticks": self.StartTicks, "nonce": nonce, "config_generation": generation, "max_source_bytes": limit, "max_frame_bytes": maxFrame, "max_active_flows": maxActive, "reclamation": "not_implemented_bounded_stop", "scope": "linux_amd64_tcp_same_uid_netns_ipv4_loopback"})
+	if err != nil || len(manifest) > maxFrame || s.used+int64(len(manifest))+flowBudget > limit {
+		return nil, ErrSource
+	}
+	meta, err := privateFile(root, "epoch-"+hex.EncodeToString(digest[:])+".source.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY)
+	if err != nil {
+		return nil, err
+	}
+	n, err := meta.Write(manifest)
+	if err != nil || n != len(manifest) || meta.Sync() != nil {
+		meta.Close()
+		return nil, ErrSource
+	}
+	meta.Close()
+	s.used += int64(len(manifest))
+	s.file, err = privateFile(root, "epoch-"+hex.EncodeToString(digest[:])+".frames", os.O_CREATE|os.O_EXCL|os.O_WRONLY)
+	if err != nil {
+		return nil, err
+	}
+	if s.file.Sync() != nil || syncDir(root) != nil {
+		return nil, ErrSource
+	}
+	ok = true
+	return s, nil
+}
+func (s *source) close() {
+	s.closeOnce.Do(func() {
+		close(s.done)
+		if s.file != nil {
+			s.file.Close()
+		}
+		if s.lock != nil {
+			s.lock.Close()
+		}
+		if s.root != nil {
+			s.root.Close()
+		}
+	})
+}
+func initialize() {
+	limit := int64(defaultLimit)
+	if v := os.Getenv("HOOPA_TRACE_MAX_BYTES"); v != "" {
+		n, e := strconv.ParseInt(v, 10, 64)
+		if e != nil {
+			global.err = ErrSource
+			return
+		}
+		limit = n
+	}
+	global.s, global.err = openSource(os.Getenv("HOOPA_TRACE_DIR"), os.Getenv("HOOPA_TRACE_GENERATION"), os.Getenv("HOOPA_TRACE_RECEIVER"), os.Getenv("HOOPA_TRACE_SECRET"), limit)
+	if global.err == nil && global.s.receiver != "" {
+		go global.s.send()
+	}
+}
+func evidence(peer, local net.Addr) ProcessEvidence {
+	unknown := func(reason string) ProcessEvidence { return ProcessEvidence{Status: "unknown", Reason: reason} }
+	if peer == nil || local == nil {
+		return unknown("socket_scope")
+	}
+	p, e := netip.ParseAddrPort(peer.String())
+	if e != nil {
+		return unknown("socket_scope")
+	}
+	l, e := netip.ParseAddrPort(local.String())
+	if e != nil {
+		return unknown("socket_scope")
+	}
+	id, e := Resolve(p, l)
+	if e != nil {
+		reason := "owner_unavailable"
+		if errors.Is(e, ErrShared) {
+			reason = "shared_socket"
+		}
+		if errors.Is(e, ErrVisibility) {
+			reason = "owner_visibility"
+		}
+		return unknown(reason)
+	}
+	pidns, e := os.Readlink(fmt.Sprintf("/proc/%d/ns/pid", id.PID))
+	if e != nil {
+		return unknown("pid_namespace_unavailable")
+	}
+	path, e := os.Readlink(fmt.Sprintf("/proc/%d/exe", id.PID))
+	if e != nil {
+		return unknown("executable_unavailable")
+	}
+	after, e := processIdentity(id.PID)
+	if e != nil || after.StartTicks != id.StartTicks || after.Name != id.Name || after.NetNS != id.NetNS {
+		return unknown("identity_changed")
+	}
+	ownsNow, e := owns(id.PID, id.SocketInode)
+	if e != nil || !ownsNow {
+		return unknown("socket_changed")
+	}
+	return ProcessEvidence{Status: "identified", PID: id.PID, Name: id.Name, NameSource: "linux_proc_comm", StartTicks: id.StartTicks, BootID: id.BootID, PIDNS: pidns, NetNS: id.NetNS, SocketInode: id.SocketInode, Path: path}
+}
+func Begin(inName string, peer, local net.Addr, host, dstIP string, started time.Time) (*Flow, error) {
+	if !Enabled(inName) {
+		return nil, nil
+	}
+	global.once.Do(initialize)
+	if global.err != nil {
+		return nil, ErrSource
+	}
+	return global.s.begin(peer, local, host, dstIP, started)
+}
+func (s *source) begin(peer, local net.Addr, host, dstIP string, started time.Time) (*Flow, error) {
+	id, err := randomID("flow:")
+	if err != nil {
+		return nil, err
+	}
+	if started.IsZero() {
+		return nil, ErrSource
+	}
+	ident := evidence(peer, local)
+	f := &Flow{s: s, id: id, identity: ident, started: started, reserved: flowBudget}
+	s.mu.Lock()
+	if s.poisoned || s.readOnly || len(s.flows) >= maxActive || s.used+s.reserved+flowBudget > s.limit {
+		s.mu.Unlock()
+		return nil, ErrSource
+	}
+	s.flows[id] = f
+	s.reserved += flowBudget
+	s.mu.Unlock()
+	targetKind, target := "unknown", ""
+	if host != "" {
+		targetKind, target = "host", host
+	} else if dstIP != "" {
+		targetKind, target = "ip_only", dstIP
+	}
+	f.mu.Lock()
+	peerText, localText := "", ""
+	if peer != nil {
+		peerText = peer.String()
+	}
+	if local != nil {
+		localText = local.String()
+	}
+	err = s.append(f, "opened", f.attemptID(), map[string]any{"process": ident, "source_addr": peerText, "entry_addr": localText, "target_kind": targetKind, "target": target, "identity_scope": "same_uid_netns_ipv4_loopback_held_socket;fd_transfer_unverified"})
+	f.mu.Unlock()
+	if err != nil {
+		s.mu.Lock()
+		if !s.poisoned {
+			s.reserved -= f.reserved
+			f.reserved = 0
+			delete(s.flows, f.id)
+		}
+		s.mu.Unlock()
+		return nil, err
+	}
+	return f, nil
+}
+func (s *source) append(f *Flow, kind, attempt string, extra map[string]any) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.poisoned {
+		return ErrSource
+	}
+	if s.seq == ^uint64(0) {
+		s.poisoned = true
+		return ErrSource
+	}
+	seq := s.seq + 1
+	obj := map[string]any{"schema_version": 1, "source_instance_id": "source:" + strings.TrimPrefix(s.epoch, "epoch:"), "source_epoch": s.epoch, "event_id": "event:" + strings.TrimPrefix(s.epoch, "epoch:") + ":" + strconv.FormatUint(seq, 10), "source_seq": strconv.FormatUint(seq, 10), "flow_id": f.id, "attempt_id": attempt, "observed_at": time.Now().UTC().Format(time.RFC3339Nano), "config_generation": s.generation, "boundary_ref": "mihomo_proxy_stream_v1", "kind": kind}
+	for k, v := range extra {
+		obj[k] = v
+	}
+	raw, err := json.Marshal(obj)
+	if err != nil || len(raw) > maxFrame {
+		return ErrSource
+	}
+	frame := make([]byte, 4+len(raw)+sha256.Size)
+	binary.BigEndian.PutUint32(frame[:4], uint32(len(raw)))
+	copy(frame[4:], raw)
+	sum := sha256.Sum256(raw)
+	copy(frame[4+len(raw):], sum[:])
+	if int64(len(frame)) > f.reserved || s.used+int64(len(frame)) > s.limit {
+		return ErrSource
+	}
+	// The final cumulative frame and an explicit dimension gap have independent
+	// headroom. Intermediate events cannot borrow either terminal reservation.
+	terminalReserve := int64(2 * (maxFrame + 36))
+	if kind != "closed" && kind != "gap" && f.reserved-int64(len(frame)) < terminalReserve {
+		return ErrSource
+	}
+	n, err := s.file.Write(frame)
+	if err != nil || n != len(frame) || s.file.Sync() != nil {
+		s.poisoned = true
+		return ErrSource
+	}
+	s.seq = seq
+	s.used += int64(len(frame))
+	f.reserved -= int64(len(frame))
+	s.reserved -= int64(len(frame))
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+	return nil
+}
+func readFrames(r io.Reader, visit func([]byte) error) (uint64, error) {
+	var seq uint64
+	for {
+		var head [4]byte
+		_, err := io.ReadFull(r, head[:])
+		if err == io.EOF {
+			return seq, nil
+		}
+		if err != nil {
+			return seq, ErrSource
+		}
+		n := binary.BigEndian.Uint32(head[:])
+		if n == 0 || n > maxFrame {
+			return seq, ErrSource
+		}
+		b := make([]byte, int(n)+sha256.Size)
+		if _, err = io.ReadFull(r, b); err != nil {
+			return seq, ErrSource
+		}
+		sum := sha256.Sum256(b[:n])
+		if !bytes.Equal(sum[:], b[n:]) {
+			return seq, ErrSource
+		}
+		var meta struct {
+			SourceSeq string `json:"source_seq"`
+		}
+		if json.Unmarshal(b[:n], &meta) != nil {
+			return seq, ErrSource
+		}
+		got, e := strconv.ParseUint(meta.SourceSeq, 10, 64)
+		if e != nil || got != seq+1 || strconv.FormatUint(got, 10) != meta.SourceSeq {
+			return seq, ErrSource
+		}
+		seq = got
+		if visit != nil {
+			if err = visit(b[:n]); err != nil {
+				return seq, err
+			}
+		}
+	}
+}
+func (s *source) send() {
+	client := &http.Client{Timeout: 2 * time.Second, Transport: &http.Transport{Proxy: nil}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	// Per-file positions are advisory only: restart replays stable IDs. No source
+	// segment is reclaimed by this bounded prototype, including after HTTP ACK.
+	positions := map[string]uint64{}
+	for {
+		entries, err := s.root.Open(".")
+		if err != nil {
+			return
+		}
+		names, err := entries.ReadDir(-1)
+		entries.Close()
+		if err != nil {
+			return
+		}
+		for _, name := range names {
+			if !strings.HasPrefix(name.Name(), "epoch-") || !strings.HasSuffix(name.Name(), ".frames") {
+				continue
+			}
+			s.mu.Lock()
+			f, e := privateFile(s.root, name.Name(), os.O_RDONLY)
+			var rawFrames [][]byte
+			if e == nil {
+				_, e = readFrames(f, func(raw []byte) error { rawFrames = append(rawFrames, append([]byte(nil), raw...)); return nil })
+				f.Close()
+			}
+			s.mu.Unlock()
+			if e != nil {
+				continue
+			}
+			for i, raw := range rawFrames {
+				if uint64(i+1) <= positions[name.Name()] {
+					continue
+				}
+				req, e := http.NewRequest(http.MethodPost, s.receiver, bytes.NewReader(raw))
+				if e != nil {
+					break
+				}
+				req.Header.Set("Content-Type", "application/json")
+				req.Header.Set("Authorization", "Bearer "+s.secret)
+				resp, e := client.Do(req)
+				if e != nil {
+					break
+				}
+				io.Copy(io.Discard, io.LimitReader(resp.Body, 4096))
+				resp.Body.Close()
+				if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+					break
+				}
+				positions[name.Name()] = uint64(i + 1)
+			}
+		}
+		select {
+		case <-s.done:
+			return
+		case <-s.wake:
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+}
+func Lookup(id string) *Flow {
+	s := global.s
+	if s == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.flows[id]
+}
+func (f *Flow) ID() string {
+	if f == nil {
+		return ""
+	}
+	return f.id
+}
+func (f *Flow) Identity() ProcessEvidence {
+	if f == nil {
+		return ProcessEvidence{Status: "unknown", Reason: "not_traced"}
+	}
+	return f.identity
+}
+func (f *Flow) attemptID() string { return f.id + ":attempt:" + strconv.Itoa(f.attempt) }
+func (f *Flow) Decide(rule, rulePayload, target string) error {
+	if f == nil {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	err := f.s.append(f, "route_decided", f.attemptID(), map[string]any{"rule": rule, "rule_payload": rulePayload, "logical_target": target, "process": f.identity})
+	if err != nil {
+		f.invalid = true
+	}
+	return err
+}
+func (f *Flow) NewAttempt() *Attempt {
+	if f == nil {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.attempt++
+	return &Attempt{f: f, id: f.attemptID(), started: time.Now()}
+}
+func (a *Attempt) Finish(err error, chains, providers []string, ready bool) {
+	if a == nil {
+		return
+	}
+	a.once.Do(func() {
+		f := a.f
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		outcome, stage := "success", ""
+		var duration any
+		if err != nil {
+			outcome = "failure"
+			stage = "dial_or_handshake"
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				outcome = "timeout"
+			}
+		} else if !ready {
+			outcome = "unknown"
+			stage = "ready_unproven"
+		} else {
+			duration = time.Since(a.started).Milliseconds()
+		}
+		var flowDuration any
+		if err == nil && ready {
+			flowDuration = time.Since(f.started).Milliseconds()
+		}
+		extra := map[string]any{"definition": "attempt_dial_handshake_v1_candidate", "duration_ms": duration, "waited_ms": time.Since(a.started).Milliseconds(), "flow_duration_ms": flowDuration, "flow_waited_ms": time.Since(f.started).Milliseconds(), "flow_definition": "request_known_to_ready_v1_candidate", "outcome": outcome, "failure_stage": stage, "ordered_chain": append([]string{}, chains...), "provider_chain": append([]string{}, providers...), "route_evidence": "returned_conn_only", "protocol_ready_validation": "unverified"}
+		if f.s.append(f, "setup_finished", a.id, extra) != nil {
+			f.invalid = true
+		}
+	})
+}
+func (f *Flow) Bind(id string) {
+	if f == nil {
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.connection = id
+	if f.s.append(f, "route_decided", f.attemptID(), map[string]any{"phase": "connection_binding", "connection_id": id}) != nil {
+		f.invalid = true
+	}
+}
+
+// Check is used before admitting relay after the connection binding is durable.
+func (f *Flow) Check() error {
+	if f == nil {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.s.mu.Lock()
+	defer f.s.mu.Unlock()
+	if f.invalid || f.s.poisoned {
+		return ErrSource
+	}
+	return nil
+}
+func (f *Flow) AddUpload(n int) {
+	if f == nil || n <= 0 {
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if ^uint64(0)-f.up < uint64(n) {
+		f.invalid = true
+		f.counterInvalid = true
+		return
+	}
+	f.up += uint64(n)
+}
+func (f *Flow) AddDownload(n int) {
+	if f == nil || n <= 0 {
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if ^uint64(0)-f.down < uint64(n) {
+		f.invalid = true
+		f.counterInvalid = true
+		return
+	}
+	f.down += uint64(n)
+}
+func (f *Flow) Close() {
+	if f == nil {
+		return
+	}
+	f.once.Do(func() {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if !f.counterInvalid {
+			// Counter frames deliberately have exactly the 13 frozen profile fields.
+			if f.s.append(f, "closed", f.attemptID(), map[string]any{"upload_bytes": strconv.FormatUint(f.up, 10), "download_bytes": strconv.FormatUint(f.down, 10)}) != nil {
+				f.invalid = true
+			}
+		}
+		if f.invalid {
+			dimensions := []string{"route_or_setup"}
+			if f.counterInvalid {
+				dimensions = []string{"bytes", "route_or_setup"}
+			}
+			_ = f.s.append(f, "gap", f.attemptID(), map[string]any{"reason": "source_event_uncertain", "dimensions": dimensions, "upload_bytes": nil, "download_bytes": nil, "connection_id": f.connection})
+		}
+		f.s.mu.Lock()
+		f.s.reserved -= f.reserved
+		f.reserved = 0
+		delete(f.s.flows, f.id)
+		f.s.mu.Unlock()
+	})
+}
+func (f *Flow) MatchProcess(field, pattern string) int8 {
+	if f == nil || f.identity.Status != "identified" {
+		return -1
+	}
+	var value string
+	switch field {
+	case "name":
+		value = f.identity.Name
+	case "path":
+		value = f.identity.Path
+	case "instance":
+		value = f.identity.BootID + ":" + f.identity.PIDNS + ":" + strconv.Itoa(f.identity.PID) + ":" + f.identity.StartTicks
+	default:
+		return -1
+	}
+	if value == pattern {
+		return 1
+	}
+	return 0
+}
