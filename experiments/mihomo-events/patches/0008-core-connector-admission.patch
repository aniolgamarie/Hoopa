+func TestConnectorRawSurvivesQualityCountersAndSourceRecovery(t *testing.T) {
+	t.Setenv("HOOPA_TRACE_PROFILE", "3")
+	s := testSource(t, defaultLimit)
+	proof := connectorIdentityFixture()
+	original := proof
+	f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now(), &proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof.LeaderComm.Text = "mutated-after-begin"
+	proof.Raw.Connect = "00"
+	if err = f.Decide("MATCH", "", "DIRECT"); err != nil {
+		t.Fatal(err)
+	}
+	a := f.NewAttempt()
+	c := qualityAttach(t, a, "connector:actual", true)
+	a.FinishConnection(nil, "", c, false)
+	a.Bind("connector:tracker")
+	a.AddUpload(9007199254740993)
+	a.AddDownload(73)
+	if err = f.Checkpoint(); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	if err = s.shutdown(); err != nil {
+		t.Fatal(err)
+	}
+	before := frames(t, s)
+	opened, err := telemetrywire.DecodeSourceEvent(before[0])
+	if err != nil || opened.Connector == nil {
+		t.Fatal("opened identity", err)
+	}
+	want, _ := json.Marshal(original)
+	got, _ := json.Marshal(opened.Connector)
+	if !bytes.Equal(want, got) {
+		t.Fatal("Begin retained mutable caller proof")
+	}
+	var quality, closed bool
+	for _, raw := range before {
+		e, err := telemetrywire.DecodeSourceEvent(raw)
+		if err != nil || e.SchemaVersion != 3 {
+			t.Fatal("schema3 decode", err)
+		}
+		if e.Quality != nil {
+			quality = true
+		}
+		if e.Kind == "closed" {
+			closed = true
+			if e.Counter.UploadBytes != 9007199254740993 || e.Counter.DownloadBytes != 73 {
+				t.Fatal("final precision lost")
+			}
+		}
+	}
+	if !quality || !closed || len(s.flows) != 0 || s.reserved != 0 {
+		t.Fatal("incomplete connector lifecycle")
+	}
+	dir, name, epoch := s.root.Name(), filepath.Base(s.file.Name()), s.epoch
+	s.close()
+	next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal("source recovery", err)
+	}
+	defer next.close()
+	if next.epoch == epoch {
+		t.Fatal("reopen reused epoch")
+	}
+	snapshots, err := next.sendSnapshots()
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, snapshot := range snapshots {
+		if snapshot.name == name {
+			found = true
+			if !reflect.DeepEqual(before, snapshot.frames) {
+				t.Fatal("recovery changed connector raw bytes")
+			}
+		}
+	}
+	if !found {
+		t.Fatal("prior connector frames missing")
+	}
+	reports := next.recoveryReports()
+	if len(reports) != 1 || reports[0].Flows[0].Final.UploadBytes != 9007199254740993 {
+		t.Fatal("recovery lost precise final")
+	}
+	raw, _ := json.Marshal(reports)
+	if bytes.Contains(raw, []byte("connector")) || bytes.Contains(raw, []byte("leader_comm")) {
+		t.Fatal("report claims connector attribution")
+	}
+	old, err := os.ReadFile(filepath.Join(dir, name))
+	if err != nil || len(old) == 0 {
+		t.Fatal("durable source missing", err)
+	}
+}
