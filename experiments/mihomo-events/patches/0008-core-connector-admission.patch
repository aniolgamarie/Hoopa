diff --git b/hoopa_identity_test.go b/hoopa_identity_test.go
new file mode 100644
index 0000000..b95b5a3
--- /dev/null
+++ b/hoopa_identity_test.go
@@ -0,0 +1,126 @@
+//go:build linux && amd64
+
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	profile "github.com/metacubex/mihomo/component/hoopaguard/profile"
+)
+
+// main.init parses CLI flags before testing main starts. Register standard
+// test flags during variable initialization so this test binary can start.
+var identityTestFlagsRegistered = func() bool { testing.Init(); return true }()
+
+func identityUnsetEnv(t *testing.T, key string) {
+	t.Helper()
+	old, exists := os.LookupEnv(key)
+	if err := os.Unsetenv(key); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if exists {
+			_ = os.Setenv(key, old)
+		} else {
+			_ = os.Unsetenv(key)
+		}
+	})
+}
+func identityCleanEnv(t *testing.T) {
+	t.Helper()
+	for _, key := range []string{"HOOPA_GUARD_CONFIG_SHA256", "HOOPA_GUARD_GENERATION", "HOOPA_IDENTITY_HANDOFF"} {
+		identityUnsetEnv(t, key)
+	}
+	for _, kv := range os.Environ() {
+		key := strings.SplitN(kv, "=", 2)[0]
+		if strings.HasPrefix(key, "HOOPA_TRACE_") {
+			identityUnsetEnv(t, key)
+		}
+	}
+}
+func TestIdentityHandoffPresenceAlwaysRequestsProtectedEntry(t *testing.T) {
+	identityCleanEnv(t)
+	if hoopaGuardRequested() {
+		t.Fatal("clean environment requests guard")
+	}
+	for _, key := range []string{"HOOPA_IDENTITY_HANDOFF", "HOOPA_GUARD_CONFIG_SHA256", "HOOPA_GUARD_GENERATION"} {
+		t.Run(key, func(t *testing.T) {
+			t.Setenv(key, "")
+			if !hoopaGuardRequested() {
+				t.Fatal("present empty protected environment bypassed guard")
+			}
+		})
+	}
+}
+func TestIdentityHandoffBindsTraceProfileAndGeneration(t *testing.T) {
+	identityCleanEnv(t)
+	p := profile.Config{Listeners: []profile.Entry{{Name: "entry", Port: 32002}}, Proxies: []profile.Node{{Name: "node:test", Type: "direct"}}}
+	t.Setenv("HOOPA_TRACE_INBOUND", "entry")
+	t.Setenv("HOOPA_TRACE_GENERATION", "generation")
+	t.Setenv("HOOPA_TRACE_ROUTE_MAP", "/private/routes.json")
+	t.Setenv("HOOPA_TRACE_PROFILE", "2")
+	enabled, mapping, err := guardTraceConfig(p, "generation")
+	if err != nil || !enabled || mapping["node:test"] != "Direct" {
+		t.Fatal("legacy profile2 rejected", err)
+	}
+	t.Setenv("HOOPA_IDENTITY_HANDOFF", "")
+	if _, _, err = guardTraceConfig(p, "generation"); !errors.Is(err, errHoopaGuard) {
+		t.Fatal("empty handoff allowed profile2", err)
+	}
+	t.Setenv("HOOPA_TRACE_PROFILE", "3")
+	enabled, _, err = guardTraceConfig(p, "generation")
+	if err != nil || !enabled {
+		t.Fatal("handoff profile3 rejected", err)
+	}
+	for _, tc := range []struct{ key, value string }{{"HOOPA_TRACE_GENERATION", "other"}, {"HOOPA_TRACE_INBOUND", "other"}, {"HOOPA_TRACE_ROUTE_MAP", "relative.json"}, {"HOOPA_TRACE_PROFILE", "1"}} {
+		t.Run(tc.key, func(t *testing.T) {
+			t.Setenv(tc.key, tc.value)
+			if _, _, err := guardTraceConfig(p, "generation"); !errors.Is(err, errHoopaGuard) {
+				t.Fatal("unbound identity trace accepted", err)
+			}
+		})
+	}
+	identityUnsetEnv(t, "HOOPA_IDENTITY_HANDOFF")
+	if _, _, err = guardTraceConfig(p, "generation"); !errors.Is(err, errHoopaGuard) {
+		t.Fatal("profile3 without identity handoff accepted", err)
+	}
+}
+func TestIdentityHandoffCannotUseTestConfigAsFDAdoption(t *testing.T) {
+	identityCleanEnv(t)
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	p := profile.Config{Hosts: map[string]string{}, Groups: []profile.Group{}, Mode: "rule", LogLevel: "silent", FindProcessMode: "off", Controller: "127.0.0.1:32003", Secret: strings.Repeat("a", 32), Listeners: []profile.Entry{{Name: "entry", Type: "mixed", Listen: "127.0.0.1", Port: 32002, Users: []profile.User{{Username: strings.Repeat("u", 32), Password: strings.Repeat("p", 32)}}}}, Proxies: []profile.Node{{Name: "node:test", Type: "direct"}}, Rules: []string{"MATCH,node:test"}}
+	raw, err := json.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = profile.Validate(raw, "generation"); err != nil {
+		t.Fatal("test profile", err)
+	}
+	path := filepath.Join(dir, "config.json")
+	if err = os.WriteFile(path, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	previousHome, previousFile, previousTest := homeDir, configFile, testConfig
+	t.Cleanup(func() { homeDir, configFile, testConfig = previousHome, previousFile, previousTest })
+	homeDir, configFile, testConfig = dir, path, true
+	hash := sha256.Sum256(raw)
+	t.Setenv("HOOPA_GUARD_CONFIG_SHA256", hex.EncodeToString(hash[:]))
+	t.Setenv("HOOPA_GUARD_GENERATION", "generation")
+	if err = runHoopaGuard(); err != nil {
+		t.Fatal("valid legacy -t baseline", err)
+	}
+	t.Setenv("HOOPA_IDENTITY_HANDOFF", "")
+	if err = runHoopaGuard(); !errors.Is(err, errHoopaGuard) {
+		t.Fatal("-t bypassed runtime identity adoption", err)
+	}
+}
