diff --git b/constant/hoopa_quality_profile_test.go b/constant/hoopa_quality_profile_test.go
new file mode 100644
index 0000000..c96248d
--- /dev/null
+++ b/constant/hoopa_quality_profile_test.go
@@ -0,0 +1,34 @@
+package constant
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+// The capability is selected at package initialization, so each profile needs a
+// fresh test process rather than mutating the exported flag after init.
+func TestHoopaQualityIdentityProfiles(t *testing.T) {
+	if profile, child := os.LookupEnv("HOOPA_QUALITY_PROFILE_CHILD"); child {
+		want := profile == "2" || profile == "3"
+		if HoopaQualityEnabled != want {
+			t.Fatalf("profile %q: quality=%v, want %v", profile, HoopaQualityEnabled, want)
+		}
+		return
+	}
+	for _, profile := range []string{"", "1", "2", "3", "03", "invalid"} {
+		t.Run("profile="+profile, func(t *testing.T) {
+			cmd := exec.Command(os.Args[0], "-test.run=^TestHoopaQualityIdentityProfiles$")
+			for _, kv := range os.Environ() {
+				if !strings.HasPrefix(kv, "HOOPA_TRACE_PROFILE=") && !strings.HasPrefix(kv, "HOOPA_QUALITY_PROFILE_CHILD=") {
+					cmd.Env = append(cmd.Env, kv)
+				}
+			}
+			cmd.Env = append(cmd.Env, "HOOPA_TRACE_PROFILE="+profile, "HOOPA_QUALITY_PROFILE_CHILD="+profile)
+			if output, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("fresh profile init: %v\n%s", err, output)
+			}
+		})
+	}
+}
