@@ -0,0 +1,29 @@
+package inbound
+
+import (
+	hoopaid "github.com/metacubex/mihomo/component/hoopaid"
+	C "github.com/metacubex/mihomo/constant"
+	"testing"
+)
+
+func TestHoopaAdmissionCopiesIndependentValues(t *testing.T) {
+	original := hoopaid.Identity{CoreGeneration: "generation", Generation: "9007199254740993", LeaderComm: hoopaid.Comm{RawHex: "immutable", Text: "leader", TextValid: true, Status: "unverified"}, LocalEndpoint: hoopaid.Endpoint{IP: "127.0.0.1", Port: 32002}, Raw: hoopaid.RawIdentity{Binding: "binding", Connect: "connect", Gate: "gate"}}
+	expected := original
+	add := WithHoopaAdmission(original)
+	original.LeaderComm.Text = "caller-mutated"
+	original.Raw.Connect = "caller-mutated"
+	original.LocalEndpoint.Port++
+	var first, second, third C.Metadata
+	ApplyAdditions(&first, add)
+	ApplyAdditions(&second, add)
+	if first.HoopaAdmission == nil || second.HoopaAdmission == nil || first.HoopaAdmission == second.HoopaAdmission || *first.HoopaAdmission != expected || *second.HoopaAdmission != expected {
+		t.Fatal("admission did not freeze distinct pure values")
+	}
+	first.HoopaAdmission.LeaderComm.Text = "first-mutated"
+	first.HoopaAdmission.Raw.Binding = "first-mutated"
+	first.HoopaAdmission.LocalEndpoint.Port++
+	ApplyAdditions(&third, add)
+	if *second.HoopaAdmission != expected || *third.HoopaAdmission != expected || third.HoopaAdmission == first.HoopaAdmission || third.HoopaAdmission == second.HoopaAdmission {
+		t.Fatal("metadata mutation escaped its own copy")
+	}
+}
diff --git b/component/hoopaid/abi.go b/component/hoopaid/abi.go
new file mode 100644
index 0000000..8a82827
--- /dev/null
+++ b/component/hoopaid/abi.go
@@ -0,0 +1,157 @@
+package coreadmission
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strconv"
+	"unicode/utf8"
+)
+
+var le = binary.LittleEndian
+
+type Endpoint struct {
+	IP   string `json:"ip"`
+	Port uint16 `json:"port"`
+}
+
+// TextValid distinguishes invalid UTF-8 from an empty comm without mutable pointers.
+type Comm struct {
+	RawHex    string `json:"raw_hex"`
+	Text      string `json:"text"`
+	TextValid bool   `json:"text_valid"`
+	Status    string `json:"status"`
+}
+type RawIdentity struct {
+	Binding string `json:"binding"`
+	Connect string `json:"connect"`
+	Gate    string `json:"gate"`
+}
+
+// Identity contains values only: subsequent rejection cannot mutate a previous grant.
+type Identity struct {
+	Schema                string      `json:"schema"`
+	IdentityCapability    string      `json:"identity_capability"`
+	ProcessPath           string      `json:"process_path"`
+	BootID                string      `json:"boot_id"`
+	CoreGeneration        string      `json:"core_generation"`
+	Generation            string      `json:"generation"`
+	SourceCgroupID        string      `json:"source_cgroup_id"`
+	RootCgroupID          string      `json:"root_cgroup_id"`
+	AcceptedCookie        string      `json:"accepted_cookie"`
+	ClientCookie          string      `json:"client_cookie"`
+	SocketNetnsCookie     string      `json:"socket_netns_cookie"`
+	TGID                  uint32      `json:"tgid_initial"`
+	LeaderPID             uint32      `json:"leader_pid_initial"`
+	CallerTID             uint32      `json:"caller_tid_initial"`
+	LeaderStartBoottimeNS string      `json:"leader_start_boottime_ns"`
+	ObservedBootNS        string      `json:"observed_boot_ns"`
+	PIDNSInode            uint32      `json:"active_pidns_inum"`
+	LeaderComm            Comm        `json:"leader_comm"`
+	CallerComm            Comm        `json:"caller_comm"`
+	LocalEndpoint         Endpoint    `json:"local_endpoint"`
+	RemoteEndpoint        Endpoint    `json:"remote_endpoint"`
+	Raw                   RawIdentity `json:"raw"`
+}
+
+type witness struct {
+	cookie, netns uint64
+	local, remote Endpoint
+}
+type gate struct {
+	closed                      bool
+	active, admitted, completed uint64
+}
+
+func readGate(raw []byte) (gate, error) {
+	var g gate
+	if len(raw) != 40 {
+		return g, errors.New("gate size")
+	}
+	closed := le.Uint32(raw[4:])
+	g = gate{closed == 1, le.Uint64(raw[8:]), le.Uint64(raw[16:]), le.Uint64(raw[24:])}
+	if le.Uint32(raw) != 0 || closed > 1 || le.Uint32(raw[32:]) != 0 || le.Uint32(raw[36:]) != 0 || g.completed > g.admitted || g.active != g.admitted-g.completed {
+		return gate{}, errors.New("invalid/poisoned gate")
+	}
+	return g, nil
+}
+func comm(raw []byte, status uint32) (Comm, error) {
+	if len(raw) != 16 || raw[15] != 0 || status > 1 {
+		return Comm{}, errors.New("invalid comm ABI")
+	}
+	end := 0
+	for end < len(raw) && raw[end] != 0 {
+		end++
+	}
+	c := Comm{RawHex: hex.EncodeToString(raw), TextValid: utf8.Valid(raw[:end]), Status: "unavailable"}
+	if c.TextValid {
+		c.Text = string(raw[:end])
+	}
+	if status == 1 {
+		c.Status = "unverified"
+	}
+	return c, nil
+}
+func config(h handoff) []byte {
+	out := make([]byte, 32)
+	for i, s := range []string{h.Generation, h.SourceCgroupID, h.NetnsCookie} {
+		n, _ := u64(s)
+		le.PutUint64(out[i*8:], n)
+	}
+	le.PutUint32(out[24:], uint32(h.Port))
+	return out
+}
+func uintKey(n uint64) []byte { out := make([]byte, 8); le.PutUint64(out, n); return out }
+func validateWitness(w witness, h handoff) error {
+	netns, _ := u64(h.NetnsCookie)
+	if w.cookie == 0 || w.netns != netns || w.local != (Endpoint{"127.0.0.1", h.Port}) || w.remote.IP != "127.0.0.1" || w.remote.Port == 0 {
+		return errors.New("original accepted socket namespace/endpoints mismatch")
+	}
+	return nil
+}
+func bindingCookie(raw []byte, w witness, h handoff) (uint64, error) {
+	if len(raw) != 56 {
+		return 0, errors.New("binding size")
+	}
+	generation, _ := u64(h.Generation)
+	netns, _ := u64(h.NetnsCookie)
+	client := le.Uint64(raw[24:])
+	if le.Uint64(raw) != generation || le.Uint64(raw[8:]) != netns || le.Uint64(raw[16:]) != w.cookie || client == 0 || client == w.cookie ||
+		le.Uint32(raw[32:]) != 0x0100007f || le.Uint32(raw[36:]) != 0x0100007f || le.Uint32(raw[40:]) != uint32(w.remote.Port) || le.Uint32(raw[44:]) != uint32(h.Port) || le.Uint32(raw[48:]) != 1 || le.Uint32(raw[52:]) != 0 {
+		return 0, errors.New("binding ABI/witness mismatch")
+	}
+	return client, nil
+}
+func identity(h handoff, w witness, b, c, g []byte) (Identity, error) {
+	var out Identity
+	client, err := bindingCookie(b, w, h)
+	if err != nil {
+		return out, err
+	}
+	if len(c) != 112 {
+		return out, errors.New("connect size")
+	}
+	generation, _ := u64(h.Generation)
+	netns, _ := u64(h.NetnsCookie)
+	source, _ := u64(h.SourceCgroupID)
+	tgid, tid, pidns, leader := le.Uint32(c[52:]), le.Uint32(c[56:]), le.Uint32(c[60:]), le.Uint32(c[64:])
+	if le.Uint64(c) != generation || le.Uint64(c[16:]) != client || le.Uint64(c[24:]) != netns || le.Uint64(c[32:]) != source || le.Uint64(c[40:]) == 0 || le.Uint64(c[8:]) < le.Uint64(c[40:]) || le.Uint32(c[48:]) != 1 || tgid == 0 || tgid > 0x7fffffff || tid == 0 || tid > 0x7fffffff || leader != tgid || pidns != h.PIDNSInode || le.Uint32(c[76:]) != 0 {
+		return out, errors.New("connect coordinates/schema mismatch")
+	}
+	caller, err := comm(c[80:96], le.Uint32(c[68:]))
+	if err != nil {
+		return out, err
+	}
+	leaderComm, err := comm(c[96:], le.Uint32(c[72:]))
+	if err != nil {
+		return out, err
+	}
+	gate, err := readGate(g)
+	if err != nil || gate.closed {
+		return out, fmt.Errorf("grant gate: %v closed=%v", err, gate.closed)
+	}
+	out = Identity{Schema: "sourceidentity-core-admission-v1", IdentityCapability: "unverified", ProcessPath: "unknown", BootID: h.BootID, CoreGeneration: h.CoreGeneration, Generation: h.Generation, SourceCgroupID: h.SourceCgroupID, RootCgroupID: h.RootCgroupID,
+		AcceptedCookie: strconv.FormatUint(w.cookie, 10), ClientCookie: strconv.FormatUint(client, 10), SocketNetnsCookie: h.NetnsCookie, TGID: tgid, LeaderPID: leader, CallerTID: tid, LeaderStartBoottimeNS: strconv.FormatUint(le.Uint64(c[40:]), 10), ObservedBootNS: strconv.FormatUint(le.Uint64(c[8:]), 10), PIDNSInode: pidns, LeaderComm: leaderComm, CallerComm: caller, LocalEndpoint: w.local, RemoteEndpoint: w.remote, Raw: RawIdentity{hex.EncodeToString(b), hex.EncodeToString(c), hex.EncodeToString(g)}}
+	return out, nil
+}
diff --git b/component/hoopaid/handoff.go b/component/hoopaid/handoff.go
new file mode 100644
index 0000000..46eed1b
--- /dev/null
+++ b/component/hoopaid/handoff.go
@@ -0,0 +1,160 @@
+// Package coreadmission is a finite isolated-guest experiment, not a production identity authority.
+package coreadmission
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"regexp"
+	"strconv"
+)
+
+var mapNames = []string{"capture_config", "connect_records", "capture_faults", "capture_gate", "online_tuples", "online_bindings"}
+var programNames = []string{"hoopa_connect", "hoopa_lifecycle", "hoopa_stop"}
+var linkNames = []string{"hoopa_connect", "hoopa_lifecycle"}
+var positiveDecimal = regexp.MustCompile(`^[1-9][0-9]{0,19}$`)
+var uuid = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var sourcePath = regexp.MustCompile(`^/sys/fs/cgroup/hoopa-online-[A-Za-z0-9_-]+$`)
+
+type handoff struct {
+	Schema         string         `json:"schema"`
+	CoreGeneration string         `json:"core_generation"`
+	Generation     string         `json:"generation"`
+	SourceCgroupID string         `json:"source_cgroup_id"`
+	RootCgroupID   string         `json:"root_cgroup_id"`
+	NetnsCookie    string         `json:"netns_cookie"`
+	PIDNSInode     uint32         `json:"pidns_inode"`
+	BootID         string         `json:"boot_id"`
+	SourcePath     string         `json:"source_path"`
+	Port           uint16         `json:"port"`
+	Maps           map[string]int `json:"maps"`
+	Programs       map[string]int `json:"programs"`
+	Links          map[string]int `json:"links"`
+}
+
+func u64(s string) (uint64, error) {
+	if !positiveDecimal.MatchString(s) {
+		return 0, errors.New("noncanonical positive uint64")
+	}
+	n, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// rejectDuplicates runs before typed decoding, including inside all FD objects.
+func jsonValue(d *json.Decoder) error {
+	t, err := d.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := t.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for d.More() {
+			key, err := d.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok || seen[name] {
+				return errors.New("duplicate/invalid JSON key")
+			}
+			seen[name] = true
+			if err = jsonValue(d); err != nil {
+				return err
+			}
+		}
+	case '[':
+		for d.More() {
+			if err = jsonValue(d); err != nil {
+				return err
+			}
+		}
+	default:
+		return errors.New("unexpected JSON delimiter")
+	}
+	_, err = d.Token()
+	return err
+}
+
+func parse(raw []byte) (handoff, error) {
+	var h handoff
+	if len(raw) == 0 || len(raw) > 8192 {
+		return h, errors.New("handoff must contain 1..8192 bytes")
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	if err := jsonValue(d); err != nil {
+		return h, err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return h, errors.New("trailing JSON")
+	}
+	var keys map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &keys); err != nil {
+		return h, err
+	}
+	names := []string{"schema", "core_generation", "generation", "source_cgroup_id", "root_cgroup_id", "netns_cookie", "pidns_inode", "boot_id", "source_path", "port", "maps", "programs", "links"}
+	if len(keys) != len(names) {
+		return h, errors.New("unexpected handoff field set")
+	}
+	for _, name := range names {
+		if _, ok := keys[name]; !ok {
+			return h, fmt.Errorf("missing exact field %s", name)
+		}
+	}
+	d = json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&h); err != nil {
+		return h, err
+	}
+	if h.Schema != "hoopa-core-identity-handoff-v1" || h.CoreGeneration == "" || h.PIDNSInode == 0 || !uuid.MatchString(h.BootID) || !sourcePath.MatchString(h.SourcePath) || h.Port == 0 {
+		return h, errors.New("invalid handoff declaration")
+	}
+	for _, s := range []string{h.Generation, h.SourceCgroupID, h.RootCgroupID, h.NetnsCookie} {
+		if _, err := u64(s); err != nil {
+			return h, err
+		}
+	}
+	if h.SourceCgroupID == h.RootCgroupID {
+		return h, errors.New("source must differ from root")
+	}
+	seen := map[int]bool{}
+	for _, group := range []struct {
+		fds   map[string]int
+		names []string
+	}{{h.Maps, mapNames}, {h.Programs, programNames}, {h.Links, linkNames}} {
+		if len(group.fds) != len(group.names) {
+			return h, errors.New("unexpected FD object size")
+		}
+		for _, name := range group.names {
+			fd, ok := group.fds[name]
+			if !ok || fd < 200 || fd > 1023 || seen[fd] {
+				return h, fmt.Errorf("invalid/duplicate FD for %s", name)
+			}
+			seen[fd] = true
+		}
+	}
+	return h, nil
+}
+
+func (h handoff) orderedFDs() []int {
+	fds := make([]int, 0, 11)
+	for _, name := range mapNames {
+		fds = append(fds, h.Maps[name])
+	}
+	for _, name := range programNames {
+		fds = append(fds, h.Programs[name])
+	}
+	for _, name := range linkNames {
+		fds = append(fds, h.Links[name])
+	}
+	return fds
+}
diff --git b/component/hoopaid/native_linux_amd64.go b/component/hoopaid/native_linux_amd64.go
new file mode 100644
index 0000000..15a2bc6
--- /dev/null
+++ b/component/hoopaid/native_linux_amd64.go
@@ -0,0 +1,361 @@
+//go:build linux && amd64
+
+package coreadmission
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"syscall"
+	"unsafe"
+)
+
+type nativeBackend struct{ call func(uint32, []byte) error }
+
+func newBackend() (backend, error) { return &nativeBackend{call: rawBPF}, nil }
+func rawBPF(command uint32, attr []byte) error {
+	r, _, errno := syscall.Syscall(321, uintptr(command), uintptr(unsafe.Pointer(&attr[0])), uintptr(len(attr)))
+	runtime.KeepAlive(attr)
+	if errno != 0 {
+		return errno
+	}
+	if r != 0 {
+		return fmt.Errorf("BPF command %d unexpected positive return %d", command, r)
+	}
+	return nil
+}
+func ptr(raw []byte) uint64 {
+	if len(raw) == 0 {
+		return 0
+	}
+	return uint64(uintptr(unsafe.Pointer(&raw[0])))
+}
+
+// Pin before encoding addresses into integer ABI fields. KeepAlive alone does
+// not prevent stack movement between address encoding and the syscall.
+func pinBuffers(buffers ...[]byte) func() {
+	var pins runtime.Pinner
+	for _, buffer := range buffers {
+		if len(buffer) > 0 {
+			pins.Pin(&buffer[0])
+		}
+	}
+	return pins.Unpin
+}
+
+func (b *nativeBackend) readInfo(fd int, buffer []byte) ([]byte, error) {
+	unpin := pinBuffers(buffer)
+	defer unpin()
+	attr := make([]byte, 16)
+	le.PutUint32(attr, uint32(fd))
+	le.PutUint32(attr[4:], uint32(len(buffer)))
+	le.PutUint64(attr[8:], ptr(buffer))
+	err := b.call(15, attr)
+	runtime.KeepAlive(buffer)
+	if err != nil {
+		return nil, err
+	}
+	n := le.Uint32(attr[4:])
+	if n > uint32(len(buffer)) {
+		return nil, errors.New("oversized kernel info")
+	}
+	return buffer[:n], nil
+}
+func (b *nativeBackend) info(fd int) ([]byte, error) { return b.readInfo(fd, make([]byte, 256)) }
+func (b *nativeBackend) programInfo(fd int) ([]byte, []uint32, error) {
+	first, err := b.info(fd)
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(first) < 80 {
+		return nil, nil, errors.New("short program info")
+	}
+	count := le.Uint32(first[52:])
+	if count > 16 {
+		return nil, nil, errors.New("program map count exceeds bound")
+	}
+	// A byte array avoids a second pointer-bearing Go object in bpf_attr.
+	ids := make([]byte, count*4)
+	unpin := pinBuffers(ids)
+	defer unpin()
+	buf := make([]byte, 256)
+	le.PutUint32(buf[52:], count)
+	le.PutUint64(buf[56:], ptr(ids))
+	second, err := b.readInfo(fd, buf)
+	runtime.KeepAlive(ids)
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(second) < 80 || le.Uint32(second[52:]) > count || string(second[:8]) != string(first[:8]) || string(second[64:80]) != string(first[64:80]) {
+		return nil, nil, errors.New("program info changed/short")
+	}
+	out := make([]uint32, le.Uint32(second[52:]))
+	for i := range out {
+		out[i] = le.Uint32(ids[i*4:])
+	}
+	return second, out, nil
+}
+func fcntl(fd, command, arg int) (int, error) {
+	r, _, errno := syscall.Syscall(syscall.SYS_FCNTL, uintptr(fd), uintptr(command), uintptr(arg))
+	if errno != 0 {
+		return 0, errno
+	}
+	return int(r), nil
+}
+func (b *nativeBackend) access(fd int) (int, error) {
+	flags, err := fcntl(fd, syscall.F_GETFL, 0)
+	return flags & syscall.O_ACCMODE, err
+}
+func (b *nativeBackend) cloexec(fd int) error {
+	flags, err := fcntl(fd, syscall.F_GETFD, 0)
+	if err != nil {
+		return err
+	}
+	_, err = fcntl(fd, syscall.F_SETFD, flags|syscall.FD_CLOEXEC)
+	return err
+}
+func (b *nativeBackend) lookup(fd int, key []byte, size int, flags uint64) ([]byte, error) {
+	out := make([]byte, size)
+	unpin := pinBuffers(key, out)
+	defer unpin()
+	attr := make([]byte, 32)
+	le.PutUint32(attr, uint32(fd))
+	le.PutUint64(attr[8:], ptr(key))
+	le.PutUint64(attr[16:], ptr(out))
+	le.PutUint64(attr[24:], flags)
+	err := b.call(1, attr)
+	runtime.KeepAlive(key)
+	runtime.KeepAlive(out)
+	return out, err
+}
+func (b *nativeBackend) nextKey(fd int, size int) error {
+	out := make([]byte, size)
+	unpin := pinBuffers(out)
+	defer unpin()
+	attr := make([]byte, 32)
+	le.PutUint32(attr, uint32(fd))
+	le.PutUint64(attr[16:], ptr(out))
+	err := b.call(4, attr)
+	runtime.KeepAlive(out)
+	return err
+}
+func (b *nativeBackend) update(fd int, key, value []byte) error {
+	unpin := pinBuffers(key, value)
+	defer unpin()
+	attr := make([]byte, 32)
+	le.PutUint32(attr, uint32(fd))
+	le.PutUint64(attr[8:], ptr(key))
+	le.PutUint64(attr[16:], ptr(value))
+	err := b.call(2, attr)
+	runtime.KeepAlive(key)
+	runtime.KeepAlive(value)
+	return err
+}
+func (b *nativeBackend) testRun(fd int) error {
+	packet := make([]byte, 64)
+	unpin := pinBuffers(packet)
+	defer unpin()
+	attr := make([]byte, 80)
+	le.PutUint32(attr, uint32(fd))
+	le.PutUint32(attr[8:], 64)
+	le.PutUint64(attr[16:], ptr(packet))
+	le.PutUint32(attr[32:], 1)
+	err := b.call(10, attr)
+	runtime.KeepAlive(packet)
+	if err != nil {
+		return err
+	}
+	if le.Uint32(attr[4:]) != 0 {
+		return fmt.Errorf("stop program retval %d", le.Uint32(attr[4:]))
+	}
+	return nil
+}
+func (b *nativeBackend) close(fd int) error { return syscall.Close(fd) }
+func inode(path string) (uint64, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return 0, err
+	}
+	s, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, errors.New("stat ABI")
+	}
+	return s.Ino, nil
+}
+func read(path string) (string, error) {
+	raw, err := os.ReadFile(path)
+	return strings.TrimSpace(string(raw)), err
+}
+func (b *nativeBackend) environment(h handoff) error {
+	cmdline, err := read("/proc/cmdline")
+	if err != nil {
+		return err
+	}
+	lab := false
+	for _, arg := range strings.Fields(cmdline) {
+		if arg == "hoopa_lab=t132" {
+			lab = true
+		}
+	}
+	if os.Geteuid() != 0 || !lab {
+		return errors.New("dedicated root t132 guest required")
+	}
+	boot, err := read("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return err
+	}
+	if boot != h.BootID {
+		return errors.New("boot ID mismatch")
+	}
+	for _, ns := range []string{"pid", "net", "user", "time", "time_for_children"} {
+		self, err := inode("/proc/self/ns/" + ns)
+		if err != nil {
+			return err
+		}
+		initial, err := inode("/proc/1/ns/" + ns)
+		if err != nil {
+			return err
+		}
+		if self != initial || ns == "pid" && self != uint64(h.PIDNSInode) {
+			return fmt.Errorf("initial guest namespace mismatch: %s", ns)
+		}
+	}
+	mounts, err := read("/proc/self/mountinfo")
+	if err != nil {
+		return err
+	}
+	matches := 0
+	for _, line := range strings.Split(mounts, "\n") {
+		parts := strings.Split(line, " - ")
+		if len(parts) != 2 {
+			continue
+		}
+		left, right := strings.Fields(parts[0]), strings.Fields(parts[1])
+		if len(left) > 4 && left[4] == "/sys/fs/cgroup" {
+			if len(right) == 0 || right[0] != "cgroup2" || left[3] != "/" {
+				return errors.New("cgroup2 root mount required")
+			}
+			matches++
+		}
+	}
+	if matches != 1 {
+		return errors.New("one cgroup2 root mount required")
+	}
+	info, err := os.Lstat(h.SourcePath)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("source leaf must be a directory")
+	}
+	kind, err := read(filepath.Join(h.SourcePath, "cgroup.type"))
+	if err != nil {
+		return err
+	}
+	if kind != "domain" {
+		return errors.New("domain source leaf required")
+	}
+	for path, want := range map[string]string{h.SourcePath: h.SourceCgroupID, "/sys/fs/cgroup": h.RootCgroupID} {
+		got, err := inode(path)
+		if err != nil {
+			return err
+		}
+		n, _ := u64(want)
+		if got != n {
+			return errors.New("actual cgroup inode mismatch")
+		}
+	}
+	membership, err := read("/proc/self/cgroup")
+	if err != nil {
+		return err
+	}
+	if membership != "0::/"+filepath.Base(h.SourcePath) {
+		return errors.New("current process not in configured source leaf")
+	}
+	return nil
+}
+func socketU64(fd int, option int) (uint64, error) {
+	var value uint64
+	size := uint32(8)
+	_, _, errno := syscall.Syscall6(syscall.SYS_GETSOCKOPT, uintptr(fd), syscall.SOL_SOCKET, uintptr(option), uintptr(unsafe.Pointer(&value)), uintptr(unsafe.Pointer(&size)), 0)
+	runtime.KeepAlive(&value)
+	runtime.KeepAlive(&size)
+	if errno != 0 {
+		return 0, errno
+	}
+	if size != 8 {
+		return 0, errors.New("socket cookie option size")
+	}
+	return value, nil
+}
+func endpoint(addr syscall.Sockaddr) (Endpoint, error) {
+	v, ok := addr.(*syscall.SockaddrInet4)
+	if !ok || v.Addr != [4]byte{127, 0, 0, 1} || v.Port < 1 || v.Port > 65535 {
+		return Endpoint{}, errors.New("non-loopback IPv4 endpoint")
+	}
+	return Endpoint{"127.0.0.1", uint16(v.Port)}, nil
+}
+func (b *nativeBackend) socket(conn *net.TCPConn) (witness, error) {
+	var w witness
+	if conn == nil {
+		return w, errors.New("nil original TCPConn")
+	}
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return w, err
+	}
+	return captureWithControl(raw.Control, captureSocket)
+}
+
+func captureWithControl(control func(func(uintptr)) error, capture func(int) (witness, error)) (witness, error) {
+	var w witness
+	var captureErr error
+	calls := 0
+	err := control(func(fd uintptr) { calls++; w, captureErr = capture(int(fd)) })
+	if calls != 1 {
+		return witness{}, errors.Join(err, captureErr, errors.New("original socket Control callback count"))
+	}
+	if err != nil || captureErr != nil {
+		return witness{}, errors.Join(err, captureErr)
+	}
+	return w, nil
+}
+func captureSocket(fd int) (witness, error) {
+	var w witness
+	for _, item := range []struct{ option, want int }{{39, syscall.AF_INET}, {syscall.SO_TYPE, syscall.SOCK_STREAM}, {38, syscall.IPPROTO_TCP}} {
+		got, err := syscall.GetsockoptInt(fd, syscall.SOL_SOCKET, item.option)
+		if err != nil {
+			return w, err
+		}
+		if got != item.want {
+			return w, errors.New("original socket must be ordinary IPv4 TCP")
+		}
+	}
+	var err error
+	w.cookie, err = socketU64(fd, 57)
+	if err != nil {
+		return w, err
+	}
+	w.netns, err = socketU64(fd, 71)
+	if err != nil {
+		return w, err
+	}
+	local, err := syscall.Getsockname(fd)
+	if err != nil {
+		return w, err
+	}
+	remote, err := syscall.Getpeername(fd)
+	if err != nil {
+		return w, err
+	}
+	w.local, err = endpoint(local)
+	if err != nil {
+		return w, err
+	}
+	w.remote, err = endpoint(remote)
+	return w, err
+}
diff --git b/component/hoopaid/native_linux_amd64_test.go b/component/hoopaid/native_linux_amd64_test.go
new file mode 100644
index 0000000..8b1bb0a
--- /dev/null
