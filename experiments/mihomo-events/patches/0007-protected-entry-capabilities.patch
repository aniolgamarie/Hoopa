+	"time"
+
+	"github.com/metacubex/mihomo/adapter/inbound"
+	"github.com/metacubex/mihomo/component/auth"
+	"github.com/metacubex/mihomo/component/hoopaguard"
+	profile "github.com/metacubex/mihomo/component/hoopaguard/profile"
+	"github.com/metacubex/mihomo/component/hoopatrace"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/hub/executor"
+	authStore "github.com/metacubex/mihomo/listener/auth"
+	"github.com/metacubex/mihomo/listener/mixed"
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+var errHoopaGuard = errors.New("Hoopa protected configuration rejected")
+
+func hoopaGuardRequested() bool {
+	_, h := os.LookupEnv("HOOPA_GUARD_CONFIG_SHA256")
+	_, g := os.LookupEnv("HOOPA_GUARD_GENERATION")
+	return h || g
+}
+
+func guardPrivateDir(path string) bool {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return false
+	}
+	real, err := filepath.EvalSymlinks(path)
+	if err != nil || real != path {
+		return false
+	}
+	fi, err := os.Lstat(path)
+	if err != nil || !fi.IsDir() || fi.Mode().Perm() != 0700 {
+		return false
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	return ok && st.Uid == uint32(os.Geteuid())
+}
+
+func guardReadConfig(path string) ([]byte, error) {
+	if !filepath.IsAbs(path) || !guardPrivateDir(filepath.Dir(path)) {
+		return nil, errHoopaGuard
+	}
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, errHoopaGuard
+	}
+	defer f.Close()
+	fi, err := f.Stat()
+	if err != nil || !fi.Mode().IsRegular() || fi.Mode().Perm() != 0600 || fi.Size() > 65536 {
+		return nil, errHoopaGuard
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok || st.Uid != uint32(os.Geteuid()) {
+		return nil, errHoopaGuard
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, 65537))
+	if err != nil || len(raw) > 65536 {
+		return nil, errHoopaGuard
+	}
+	return raw, nil
+}
+
+func guardTraceConfig(p profile.Config, generation string) (bool, map[string]string, error) {
+	name := os.Getenv("HOOPA_TRACE_INBOUND")
+	if name == "" {
+		for _, kv := range os.Environ() {
+			if strings.HasPrefix(kv, "HOOPA_TRACE_") && strings.SplitN(kv, "=", 2)[1] != "" {
+				return false, nil, errHoopaGuard
+			}
+		}
+		return false, nil, nil
+	}
+	found := false
+	for _, e := range p.Listeners {
+		if e.Name == name {
+			found = true
+		}
+	}
+	if !found || os.Getenv("HOOPA_TRACE_GENERATION") != generation || os.Getenv("HOOPA_TRACE_PROFILE") != "2" || !filepath.IsAbs(os.Getenv("HOOPA_TRACE_ROUTE_MAP")) {
+		return false, nil, errHoopaGuard
+	}
+	expected := map[string]string{}
+	for _, n := range p.Proxies {
+		expected[n.Name] = map[string]string{"direct": "Direct", "http": "Http", "socks5": "Socks5"}[n.Type]
+	}
+	for _, g := range p.Groups {
+		expected[g.Name] = "Selector"
+	}
+	return true, expected, nil
+}
+
+func runHoopaGuard() error {
+	// Protected startup does not enter stock init, CLI override, reload or shell paths.
+	log.SetLevel(log.SILENT)
+	if configString != "" || configFile == "-" || !guardPrivateDir(homeDir) || geodataMode || postUp != "" || postDown != "" || externalUI != "" || externalController != "" || externalControllerUnix != "" || externalControllerPipe != "" || secret != "" || flag.NArg() != 0 {
+		return errHoopaGuard
+	}
+	raw, err := guardReadConfig(configFile)
+	if err != nil {
+		return errHoopaGuard
+	}
+	digest := sha256.Sum256(raw)
+	hash := hex.EncodeToString(digest[:])
+	if os.Getenv("HOOPA_GUARD_CONFIG_SHA256") != hash {
+		return errHoopaGuard
+	}
+	generation := os.Getenv("HOOPA_GUARD_GENERATION")
+	p, err := profile.Validate(raw, generation)
+	if err != nil {
+		return errHoopaGuard
+	}
+	tracing, expected, err := guardTraceConfig(p, generation)
+	if err != nil {
+		return errHoopaGuard
+	}
+	C.SetHomeDir(homeDir)
+	C.SetConfig(configFile)
+	cfg, err := executor.ParseWithBytes(raw)
+	if err != nil {
+		return errHoopaGuard
+	}
+	// No generated default/hidden listener, rule provider or automatic update is admitted.
+	g := cfg.General
+	if g.Port != 0 || g.SocksPort != 0 || g.RedirPort != 0 || g.TProxyPort != 0 || g.MixedPort != 0 || g.Tun.Enable || g.TuicServer.Enable || len(cfg.Tunnels) != 0 || len(cfg.RuleProviders) != 0 || g.GeoAutoUpdate {
+		return errHoopaGuard
+	}
+	if testConfig {
+		return nil
+	}
+	if tracing {
+		if err := hoopatrace.PrepareGuard(generation, expected); err != nil {
+			return errHoopaGuard
+		}
+	}
+	defer hoopatrace.Shutdown()
+	// Apply routes/proxies without opening any stock listener or controller.
+	cfg.Listeners = nil
+	C.HoopaProtected = true
+	executor.ApplyConfig(cfg, true)
+	defer executor.Shutdown()
+	r := &hoopaGuardRuntime{state: "preparing", generation: generation, hash: hash, secret: p.Secret, conns: map[net.Conn]bool{}}
+	defer r.stop()
+	// Reserve every socket first. A later bind failure closes the earlier ones;
+	// no auth/CONNECT response or payload can be dispatched before all succeed.
+	addresses := make([]string, 0, len(p.Listeners)+1)
+	for _, e := range p.Listeners {
+		addresses = append(addresses, net.JoinHostPort(e.Listen, strconv.Itoa(int(e.Port))))
+	}
+	addresses = append(addresses, p.Controller)
+	for _, address := range addresses {
+		f, err := hoopaguard.Reserve(address)
+		if err != nil {
+			return errHoopaGuard
+		}
+		r.reserved = append(r.reserved, f)
+	}
+	for i, f := range r.reserved {
+		ln, err := hoopaguard.Listen(f)
+		if err != nil {
+			return errHoopaGuard
+		}
+		if i == len(p.Listeners) {
+			r.controller = ln
+		} else {
+			r.entries = append(r.entries, ln)
+		}
+	}
+	terms, hups := make(chan os.Signal, 1), make(chan os.Signal, 1)
+	signal.Notify(terms, syscall.SIGINT, syscall.SIGTERM)
+	signal.Notify(hups, syscall.SIGHUP)
+	defer signal.Stop(terms)
+	defer signal.Stop(hups)
+	r.mu.Lock()
+	r.state = "running"
+	r.mu.Unlock()
+	for i, e := range p.Listeners {
+		store := authStore.NewAuthStore(auth.NewAuthenticator([]auth.AuthUser{{User: e.Users[0].Username, Pass: e.Users[0].Password}}))
+		r.accept.Add(1)
+		go r.serveEntry(r.entries[i], e.Name, store)
+	}
+	r.server = &http.Server{Handler: r, ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 3 * time.Second, WriteTimeout: 3 * time.Second, IdleTimeout: 5 * time.Second, MaxHeaderBytes: 8192}
+	serve := make(chan error, 1)
+	go func() { serve <- r.server.Serve(r.controller) }()
+
+	for {
+		select {
+		case <-terms:
+			return nil
+		case <-hups: // Explicitly unsupported: immutable config requires full process replace.
+		case <-serve:
+			return errHoopaGuard
+		}
+	}
+}
+
+type hoopaGuardRuntime struct {
+	mu                              sync.Mutex
+	state, generation, hash, secret string
+	entries                         []net.Listener
+	reserved                        []*os.File
+	controller                      net.Listener
+	server                          *http.Server
+	conns                           map[net.Conn]bool
+	accept, workers                 sync.WaitGroup
+}
+
+func (r *hoopaGuardRuntime) serveEntry(ln net.Listener, name string, store auth.AuthStore) {
+	defer r.accept.Done()
+	for {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		r.mu.Lock()
+		if r.state != "running" {
+			r.mu.Unlock()
+			c.Close()
+			continue
+		}
+		r.conns[c] = true
+		r.workers.Add(1)
+		r.mu.Unlock()
+		go func() {
+			defer r.workers.Done()
+			defer func() { c.Close(); r.mu.Lock(); delete(r.conns, c); r.mu.Unlock() }()
+			mixed.HandleHoopaConn(c, tunnel.Tunnel, store, inbound.WithInName(name), inbound.WithSpecialRules(""), inbound.WithSpecialProxy(""))
+		}()
+	}
+}
+
+func (r *hoopaGuardRuntime) drain() bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.state == "draining" {
+		return true
+	}
+	if r.state != "running" {
+		return false
+	}
+	r.state = "draining"
+	for _, ln := range r.entries {
+		if err := ln.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+			r.state = "degraded"
+		}
+	}
+	return r.state == "draining"
+}
+func (r *hoopaGuardRuntime) stop() {
+	for _, f := range r.reserved {
+		_ = f.Close()
+	}
+	r.mu.Lock()
+	r.state = "stopped"
+	for _, ln := range r.entries {
+		_ = ln.Close()
+	}
+	r.mu.Unlock()
+	r.accept.Wait()
+	if r.server != nil {
+		_ = r.server.Close()
+	} else if r.controller != nil {
+		_ = r.controller.Close()
+	}
+	r.mu.Lock()
+	for c := range r.conns {
+		_ = c.Close()
+	}
+	r.mu.Unlock()
+	// Source shutdown after known handlers settle; a bounded incomplete shutdown
+	// still becomes pending/gap via the existing source rules, never a fake final.
+	done := make(chan struct{})
+	go func() { r.workers.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+	}
+}
+func (r *hoopaGuardRuntime) ServeHTTP(w http.ResponseWriter, q *http.Request) {
+	host, _, err := net.SplitHostPort(q.RemoteAddr)
+	headers := q.Header.Values("Authorization")
+	if err != nil || host != "127.0.0.1" || len(headers) != 1 || subtle.ConstantTimeCompare([]byte(headers[0]), []byte("Bearer "+r.secret)) != 1 {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	known := q.Method == "GET" && q.URL.Path == "/hoopa/status" || q.Method == "POST" && q.URL.Path == "/hoopa/drain"
+	if known && (q.URL.RawQuery != "" || q.ContentLength != 0 || len(q.TransferEncoding) != 0) {
+		http.Error(w, "invalid request", 400)
+		return
+	}
+	switch {
+	case q.Method == "GET" && q.URL.Path == "/hoopa/status":
+		r.mu.Lock()
+		result := struct {
+			Schema           int    `json:"schema_version"`
+			Generation       string `json:"config_generation"`
+			Hash             string `json:"config_sha256"`
+			State            string `json:"state"`
+			IdentityInstance bool   `json:"identity_instance"`
+			IdentityName     bool   `json:"identity_name"`
+			IdentityPath     bool   `json:"identity_path"`
+			Connections      int    `json:"accepted_tcp_connections"`
+		}{Schema: 1, Generation: r.generation, Hash: r.hash, State: r.state, Connections: len(r.conns)}
+		r.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(result)
+	case q.Method == "POST" && q.URL.Path == "/hoopa/drain":
+		if !r.drain() {
+			http.Error(w, "drain incomplete", 503)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, "{\"state\":\"draining\"}\n")
+	default:
+		http.Error(w, "full replace required", http.StatusConflict)
+	}
+}
