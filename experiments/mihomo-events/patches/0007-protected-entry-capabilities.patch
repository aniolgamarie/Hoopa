+++ b/component/hoopatrace/guard_linux_test.go
@@ -0,0 +1,39 @@
+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"os"
+	"testing"
+)
+
+func TestSourceGuardRejectsReadOnlyCapacity(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 32; i++ {
+		s, err := openSource(dir, "gen:guard", "", "", defaultLimit)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := guardReady(s, "gen:guard"); err != nil {
+			t.Fatal("fresh writable source rejected", i, err)
+		}
+		if err := s.shutdown(); err != nil {
+			t.Fatal(err)
+		}
+		s.close()
+	}
+	s, err := openSource(dir, "gen:guard", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.close()
+	if !s.readOnly {
+		t.Fatal("fixture did not reach actual epoch capacity")
+	}
+	if guardReady(s, "gen:guard") == nil {
+		t.Fatal("read-only replay source admitted protected ingress")
+	}
+}
