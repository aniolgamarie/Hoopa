+					copy[k] = v
+				}
+			}
+			original := f[tc.index][tc.key]
+			f[tc.index][tc.key], _ = json.Marshal([]map[string]json.RawMessage{copy})
+			requireInvalidSource(t, encodeCounterFields(t, f[tc.index]))
+			f[tc.index][tc.key] = original
