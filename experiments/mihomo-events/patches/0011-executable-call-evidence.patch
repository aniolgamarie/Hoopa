+	check = func(raw []byte, wrap func([]byte) []byte) {
+		fields, ok := object(raw)
+		if !ok {
+			return
+		}
+		for key, value := range fields {
+			copy := wireFields{}
+			for k, v := range fields {
+				copy[k] = v
+			}
