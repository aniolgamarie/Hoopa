+func TestConnectorV4PathsAndIntegerBoundaries(t *testing.T) {
+	for _, path := range [][]byte{[]byte("/bin/程序 (deleted)"), []byte("/" + strings.Repeat("a", 254)), {'/', 0xff, '/', 'o', 'k'}, {'/', 'x', '/', 0xff}} {
