@@ -0,0 +1,69 @@
+package hoopaid
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"strconv"
+	"unicode/utf8"
+)
+
+// Executable is an immutable value snapshot of the executable observed during a
+// connect call. It does not authenticate identity or enable process rules.
+type Executable struct {
+	Schema               string `json:"schema"`
+	Status               string `json:"status"`
+	Source               string `json:"source"`
+	NameSource           string `json:"name_source"`
+	CallToken            string `json:"call_token"`
+	ObservedBootNS       string `json:"observed_boot_ns"`
+	PathRawHex           string `json:"path_raw_hex"`
+	PathText             string `json:"path_text"`
+	PathTextValid        bool   `json:"path_text_valid"`
+	ProgramNameRawHex    string `json:"program_name_raw_hex"`
+	ProgramName          string `json:"program_name"`
+	ProgramNameTextValid bool   `json:"program_name_text_valid"`
+	RawRecord            string `json:"raw_record"`
+}
+
+func executableIdentity(raw []byte, id Identity) (Executable, error) {
+	invalid := func() (Executable, error) {
+		return Executable{}, errors.New("invalid executable ABI/connector binding")
+	}
+	if len(raw) != 296 {
+		return invalid()
+	}
+	cookie, err := u64(id.ClientCookie)
+	if err != nil {
+		return invalid()
+	}
+	start, err := u64(id.LeaderStartBoottimeNS)
+	if err != nil {
+		return invalid()
+	}
+	end, err := u64(id.ObservedBootNS)
+	if err != nil {
+		return invalid()
+	}
+	observed, token := le.Uint64(raw[24:]), le.Uint64(raw[32:])
+	n := le.Uint32(raw[16:])
+	if cookie == 0 || id.TGID == 0 || id.CallerTID == 0 || start == 0 || observed == 0 || token == 0 || le.Uint64(raw) != cookie || le.Uint32(raw[8:]) != id.TGID || le.Uint32(raw[12:]) != id.CallerTID || le.Uint32(raw[20:]) != 1 || observed < start || observed > end || n < 2 || n > 256 {
+		return invalid()
+	}
+	path := raw[40 : 40+int(n)-1]
+	if path[0] != '/' || raw[40+int(n)-1] != 0 || bytes.IndexByte(path, 0) >= 0 {
+		return invalid()
+	}
+	name := path[bytes.LastIndexByte(path, '/')+1:]
+	if len(name) == 0 {
+		return invalid()
+	}
+	out := Executable{Schema: "sourceidentity-executable-call-v1", Status: "unverified", Source: "task_exe_file_d_path_v1", NameSource: "executable_path_basename_v1", CallToken: strconv.FormatUint(token, 10), ObservedBootNS: strconv.FormatUint(observed, 10), PathRawHex: hex.EncodeToString(path), PathTextValid: utf8.Valid(path), ProgramNameRawHex: hex.EncodeToString(name), ProgramNameTextValid: utf8.Valid(name), RawRecord: hex.EncodeToString(raw)}
+	if out.PathTextValid {
+		out.PathText = string(path)
+	}
+	if out.ProgramNameTextValid {
+		out.ProgramName = string(name)
+	}
+	return out, nil
+}
diff --git a/component/hoopaid/executable_native_linux_amd64.go b/component/hoopaid/executable_native_linux_amd64.go
new file mode 100644
--- /dev/null
+++ b/component/hoopaid/executable_native_linux_amd64.go
@@ -0,0 +1,81 @@
+//go:build linux && amd64
+
+package hoopaid
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+func (b *nativeBackend) linkTarget(fd int) ([]byte, string, error) {
+	first, err := b.info(fd)
+	if err != nil || len(first) < 28 {
+		return nil, "", errors.Join(err, errors.New("short link info"))
+	}
+	if le.Uint32(first) != 1 {
+		return first, "", nil
+	}
+	name := make([]byte, 32)
+	unpin := pinBuffers(name)
+	defer unpin()
+	buf := make([]byte, 256)
+	le.PutUint64(buf[16:], ptr(name))
+	le.PutUint32(buf[24:], uint32(len(name)))
+	second, err := b.readInfo(fd, buf)
+	runtime.KeepAlive(name)
+	if err != nil {
+		return nil, "", err
+	}
+	if len(second) < 28 || !bytes.Equal(first[:12], second[:12]) {
+		return nil, "", errors.New("raw tracepoint link changed")
+	}
+	n := le.Uint32(second[24:])
+	if n < 2 || n > uint32(len(name)) || name[n-1] != 0 || bytes.IndexByte(name[:n-1], 0) >= 0 {
+		return nil, "", errors.New("raw tracepoint target string")
+	}
+	return second, string(name[:n-1]), nil
+}
+
+// Resolve the actual program target BTF object, rather than equating unrelated
+// function IDs. Only this fixed vmlinux byte stream is accepted by the prototype.
+func (b *nativeBackend) targetBTF(id uint32) (result error) {
+	attr := make([]byte, 12)
+	le.PutUint32(attr, id)
+	fd, _, errno := syscall.Syscall(321, 19, uintptr(unsafe.Pointer(&attr[0])), uintptr(len(attr)))
+	runtime.KeepAlive(attr)
+	if errno != 0 {
+		return errno
+	}
+	defer func() { result = errors.Join(result, syscall.Close(int(fd))) }()
+	first, err := b.info(int(fd))
+	if err != nil {
+		return err
+	}
+	if len(first) < 32 || le.Uint32(first[8:]) != executableBTFSize || le.Uint32(first[12:]) != id || le.Uint32(first[28:]) != 1 {
+		return errors.New("target BTF declaration mismatch")
+	}
+	raw := make([]byte, executableBTFSize)
+	name := make([]byte, 32)
+	unpin := pinBuffers(raw, name)
+	defer unpin()
+	info := make([]byte, 256)
+	le.PutUint64(info, ptr(raw))
+	le.PutUint32(info[8:], uint32(len(raw)))
+	le.PutUint64(info[16:], ptr(name))
+	le.PutUint32(info[24:], uint32(len(name)))
+	second, err := b.readInfo(int(fd), info)
+	runtime.KeepAlive(raw)
+	runtime.KeepAlive(name)
+	if err != nil {
+		return err
+	}
+	if len(second) < 32 || le.Uint32(second[8:]) != executableBTFSize || le.Uint32(second[12:]) != id || le.Uint32(second[28:]) != 1 || !bytes.Equal(name[:8], []byte("vmlinux\x00")) || fmt.Sprintf("%x", sha256.Sum256(raw)) != executableBTFSHA256 {
+		return errors.New("target BTF content mismatch")
+	}
+	return nil
+}
