+func rewriteClosureFrame(t *testing.T, name string, change func(map[string]json.RawMessage) []byte) {
+	t.Helper()
+	raw, err := os.ReadFile(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := binary.BigEndian.Uint32(raw[:4])
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw[4:4+n], &fields) != nil {
+		t.Fatal("fixture")
+	}
+	payload := change(fields)
+	frame := make([]byte, 4+len(payload)+sha256.Size)
+	binary.BigEndian.PutUint32(frame, uint32(len(payload)))
+	copy(frame[4:], payload)
+	sum := sha256.Sum256(payload)
+	copy(frame[4+len(payload):], sum[:])
+	frame = append(frame, raw[4+int(n)+sha256.Size:]...)
+	if err = os.WriteFile(name, frame, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestHoopaReopenRejectsStrictFrameViolations(t *testing.T) {
+	for _, kind := range []string{"duplicate", "generation", "instance", "unknown_field", "orphan_closed", "checksum"} {
+		t.Run(kind, func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			newClosureFlow(t, s)
+			dir, name := s.root.Name(), s.file.Name()
+			s.close()
+			if kind == "checksum" {
+				raw, _ := os.ReadFile(name)
+				raw[len(raw)-1] ^= 1
+				os.WriteFile(name, raw, 0600)
+			} else {
+				rewriteClosureFrame(t, name, func(f map[string]json.RawMessage) []byte {
+					switch kind {
+					case "generation":
+						f["config_generation"] = json.RawMessage(`"other"`)
+					case "instance":
+						f["source_instance_id"] = json.RawMessage(`"other"`)
+					case "unknown_field":
+						f["secret"] = json.RawMessage(`"private"`)
+					case "orphan_closed":
+						for _, k := range []string{"process", "source_addr", "entry_addr", "target_kind", "target", "identity_scope"} {
+							delete(f, k)
+						}
+						f["kind"] = json.RawMessage(`"closed"`)
+						f["upload_bytes"] = json.RawMessage(`"0"`)
+						f["download_bytes"] = json.RawMessage(`"0"`)
+					}
+					raw, _ := json.Marshal(f)
+					if kind == "duplicate" {
+						raw = append(raw[:len(raw)-1], []byte(`,"source\u005fseq":"1"}`)...)
+					}
+					return raw
+				})
+			}
+			before, _ := os.ReadFile(name)
+			next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+			if err == nil {
+				next.close()
+				t.Fatal("invalid strict frame admitted")
+			}
+			after, _ := os.ReadFile(name)
+			if !bytes.Equal(before, after) {
+				t.Fatal("bad evidence repaired")
+			}
+		})
+	}
+}
+func TestHoopaReplayMutationDisablesNewRecording(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	f := newClosureFlow(t, s)
+	f.Close()
+	dir, oldName := s.root.Name(), s.file.Name()
+	s.close()
+	next, err := openSource(dir, "next-generation", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer next.close()
+	active := newClosureFlow(t, next)
+	rewriteClosureFrame(t, oldName, func(f map[string]json.RawMessage) []byte {
+		f["target"] = json.RawMessage(`"changed.test"`)
+		b, _ := json.Marshal(f)
+		return b
+	})
+	if _, err = next.sendSnapshots(); err == nil || !next.poisoned || !next.readOnly {
+		t.Fatal("changed old snapshot sent")
+	}
+	if _, err = next.begin(testPeer(), testEntry(), "example.test", "", time.Now()); err == nil {
+		t.Fatal("recording admitted after old snapshot mutation")
+	}
+	active.AddDownload(5)
+	if active.down != 5 {
+		t.Fatal("recording failure changed existing flow data path")
+	}
+	for _, r := range next.recoveryReports() {
+		if r.RecordingStatus != "unavailable" {
+			t.Fatal("current recording failure hidden")
+		}
+	}
+}
