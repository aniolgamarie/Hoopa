diff --git a/component/hoopatrace/telemetrywire/counter_event.go b/component/hoopatrace/telemetrywire/counter_event.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/counter_event.go
@@ -0,0 +1,155 @@
+// Package telemetrywire decodes candidate experimental counter frames. Parsing a
+// frame does not establish an event source, delivery guarantee or capability gate.
+package telemetrywire
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const counterInputLimit = 64 * 1024
+
+type CounterKind string
+
+const (
+	BytesCheckpoint CounterKind = "bytes_checkpoint"
+	Closed          CounterKind = "closed"
+)
+
+// ErrInvalidCounterEvent intentionally contains no input values or raw parser
+// errors, which could disclose private frame content.
+var ErrInvalidCounterEvent = errors.New("invalid candidate counter event")
+
+type CounterEvent struct {
+	SchemaVersion    uint8       `json:"schema_version"`
+	SourceInstanceID string      `json:"source_instance_id"`
+	SourceEpoch      string      `json:"source_epoch"`
+	EventID          string      `json:"event_id"`
+	SourceSeq        uint64      `json:"source_seq,string"`
+	FlowID           string      `json:"flow_id"`
+	AttemptID        string      `json:"attempt_id"`
+	ObservedAt       time.Time   `json:"observed_at"`
+	ConfigGeneration string      `json:"config_generation"`
+	BoundaryRef      string      `json:"boundary_ref"`
+	Kind             CounterKind `json:"kind"`
+	UploadBytes      uint64      `json:"upload_bytes,string"`
+	DownloadBytes    uint64      `json:"download_bytes,string"`
+}
+
+func knownCounterField(name string) bool {
+	switch name {
+	case "schema_version", "source_instance_id", "source_epoch", "event_id", "source_seq", "flow_id", "attempt_id", "observed_at", "config_generation", "boundary_ref", "kind", "upload_bytes", "download_bytes":
+		return true
+	default:
+		return false
+	}
+}
+
+// DecodeCounterEvent accepts only the candidate v1 flat wire profile. Version is
+// the literal JSON number token 1, sequence/counts are canonical decimal strings,
+// and observed_at must retain UTC Z syntax. No numeric value passes through float64.
+func DecodeCounterEvent(raw []byte) (CounterEvent, error) {
+	invalid := func() (CounterEvent, error) { return CounterEvent{}, ErrInvalidCounterEvent }
+	if len(raw) == 0 || len(raw) > counterInputLimit || !utf8.Valid(raw) {
+		return invalid()
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return invalid()
+	}
+	fields := make(map[string]json.RawMessage, 13)
+	for decoder.More() {
+		token, err := decoder.Token()
+		if err != nil {
+			return invalid()
+		}
+		name, ok := token.(string)
+		if !ok || !knownCounterField(name) {
+			return invalid()
+		}
+		// Token has already unescaped the name, so escaped duplicates also collide.
+		if _, exists := fields[name]; exists {
+			return invalid()
+		}
+		var value json.RawMessage
+		if err := decoder.Decode(&value); err != nil {
+			return invalid()
+		}
+		fields[name] = value
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') || len(fields) != 13 {
+		return invalid()
+	}
+	var trailing json.RawMessage
+	if decoder.Decode(&trailing) != io.EOF {
+		return invalid()
+	}
+	if !bytes.Equal(bytes.TrimSpace(fields["schema_version"]), []byte("1")) {
+		return invalid()
+	}
+	values := make(map[string]string, 12)
+	for name, value := range fields {
+		if name == "schema_version" {
+			continue
+		}
+		value = bytes.TrimSpace(value)
+		if len(value) == 0 || value[0] != '"' {
+			return invalid()
+		}
+		var text string
+		if err := json.Unmarshal(value, &text); err != nil {
+			return invalid()
+		}
+		values[name] = text
+	}
+	var instance, epoch, event, flow, attempt, generation string
+	for _, id := range []struct {
+		name   string
+		target *string
+	}{
+		{"source_instance_id", &instance}, {"source_epoch", &epoch}, {"event_id", &event}, {"flow_id", &flow}, {"attempt_id", &attempt}, {"config_generation", &generation},
+	} {
+		parsed, err := parseID(values[id.name])
+		if err != nil {
+			return invalid()
+		}
+		*id.target = parsed
+	}
+	seq, err := parseBytes(values["source_seq"])
+	if err != nil || seq == 0 {
+		return invalid()
+	}
+	upload, err := parseBytes(values["upload_bytes"])
+	if err != nil {
+		return invalid()
+	}
+	download, err := parseBytes(values["download_bytes"])
+	if err != nil {
+		return invalid()
+	}
+	if !strings.HasSuffix(values["observed_at"], "Z") {
+		return invalid()
+	}
+	observed, err := parseTimestamp(values["observed_at"])
+	if err != nil {
+		return invalid()
+	}
+	if values["boundary_ref"] != "mihomo_proxy_stream_v1" {
+		return invalid()
+	}
+	kind := CounterKind(values["kind"])
+	if kind != BytesCheckpoint && kind != Closed {
+		return invalid()
+	}
+	return CounterEvent{
+		SchemaVersion: 1, SourceInstanceID: instance, SourceEpoch: string(epoch), EventID: event, SourceSeq: uint64(seq), FlowID: flow, AttemptID: attempt, ObservedAt: observed, ConfigGeneration: string(generation), BoundaryRef: values["boundary_ref"], Kind: kind, UploadBytes: upload, DownloadBytes: download,
+	}, nil
+}
diff --git a/component/hoopatrace/telemetrywire/manifest.go b/component/hoopatrace/telemetrywire/manifest.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/manifest.go
@@ -0,0 +1,68 @@
+package telemetrywire
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"unicode/utf8"
+)
+
+var ErrInvalidManifest = errors.New("invalid source manifest")
+
+// Manifest is the existing bounded P0 profile. Decode checks the identity
+// digest, not whether the historical binary or process still exists.
+type Manifest struct {
+	SourceEpoch, SourceInstanceID, ConfigGeneration string
+	SHA256                                          string
+	MaxSourceBytes                                  uint64
+	Raw                                             json.RawMessage
+}
+
+func hexBytes(s string, n int) bool {
+	b, err := hex.DecodeString(s)
+	return err == nil && len(b) == n && hex.EncodeToString(b) == s
+}
+
+func DecodeManifest(raw []byte) (Manifest, error) {
+	bad := func() (Manifest, error) { return Manifest{}, ErrInvalidManifest }
+	f, ok := object(raw)
+	if !ok || len(raw) > 8192 || !utf8.Valid(raw) || !exactFields(f, "schema_version source_epoch binary_path binary_sha256 boot_id pid start_ticks nonce config_generation max_source_bytes max_frame_bytes max_active_flows reclamation scope") || strings.TrimSpace(string(f["schema_version"])) != "1" {
+		return bad()
+	}
+	epoch, ok := id(f["source_epoch"])
+	if !ok || !strings.HasPrefix(epoch, "epoch:") || !hexBytes(strings.TrimPrefix(epoch, "epoch:"), 32) {
+		return bad()
+	}
+	exe, a := scalarText(f["binary_path"])
+	binaryHash, b := scalarText(f["binary_sha256"])
+	boot, c := scalarText(f["boot_id"])
+	nonce, d := scalarText(f["nonce"])
+	start, e := scalarText(f["start_ticks"])
+	generation, g := id(f["config_generation"])
+	pid, h := decimal(f["pid"], false, true)
+	if !a || !b || !c || !d || !e || !g || !h || !filepath.IsAbs(exe) || !hexBytes(binaryHash, 32) || !hexBytes(nonce, 16) || pid > 1<<31-1 {
+		return bad()
+	}
+	if len(boot) != 36 || boot[8] != '-' || boot[13] != '-' || boot[18] != '-' || boot[23] != '-' || !hexBytes(strings.ReplaceAll(boot, "-", ""), 16) {
+		return bad()
+	}
+	if _, err := parseBytes(start); err != nil {
+		return bad()
+	}
+	limit, ok := decimal(f["max_source_bytes"], false, true)
+	frame, frameOK := decimal(f["max_frame_bytes"], false, true)
+	active, activeOK := decimal(f["max_active_flows"], false, true)
+	if !ok || limit < 20*(8192+36) || limit > 8*1024*1024 || !frameOK || frame != 8192 || !activeOK || active != MaxActiveFlows || !literal(f, "reclamation", "not_implemented_bounded_stop") || !literal(f, "scope", "linux_amd64_tcp_same_uid_netns_ipv4_loopback") {
+		return bad()
+	}
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%s|%s|%s|%d|%s|%s", exe, binaryHash, boot, pid, start, nonce)))
+	if epoch != "epoch:"+hex.EncodeToString(digest[:]) {
+		return bad()
+	}
+	sum := sha256.Sum256(raw)
+	return Manifest{SourceEpoch: epoch, SourceInstanceID: "source:" + strings.TrimPrefix(epoch, "epoch:"), ConfigGeneration: generation, SHA256: hex.EncodeToString(sum[:]), MaxSourceBytes: limit, Raw: append(json.RawMessage(nil), raw...)}, nil
+}
diff --git a/component/hoopatrace/telemetrywire/recovery.go b/component/hoopatrace/telemetrywire/recovery.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/recovery.go
@@ -0,0 +1,122 @@
+package telemetrywire
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+)
+
+var ErrInvalidRecovery = errors.New("source recovery evidence invalid")
+
+// WriterEndEvidence is supplied only by an explicit recovery/start adapter
+// after taking the source writer lock and validating a full stable snapshot.
+// This pure package cannot acquire a lock or prove an OS/network process ended.
+type WriterEndEvidence struct {
+	Kind           string `json:"kind"`
+	SourceEpoch    string `json:"source_epoch"`
+	ManifestSHA256 string `json:"manifest_sha256"`
+	FramesSHA256   string `json:"frames_sha256"`
+	ObservedAt     string `json:"observed_at"`
+}
+
+type RecoveryCounter struct {
+	EventID       string `json:"event_id"`
+	SourceSeq     uint64 `json:"source_seq,string"`
+	UploadBytes   uint64 `json:"upload_bytes,string"`
+	DownloadBytes uint64 `json:"download_bytes,string"`
+}
+
+type RecoveryFlow struct {
+	FlowID           string           `json:"flow_id"`
+	OpenedEventID    string           `json:"opened_event_id"`
+	State            string           `json:"state"`
+	Reason           string           `json:"reason"`
+	LastCheckpoint   *RecoveryCounter `json:"last_trusted_checkpoint"`
+	Final            *RecoveryCounter `json:"final"`
+	TailBytes        *uint64          `json:"tail_bytes"`
+	GapDimensions    []string         `json:"gap_dimensions"`
+	ReconciliationID string           `json:"reconciliation_id,omitempty"`
+	FactSHA256       string           `json:"fact_sha256,omitempty"`
+}
+
+type RecoveryReport struct {
+	Scope            string             `json:"scope"`
+	SourceEpoch      string             `json:"source_epoch"`
+	SourceInstanceID string             `json:"source_instance_id"`
+	ConfigGeneration string             `json:"config_generation"`
+	ManifestSHA256   string             `json:"manifest_sha256"`
+	FramesSHA256     string             `json:"frames_sha256"`
+	LastSourceSeq    uint64             `json:"last_source_seq,string"`
+	EpochFinality    string             `json:"epoch_finality"`
+	ScanStatus       string             `json:"scan_status"`
+	HistoryQuality   string             `json:"history_quality"`
+	RecordingStatus  string             `json:"recording_status"`
+	WriterEnd        *WriterEndEvidence `json:"writer_end_evidence"`
+	Flows            []RecoveryFlow     `json:"flows"`
+}
+
+func recoveryCounter(c *CounterEvent) *RecoveryCounter {
+	if c == nil {
+		return nil
+	}
+	return &RecoveryCounter{c.EventID, c.SourceSeq, c.UploadBytes, c.DownloadBytes}
+}
+
+// ProjectRecovery consumes a validated State.Snapshot and a paired manifest.
+// A read-only adapter passes nil evidence and never seals a missing final.
+// Reports are derived data: no source/receipt position or byte fact is created.
+func ProjectRecovery(m Manifest, life Lifecycle, framesHash string, ended *WriterEndEvidence) (RecoveryReport, error) {
+	bad := func() (RecoveryReport, error) { return RecoveryReport{}, ErrInvalidRecovery }
+	validated, err := DecodeManifest(m.Raw)
+	if err != nil || validated.SHA256 != m.SHA256 || !hexBytes(framesHash, 32) {
+		return bad()
+	}
+	m = validated
+	if life.LastSourceSeq != 0 && (life.SourceEpoch != m.SourceEpoch || life.SourceInstanceID != m.SourceInstanceID || life.ConfigGeneration != m.ConfigGeneration) {
+		return bad()
+	}
+	if ended != nil {
+		if ended.Kind != "exclusive_writer_full_scan" || ended.SourceEpoch != m.SourceEpoch || ended.ManifestSHA256 != m.SHA256 || ended.FramesSHA256 != framesHash {
+			return bad()
+		}
+		if _, err := parseTimestamp(ended.ObservedAt); err != nil {
+			return bad()
+		}
+	}
+	r := RecoveryReport{Scope: "P0_derived_source_lifecycle_only", SourceEpoch: m.SourceEpoch, SourceInstanceID: m.SourceInstanceID, ConfigGeneration: m.ConfigGeneration, ManifestSHA256: m.SHA256, FramesSHA256: framesHash, LastSourceSeq: life.LastSourceSeq, EpochFinality: life.EpochFinality, ScanStatus: "validated", HistoryQuality: "no_missing_final", RecordingStatus: "unverified", Flows: []RecoveryFlow{}}
+	if ended != nil {
+		copy := *ended
+		r.WriterEnd = &copy
+	}
+	for _, f := range life.Flows {
+		out := RecoveryFlow{FlowID: f.FlowID, OpenedEventID: f.OpenedEventID, State: f.State, Reason: f.Reason, LastCheckpoint: recoveryCounter(f.LastCheckpoint), Final: recoveryCounter(f.Final), GapDimensions: append([]string{}, f.GapDimensions...)}
+		if f.TailBytes != nil {
+			copy := *f.TailBytes
+			out.TailBytes = &copy
+		}
+		if f.State == "pending" && ended != nil {
+			out.State, out.Reason, out.TailBytes = "gap", "epoch_ended_without_final", nil
+			out.GapDimensions = []string{"bytes", "route_or_setup", "window_checkpoints"}
+			key, _ := json.Marshal([]string{"hoopa_missing_final_v1", m.SourceInstanceID, m.SourceEpoch, f.FlowID, f.OpenedEventID, out.Reason})
+			sum := sha256.Sum256(key)
+			out.ReconciliationID = "reconciliation:" + hex.EncodeToString(sum[:])
+			// Run timestamps and scan cutoffs are observations, not fact content.
+			payload, _ := json.Marshal(struct {
+				ID         string
+				Checkpoint *RecoveryCounter
+				Boundary   string
+				Tail       *uint64
+			}{out.ReconciliationID, out.LastCheckpoint, "mihomo_proxy_stream_v1", nil})
+			fact := sha256.Sum256(payload)
+			out.FactSHA256 = hex.EncodeToString(fact[:])
+		}
+		if out.State == "gap" || len(out.GapDimensions) != 0 {
+			r.HistoryQuality = "gap"
+		} else if out.State == "pending" && r.HistoryQuality != "gap" {
+			r.HistoryQuality = "pending"
+		}
+		r.Flows = append(r.Flows, out)
+	}
+	return r, nil
+}
diff --git a/component/hoopatrace/telemetrywire/scalars.go b/component/hoopatrace/telemetrywire/scalars.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/scalars.go
@@ -0,0 +1,41 @@
+package telemetrywire
+
+import (
+	"errors"
+	"regexp"
+	"strconv"
+	"time"
+)
+
+func parseID(s string) (string, error) {
+	if len(s) == 0 || len(s) > 128 {
+		return "", errors.New("invalid ID")
+	}
+	for i, c := range []byte(s) {
+		alnum := c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9'
+		if !alnum && (i == 0 || c != '.' && c != '_' && c != ':' && c != '-') {
+			return "", errors.New("invalid ID")
+		}
+	}
+	return s, nil
+}
+func parseBytes(s string) (uint64, error) {
+	if s == "" || len(s) > 1 && s[0] == '0' {
+		return 0, errors.New("invalid decimal")
+	}
+	for _, c := range []byte(s) {
+		if c < '0' || c > '9' {
+			return 0, errors.New("invalid decimal")
+		}
+	}
+	return strconv.ParseUint(s, 10, 64)
+}
+
+var timestampForm = regexp.MustCompile(`^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?Z$`)
+
+func parseTimestamp(s string) (time.Time, error) {
+	if !timestampForm.MatchString(s) {
+		return time.Time{}, errors.New("invalid UTC timestamp")
+	}
+	return time.Parse(time.RFC3339Nano, s)
+}
diff --git a/component/hoopatrace/telemetrywire/source_event.go b/component/hoopatrace/telemetrywire/source_event.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/source_event.go
@@ -0,0 +1,374 @@
+package telemetrywire
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/netip"
+	"strings"
+	"unicode/utf8"
+)
+
+const SourceInputLimit = 8192
+
+var ErrInvalidSourceEvent = errors.New("invalid experimental source event")
+
+// SourceEvent is the frozen experimental wire profile, not proof of identity,
+// ready timing or a capability gate. Raw retains the original bytes for replay.
+// Null flow/attempt are allowed only on the source-scoped epoch_closed marker.
+type SourceEvent struct {
+	SourceInstanceID  string
+	SourceEpoch       string
+	EventID           string
+	SourceSeq         uint64
+	FlowID, AttemptID string
+	ConfigGeneration  string
+	Kind              string
+	Counter           *CounterEvent
+	Raw               json.RawMessage
+	Phase             string
+	GapReason         string
+	GapDimensions     []string
+	UnfinishedFlows   uint64
+	EpochFinality     string
+}
+
+type wireFields map[string]json.RawMessage
+
+// object rejects duplicate decoded names, including escaped aliases. Values
+// stay RawMessage: no integer ever passes through float64.
+func object(raw []byte) (wireFields, bool) {
+	d := json.NewDecoder(bytes.NewReader(raw))
+	t, err := d.Token()
+	if err != nil || t != json.Delim('{') {
+		return nil, false
+	}
+	f := wireFields{}
+	for d.More() {
+		t, err := d.Token()
+		if err != nil {
+			return nil, false
+		}
+		k, ok := t.(string)
+		if !ok {
+			return nil, false
+		}
+		if _, exists := f[k]; exists {
+			return nil, false
+		}
+		var v json.RawMessage
+		if d.Decode(&v) != nil {
+			return nil, false
+		}
+		f[k] = v
+	}
+	t, err = d.Token()
+	if err != nil || t != json.Delim('}') {
+		return nil, false
+	}
+	var tail json.RawMessage
+	return f, d.Decode(&tail) == io.EOF
+}
+
+func exactFields(f wireFields, names string) bool {
+	keys := strings.Fields(names)
+	if len(f) != len(keys) {
+		return false
+	}
+	for _, k := range keys {
+		if _, ok := f[k]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func scalarText(raw []byte) (string, bool) {
+	var s string
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || raw[0] != '"' || json.Unmarshal(raw, &s) != nil || len(s) > 4096 || strings.ContainsRune(s, 0) {
+		return "", false
+	}
+	return s, true
+}
+
+func literal(f wireFields, key, want string) bool {
+	s, ok := scalarText(f[key])
+	return ok && s == want
+}
+func null(raw []byte) bool { return bytes.Equal(bytes.TrimSpace(raw), []byte("null")) }
+func decimal(raw []byte, quoted bool, nonzero bool) (uint64, bool) {
+	s := string(bytes.TrimSpace(raw))
+	if quoted {
+		var ok bool
+		s, ok = scalarText(raw)
+		if !ok {
+			return 0, false
+		}
+	}
+	v, err := parseBytes(s)
+	return uint64(v), err == nil && (!nonzero || v != 0)
+}
+func id(raw []byte) (string, bool) {
+	s, ok := scalarText(raw)
+	v, err := parseID(s)
+	return v, ok && err == nil
+}
+func stringsArray(raw []byte, nonempty bool) ([]string, bool) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || raw[0] != '[' {
+		return nil, false
+	}
+	var items []json.RawMessage
+	if json.Unmarshal(raw, &items) != nil || len(items) > 64 || nonempty && len(items) == 0 {
+		return nil, false
+	}
+	out := make([]string, 0, len(items))
+	for _, raw := range items {
+		s, ok := scalarText(raw)
+		if !ok {
+			return nil, false
+		}
+		out = append(out, s)
+	}
+	return out, true
+}
+
+func processValid(raw []byte) bool {
+	p, ok := object(raw)
+	if !ok {
+		return false
+	}
+	if literal(p, "status", "unknown") {
+		r, ok := id(p["reason"])
+		return exactFields(p, "status reason") && ok && r != ""
+	}
+	if !exactFields(p, "status pid name name_source start_ticks boot_id pid_namespace network_namespace socket_inode path") || !literal(p, "status", "identified") || !literal(p, "name_source", "linux_proc_comm") {
+		return false
+	}
+	pid, ok := decimal(p["pid"], false, true)
+	if !ok || pid > 1<<31-1 {
+		return false
+	}
+	if _, ok := decimal(p["start_ticks"], true, false); !ok {
+		return false
+	}
+	if _, ok := decimal(p["socket_inode"], true, true); !ok {
+		return false
+	}
+	for _, k := range []string{"name", "path", "boot_id"} {
+		if s, ok := scalarText(p[k]); !ok || s == "" {
+			return false
+		}
+	}
+	for _, pair := range []struct{ key, prefix string }{{"pid_namespace", "pid:["}, {"network_namespace", "net:["}} {
+		s, ok := scalarText(p[pair.key])
+		if !ok || !strings.HasPrefix(s, pair.prefix) || !strings.HasSuffix(s, "]") {
+			return false
+		}
+		n := strings.TrimSuffix(strings.TrimPrefix(s, pair.prefix), "]")
+		v, err := parseBytes(n)
+		if err != nil || v == 0 {
+			return false
+		}
+	}
+	return true
+}
+
+const commonFields = "schema_version source_instance_id source_epoch event_id source_seq flow_id attempt_id observed_at config_generation boundary_ref kind"
+
+func kindValid(f wireFields, kind string) bool {
+	switch kind {
+	case "opened":
+		if !exactFields(f, commonFields+" process source_addr entry_addr target_kind target identity_scope") || !processValid(f["process"]) || !literal(f, "identity_scope", "same_uid_netns_ipv4_loopback_held_socket;fd_transfer_unverified") {
+			return false
+		}
+		for _, k := range []string{"source_addr", "entry_addr"} {
+			s, ok := scalarText(f[k])
+			if !ok {
+				return false
+			}
+			if _, err := netip.ParseAddrPort(s); err != nil {
+				return false
+			}
+		}
+		target, ok := scalarText(f["target"])
+		if !ok {
+			return false
+		}
+		if literal(f, "target_kind", "unknown") {
+			return target == ""
+		}
+		if literal(f, "target_kind", "ip_only") {
+			_, err := netip.ParseAddr(target)
+			return err == nil
+		}
+		return literal(f, "target_kind", "host") && target != ""
+	case "route_decided":
+		if _, exists := f["phase"]; exists {
+			_, ok := id(f["connection_id"])
+			return exactFields(f, commonFields+" phase connection_id") && literal(f, "phase", "connection_binding") && ok
+		}
+		if !exactFields(f, commonFields+" rule rule_payload logical_target process") || !processValid(f["process"]) {
+			return false
+		}
+		for _, k := range []string{"rule", "rule_payload", "logical_target"} {
+			if _, ok := scalarText(f[k]); !ok {
+				return false
+			}
+		}
+		return true
+	case "setup_finished":
+		if !exactFields(f, commonFields+" definition duration_ms waited_ms flow_duration_ms flow_waited_ms flow_definition outcome failure_stage ordered_chain provider_chain route_evidence protocol_ready_validation") || !literal(f, "definition", "attempt_dial_handshake_v1_candidate") || !literal(f, "flow_definition", "request_known_to_ready_v1_candidate") || !literal(f, "route_evidence", "returned_conn_only") || !literal(f, "protocol_ready_validation", "unverified") {
+			return false
+		}
+		outcome, ok := scalarText(f["outcome"])
+		if !ok || outcome != "success" && outcome != "failure" && outcome != "timeout" && outcome != "unknown" {
+			return false
+		}
+		if _, ok := scalarText(f["failure_stage"]); !ok {
+			return false
+		}
+		for _, k := range []string{"ordered_chain", "provider_chain"} {
+			items, ok := stringsArray(f[k], false)
+			if !ok {
+				return false
+			}
+			// The fixed core preserves an empty provider name for a direct or
+			// otherwise unlabelled chain hop. Keep it verbatim, never infer a
+			// provider; actual node names themselves must be nonempty.
+			if k == "ordered_chain" {
+				for _, item := range items {
+					if item == "" {
+						return false
+					}
+				}
+			}
+		}
+		for _, pair := range []struct{ duration, waited string }{{"duration_ms", "waited_ms"}, {"flow_duration_ms", "flow_waited_ms"}} {
+			wait, ok := decimal(f[pair.waited], false, false)
+			if !ok || wait > 1<<63-1 {
+				return false
+			}
+			if outcome != "success" {
+				if !null(f[pair.duration]) {
+					return false
+				}
+				continue
+			}
+			duration, ok := decimal(f[pair.duration], false, false)
+			if !ok || duration > wait {
+				return false
+			}
+		}
+		return true
+	case "gap":
+		if !exactFields(f, commonFields+" reason dimensions upload_bytes download_bytes connection_id") || !null(f["upload_bytes"]) || !null(f["download_bytes"]) {
+			return false
+		}
+		if !literal(f, "reason", "source_event_uncertain") && !literal(f, "reason", "source_shutdown_before_final") {
+			return false
+		}
+		if s, ok := scalarText(f["connection_id"]); !ok {
+			return false
+		} else if s != "" {
+			if _, err := parseID(s); err != nil {
+				return false
+			}
+		}
+		dims, ok := stringsArray(f["dimensions"], true)
+		if !ok {
+			return false
+		}
+		seen := map[string]bool{}
+		for _, dim := range dims {
+			if seen[dim] || dim != "bytes" && dim != "route_or_setup" && dim != "window_checkpoints" {
+				return false
+			}
+			seen[dim] = true
+		}
+		return true
+	case "epoch_closed":
+		if !exactFields(f, commonFields+" reason unfinished_flows finality") || !null(f["flow_id"]) || !null(f["attempt_id"]) || !literal(f, "reason", "core_shutdown") {
+			return false
+		}
+		n, ok := decimal(f["unfinished_flows"], true, false)
+		return ok && (n == 0 && literal(f, "finality", "complete") || n != 0 && literal(f, "finality", "incomplete"))
+	}
+	return false
+}
+
+// DecodeSourceEvent strictly validates the current candidate, including nested
+// ProcessEvidence. It preserves unknown counters as null and candidate timing as
+// unverified. It does not infer source continuity from one well-shaped frame.
+func DecodeSourceEvent(raw []byte) (SourceEvent, error) {
+	invalid := func() (SourceEvent, error) { return SourceEvent{}, ErrInvalidSourceEvent }
+	if len(raw) == 0 || len(raw) > SourceInputLimit || !utf8.Valid(raw) {
+		return invalid()
+	}
+	f, ok := object(raw)
+	if !ok || !bytes.Equal(bytes.TrimSpace(f["schema_version"]), []byte("1")) || !literal(f, "boundary_ref", "mihomo_proxy_stream_v1") {
+		return invalid()
+	}
+	kind, ok := scalarText(f["kind"])
+	if !ok {
+		return invalid()
+	}
+	e := SourceEvent{Kind: kind}
+	var epoch, generation string
+	for _, item := range []struct {
+		key string
+		dst *string
+	}{{"source_instance_id", &e.SourceInstanceID}, {"source_epoch", &epoch}, {"event_id", &e.EventID}, {"config_generation", &generation}} {
+		v, ok := id(f[item.key])
+		if !ok {
+			return invalid()
+		}
+		*item.dst = v
+	}
+	e.SourceEpoch, e.ConfigGeneration = string(epoch), string(generation)
+	e.SourceSeq, ok = decimal(f["source_seq"], true, true)
+	if !ok {
+		return invalid()
+	}
+	s, ok := scalarText(f["observed_at"])
+	if !ok || !strings.HasSuffix(s, "Z") {
+		return invalid()
+	}
+	if _, err := parseTimestamp(s); err != nil {
+		return invalid()
+	}
+	if kind != "epoch_closed" {
+		e.FlowID, ok = id(f["flow_id"])
+		if !ok {
+			return invalid()
+		}
+		e.AttemptID, ok = id(f["attempt_id"])
+		if !ok {
+			return invalid()
+		}
+	}
+	if kind == string(BytesCheckpoint) || kind == string(Closed) {
+		counter, err := DecodeCounterEvent(raw)
+		if err != nil {
+			return invalid()
+		}
+		e.Counter = &counter
+	} else if !kindValid(f, kind) {
+		return invalid()
+	}
+	if kind == "route_decided" && literal(f, "phase", "connection_binding") {
+		e.Phase = "connection_binding"
+	}
+	if kind == "gap" {
+		e.GapReason, _ = scalarText(f["reason"])
+		e.GapDimensions, _ = stringsArray(f["dimensions"], true)
+	}
+	if kind == "epoch_closed" {
+		e.UnfinishedFlows, _ = decimal(f["unfinished_flows"], true, false)
+		e.EpochFinality, _ = scalarText(f["finality"])
+	}
+	e.Raw = append(json.RawMessage(nil), raw...)
+	return e, nil
+}
diff --git a/component/hoopatrace/telemetrywire/state.go b/component/hoopatrace/telemetrywire/state.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/telemetrywire/state.go
@@ -0,0 +1,196 @@
+package telemetrywire
+
+import "errors"
+
+var ErrInvalidLifecycle = errors.New("invalid source epoch lifecycle")
+
+// MaxActiveFlows is the concurrent admission bound of this frozen P0 profile.
+// Terminal history remains available independently of the active-flow budget.
+const MaxActiveFlows = 32
+
+// Flow is a projection of confirmed v1 frames, not a network-end observation.
+type Flow struct {
+	SourceEpoch    string
+	FlowID         string
+	OpenedEventID  string
+	State          string
+	Reason         string
+	LastCheckpoint *CounterEvent
+	Final          *CounterEvent
+	TailBytes      *uint64
+	GapDimensions  []string
+}
+
+type Lifecycle struct {
+	SourceEpoch      string
+	SourceInstanceID string
+	ConfigGeneration string
+	LastSourceSeq    uint64
+	EpochFinality    string
+	Flows            []Flow
+}
+
+type flowState struct {
+	Flow
+	terminal, shutdown, gapSeen bool
+}
+
+// State is a single-writer, pure epoch validator. Its zero value is ready for
+// the first sequence-1 event. Only pass unmodified DecodeSourceEvent results.
+// Validate has no side effects; Commit revalidates and advances after the
+// caller's durable write succeeds. No duplicate event is accepted here: receipt
+// deduplication belongs to the receiver and precedes validation.
+type State struct {
+	epoch, instance, generation string
+	last                        uint64
+	finality                    string
+	flows                       map[string]flowState
+	order                       []string
+	events                      map[string]bool
+	attempts                    map[string]string
+	finished                    map[string]bool
+	active                      int
+}
+
+func (s *State) next(e SourceEvent) (flowState, error) {
+	bad := func() (flowState, error) { return flowState{}, ErrInvalidLifecycle }
+	if s.last == ^uint64(0) || e.SourceSeq != s.last+1 || s.finality != "" || s.events[e.EventID] {
+		return bad()
+	}
+	if s.last != 0 && (s.epoch != e.SourceEpoch || s.instance != e.SourceInstanceID || s.generation != e.ConfigGeneration) {
+		return bad()
+	}
+	if e.Kind == "epoch_closed" {
+		var unfinished uint64
+		for _, f := range s.flows {
+			if !f.terminal {
+				return bad()
+			}
+			if f.shutdown {
+				unfinished++
+			}
+		}
+		if unfinished != e.UnfinishedFlows {
+			return bad()
+		}
+		return flowState{}, nil
+	}
+	if owner, ok := s.attempts[e.AttemptID]; ok && owner != e.FlowID {
+		return bad()
+	}
+	f, exists := s.flows[e.FlowID]
+	if e.Kind == "opened" {
+		if exists || s.active >= MaxActiveFlows {
+			return bad()
+		}
+		return flowState{Flow: Flow{SourceEpoch: e.SourceEpoch, FlowID: e.FlowID, OpenedEventID: e.EventID, State: "pending", Reason: "source_final_missing", GapDimensions: []string{}}}, nil
+	}
+	if !exists || f.terminal && e.Kind != "gap" {
+		return bad()
+	}
+	switch e.Kind {
+	case "route_decided":
+		// v1 has no attempt-start event: decisions, bindings and checkpoints may
+		// observe an attempt before setup_finished. Multiple attempts are valid.
+	case "setup_finished":
+		if s.finished[e.AttemptID] {
+			return bad()
+		}
+	case "bytes_checkpoint", "closed":
+		if e.Counter == nil {
+			return bad()
+		}
+		previous := f.LastCheckpoint
+		if previous != nil && (e.Counter.UploadBytes < previous.UploadBytes || e.Counter.DownloadBytes < previous.DownloadBytes) {
+			return bad()
+		}
+		counter := *e.Counter
+		if e.Kind == "bytes_checkpoint" {
+			f.LastCheckpoint = &counter
+		} else {
+			zero := uint64(0)
+			f.Final, f.TailBytes, f.State, f.Reason, f.terminal = &counter, &zero, "closed", "", true
+		}
+	case "gap":
+		if f.gapSeen {
+			return bad()
+		}
+		for _, dim := range e.GapDimensions {
+			if dim == "bytes" && f.Final != nil {
+				return bad()
+			}
+		}
+		f.GapDimensions = append(append([]string{}, f.GapDimensions...), e.GapDimensions...)
+		if f.Final == nil {
+			f.State, f.Reason = "gap", e.GapReason
+		}
+		f.gapSeen, f.terminal = true, true
+		f.shutdown = e.GapReason == "source_shutdown_before_final"
+	default:
+		return bad()
+	}
+	return f, nil
+}
+
+func (s *State) Validate(e SourceEvent) error { _, err := s.next(e); return err }
+
+func (s *State) Commit(e SourceEvent) error {
+	f, err := s.next(e)
+	if err != nil {
+		return err
+	}
+	if s.events == nil {
+		s.events = map[string]bool{}
+		s.flows = map[string]flowState{}
+		s.attempts = map[string]string{}
+		s.finished = map[string]bool{}
+	}
+	if s.last == 0 {
+		s.epoch, s.instance, s.generation = e.SourceEpoch, e.SourceInstanceID, e.ConfigGeneration
+	}
+	s.last = e.SourceSeq
+	s.events[e.EventID] = true
+	if e.Kind == "epoch_closed" {
+		s.finality = e.EpochFinality
+		return nil
+	}
+	if e.Kind == "opened" {
+		s.order = append(s.order, e.FlowID)
+		s.active++
+	} else if previous := s.flows[e.FlowID]; !previous.terminal && f.terminal {
+		s.active--
+	}
+	s.flows[e.FlowID] = f
+	s.attempts[e.AttemptID] = e.FlowID
+	if e.Kind == "setup_finished" {
+		s.finished[e.AttemptID] = true
+	}
+	return nil
+}
+
+// Snapshot returns a detached, stable projection in original opened order.
+func (s *State) Snapshot() Lifecycle {
+	finality := s.finality
+	if finality == "" {
+		finality = "unverified"
+	}
+	out := Lifecycle{SourceEpoch: s.epoch, SourceInstanceID: s.instance, ConfigGeneration: s.generation, LastSourceSeq: s.last, EpochFinality: finality, Flows: []Flow{}}
+	for _, id := range s.order {
+		f := s.flows[id].Flow
+		f.GapDimensions = append([]string{}, f.GapDimensions...)
+		if f.LastCheckpoint != nil {
+			v := *f.LastCheckpoint
+			f.LastCheckpoint = &v
+		}
+		if f.Final != nil {
+			v := *f.Final
+			f.Final = &v
+		}
+		if f.TailBytes != nil {
+			v := *f.TailBytes
+			f.TailBytes = &v
+		}
+		out.Flows = append(out.Flows, f)
+	}
+	return out
+}
