+func TestHoopaShortWriteAndENOSPCPreserveEvidence(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		t.Run(fmt.Sprint("partial_", partial), func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			f := newClosureFlow(t, s)
+			dir, name := s.root.Name(), s.file.Name()
+			confirmed := s.confirmedSize
+			s.mu.Lock()
+			s.writeFrame = func(b []byte) (int, error) {
+				if partial {
+					n, _ := s.file.Write(b[:len(b)/2])
+					return n, syscall.ENOSPC
+				}
+				return 0, syscall.ENOSPC
+			}
+			s.mu.Unlock()
+			if f.Checkpoint() == nil || !s.poisoned || s.seq != 1 || s.confirmedSize != confirmed {
+				t.Fatal("failed write advanced source")
+			}
+			if len(snapshotsFor(t, s, filepath.Base(name))) != 1 {
+				t.Fatal("partial write sent")
+			}
+			if _, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now()); err == nil {
+				t.Fatal("admitted after ENOSPC")
+			}
+			before, _ := os.ReadFile(name)
+			s.close()
+			next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+			if partial {
+				if err == nil {
+					next.close()
+					t.Fatal("partial tail accepted")
+				}
+			} else {
+				if err != nil {
+					t.Fatal(err)
+				}
+				next.close()
+			}
+			after, _ := os.ReadFile(name)
+			if !bytes.Equal(before, after) {
+				t.Fatal("failed write evidence truncated")
+			}
+		})
+	}
+}
