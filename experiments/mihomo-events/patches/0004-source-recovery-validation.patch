+func TestHoopaThirtyTwoPendingFlowsKeepHistorySeparateFromReady(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	for i := 0; i < maxActive; i++ {
+		newClosureFlow(t, s)
+	}
+	if _, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now()); err == nil {
+		t.Fatal("active flow bound bypassed")
+	}
+	dir, epoch := s.root.Name(), s.epoch
+	s.close()
+	next, err := openSource(dir, "new-generation", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer next.close()
+	var count int
+	for _, r := range next.recoveryReports() {
+		if r.SourceEpoch == epoch {
+			count = len(r.Flows)
+			if r.HistoryQuality != "gap" || r.RecordingStatus != "ready" {
+				t.Fatal("historical gap blocked ready")
+			}
+			for _, f := range r.Flows {
+				if f.TailBytes != nil || f.State != "gap" {
+					t.Fatal("unfinished flow became exact")
+				}
+			}
+		}
+	}
+	if count != 32 {
+		t.Fatal("pending census missing", count)
+	}
+	newClosureFlow(t, next).Close()
+}
