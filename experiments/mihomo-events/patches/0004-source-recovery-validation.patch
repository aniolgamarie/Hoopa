diff --git a/component/hoopatrace/recovery_linux.go b/component/hoopatrace/recovery_linux.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/recovery_linux.go
@@ -0,0 +1,251 @@
+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"io/fs"
+	"os"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/metacubex/mihomo/component/hoopatrace/telemetrywire"
+)
+
+type replayEpoch struct {
+	manifest   telemetrywire.Manifest
+	framesHash string
+	size       int64
+}
+type sendSnapshot struct {
+	name   string
+	frames [][]byte
+}
+
+// readStableFile never repairs a file. The caller owns the source writer lock;
+// repeated content and pathname checks also detect changes by non-writer users.
+func readStableFile(root *os.Root, name string, maximum int64, confirm bool) ([]byte, error) {
+	f, err := privateFile(root, name, os.O_RDONLY)
+	if err != nil {
+		return nil, ErrSource
+	}
+	defer f.Close()
+	before, err := f.Stat()
+	if err != nil || before.Size() > maximum {
+		return nil, ErrSource
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, maximum+1))
+	if err != nil || int64(len(raw)) != before.Size() {
+		return nil, ErrSource
+	}
+	if confirm && f.Sync() != nil {
+		return nil, ErrSource
+	}
+	if _, err = f.Seek(0, io.SeekStart); err != nil {
+		return nil, ErrSource
+	}
+	repeated, err := io.ReadAll(io.LimitReader(f, maximum+1))
+	if err != nil || !bytes.Equal(raw, repeated) {
+		return nil, ErrSource
+	}
+	after, err := f.Stat()
+	if err != nil || after.Size() != before.Size() || !after.ModTime().Equal(before.ModTime()) {
+		return nil, ErrSource
+	}
+	named, err := root.Lstat(name)
+	if err != nil || !os.SameFile(after, named) || named.Size() != after.Size() || !named.ModTime().Equal(after.ModTime()) {
+		return nil, ErrSource
+	}
+	return raw, nil
+}
+func boundFrames(raw []byte, m telemetrywire.Manifest, visit func([]byte) error) (telemetrywire.Lifecycle, error) {
+	life, err := scanFrames(bytes.NewReader(raw), visit)
+	if err != nil {
+		return life, ErrSource
+	}
+	if life.LastSourceSeq != 0 && (life.SourceEpoch != m.SourceEpoch || life.SourceInstanceID != m.SourceInstanceID || life.ConfigGeneration != m.ConfigGeneration) {
+		return life, ErrSource
+	}
+	return life, nil
+}
+
+func (s *source) scanPrevious(entries []fs.DirEntry) (int, error) {
+	pairs := map[string]uint8{}
+	for _, e := range entries {
+		name := e.Name()
+		if !strings.HasPrefix(name, "epoch-") {
+			continue
+		}
+		suffix := ""
+		bit := uint8(0)
+		if strings.HasSuffix(name, ".frames") {
+			suffix = ".frames"
+			bit = 1
+		} else if strings.HasSuffix(name, ".source.json") {
+			suffix = ".source.json"
+			bit = 2
+		} else {
+			return 0, ErrSource
+		}
+		stem := strings.TrimSuffix(name, suffix)
+		// A valid manifest will also prove the full canonical digest in the stem.
+		if len(stem) != len("epoch-")+64 {
+			return 0, ErrSource
+		}
+		pairs[stem] |= bit
+	}
+	if len(pairs) > 32 {
+		return 0, ErrSource
+	}
+	stems := make([]string, 0, len(pairs))
+	for stem, bits := range pairs {
+		if bits != 3 {
+			return 0, ErrSource
+		}
+		stems = append(stems, stem)
+	}
+	sort.Strings(stems)
+	for _, stem := range stems {
+		meta, err := readStableFile(s.root, stem+".source.json", maxFrame, true)
+		if err != nil {
+			return 0, err
+		}
+		m, err := telemetrywire.DecodeManifest(meta)
+		if err != nil || "epoch-"+strings.TrimPrefix(m.SourceEpoch, "epoch:") != stem {
+			return 0, ErrSource
+		}
+		raw, err := readStableFile(s.root, stem+".frames", s.limit, true)
+		if err != nil {
+			return 0, err
+		}
+		if uint64(len(meta)+len(raw)) > m.MaxSourceBytes {
+			return 0, ErrSource
+		}
+		s.used += int64(len(meta) + len(raw))
+		if s.used > s.limit {
+			return 0, ErrSource
+		}
+		life, err := boundFrames(raw, m, nil)
+		if err != nil {
+			return 0, err
+		}
+		digest := sha256.Sum256(raw)
+		framesHash := hex.EncodeToString(digest[:])
+		// A directory sync completes confirmation of the paired old files before
+		// they can enter the replay set or support a derived writer-end report.
+		if syncDir(s.root) != nil {
+			return 0, ErrSource
+		}
+		ended := &telemetrywire.WriterEndEvidence{Kind: "exclusive_writer_full_scan", SourceEpoch: m.SourceEpoch, ManifestSHA256: m.SHA256, FramesSHA256: framesHash, ObservedAt: time.Now().UTC().Format(time.RFC3339Nano)}
+		report, err := telemetrywire.ProjectRecovery(m, life, framesHash, ended)
+		if err != nil {
+			return 0, ErrSource
+		}
+		s.replay[stem+".frames"] = replayEpoch{m, framesHash, int64(len(raw))}
+		s.reports = append(s.reports, report)
+	}
+	return len(pairs), nil
+}
+
+// sendSnapshots copies only confirmed bytes while holding s.mu; HTTP is outside
+// this lock. An uncertain full write remains on disk but is not sent until a
+// later writer-lock reopen has validated and synced the complete snapshot.
+func (s *source) sendSnapshots() ([]sendSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.rawClosed {
+		return nil, ErrSource
+	}
+	bad := func() ([]sendSnapshot, error) { s.poisoned = true; s.readOnly = true; return nil, ErrSource }
+	names := make([]string, 0, len(s.replay))
+	for name := range s.replay {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	result := make([]sendSnapshot, 0, len(names)+1)
+	for _, name := range names {
+		old := s.replay[name]
+		meta, err := readStableFile(s.root, strings.TrimSuffix(name, ".frames")+".source.json", maxFrame, false)
+		if err != nil {
+			return bad()
+		}
+		m, err := telemetrywire.DecodeManifest(meta)
+		if err != nil || m.SHA256 != old.manifest.SHA256 {
+			return bad()
+		}
+		raw, err := readStableFile(s.root, name, s.limit, false)
+		if err != nil || int64(len(raw)) != old.size {
+			return bad()
+		}
+		digest := sha256.Sum256(raw)
+		if hex.EncodeToString(digest[:]) != old.framesHash {
+			return bad()
+		}
+		rows := [][]byte{}
+		if _, err = boundFrames(raw, m, func(b []byte) error { rows = append(rows, append([]byte(nil), b...)); return nil }); err != nil {
+			return bad()
+		}
+		result = append(result, sendSnapshot{name, rows})
+	}
+	if s.file != nil {
+		name := "epoch-" + strings.TrimPrefix(s.epoch, "epoch:") + ".frames"
+		meta, err := readStableFile(s.root, strings.TrimSuffix(name, ".frames")+".source.json", maxFrame, false)
+		if err != nil {
+			return bad()
+		}
+		m, err := telemetrywire.DecodeManifest(meta)
+		if err != nil || m.SHA256 != s.manifest.SHA256 {
+			return bad()
+		}
+		f, err := privateFile(s.root, name, os.O_RDONLY)
+		if err != nil {
+			return bad()
+		}
+		info, err := f.Stat()
+		if err != nil || info.Size() < s.confirmedSize {
+			f.Close()
+			return bad()
+		}
+		raw, err := io.ReadAll(io.NewSectionReader(f, 0, s.confirmedSize))
+		f.Close()
+		if err != nil || int64(len(raw)) != s.confirmedSize {
+			return bad()
+		}
+		digest := sha256.Sum256(raw)
+		if !bytes.Equal(digest[:], s.confirmedHasher.Sum(nil)) {
+			return bad()
+		}
+		rows := [][]byte{}
+		if _, err = boundFrames(raw, m, func(b []byte) error { rows = append(rows, append([]byte(nil), b...)); return nil }); err != nil {
+			return bad()
+		}
+		result = append(result, sendSnapshot{name, rows})
+	}
+	return result, nil
+}
+
+// recoveryReports returns detached derived history plus current recording state.
+// "ready" refers only to this bounded source's recording capacity, not protocol
+// ready, business success, identity completeness or a CapabilityRecord.
+func (s *source) recoveryReports() []telemetrywire.RecoveryReport {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	raw, _ := json.Marshal(s.reports)
+	var out []telemetrywire.RecoveryReport
+	_ = json.Unmarshal(raw, &out)
+	status := "ready"
+	if s.poisoned || s.rawClosed || s.stopping {
+		status = "unavailable"
+	} else if s.readOnly {
+		status = "replay_only"
+	}
+	for i := range out {
+		out[i].RecordingStatus = status
+	}
+	return out
+}
