+// Fixed scan-regression budget declared before this measured run: exactly 32
+// epoch pairs and 8MiB total source evidence, <=60s scan, <=512MiB extra sampled
+// Go heap. These bounds are regression guards, not product RSS/CPU guarantees.
+func TestHoopaBoundedThirtyTwoEpochEightMiBScanCost(t *testing.T) {
+	dir := t.TempDir()
+	os.Chmod(dir, 0700)
+	var firstFrames string
+	var template map[string]json.RawMessage
+	for i := 0; i < 32; i++ {
+		s, err := openSource(dir, "test-generation", "", "", defaultLimit)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == 0 {
+			f := newClosureFlow(t, s)
+			f.Close()
+			rows := frames(t, s)
+			json.Unmarshal(rows[0], &template)
+			firstFrames = s.file.Name()
+		}
+		s.close()
+	}
+	entries, _ := os.ReadDir(dir)
+	var metadataBytes int
+	for _, e := range entries {
+		if strings.HasSuffix(e.Name(), ".source.json") {
+			info, _ := e.Info()
+			metadataBytes += int(info.Size())
+		}
+	}
+	target := defaultLimit - metadataBytes
+	var buffer bytes.Buffer
+	seq, flow, steps := 0, 0, 0
+	emit := func(kind string, payload int, padTo int) {
+		fields := map[string]json.RawMessage{}
+		for k, v := range template {
+			fields[k] = v
+		}
+		seq++
+		fields["source_seq"], _ = json.Marshal(strconv.Itoa(seq))
+		fields["event_id"], _ = json.Marshal("scan-event-" + strconv.Itoa(seq))
+		fields["flow_id"], _ = json.Marshal("scan-flow-" + strconv.Itoa(flow))
+		fields["attempt_id"], _ = json.Marshal("scan-attempt-" + strconv.Itoa(flow))
+		fields["kind"], _ = json.Marshal(kind)
+		if kind != "opened" {
+			for _, k := range []string{"process", "source_addr", "entry_addr", "target_kind", "target", "identity_scope"} {
+				delete(fields, k)
+			}
+		}
+		switch kind {
+		case "route_decided":
+			fields["rule"] = json.RawMessage(`"MATCH"`)
+			fields["rule_payload"], _ = json.Marshal(strings.Repeat("x", payload))
+			fields["logical_target"] = json.RawMessage(`"DIRECT"`)
+			fields["process"] = template["process"]
+		case "closed":
+			fields["upload_bytes"] = json.RawMessage(`"0"`)
+			fields["download_bytes"] = json.RawMessage(`"0"`)
+		}
+		raw, _ := json.Marshal(fields)
+		if padTo > 0 {
+			if padTo < 4+len(raw)+sha256.Size || padTo > maxFrame+36 {
+				t.Fatal("padding fixture bound")
+			}
+			raw = append(raw, bytes.Repeat([]byte(" "), padTo-4-len(raw)-sha256.Size)...)
+		}
+		var header [4]byte
+		binary.BigEndian.PutUint32(header[:], uint32(len(raw)))
+		buffer.Write(header[:])
+		buffer.Write(raw)
+		sum := sha256.Sum256(raw)
+		buffer.Write(sum[:])
+	}
+	emit("opened", 0, 0)
+	for target-buffer.Len() > 2*(maxFrame+36) {
+		if steps == 20 {
+			emit("closed", 0, 0)
+			flow++
+			emit("opened", 0, 0)
+			steps = 0
+		}
+		emit("route_decided", 3600, 0)
+		steps++
+	}
+	// Close the last real flow. Final closed JSON whitespace fills the exact cap;
+	// all preceding events stay below the original per-flow event reservation.
+	for target-buffer.Len() > maxFrame+36 {
+		emit("route_decided", 0, 0)
+	}
+	emit("closed", 0, target-buffer.Len())
+	if buffer.Len() != target {
+		t.Fatal("not exact quota")
+	}
+	if err := os.WriteFile(firstFrames, buffer.Bytes(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	buffer.Reset()
+	buffer = bytes.Buffer{}
+	runtime.GC()
+	var baseline runtime.MemStats
+	runtime.ReadMemStats(&baseline)
+	stop, done := make(chan struct{}), make(chan uint64)
+	go func() {
+		peak := baseline.HeapAlloc
+		timer := time.NewTicker(time.Millisecond)
+		defer timer.Stop()
+		for {
+			select {
+			case <-stop:
+				done <- peak
+				return
+			case <-timer.C:
+				var m runtime.MemStats
+				runtime.ReadMemStats(&m)
+				if m.HeapAlloc > peak {
+					peak = m.HeapAlloc
+				}
+			}
+		}
+	}()
+	started := time.Now()
+	s, err := openSource(dir, "test-generation", "", "", defaultLimit)
+	elapsed := time.Since(started)
+	close(stop)
+	peak := <-done
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.close()
+	if !s.readOnly || s.used != defaultLimit || len(s.recoveryReports()) != 32 {
+		t.Fatal("quota scan/capacity classification wrong")
+	}
+	extra := peak - baseline.HeapAlloc
+	var usage syscall.Rusage
+	syscall.Getrusage(syscall.RUSAGE_SELF, &usage)
+	t.Logf("scale=32 epoch pairs, source_bytes=%d, frames=%d, unfinished_flows=0; scan=%s, sampled_extra_Go_heap_bytes=%d, process_lifetime_MaxRSS_KiB=%d; thresholds scan<=60s heap<=512MiB", s.used, seq, elapsed, extra, usage.Maxrss)
+	if elapsed > 60*time.Second || extra > 512*1024*1024 {
+		t.Fatal("declared scan regression budget exceeded")
+	}
+	// One extra byte is both beyond the quota and an invalid suffix; do not repair.
+	s.close()
+	f, _ := os.OpenFile(firstFrames, os.O_APPEND|os.O_WRONLY, 0)
+	f.Write([]byte{0})
+	f.Close()
+	before, _ := os.Stat(firstFrames)
+	next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+	if err == nil {
+		next.close()
+		t.Fatal("over-capacity history accepted")
+	}
+	after, _ := os.Stat(firstFrames)
+	if before.Size() != after.Size() {
+		t.Fatal("over-capacity evidence truncated")
+	}
+}
