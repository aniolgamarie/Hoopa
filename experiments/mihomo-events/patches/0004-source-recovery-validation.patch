+func TestHoopaReopenRejectsThirtyThreePendingFlows(t *testing.T) {
+	s := testSource(t, defaultLimit)
+	// Use the real admission/write path for the supported 32-flow prefix, with
+	// the periodic worker stopped only to keep this fixture's sequence fixed.
+	s.stopCheckpoints()
+	for i := 0; i < 32; i++ {
+		newClosureFlow(t, s)
+	}
+	name, dir := s.file.Name(), s.root.Name()
+	first := frames(t, s)[0]
+	nextSeq := s.seq + 1
+	s.close()
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(first, &fields); err != nil {
+		t.Fatal(err)
+	}
+	fields["source_seq"], _ = json.Marshal(strconv.FormatUint(nextSeq, 10))
+	fields["event_id"] = json.RawMessage(`"pending-event-extra"`)
+	fields["flow_id"] = json.RawMessage(`"pending-flow-extra"`)
+	fields["attempt_id"] = json.RawMessage(`"pending-attempt-extra"`)
+	raw, err := json.Marshal(fields)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original, err := os.ReadFile(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buffer bytes.Buffer
+	buffer.Write(original)
+	var header [4]byte
+	binary.BigEndian.PutUint32(header[:], uint32(len(raw)))
+	buffer.Write(header[:])
+	buffer.Write(raw)
+	sum := sha256.Sum256(raw)
+	buffer.Write(sum[:])
+	before := append([]byte(nil), buffer.Bytes()...)
+	if len(before) >= defaultLimit {
+		t.Fatal("fixture exceeds independent byte quota")
+	}
+	if err := os.WriteFile(name, before, 0600); err != nil {
+		t.Fatal(err)
+	}
+	// The generated manifest and real prefix remain intact; only the appended
+	// 33rd concurrent opened exceeds its validated active-flow capability.
+	next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+	if err == nil {
+		next.close()
+		t.Fatal("33 pending flows admitted under valid manifest")
+	}
+	after, err := os.ReadFile(name)
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatal("over-active evidence changed", err)
+	}
+}
