+func TestHoopaReopenRejectsMalformedManifest(t *testing.T) {
+	for _, kind := range []string{"invalid_json", "duplicate", "generation", "identity", "missing_manifest", "orphan_manifest"} {
+		t.Run(kind, func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			if _, err := s.begin(&net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32001}, &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32002}, "example.test", "", time.Now()); err != nil {
+				t.Fatal(err)
+			}
+			dir, epoch := s.root.Name(), s.epoch
+			s.close()
+			name := filepath.Join(dir, "epoch-"+epoch[len("epoch:"):]+".source.json")
+			raw, err := os.ReadFile(name)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var fields map[string]json.RawMessage
+			if json.Unmarshal(raw, &fields) != nil {
+				t.Fatal("fixture")
+			}
+			switch kind {
+			case "invalid_json":
+				raw = []byte(`{"schema_version":`)
+			case "duplicate":
+				raw = append(raw[:len(raw)-1], []byte(`,"schema_version":1}`)...)
+			case "generation":
+				fields["config_generation"] = json.RawMessage(`"wrong"`)
+				raw, _ = json.Marshal(fields)
+			case "identity":
+				fields["nonce"] = json.RawMessage(`"00000000000000000000000000000000"`)
+				raw, _ = json.Marshal(fields)
+			case "missing_manifest":
+				if err = os.Remove(name); err != nil {
+					t.Fatal(err)
+				}
+			case "orphan_manifest":
+				if err = os.Remove(filepath.Join(dir, "epoch-"+epoch[len("epoch:"):]+".frames")); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if kind != "missing_manifest" {
+				if err = os.WriteFile(name, raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, _ := os.ReadFile(name)
+			next, err := openSource(dir, "test-generation", "", "", defaultLimit)
+			if err == nil {
+				next.close()
+				t.Fatal("invalid manifest pairing accepted")
+			}
+			after, _ := os.ReadFile(name)
+			if string(before) != string(after) {
+				t.Fatal("evidence repaired")
+			}
+		})
+	}
+}
