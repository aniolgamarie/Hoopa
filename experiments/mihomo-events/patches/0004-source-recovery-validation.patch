+func testPeer() net.Addr  { return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32001} }
+func testEntry() net.Addr { return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32002} }
+
+func newClosureFlow(t *testing.T, s *source) *Flow {
+	t.Helper()
+	f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+func snapshotsFor(t *testing.T, s *source, name string) [][]byte {
+	t.Helper()
+	snapshots, err := s.sendSnapshots()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range snapshots {
+		if v.name == name {
+			return v.frames
+		}
+	}
+	t.Fatal("missing snapshot", name)
+	return nil
+}
+func TestHoopaSyncUncertainPrefixAndReopenExactRecovery(t *testing.T) {
+	for _, terminal := range []bool{false, true} {
+		t.Run(fmt.Sprint("closed_", terminal), func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			f := newClosureFlow(t, s)
+			name := filepath.Base(s.file.Name())
+			dir := s.root.Name()
+			confirmed := s.confirmedSize
+			f.AddUpload(9007199254740993)
+			f.AddDownload(17)
+			s.mu.Lock()
+			s.syncFrame = func() error {
+				if err := s.file.Sync(); err != nil {
+					return err
+				}
+				return io.ErrUnexpectedEOF
+			}
+			s.mu.Unlock()
+			if terminal {
+				f.Close()
+			} else if f.Checkpoint() == nil {
+				t.Fatal("uncertain sync accepted")
+			}
+			if !s.poisoned || s.seq != 1 || s.confirmedSize != confirmed || s.state.Snapshot().LastSourceSeq != 1 {
+				t.Fatal("uncertain frame advanced confirmation")
+			}
+			if got := snapshotsFor(t, s, name); len(got) != 1 {
+				t.Fatal("unconfirmed complete frame exposed to sender")
+			}
+			all := frames(t, s)
+			if len(all) != 2 {
+				t.Fatal("complete uncertain frame lost")
+			}
+			original, _ := os.ReadFile(s.file.Name())
+			s.close()
+			var factID, factHash string
+			for attempt := 0; attempt < 3; attempt++ {
+				next, err := openSource(dir, "new-generation", "", "", defaultLimit)
+				if err != nil {
+					t.Fatal(err)
+				}
+				got := snapshotsFor(t, next, name)
+				if len(got) != 2 || !bytes.Equal(got[0], all[0]) || !bytes.Equal(got[1], all[1]) {
+					next.close()
+					t.Fatal("reopen changed original ID/seq/bytes")
+				}
+				reports := next.recoveryReports()
+				var found bool
+				for _, r := range reports {
+					if r.SourceEpoch == s.epoch {
+						found = true
+						if r.RecordingStatus != "ready" || len(r.Flows) != 1 {
+							t.Fatal("history prevented current ready")
+						}
+						v := r.Flows[0]
+						if terminal {
+							if v.State != "closed" || v.Final == nil || v.Final.UploadBytes != 9007199254740993 || v.ReconciliationID != "" || v.TailBytes == nil {
+								t.Fatal("exact final changed or missing-final gap fabricated")
+							}
+						} else {
+							if v.State != "gap" || v.Reason != "epoch_ended_without_final" || v.TailBytes != nil || v.LastCheckpoint == nil || v.LastCheckpoint.UploadBytes != 9007199254740993 {
+								t.Fatal("checkpoint/unknown tail lost")
+							}
+							if attempt == 0 {
+								factID, factHash = v.ReconciliationID, v.FactSHA256
+							} else if v.ReconciliationID != factID || v.FactSHA256 != factHash {
+								t.Fatal("repeated recovery duplicated fact")
+							}
+						}
+						// Caller mutation of a report must not change subsequent projections.
+						r.Flows[0].State = "modified"
+						if r.Flows[0].LastCheckpoint != nil {
+							r.Flows[0].LastCheckpoint.UploadBytes = 0
+						}
+					}
+				}
+				if !found {
+					t.Fatal("missing old report")
+				}
+				for _, r := range next.recoveryReports() {
+					if r.SourceEpoch == s.epoch && r.Flows[0].State == "modified" {
+						t.Fatal("report aliases source")
+					}
+				}
+				active := newClosureFlow(t, next)
+				active.Close()
+				next.close()
+			}
+			after, _ := os.ReadFile(filepath.Join(dir, name))
+			if !bytes.Equal(original, after) {
+				t.Fatal("recovery rewrote old source")
+			}
+		})
+	}
+}
