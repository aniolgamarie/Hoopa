+func TestMultiEntryGuardEnvAndTraceBinding(t *testing.T) {
+	identityCleanEnv(t)
+	identityUnsetEnv(t, "HOOPA_IDENTITY_HANDOFF_SET")
+	t.Setenv("HOOPA_IDENTITY_HANDOFF_SET", "")
+	if !hoopaGuardRequested() {
+		t.Fatal("empty set bypassed protected entry")
+	}
+	p := profile.Config{Listeners: []profile.Entry{{Name: "entry-a", Port: 18993}, {Name: "entry-b", Port: 18995}}, Proxies: []profile.Node{{Name: "node:a", Type: "direct"}}}
+	for k, v := range map[string]string{"HOOPA_TRACE_GENERATION": "generation", "HOOPA_TRACE_PROFILE": "5", "HOOPA_TRACE_ROUTE_MAP": "/private/routes.json"} {
+		t.Setenv(k, v)
+	}
+	if enabled, _, err := guardTraceConfig(p, "generation"); err != nil || !enabled {
+		t.Fatal(err)
+	}
+	for _, pair := range [][2]string{{"HOOPA_IDENTITY_HANDOFF", ""}, {"HOOPA_TRACE_INBOUND", "entry-a"}, {"HOOPA_TRACE_PROFILE", "4"}, {"HOOPA_TRACE_GENERATION", "other"}, {"HOOPA_TRACE_ROUTE_MAP", "relative"}} {
+		t.Run(pair[0], func(t *testing.T) {
+			t.Setenv(pair[0], pair[1])
+			if _, _, err := guardTraceConfig(p, "generation"); err == nil {
+				t.Fatal("invalid new tracing admitted")
+			}
+		})
+	}
+}
+func TestMultiEntryObservationSurfaceUnavailableAndLegacyUnchanged(t *testing.T) {
+	// The empty OwnerSet explicitly reports no usable owners; actual original
+	// Status/Diagnostics success is exercised by hoopaid's fully adopted fakes.
+	set := &hoopaid.OwnerSet{}
+	r := &hoopaGuardRuntime{state: "running", generation: "g", hash: "h", secret: "fixed-test-token", conns: map[net.Conn]bool{}, identitySet: set}
+	for _, path := range []string{"/hoopa/status", "/hoopa/capture-health"} {
+		q := httptest.NewRequest("GET", path, nil)
+		q.RemoteAddr = "127.0.0.1:1234"
+		q.Header.Set("Authorization", "Bearer fixed-test-token")
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, q)
+		if w.Code != 200 {
+			t.Fatal(w.Code, w.Body.String())
+		}
+		var v map[string]any
+		json.Unmarshal(w.Body.Bytes(), &v)
+		if path == "/hoopa/status" {
+			if v["schema_version"] != float64(2) || v["experimental_admission"] != nil {
+				t.Fatal(v)
+			}
+			v = v["experimental_admissions"].(map[string]any)
+		}
+		if v["schema"] != "hoopa-entry-admission-observation-v1" || v["observation"] != "sequential_reads" || v["all_usable_observed"] != false {
+			t.Fatal(v)
+		}
+	}
+	if r.state != "running" {
+		t.Fatal("read mutated runtime")
+	}
+}
