+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"os"
+	"sync/atomic"
+)
+
+type entrySelection struct {
+	names                    map[string]bool
+	generation, programRules string
+}
+
+var guardSelection atomic.Pointer[entrySelection]
+
+// PrepareGuardEntries is called only with the guard-validated immutable owner
+// inventory. Selection and optional program-rule grant bind inside source.once;
+// legacy/lazy initialization can never acquire this grant afterwards.
+func PrepareGuardEntries(generation string, expected map[string]string, entries []string, programRules string) error {
+	_, newMode := os.LookupEnv("HOOPA_IDENTITY_HANDOFF_SET")
+	_, legacy := os.LookupEnv("HOOPA_IDENTITY_HANDOFF")
+	if !newMode || legacy || os.Getenv("HOOPA_TRACE_INBOUND") != "" || os.Getenv("HOOPA_TRACE_PROFILE") != "5" || os.Getenv("HOOPA_TRACE_GENERATION") != generation || !token(generation) || os.Getenv("HOOPA_TRACE_ROUTE_MAP") == "" || (programRules != "" && programRules != ProgramRuleProfileID) || len(entries) < 2 || len(entries) > 4 {
+		return ErrSource
+	}
+	names := make(map[string]bool, len(entries))
+	for _, name := range entries {
+		if !token(name) || names[name] {
+			return ErrSource
+		}
+		names[name] = true
+	}
+	checkRoutes := func(routes map[string]routeEntry) error {
+		if len(routes) != len(expected) {
+			return ErrSource
+		}
+		for name, typ := range expected {
+			r, ok := routes[name]
+			if !ok || r.AdapterType != typ || r.ProviderName != "" || r.ProviderID != nil {
+				return ErrSource
+			}
+		}
+		return nil
+	}
+	global.once.Do(func() {
+		initializeWithRoutes(checkRoutes)
+		if global.err == nil && global.s != nil {
+			global.s.programRules = programRules
+			if guardReady(global.s, generation) != nil {
+				global.err = ErrSource
+				return
+			}
+			guardSelection.Store(&entrySelection{names: names, generation: generation, programRules: programRules})
+		}
+	})
+	selection := guardSelection.Load()
+	if global.err != nil || global.s == nil || selection == nil || selection.generation != generation || selection.programRules != programRules || len(selection.names) != len(names) {
+		return ErrSource
+	}
+	for name := range names {
+		if !selection.names[name] {
+			return ErrSource
+		}
+	}
+	if checkRoutes(global.s.routes) != nil {
+		return ErrSource
+	}
+	return guardReady(global.s, generation)
+}
