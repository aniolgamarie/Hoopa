+func assertAllSetFDsClosedOnce(t *testing.T, fs []*scopedFake) {
+	t.Helper()
+	global := map[int]bool{}
+	for _, f := range fs {
+		want := map[int]bool{}
+		for _, fd := range f.h.orderedFDs() {
+			want[fd] = true
+		}
+		if len(f.closed) != len(want) {
+			t.Fatalf("FD close census: got %v want %v", f.closed, want)
+		}
+		for _, fd := range f.closed {
+			if !want[fd] || global[fd] {
+				t.Fatalf("unowned or repeated close %d", fd)
+			}
+			global[fd] = true
+			delete(want, fd)
+		}
+		if len(want) != 0 {
+			t.Fatal("FDs not released", want)
+		}
+	}
