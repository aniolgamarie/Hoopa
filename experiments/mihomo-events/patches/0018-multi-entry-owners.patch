+	}
+	flow, err := Begin("entry-a", nil, nil, "", "", time.Now())
+	if err != nil || flow != nil || global.s != nil {
+		t.Fatal("Begin initialized before preparation")
+	}
+	prepare := func() error { return PrepareGuardEntries(generation, expected, entries, opt) }
+	if mode == "legacy-first" || mode == "lazy-first" {
+		if mode == "lazy-first" {
+			global.once.Do(initialize)
+		} else {
