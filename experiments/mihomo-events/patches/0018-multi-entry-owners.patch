+
+func setFixture() ([]byte, []Entry, []*scopedFake) {
+	return setFixtureFor([]Entry{{Name: "entry-a", Port: 18993}, {Name: "entry-b", Port: 18995}})
+}
+func setFixtureFor(expected []Entry) ([]byte, []Entry, []*scopedFake) {
+	entries := []map[string]any{}
+	backends := []*scopedFake{}
+	for i, e := range expected {
+		h := exampleV4()
+		h.Port = e.Port
+		h.Generation, _ = CaptureGeneration(h.CoreGeneration, e.Name, e.Port)
+		for _, group := range []map[string]int{h.Maps, h.Programs, h.Links} {
+			for name, fd := range group {
+				group[name] = fd + i*100
+			}
+		}
+		f := newScopedFake(h)
+		offset := uint32(i * 100)
+		for _, group := range []map[string]int{h.Maps, h.Programs, h.Links} {
+			for _, fd := range group {
+				le.PutUint32(f.infos[fd][4:], le.Uint32(f.infos[fd][4:])+offset)
+			}
+		}
+		for _, fd := range h.Programs {
+			for j := range f.refs[fd] {
+				f.refs[fd][j] += offset
+			}
+		}
+		for _, fd := range h.Links {
+			le.PutUint32(f.infos[fd][8:], le.Uint32(f.infos[fd][8:])+offset)
+		}
+		backends = append(backends, f)
+		entries = append(entries, map[string]any{"entry": e.Name, "port": e.Port, "handoff": h})
+	}
+	raw, _ := json.Marshal(map[string]any{"schema": HandoffSetSchema, "core_generation": "core-fixed", "entries": entries})
+	return raw, expected, backends
+}
+func factory(fs []*scopedFake) func(int) (backend, error) {
+	return func(i int) (backend, error) { return fs[i], nil }
+}
+func TestOwnerSetReorderedAndConcurrentObserveClose(t *testing.T) {
+	raw, expected, fs := setFixture()
+	var fields map[string]json.RawMessage
+	json.Unmarshal(raw, &fields)
+	var entries []json.RawMessage
+	json.Unmarshal(fields["entries"], &entries)
+	entries[0], entries[1] = entries[1], entries[0]
+	fields["entries"], _ = json.Marshal(entries)
+	raw, _ = json.Marshal(fields)
+	// The factory is config-ordered, not untrusted-array-ordered.
+	set, err := adoptSet(raw, "core-fixed", expected, factory(fs))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if set.Owner("entry-b", 18995) == nil || set.Owner("entry-a", 18995) != nil {
+		t.Fatal("wrong entry binding")
+	}
+	obs := set.Observe()
+	if len(obs.Entries) != 2 || obs.Entries[0].Entry != "entry-a" || !obs.AllUsableObserved {
+		t.Fatalf("%+v", obs)
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 20; j++ {
+				set.Observe()
+			}
+			set.Close()
+		}()
+	}
+	wg.Wait()
+	if set.Owner("entry-a", 18993) != nil || set.Observe().AllUsableObserved {
+		t.Fatal("closed set usable")
+	}
+	for _, f := range fs {
+		if len(f.closed) != len(f.h.orderedFDs()) {
+			t.Fatal("wrong close count", f.closed)
+		}
+		seen := map[int]bool{}
+		for _, fd := range f.closed {
+			if seen[fd] {
+				t.Fatal("double close")
+			}
+			seen[fd] = true
+		}
+	}
+}
+func TestOwnerSetStructuralFailuresConsumeNone(t *testing.T) {
+	for _, fault := range []string{"missing", "duplicate-entry", "duplicate-port", "wrong-port", "generation", "core", "namespace", "fd", "legacy-child", "null", "extra", "bool", "duplicate-json", "trailing", "depth", "oversize"} {
+		t.Run(fault, func(t *testing.T) {
+			raw, expected, fs := setFixture()
+			var v map[string]any
+			json.Unmarshal(raw, &v)
+			es := v["entries"].([]any)
+			a := es[0].(map[string]any)
+			b := es[1].(map[string]any)
+			h := b["handoff"].(map[string]any)
+			switch fault {
+			case "missing":
+				v["entries"] = es[:1]
+			case "duplicate-entry":
+				b["entry"] = a["entry"]
+			case "duplicate-port":
+				b["port"] = a["port"]
+			case "wrong-port":
+				b["port"] = 19000
+			case "generation":
+				h["generation"] = "1"
+			case "core":
+				h["core_generation"] = "other"
+			case "namespace":
+				h["userns_inode"] = 1
+			case "fd":
+				h["maps"].(map[string]any)["capture_config"] = a["handoff"].(map[string]any)["maps"].(map[string]any)["capture_config"]
+			case "legacy-child":
+				h["schema"] = "hoopa-core-identity-handoff-v3"
+			case "null":
+				b["handoff"] = nil
+			case "extra":
+				b["extra"] = 1
+			case "bool":
+				b["port"] = true
+			}
+			raw, _ = json.Marshal(v)
+			switch fault {
+			case "duplicate-json":
+				raw = bytes.Replace(raw, []byte(`"port":18993`), []byte(`"port":18993,"port":18993`), 1)
+			case "trailing":
+				raw = append(raw, []byte(` {}`)...)
+			case "depth":
+				raw = []byte(strings.Repeat("[", 40) + strings.Repeat("]", 40))
+			case "oversize":
+				raw = bytes.Repeat([]byte(" "), 40961)
+			}
+			calls := 0
+			_, err := adoptSet(raw, "core-fixed", expected, func(i int) (backend, error) { calls++; return fs[i], nil })
+			if err == nil || calls != 0 {
+				t.Fatal("structural failure acquired ownership", err, calls)
+			}
+			for _, f := range fs {
+				if len(f.log) != 0 || len(f.closed) != 0 {
+					t.Fatal("parse had effects")
+				}
+			}
+		})
+	}
+	raw, expected, fs := setFixture()
+	_, err := adoptSet(raw, "core-fixed", expected, func(i int) (backend, error) {
+		if i == 1 {
+			return nil, errors.New("backend failure")
+		}
+		return fs[i], nil
+	})
+	if err == nil {
+		t.Fatal("backend failure passed")
+	}
+	for _, f := range fs {
+		if len(f.closed) != 0 {
+			t.Fatal("backend failure consumed FD")
+		}
+	}
+}
+func TestOwnerSetTypedAliasesReadOnlyBeforeAdopt(t *testing.T) {
+	for _, kind := range []string{"map", "program", "link", "within-map", "info", "wrong-kind"} {
+		t.Run(kind, func(t *testing.T) {
+			raw, expected, fs := setFixture()
+			h0, h1 := fs[0].h, fs[1].h
+			switch kind {
+			case "map":
+				le.PutUint32(fs[1].infos[h1.Maps["capture_config"]][4:], le.Uint32(fs[0].infos[h0.Maps["capture_config"]][4:]))
+			case "program":
+				le.PutUint32(fs[1].infos[h1.Programs["hoopa_connect"]][4:], le.Uint32(fs[0].infos[h0.Programs["hoopa_connect"]][4:]))
+			case "link":
+				le.PutUint32(fs[1].infos[h1.Links["hoopa_connect"]][4:], le.Uint32(fs[0].infos[h0.Links["hoopa_connect"]][4:]))
+			case "within-map":
+				le.PutUint32(fs[0].infos[h0.Maps["capture_config"]][4:], le.Uint32(fs[0].infos[h0.Maps["capture_gate"]][4:]))
+			case "wrong-kind":
+				le.PutUint32(fs[1].infos[h1.Maps["capture_config"]], 999)
+			case "info":
+				fs[1].fail = fmt.Sprintf("info:%d", h1.Maps["capture_config"])
+			}
+			if _, err := adoptSet(raw, "core-fixed", expected, factory(fs)); err == nil {
+				t.Fatal("alias/info failure passed")
+			}
+			for _, f := range fs {
+				if len(f.closed) != 21 {
+					t.Fatal("raw set not closed once", len(f.closed))
+				}
+				for _, call := range f.log {
+					if !strings.HasPrefix(call, "info:") && !strings.HasPrefix(call, "close:") && !strings.HasPrefix(call, "access:") && !strings.HasPrefix(call, "program:") {
+						t.Fatal("alias check was not read-only", call)
+					}
+				}
+			}
+		})
+	}
+}
+func TestOwnerSetPartialAdoptionAndCleanupErrors(t *testing.T) {
+	raw, expected, fs := setFixture()
+	fs[1].writableScope = true
+	fs[0].stopErr = errors.New("stop-failure")
+	fs[0].fail = fmt.Sprintf("close:%d", fs[0].h.Maps["capture_config"])
+	set, err := adoptSet(raw, "core-fixed", expected, factory(fs))
+	if err == nil || set != nil || !strings.Contains(err.Error(), "stop-failure") || !strings.Contains(err.Error(), "close") {
+		t.Fatal(set, err)
+	}
+	for _, f := range fs {
+		seen := map[int]bool{}
+		for _, fd := range f.closed {
+			if seen[fd] {
+				t.Fatal("duplicate cleanup")
+			}
+			seen[fd] = true
+		}
+		if len(seen) != 21 {
+			t.Fatal("lost cleanup", len(seen))
+		}
+	}
+}
