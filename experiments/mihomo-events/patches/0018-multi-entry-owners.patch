+package hoopaid
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/metacubex/mihomo/component/identityprofile"
+)
+
+const HandoffSetSchema = "hoopa-core-identity-handoff-set-v1"
+
+type Entry struct {
+	Name string
+	Port uint16
+}
+type EntryOwner struct {
+	Entry      string
+	Port       uint16
+	Generation string
+	Owner      *Owner
+}
+type parsedEntry struct {
+	binding EntryOwner
+	h       handoff
+	raw     []byte
+}
+
+func entryToken(s string) bool {
+	if len(s) < 1 || len(s) > 128 {
+		return false
+	}
+	for i, c := range []byte(s) {
+		alpha := c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+		if !alpha && (i == 0 || !strings.ContainsRune("._:-", rune(c))) {
+			return false
+		}
+	}
+	return true
+}
+
+// CaptureGeneration is an identifier, never an authorization credential.
+func CaptureGeneration(core, entry string, port uint16) (string, error) {
+	if !entryToken(core) || !entryToken(entry) || port == 0 {
+		return "", errors.New("invalid capture generation coordinates")
+	}
+	digest := sha256.Sum256([]byte("hoopa-entry-capture-v1\x00" + core + "\x00" + entry + "\x00" + strconv.Itoa(int(port))))
+	n := binary.BigEndian.Uint64(digest[:8])
+	if n == 0 {
+		return "", errors.New("zero capture generation")
+	}
+	return strconv.FormatUint(n, 10), nil
+}
+
+// New envelope only: bound recursion before typed parsing or ownership.
+func setJSONValue(d *json.Decoder, depth int) error {
+	if depth > 16 {
+		return errors.New("handoff set nesting limit")
+	}
+	t, err := d.Token()
+	if err != nil {
+		return err
+	}
+	if t == nil {
+		return errors.New("null handoff set value")
+	}
+	delim, ok := t.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for d.More() {
+			k, e := d.Token()
+			if e != nil {
+				return e
+			}
+			name, ok := k.(string)
+			if !ok || seen[name] {
+				return errors.New("duplicate JSON key")
+			}
+			seen[name] = true
+			if e = setJSONValue(d, depth+1); e != nil {
+				return e
+			}
+		}
+	case '[':
+		for d.More() {
+			if e := setJSONValue(d, depth+1); e != nil {
+				return e
+			}
+		}
+	default:
+		return errors.New("unexpected JSON delimiter")
+	}
+	_, err = d.Token()
+	return err
+}
+func exactObject(raw []byte, names ...string) (map[string]json.RawMessage, error) {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return nil, err
+	}
+	if len(fields) != len(names) {
+		return nil, errors.New("unexpected set field count")
+	}
+	for _, name := range names {
+		if _, ok := fields[name]; !ok {
+			return nil, fmt.Errorf("missing set field %s", name)
+		}
+	}
+	return fields, nil
+}
+func parseSet(raw []byte, core string, expected []Entry) ([]parsedEntry, error) {
+	if len(raw) < 1 || len(raw) > 40960 || !entryToken(core) || len(expected) < 2 || len(expected) > 4 {
+		return nil, errors.New("invalid handoff set bounds")
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	if err := setJSONValue(d, 0); err != nil {
+		return nil, err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return nil, errors.New("trailing set JSON")
+	}
+	fields, err := exactObject(raw, "schema", "core_generation", "entries")
+	if err != nil {
+		return nil, err
+	}
+	var schema, generation string
+	if json.Unmarshal(fields["schema"], &schema) != nil || json.Unmarshal(fields["core_generation"], &generation) != nil || schema != HandoffSetSchema || generation != core {
+		return nil, errors.New("set schema/core generation mismatch")
+	}
+	var rows []json.RawMessage
+	if json.Unmarshal(fields["entries"], &rows) != nil || len(rows) != len(expected) {
+		return nil, errors.New("set entry census mismatch")
+	}
+	expectedByName := map[string]uint16{}
+	ports := map[uint16]bool{}
+	for _, e := range expected {
+		if !entryToken(e.Name) || e.Port == 0 || expectedByName[e.Name] != 0 || ports[e.Port] {
+			return nil, errors.New("invalid expected entry inventory")
+		}
+		expectedByName[e.Name] = e.Port
+		ports[e.Port] = true
+	}
+	byName := map[string]parsedEntry{}
+	allFDs := map[int]bool{}
+	captures := map[string]bool{}
+	var common *handoff
+	for _, rawRow := range rows {
+		row, e := exactObject(rawRow, "entry", "port", "handoff")
+		if e != nil {
+			return nil, e
+		}
+		var name string
+		var port uint16
+		if json.Unmarshal(row["entry"], &name) != nil || json.Unmarshal(row["port"], &port) != nil || !entryToken(name) || port == 0 || expectedByName[name] != port {
+			return nil, errors.New("unexpected entry/port binding")
+		}
+		if _, ok := byName[name]; ok {
+			return nil, errors.New("duplicate entry")
+		}
+		h, e := parse(row["handoff"])
+		if e != nil {
+			return nil, e
+		}
+		capture, e := CaptureGeneration(core, name, port)
+		if e != nil || h.Schema != identityprofile.HandoffSchema || h.CoreGeneration != core || h.Port != port || h.Generation != capture || captures[capture] {
+			return nil, errors.New("child profile/port/generation mismatch")
+		}
+		captures[capture] = true
+		if common != nil && (h.BootID != common.BootID || h.PIDNSInode != common.PIDNSInode || h.UserNSInode != common.UserNSInode || h.MountNSInode != common.MountNSInode || h.SourcePath != common.SourcePath || h.SourceCgroupID != common.SourceCgroupID || h.RootCgroupID != common.RootCgroupID || h.NetnsCookie != common.NetnsCookie) {
+			return nil, errors.New("child common environment mismatch")
+		}
+		if common == nil {
+			copy := h
+			common = &copy
+		}
+		for _, fd := range h.orderedFDs() {
+			if allFDs[fd] {
+				return nil, errors.New("cross-entry FD alias")
+			}
+			allFDs[fd] = true
+		}
+		byName[name] = parsedEntry{binding: EntryOwner{Entry: name, Port: port, Generation: capture}, h: h, raw: append([]byte(nil), row["handoff"]...)}
+	}
+	result := make([]parsedEntry, 0, len(expected))
+	for _, e := range expected {
+		row, ok := byName[e.Name]
+		if !ok {
+			return nil, errors.New("missing entry")
+		}
+		result = append(result, row)
+	}
+	return result, nil
+}
+
+type OwnerSet struct {
+	mu       sync.Mutex
+	entries  []EntryOwner
+	closed   bool
+	closeErr error
+}
+
+func AdoptSet(raw []byte, core string, expected []Entry) (*OwnerSet, error) {
+	return adoptSet(raw, core, expected, func(int) (backend, error) { return newBackend() })
+}
+func adoptSet(raw []byte, core string, expected []Entry, construct func(int) (backend, error)) (*OwnerSet, error) {
+	entries, err := parseSet(raw, core, expected)
+	if err != nil {
+		return nil, err
+	}
+	backends := make([]backend, len(entries))
+	for i := range entries {
+		backends[i], err = construct(i)
+		if err != nil {
+			return nil, err
+		}
+		if backends[i] == nil {
+			return nil, errors.New("nil set backend")
+		}
+	}
+	// Complete parse and all backend construction precede descriptor ownership.
+	rawOwned := make([]bool, len(entries))
+	for i := range rawOwned {
+		rawOwned[i] = true
+	}
+	set := &OwnerSet{}
+	fail := func(primary error) (*OwnerSet, error) {
+		errs := []error{primary}
+		for i := len(entries) - 1; i >= 0; i-- {
+			if rawOwned[i] {
+				rawOwned[i] = false
+				fds := entries[i].h.orderedFDs()
+				for j := len(fds) - 1; j >= 0; j-- {
+					if e := backends[i].close(fds[j]); e != nil {
+						errs = append(errs, fmt.Errorf("raw close fd %d: %w", fds[j], e))
+					}
+				}
+			}
+		}
+		errs = append(errs, set.Close())
+		return nil, errors.Join(errs...)
+	}
+	// Typed object IDs must be read from each actual FD, before legacy adopt's
+	// initialState frozen-write probe or any TEST_RUN. Kernel BTF may be shared.
+	seen := []map[uint32]bool{{}, {}, {}}
+	for i, e := range entries {
+		for kind, group := range []map[string]int{e.h.Maps, e.h.Programs, e.h.Links} {
+			for _, fd := range group {
+				raw, readErr := backends[i].info(fd)
+				if readErr != nil {
+					return fail(readErr)
+				}
+				if len(raw) < 8 {
+					return fail(errors.New("short typed object info"))
+				}
+				id := le.Uint32(raw[4:])
+				if id == 0 || seen[kind][id] {
+					return fail(errors.New("typed kernel object alias"))
+				}
+				seen[kind][id] = true
+			}
+		}
+	}
+	// Validate every declared FD's actual ABI/role read-only before the first
+	// child's freeze probe. A mismatched kind must not hide an object alias in a
+	// different declared group. These temporary inspectors never own/close FDs.
+	for i, e := range entries {
+		inspector := &Owner{h: e.h, b: backends[i], programIDs: map[string]uint32{}, linkIDs: map[string]uint32{}}
+		if err := inspector.verifyObjects(); err != nil {
+			return fail(err)
+		}
+	}
+	for i, e := range entries {
+		rawOwned[i] = false // Existing internal adopt owns this parsed-valid subset.
+		owner, eAdopt := adopt(e.raw, core, e.binding.Port, backends[i])
+		if eAdopt != nil {
+			return fail(eAdopt)
+		}
+		binding := e.binding
+		binding.Owner = owner
+		set.entries = append(set.entries, binding)
+	}
+	return set, nil
+}
+func (s *OwnerSet) Entries() []EntryOwner {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]EntryOwner(nil), s.entries...)
+}
+func (s *OwnerSet) Owner(name string, port uint16) *Owner {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	for _, e := range s.entries {
+		if e.Entry == name && e.Port == port {
+			return e.Owner
+		}
+	}
+	return nil
+}
+func (s *OwnerSet) Close() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return s.closeErr
+	}
+	s.closed = true
+	var errs []error
+	for i := len(s.entries) - 1; i >= 0; i-- {
+		if s.entries[i].Owner != nil {
+			errs = append(errs, s.entries[i].Owner.Close())
+		}
+	}
+	s.closeErr = errors.Join(errs...)
+	return s.closeErr
+}
+
+type EntryObservation struct {
+	Entry             string              `json:"entry"`
+	Port              uint16              `json:"port"`
+	CaptureGeneration string              `json:"capture_generation"`
+	Status            *Status             `json:"status,omitempty"`
+	Diagnostics       *CaptureDiagnostics `json:"diagnostics,omitempty"`
+	Unavailable       string              `json:"unavailable,omitempty"`
+}
+type EntryObservations struct {
+	Schema            string             `json:"schema"`
+	Observation       string             `json:"observation"`
+	Entries           []EntryObservation `json:"entries"`
+	AllUsableObserved bool               `json:"all_usable_observed"`
+}
+
+func (s *OwnerSet) Observe() EntryObservations {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	result := EntryObservations{Schema: "hoopa-entry-admission-observation-v1", Observation: "sequential_reads", Entries: make([]EntryObservation, 0, len(s.entries)), AllUsableObserved: len(s.entries) >= 2 && !s.closed}
+	for _, e := range s.entries {
+		row := EntryObservation{Entry: e.Entry, Port: e.Port, CaptureGeneration: e.Generation}
+		if e.Owner == nil {
+			row.Unavailable = "owner_unavailable"
+			result.AllUsableObserved = false
+		} else {
+			status := e.Owner.Status()
+			diagnostics := e.Owner.Diagnostics()
+			row.Status = &status
+			row.Diagnostics = &diagnostics
+			if status.Revoked || diagnostics.State != "no_fault_observed" || diagnostics.Incomplete {
+				result.AllUsableObserved = false
+			}
+		}
+		result.Entries = append(result.Entries, row)
+	}
+	return result
+}
