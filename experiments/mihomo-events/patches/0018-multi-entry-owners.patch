+	}
+	if f, err := Begin("unknown", nil, nil, "", "", time.Now()); f != nil || err != nil {
+		t.Fatal("unknown Begin selected")
+	}
+	if f, err := Begin("entry-b", nil, nil, "", "", time.Now()); f != nil || err == nil {
+		t.Fatal("selected Begin bypassed source5 proof requirement")
+	}
+
+	if mode == "new-then-legacy" {
+		if PrepareGuard(generation, expected) == nil {
+			t.Fatal("new selection accepted legacy preparation")
+		}
+		return
+	}
+	switch mode {
+	case "changed-entries":
+		entries = []string{"entry-a", "entry-c"}
+	case "changed-generation":
+		generation = "other"
+	case "changed-routes":
+		expected[node] = "Direct"
+	case "changed-optin":
+		opt = ProgramRuleProfileID
+	}
+	if strings.HasPrefix(mode, "changed-") {
