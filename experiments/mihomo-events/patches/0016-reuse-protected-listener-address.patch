+func TestHoopaGuardReservationNoListen(t *testing.T) {
+	guardNetworkTest(t)
+	address := guardFreeAddress(t)
+	first := guardReserve(t, address)
+	second := guardReserve(t, address)
+	if conn, err := net.DialTimeout("tcp4", address, 100*time.Millisecond); err == nil {
+		_ = conn.Close()
+		t.Fatal("reusable reservations were listening")
+	}
+	_ = guardListen(t, first)
+	if duplicate, err := Listen(second); err == nil {
+		_ = duplicate.Close()
+		t.Fatal("second reservation displaced live listener")
+	}
+	if duplicate, err := Reserve(address); err == nil {
+		_ = duplicate.Close()
+		t.Fatal("new reservation displaced live listener")
+	}
+}
