+func TestHoopaGuardImmediateRebindWithOldClientOpen(t *testing.T) {
+	guardNetworkTest(t)
+	address := guardFreeAddress(t)
+	oldListener := guardListen(t, guardReserve(t, address))
+	oldClient := guardConnect(t, address)
+	oldPeer := guardAccept(t, oldListener)
+	// Server initiates close while the client retains its socket after EOF.
+	if err := oldPeer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := oldListener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var byteBuffer [1]byte
+	if n, err := oldClient.Read(byteBuffer[:]); n != 0 || err != io.EOF {
+		t.Fatalf("old client expected EOF, n=%d err=%v", n, err)
+	}
+
+	// No TIME_WAIT delay, client close, SO_LINGER or system setting change.
+	newListener := guardListen(t, guardReserve(t, address))
+	newClient := guardConnect(t, address)
+	newPeer := guardAccept(t, newListener)
+	request := []byte("new-core")
+	if n, err := newClient.Write(request); n != len(request) || err != nil {
+		t.Fatalf("new client write n=%d err=%v", n, err)
+	}
+	got := make([]byte, len(request))
+	if _, err := io.ReadFull(newPeer, got); err != nil || string(got) != string(request) {
+		t.Fatalf("new peer read %q err=%v", got, err)
+	}
+	if n, err := newPeer.Write(got); n != len(got) || err != nil {
+		t.Fatalf("new peer write n=%d err=%v", n, err)
+	}
+	if _, err := io.ReadFull(newClient, got); err != nil || string(got) != string(request) {
+		t.Fatalf("new client echo %q err=%v", got, err)
+	}
+}
