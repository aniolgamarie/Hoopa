diff --git a/component/hoopatrace/quality_linux.go b/component/hoopatrace/quality_linux.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/quality_linux.go
@@ -0,0 +1,331 @@
+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/metacubex/mihomo/component/hoopatrace/telemetrywire"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type routeMapping struct {
+	SchemaVersion    int          `json:"schema_version"`
+	ConfigGeneration string       `json:"config_generation"`
+	Entries          []routeEntry `json:"entries"`
+}
+type routeEntry struct {
+	InternalName string  `json:"internal_name"`
+	AdapterType  string  `json:"adapter_type"`
+	ProviderName string  `json:"provider_name"`
+	NodeID       *string `json:"node_id"`
+	ProviderID   *string `json:"provider_id"`
+	GroupID      *string `json:"group_id"`
+	DisplayAlias string  `json:"display_alias"`
+}
+
+// The opt-in mapping is immutable for this source's config generation. Missing
+// mappings leave actual raw hops unmapped. A supplied conflicting mapping fails.
+func loadRouteMapping(path, generation string) (map[string]routeEntry, error) {
+	out := map[string]routeEntry{}
+	if path == "" {
+		return out, nil
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, ErrSource
+	}
+	defer f.Close()
+	fi, err := f.Stat()
+	if err != nil || !fi.Mode().IsRegular() || fi.Mode().Perm() != 0600 || fi.Size() > 65536 {
+		return nil, ErrSource
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, 65537))
+	if err != nil || len(raw) > 65536 {
+		return nil, ErrSource
+	}
+	// Reject duplicate keys recursively before typed parsing.
+	d := json.NewDecoder(strings.NewReader(string(raw)))
+	if !uniqueJSONValue(d) {
+		return nil, ErrSource
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return nil, ErrSource
+	}
+	d = json.NewDecoder(strings.NewReader(string(raw)))
+	d.DisallowUnknownFields()
+	var m routeMapping
+	if d.Decode(&m) != nil || m.SchemaVersion != 1 || m.ConfigGeneration != generation || len(m.Entries) > 64 {
+		return nil, ErrSource
+	}
+	for _, e := range m.Entries {
+		if !token(e.InternalName) || e.AdapterType == "" || e.DisplayAlias == "" || len(e.DisplayAlias) > 256 {
+			return nil, ErrSource
+		}
+		if _, ok := out[e.InternalName]; ok {
+			return nil, ErrSource
+		}
+		if (e.NodeID == nil) == (e.GroupID == nil) {
+			return nil, ErrSource
+		}
+		if e.NodeID != nil && (*e.NodeID != e.InternalName || !strings.HasPrefix(*e.NodeID, "node:")) {
+			return nil, ErrSource
+		}
+		if e.GroupID != nil && (*e.GroupID != e.InternalName || !strings.HasPrefix(*e.GroupID, "group:") || e.ProviderID != nil || e.ProviderName != "") {
+			return nil, ErrSource
+		}
+		if e.ProviderName == "" && e.ProviderID != nil || e.ProviderName != "" && (e.ProviderID == nil || *e.ProviderID != e.ProviderName || !strings.HasPrefix(*e.ProviderID, "provider:")) {
+			return nil, ErrSource
+		}
+		out[e.InternalName] = e
+	}
+	return out, nil
+}
+func uniqueJSONValue(d *json.Decoder) bool {
+	t, err := d.Token()
+	if err != nil {
+		return false
+	}
+	switch t {
+	case json.Delim('{'):
+		keys := map[string]bool{}
+		for d.More() {
+			k, err := d.Token()
+			s, ok := k.(string)
+			if err != nil || !ok || keys[s] {
+				return false
+			}
+			keys[s] = true
+			if !uniqueJSONValue(d) {
+				return false
+			}
+		}
+		t, err = d.Token()
+		return err == nil && t == json.Delim('}')
+	case json.Delim('['):
+		for d.More() {
+			if !uniqueJSONValue(d) {
+				return false
+			}
+		}
+		t, err = d.Token()
+		return err == nil && t == json.Delim(']')
+	}
+	_, delim := t.(json.Delim)
+	return !delim
+}
+
+func (a *Attempt) Attach(c C.Conn) error {
+	if a == nil || a.f.s.profile != 2 || c == nil {
+		return nil
+	}
+	f := a.f
+	e := C.HoopaEvidenceOf(c)
+	// Unknown Conn implementations still get an actual reference, but no proof.
+	if e.Ref == "" {
+		var err error
+		e.Ref, err = randomID("conn:")
+		if err != nil {
+			return err
+		}
+		e.Kind = "ready_unproven"
+		e.Protocol = "unknown"
+	}
+	hops := []telemetrywire.RouteHop{}
+	for _, h := range e.Hops {
+		hop := telemetrywire.RouteHop{InternalName: h.Name, AdapterType: h.AdapterType, ProviderName: h.ProviderName}
+		if m, ok := f.s.routes[h.Name]; ok {
+			if m.AdapterType != h.AdapterType || m.ProviderName != h.ProviderName {
+				return ErrSource
+			}
+			hop.NodeID, hop.ProviderID, hop.GroupID = m.NodeID, m.ProviderID, m.GroupID
+		}
+		hops = append(hops, hop)
+	}
+	// If a wrapper has no explicit route evidence, raw Connection.Chains remains
+	// observed evidence but has no verified adapter type or stable ID.
+	if len(hops) == 0 {
+		for i, name := range c.Chains() {
+			provider := ""
+			if i < len(c.ProviderChains()) {
+				provider = c.ProviderChains()[i]
+			}
+			hops = append(hops, telemetrywire.RouteHop{InternalName: name, AdapterType: "unverified", ProviderName: provider})
+		}
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.terminal || len(f.segments) >= 10 || a.segment != nil {
+		return ErrSource
+	}
+	if err := f.s.append(f, "route_decided", a.id, map[string]any{"phase": "actual_connection", "actual_connection_ref": e.Ref, "ordered_chain": hops}); err != nil {
+		f.invalid = true
+		return err
+	}
+	a.proof = e
+	a.segment = &segmentCounter{ActualConnectionRef: e.Ref, AttemptID: a.id}
+	f.segments = append(f.segments, a.segment)
+	return nil
+}
+
+type segmentCounter struct {
+	ActualConnectionRef string `json:"actual_connection_ref"`
+	AttemptID           string `json:"attempt_id"`
+	UploadBytes         uint64 `json:"upload_bytes,string"`
+	DownloadBytes       uint64 `json:"download_bytes,string"`
+}
+
+// These adapters capture a particular attempt, so a retry cannot reassign old
+// bytes to the final connection. All cumulative updates share the flow lock.
+func (a *Attempt) AddUpload(n int) {
+	if a != nil {
+		a.f.addSegment(a.segment, n, true)
+	}
+}
+func (a *Attempt) AddDownload(n int) {
+	if a != nil {
+		a.f.addSegment(a.segment, n, false)
+	}
+}
+func (a *Attempt) Close() {
+	if a != nil {
+		a.f.Close()
+	}
+}
+func (a *Attempt) Bind(id string) {
+	if a != nil {
+		a.f.bindSegment(id, a)
+	}
+}
+func (f *Flow) addSegment(seg *segmentCounter, n int, upload bool) {
+	if f == nil || n <= 0 {
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.terminal {
+		return
+	}
+	total, bucket := &f.down, &f.unallocatedDown
+	if upload {
+		total, bucket = &f.up, &f.unallocatedUp
+	}
+	if seg != nil {
+		if upload {
+			bucket = &seg.UploadBytes
+		} else {
+			bucket = &seg.DownloadBytes
+		}
+	}
+	if ^uint64(0)-*total < uint64(n) || ^uint64(0)-*bucket < uint64(n) {
+		f.invalid = true
+		f.counterInvalid = true
+		return
+	}
+	*total += uint64(n)
+	*bucket += uint64(n)
+}
+func (f *Flow) counterExtra() map[string]any {
+	m := map[string]any{"upload_bytes": strconv.FormatUint(f.up, 10), "download_bytes": strconv.FormatUint(f.down, 10)}
+	if f.s.profile == 2 {
+		values := make([]segmentCounter, 0, len(f.segments))
+		for _, s := range f.segments {
+			values = append(values, *s)
+		}
+		m["segments"] = values
+		m["unallocated_upload_bytes"] = strconv.FormatUint(f.unallocatedUp, 10)
+		m["unallocated_download_bytes"] = strconv.FormatUint(f.unallocatedDown, 10)
+	}
+	return m
+}
+func (f *Flow) bindSegment(id string, a *Attempt) {
+	if f.s.profile != 2 {
+		f.Bind(id)
+		return
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.connection = id
+	if a.segment == nil {
+		f.invalid = true
+		return
+	}
+	if f.s.append(f, "route_decided", a.id, map[string]any{"phase": "connection_binding", "connection_id": id, "actual_connection_ref": a.segment.ActualConnectionRef}) != nil {
+		f.invalid = true
+	}
+}
+func numberNS(t time.Time) string { return strconv.FormatInt(C.HoopaMonotonicNS(t), 10) }
+func (a *Attempt) finishQuality(err error, stage string) {
+	// Capture before flow lock/Sync. The protocol point was captured on the Conn.
+	finish := time.Now()
+	f := a.f
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	p := a.proof
+	kind, protocol, reason := "ready_unproven", "unknown", "ready_unknown"
+	var ready, duration, flowDuration, ref any
+	if a.segment != nil {
+		ref = a.segment.ActualConnectionRef
+	}
+	if !p.ReadyAt.IsZero() && !p.ReadyAt.Before(a.started) && !p.ReadyAt.After(finish) && ref != nil {
+		kind, protocol, reason = p.Kind, p.Protocol, ""
+		ready = numberNS(p.ReadyAt)
+	}
+	outcome := "unknown"
+	if err != nil {
+		outcome = "failure"
+		if errors.Is(err, context.Canceled) {
+			outcome = "cancelled"
+		} else {
+			var ne net.Error
+			if errors.Is(err, context.DeadlineExceeded) || errors.As(err, &ne) && ne.Timeout() {
+				outcome = "timeout"
+			}
+		}
+	} else if ready != nil {
+		outcome = "success"
+		duration = strconv.FormatInt(p.ReadyAt.Sub(a.started).Milliseconds(), 10)
+		flowDuration = strconv.FormatInt(p.ReadyAt.Sub(f.started).Milliseconds(), 10)
+	}
+	if err == nil {
+		stage = ""
+	}
+	extra := map[string]any{"definition": "forward_setup_v2", "protocol": protocol, "ready_kind": kind, "outcome": outcome, "reason": reason, "failure_stage": stage, "flow_start_ns": numberNS(f.started), "attempt_start_ns": numberNS(a.started), "ready_ns": ready, "finish_ns": numberNS(finish), "duration_ms": duration, "flow_duration_ms": flowDuration, "observed_wait_ms": strconv.FormatInt(finish.Sub(a.started).Milliseconds(), 10), "flow_observed_wait_ms": strconv.FormatInt(finish.Sub(f.started).Milliseconds(), 10), "actual_connection_ref": ref}
+	if f.s.append(f, "setup_finished", a.id, extra) != nil {
+		f.invalid = true
+	}
+}
+
+func (a *Attempt) FinishConnection(err error, stage string, c C.Conn, legacyReady bool) {
+	if a == nil {
+		return
+	}
+	if a.f.s.profile == 2 {
+		a.once.Do(func() { a.finishQuality(err, stage) })
+		return
+	}
+	var chains, providers []string
+	if c != nil {
+		chains = append([]string{}, c.Chains()...)
+		providers = append([]string{}, c.ProviderChains()...)
+	}
+	a.Finish(err, chains, providers, legacyReady)
+}
+
+// Attempt zero is the pre-dial setup interval, starting at target_known. It only
+// emits a failure when metadata/routing actually aborts before a Dial attempt.
+func (f *Flow) FailBeforeDial(err error) {
+	if f == nil || f.s.profile != 2 || err == nil {
+		return
+	}
+	a := &Attempt{f: f, id: f.id + ":attempt:0", started: f.started}
+	a.FinishConnection(err, "pre_route", nil, false)
+}
diff --git a/component/hoopatrace/quality_linux_test.go b/component/hoopatrace/quality_linux_test.go
new file mode 100644
--- /dev/null
+++ b/component/hoopatrace/quality_linux_test.go
@@ -0,0 +1,227 @@
+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"context"
+	"errors"
+	"github.com/metacubex/mihomo/component/hoopatrace/telemetrywire"
+	C "github.com/metacubex/mihomo/constant"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+type qualityConn struct {
+	C.Conn
+	proof C.HoopaConnEvidence
+}
+
+func (c qualityConn) HoopaEvidence() C.HoopaConnEvidence { return c.proof }
+func newQualityFlow(t *testing.T) (*source, *Flow) {
+	t.Helper()
+	t.Setenv("HOOPA_TRACE_PROFILE", "2")
+	s := testSource(t, defaultLimit)
+	f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s, f
+}
+func qualityAttach(t *testing.T, a *Attempt, ref string, ready bool) qualityConn {
+	t.Helper()
+	p := C.HoopaConnEvidence{Ref: ref, Kind: "ready_unproven", Protocol: "unknown", Hops: []C.HoopaHop{{Name: "node:a", AdapterType: "Http"}}}
+	if ready {
+		p.ReadyAt = time.Now()
+		p.Kind = "http_connect_accepted"
+		p.Protocol = "http_connect"
+	}
+	c := qualityConn{proof: p}
+	if err := a.Attach(c); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+func TestQualitySegmentsRetryAndCheckpoint(t *testing.T) {
+	s, f := newQualityFlow(t)
+	first := f.NewAttempt()
+	c1 := qualityAttach(t, first, "conn:a", false)
+	first.AddUpload(3)
+	first.FinishConnection(io.ErrShortWrite, "initial_write", c1, false)
+	second := f.NewAttempt()
+	c2 := qualityAttach(t, second, "conn:b", true)
+	second.FinishConnection(nil, "", c2, false)
+	second.Bind("tracker:b")
+	var wg sync.WaitGroup
+	for k := 0; k < 2; k++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 100; i++ {
+				second.AddUpload(1)
+				second.AddDownload(2)
+			}
+		}()
+	}
+	for i := 0; i < 10; i++ {
+		if err := f.Checkpoint(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	wg.Wait()
+	f.AddUpload(7)
+	f.Close()
+	var final telemetrywire.SourceEvent
+	for _, raw := range frames(t, s) {
+		e, err := telemetrywire.DecodeSourceEvent(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if e.Kind == "closed" {
+			final = e
+		}
+	}
+	if final.Counter == nil || final.Counter.UploadBytes != 210 || final.Counter.DownloadBytes != 400 || len(final.Segments) != 2 || final.Segments[0].UploadBytes != 3 || final.Segments[1].UploadBytes != 200 || final.UnallocatedUpload != 7 {
+		t.Fatalf("wrong segment totals: %+v", final)
+	}
+}
+func TestQualityReadySeparateFromFinishAndErrorOutcome(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		err     error
+		proof   bool
+		outcome string
+	}{{"success", nil, true, "success"}, {"failure", io.ErrUnexpectedEOF, false, "failure"}, {"timeout", context.DeadlineExceeded, false, "timeout"}, {"cancelled", context.Canceled, false, "cancelled"}, {"lazy", nil, false, "unknown"}} {
+		t.Run(tc.name, func(t *testing.T) {
+			s, f := newQualityFlow(t)
+			a := f.NewAttempt()
+			c := qualityAttach(t, a, "conn:a", tc.proof)
+			ready := c.proof.ReadyAt
+			time.Sleep(25 * time.Millisecond)
+			a.FinishConnection(tc.err, "initial_write", c, true)
+			f.Close()
+			for _, raw := range frames(t, s) {
+				e, _ := telemetrywire.DecodeSourceEvent(raw)
+				if e.Quality == nil {
+					continue
+				}
+				q := e.Quality
+				if q.Outcome != tc.outcome {
+					t.Fatalf("outcome=%s", q.Outcome)
+				}
+				if tc.proof {
+					if q.ReadyNS == nil || *q.ReadyNS != uint64(C.HoopaMonotonicNS(ready)) || q.DurationMS == nil || q.ObservedWaitMS < *q.DurationMS+20 {
+						t.Fatal("finish replaced protocol point")
+					}
+				} else if q.ReadyNS != nil || q.DurationMS != nil || q.Reason != "ready_unknown" {
+					t.Fatal("unproved ready became success")
+				}
+			}
+		})
+	}
+}
+func TestQualityReopenRetainsV1AndV2Epochs(t *testing.T) {
+	dir := t.TempDir()
+	os.Chmod(dir, 0700)
+	for _, profile := range []string{"1", "2"} {
+		t.Setenv("HOOPA_TRACE_PROFILE", profile)
+		s, err := openSource(dir, "generation", "", "", defaultLimit)
+		if err != nil {
+			t.Fatal(err)
+		}
+		f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if profile == "2" {
+			a := f.NewAttempt()
+			c := qualityAttach(t, a, "conn:a", true)
+			a.FinishConnection(nil, "", c, false)
+			a.AddUpload(11)
+		} else {
+			f.AddUpload(7)
+		}
+		f.Close()
+		if err = s.shutdown(); err != nil {
+			t.Fatal(err)
+		}
+		s.close()
+	}
+	before := map[string]string{}
+	entries, _ := os.ReadDir(dir)
+	for _, e := range entries {
+		if filepath.Ext(e.Name()) != ".lock" {
+			b, _ := os.ReadFile(filepath.Join(dir, e.Name()))
+			before[e.Name()] = string(b)
+		}
+	}
+	s, err := openSource(dir, "generation", "", "", defaultLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.close()
+	if len(s.reports) != 2 {
+		t.Fatalf("reports=%d", len(s.reports))
+	}
+	for name, b := range before {
+		now, _ := os.ReadFile(filepath.Join(dir, name))
+		if string(now) != b {
+			t.Fatal("old epoch changed")
+		}
+	}
+}
+func TestQualityMappingMismatchFailsBeforeRegistration(t *testing.T) {
+	s, f := newQualityFlow(t)
+	name := "node:a"
+	s.routes = map[string]routeEntry{name: {InternalName: name, AdapterType: "Socks5", NodeID: &name, DisplayAlias: "alias"}}
+	a := f.NewAttempt()
+	err := a.Attach(qualityConn{proof: C.HoopaConnEvidence{Ref: "conn:a", Hops: []C.HoopaHop{{Name: name, AdapterType: "Http"}}}})
+	if !errors.Is(err, ErrSource) || len(f.segments) != 0 {
+		t.Fatal("mapping mismatch admitted")
+	}
+	a.FinishConnection(err, "dial_or_handshake", nil, false)
+	f.Close()
+}
+
+func TestQualityFlowPreDialWaitAndAbortedRoute(t *testing.T) {
+	for _, aborted := range []bool{false, true} {
+		name := "success"
+		if aborted {
+			name = "aborted"
+		}
+		t.Run(name, func(t *testing.T) {
+			s, f := newQualityFlow(t)
+			time.Sleep(70 * time.Millisecond)
+			if aborted {
+				f.FailBeforeDial(context.DeadlineExceeded)
+			} else {
+				a := f.NewAttempt()
+				c := qualityAttach(t, a, "conn:a", true)
+				a.FinishConnection(nil, "", c, false)
+			}
+			f.Close()
+			seen := false
+			for _, raw := range frames(t, s) {
+				e, _ := telemetrywire.DecodeSourceEvent(raw)
+				if e.Quality == nil {
+					continue
+				}
+				seen = true
+				q := e.Quality
+				if aborted {
+					if q.Outcome != "timeout" || q.FailureStage != "pre_route" || q.ActualConnectionRef != nil || q.DurationMS != nil || q.AttemptStartNS != q.FlowStartNS || q.ObservedWaitMS < 65 {
+						t.Fatal("pre-route failure lost")
+					}
+				} else if q.DurationMS == nil || q.FlowDurationMS == nil || *q.FlowDurationMS < *q.DurationMS+65 {
+					t.Fatal("pre-dial wait lost from flow")
+				}
+			}
+			if !seen {
+				t.Fatal("no setup sample")
+			}
+		})
+	}
+}
