+type qualityRuleDNS struct{ resolver.Resolver }
+
+func (qualityRuleDNS) Invalid() bool { return true }
+func (qualityRuleDNS) LookupIP(ctx context.Context, _ string) ([]netip.Addr, error) {
+	select {
+	case <-time.After(90 * time.Millisecond):
+		return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+func (d qualityRuleDNS) LookupIPv4(ctx context.Context, h string) ([]netip.Addr, error) {
+	return d.LookupIP(ctx, h)
+}
+func TestHoopaQualityRuleDNSBelongsToFlow(t *testing.T) {
+	dir := t.TempDir()
+	os.Chmod(dir, 0700)
+	t.Setenv("HOOPA_TRACE_PROFILE", "2")
+	t.Setenv("HOOPA_TRACE_DIR", dir)
+	t.Setenv("HOOPA_TRACE_GENERATION", "dns-generation")
+	t.Setenv("HOOPA_TRACE_INBOUND", "dns-test")
+	t.Setenv("HOOPA_TRACE_ROUTE_MAP", "")
+	t.Setenv("HOOPA_TRACE_RECEIVER", "")
+	oldEnabled, oldResolver, oldRules, oldProxies, oldMode := C.HoopaQualityEnabled, resolver.DefaultResolver, rules, proxies, mode
+	defer func() {
+		C.HoopaQualityEnabled, resolver.DefaultResolver, rules, proxies, mode = oldEnabled, oldResolver, oldRules, oldProxies, oldMode
+	}()
+	C.HoopaQualityEnabled = true
+	resolver.DefaultResolver = qualityRuleDNS{}
+	mode = Rule
+	direct := &qualityRuleDirect{}
+	ipRule, err := common.NewIPCIDR("127.0.0.0/8", "node:direct")
+	if err != nil {
+		t.Fatal(err)
+	}
+	rules = []C.Rule{ipRule}
+	proxies = map[string]C.Proxy{"DIRECT": direct, "node:direct": direct}
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		c, err := ln.Accept()
+		if err == nil {
+			c.Close()
+		}
+	}()
+	started := time.Now()
+	f, err := hoopatrace.Begin("dns-test", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32000}, &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 32001}, "rule-slow.invalid", "", started)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer hoopatrace.Shutdown()
+	metadata := &C.Metadata{Host: "rule-slow.invalid", DstPort: uint16(ln.Addr().(*net.TCPAddr).Port), HoopaFlowID: f.ID(), NetWork: C.TCP}
+	beforeDNS := time.Now()
+	proxy, rule, err := resolveMetadata(metadata)
+	afterDNS := time.Now()
+	if err != nil || rule != ipRule || proxy != direct || afterDNS.Sub(beforeDNS) < 85*time.Millisecond {
+		t.Fatal("rule DNS fixture did not resolve", err)
+	}
+	a := f.NewAttempt()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c, err := proxy.DialContext(ctx, metadata.Pure())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	<-done
+	if err = a.Attach(c); err != nil {
+		t.Fatal(err)
+	}
+	a.FinishConnection(nil, "", c, false)
+	f.Close()
+	hoopatrace.Shutdown()
+	paths, _ := filepath.Glob(filepath.Join(dir, "*.frames"))
+	if len(paths) != 1 {
+		t.Fatal("source file missing")
+	}
+	data, err := os.Open(paths[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer data.Close()
+	var state W.State
+	found := false
+	for {
+		var h [4]byte
+		if _, err = io.ReadFull(data, h[:]); err == io.EOF {
+			break
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		n := binary.BigEndian.Uint32(h[:])
+		b := make([]byte, n+32)
+		if _, err = io.ReadFull(data, b); err != nil {
+			t.Fatal(err)
+		}
+		e, err := W.DecodeSourceEvent(b[:n])
+		if err != nil || state.Commit(e) != nil {
+			t.Fatal("invalid source event", err)
+		}
+		if e.Quality == nil {
+			continue
+		}
+		found = true
+		q := e.Quality
+		if q.Outcome != "success" || q.FlowDurationMS == nil || q.DurationMS == nil || *q.FlowDurationMS < *q.DurationMS+85 || q.AttemptStartNS < uint64(C.HoopaMonotonicNS(afterDNS)) || q.FlowStartNS != uint64(C.HoopaMonotonicNS(started)) {
+			t.Fatalf("wrong DNS/attempt boundary: %+v", q)
+		}
+	}
+	if !found {
+		t.Fatal("no quality event")
+	}
+}
+
+// Test-only direct dialer isolates the actual rule DNS boundary from unrelated
+// outbound package imports (outbound imports dns, which imports tunnel).
+type qualityRuleDirect struct{ hoopaProxyFake }
+
+func (*qualityRuleDirect) DialContext(ctx context.Context, m *C.Metadata) (C.Conn, error) {
+	if !m.DstIP.IsLoopback() {
+		return nil, fmt.Errorf("fixture requires resolved loopback")
+	}
+	c, err := (&net.Dialer{}).DialContext(ctx, "tcp4", net.JoinHostPort(m.DstIP.String(), fmt.Sprint(m.DstPort)))
+	if err != nil {
+		return nil, err
+	}
+	return &qualityRuleConn{ExtendedConn: N.NewExtendedConn(c), ready: time.Now()}, nil
+}
+
+type qualityRuleConn struct {
+	N.ExtendedConn
+	ready time.Time
+}
+
+func (c *qualityRuleConn) Chains() C.Chain               { return C.Chain{"node:direct"} }
+func (c *qualityRuleConn) ProviderChains() C.Chain       { return C.Chain{""} }
+func (c *qualityRuleConn) AppendToChains(C.ProxyAdapter) {}
+func (c *qualityRuleConn) RemoteDestination() string     { return c.RemoteAddr().String() }
+func (c *qualityRuleConn) HoopaEvidence() C.HoopaConnEvidence {
+	return C.HoopaConnEvidence{Ref: "conn:rule-dns", ReadyAt: c.ready, Kind: "tcp_connected", Protocol: "direct_tcp", Hops: []C.HoopaHop{{Name: "node:direct", AdapterType: "Direct"}}}
+}
