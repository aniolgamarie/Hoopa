+++ b/adapter/outbound/hoopa_quality.go
@@ -0,0 +1,27 @@
+package outbound
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"net"
+	"time"
+)
+
+func (c *conn) HoopaEvidence() C.HoopaConnEvidence {
+	e := c.hoopa
+	e.Hops = append([]C.HoopaHop(nil), e.Hops...)
+	return e
+}
+
+// Explicit protocol completion replaces, never inherits, an inner proof.
+// The inner actual route is retained independently of readiness.
+func hoopaReadyConn(c net.Conn, a C.ProxyAdapter, kind, protocol string, ready time.Time, inner C.HoopaConnEvidence, proven bool) C.Conn {
+	out := NewConn(c, a).(*conn)
+	if !C.HoopaQualityEnabled {
+		return out
+	}
+	out.hoopa.Hops = append(append([]C.HoopaHop{}, inner.Hops...), out.hoopa.Hops...)
+	if proven {
+		out.hoopa.ReadyAt, out.hoopa.Kind, out.hoopa.Protocol = ready, kind, protocol
+	}
+	return out
+}
