diff --git a/constant/hoopa_quality.go b/constant/hoopa_quality.go
new file mode 100644
--- /dev/null
+++ b/constant/hoopa_quality.go
@@ -0,0 +1,32 @@
+package constant
+
+import (
+	"os"
+	"time"
+)
+
+// This opt-in experimental evidence is local to a concrete returned connection.
+// It is not a promise for arbitrary protocol wrappers or business requests.
+var HoopaQualityEnabled = os.Getenv("HOOPA_TRACE_PROFILE") == "2"
+var hoopaMonotonicOrigin = time.Now()
+
+func HoopaMonotonicNS(t time.Time) int64 { return t.Sub(hoopaMonotonicOrigin).Nanoseconds() }
+
+type HoopaHop struct{ Name, AdapterType, ProviderName string }
+type HoopaConnEvidence struct {
+	Ref            string
+	ReadyAt        time.Time
+	Kind, Protocol string
+	Hops           []HoopaHop
+}
+
+type HoopaEvidenceConn interface{ HoopaEvidence() HoopaConnEvidence }
+
+// Only explicitly transparent wrappers forward this interface. Never search an
+// arbitrary Upstream chain: an unknown outer protocol must mask inner readiness.
+func HoopaEvidenceOf(c any) HoopaConnEvidence {
+	if p, ok := c.(HoopaEvidenceConn); ok {
+		return p.HoopaEvidence()
+	}
+	return HoopaConnEvidence{}
+}
