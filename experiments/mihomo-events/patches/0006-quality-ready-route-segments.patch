+	"net/netip"
+	"testing"
+	"time"
+)
+
+type qualityPipeDialer struct {
+	C.Dialer
+	conn net.Conn
+}
+
+func (d qualityPipeDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	return d.conn, nil
+}
+func qualityEnabled(t *testing.T) {
+	t.Helper()
+	old := C.HoopaQualityEnabled
+	C.HoopaQualityEnabled = true
+	t.Cleanup(func() { C.HoopaQualityEnabled = old })
+}
+
+func TestHoopaQualityHTTPCompletionAndCancellation(t *testing.T) {
+	qualityEnabled(t)
+	for _, tc := range []struct {
+		name, response string
+		cancel         bool
+	}{{"success", "HTTP/1.1 200 Established\r\n\r\npayload", false}, {"reject", "HTTP/1.1 403 Rejected\r\n\r\n", false}, {"truncated", "HTTP/1.1 200 Established\r\n", false}, {"cancelled", "", true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			client.SetDeadline(time.Now().Add(2 * time.Second))
+			server.SetDeadline(time.Now().Add(2 * time.Second))
+			readRequest := make(chan struct{})
+			release := make(chan struct{})
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				defer server.Close()
+				r := bufio.NewReader(server)
+				for {
+					s, err := r.ReadString('\n')
+					if err != nil {
+						return
+					}
+					if s == "\r\n" {
+						break
+					}
+				}
+				close(readRequest)
+				<-release
+				if tc.response != "" {
+					server.Write([]byte(tc.response))
+				}
+			}()
+			h, err := NewHttp(HttpOption{BasicOption: BasicOption{DialerForAPI: qualityPipeDialer{conn: client}}, Name: "node:a", Server: "127.0.0.1", Port: 80})
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			type result struct {
+				c   C.Conn
+				err error
+			}
+			resultCh := make(chan result, 1)
+			go func() {
+				c, err := h.DialContext(ctx, &C.Metadata{Host: "example.test", DstPort: 443})
+				resultCh <- result{c, err}
+			}()
+			<-readRequest
+			select {
+			case <-resultCh:
+				t.Fatal("ready before accepted response")
+			default:
+			}
+			beforeReply := time.Now()
+			if tc.cancel {
+				cancel()
+			}
+			close(release)
+			out := <-resultCh
+			<-done
+			if tc.name == "success" {
+				if out.err != nil {
+					t.Fatal(out.err)
+				}
+				defer out.c.Close()
+				p := C.HoopaEvidenceOf(out.c)
+				if p.Kind != "http_connect_accepted" || p.ReadyAt.Before(beforeReply) || p.ReadyAt.After(time.Now()) || p.Ref == "" {
+					t.Fatalf("bad proof %+v", p)
+				}
+				b, err := io.ReadAll(out.c)
+				if err != nil || string(b) != "payload" {
+					t.Fatal("read-ahead boundary", err)
+				}
+			} else if out.err == nil || out.c != nil {
+				t.Fatal("failed handshake returned proof/conn")
+			}
+			if tc.cancel && !errors.Is(out.err, context.Canceled) {
+				t.Fatalf("cancel=%v", out.err)
+			}
+		})
+	}
+}
+
+func TestHoopaQualitySOCKSFullReplyAndTimeout(t *testing.T) {
+	qualityEnabled(t)
+	for _, tc := range []struct {
+		name  string
+		reply []byte
+		stall bool
+	}{{"success", []byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 80}, false}, {"bad_ver", []byte{4, 0, 0, 1, 127, 0, 0, 1, 0, 80}, false}, {"bad_rep", []byte{5, 5, 0, 1, 127, 0, 0, 1, 0, 80}, false}, {"bad_rsv", []byte{5, 0, 1, 1, 127, 0, 0, 1, 0, 80}, false}, {"truncated", []byte{5, 0, 0, 1, 127, 0}, false}, {"timeout", nil, true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			client.SetDeadline(time.Now().Add(2 * time.Second))
+			server.SetDeadline(time.Now().Add(2 * time.Second))
+			release := make(chan struct{})
+			gotRequest := make(chan struct{})
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				defer server.Close()
+				var head [2]byte
+				if _, err := io.ReadFull(server, head[:]); err != nil {
+					return
+				}
+				methods := make([]byte, int(head[1]))
+				if _, err := io.ReadFull(server, methods); err != nil {
+					return
+				}
+				if _, err := server.Write([]byte{5, 0}); err != nil {
+					return
+				}
+				var req [10]byte
+				if _, err := io.ReadFull(server, req[:]); err != nil {
+					return
+				}
+				close(gotRequest)
+				<-release
+				if !tc.stall {
+					server.Write(tc.reply)
+				}
+			}()
+			ss, err := NewSocks5(Socks5Option{BasicOption: BasicOption{DialerForAPI: qualityPipeDialer{conn: client}}, Name: "node:b", Server: "127.0.0.1", Port: 1080})
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+			defer cancel()
+			type result struct {
+				c   C.Conn
+				err error
+			}
+			outCh := make(chan result, 1)
+			go func() {
+				c, err := ss.DialContext(ctx, &C.Metadata{DstIP: netip.MustParseAddr("127.0.0.1"), DstPort: 443})
+				outCh <- result{c, err}
+			}()
+			<-gotRequest
+			select {
+			case <-outCh:
+				t.Fatal("ready before complete BND")
+			default:
+			}
+			beforeReply := time.Now()
+			if !tc.stall {
+				close(release)
+			}
+			out := <-outCh
+			if tc.stall {
+				close(release)
+			}
+			<-done
+			if tc.name == "success" {
+				if out.err != nil {
+					t.Fatal(out.err)
+				}
+				defer out.c.Close()
+				p := C.HoopaEvidenceOf(out.c)
+				if p.Kind != "socks5_connect_accepted" || p.ReadyAt.Before(beforeReply) {
+					t.Fatal("missing proof")
+				}
+			} else if out.err == nil || out.c != nil {
+				t.Fatal("bad SOCKS reply accepted")
+			}
+			if tc.stall && !errors.Is(out.err, context.DeadlineExceeded) {
+				t.Fatalf("timeout=%v", out.err)
+			}
+		})
+	}
+}
+
+type qualityDelayedResolver struct {
+	resolver.Resolver
+	delay time.Duration
+}
+
+func (r qualityDelayedResolver) Invalid() bool { return true }
+func (r qualityDelayedResolver) LookupIPv4(ctx context.Context, _ string) ([]netip.Addr, error) {
+	select {
+	case <-time.After(r.delay):
+		return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+func (r qualityDelayedResolver) LookupIP(ctx context.Context, s string) ([]netip.Addr, error) {
+	return r.LookupIPv4(ctx, s)
+}
+func TestHoopaQualityDirectIncludesSlowDNS(t *testing.T) {
+	qualityEnabled(t)
+	old := resolver.DirectHostResolver
+	resolver.DirectHostResolver = qualityDelayedResolver{delay: 80 * time.Millisecond}
+	defer func() { resolver.DirectHostResolver = old }()
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		c, err := ln.Accept()
+		if err == nil {
+			c.Close()
+		}
+	}()
+	d := NewDirectWithOption(DirectOption{Name: "node:direct", BasicOption: BasicOption{IPVersion: C.IPv4Only}})
+	start := time.Now()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c, err := d.DialContext(ctx, &C.Metadata{Host: "slow-quality.invalid", DstPort: uint16(ln.Addr().(*net.TCPAddr).Port)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	<-done
+	p := C.HoopaEvidenceOf(c)
+	elapsed := p.ReadyAt.Sub(start)
+	if p.Kind != "tcp_connected" || elapsed < 75*time.Millisecond || elapsed > 750*time.Millisecond {
+		t.Fatalf("DNS boundary elapsed=%s kind=%s", elapsed, p.Kind)
+	}
+}
+
+type qualityLazyConn struct {
+	net.Conn
+	written bool
+}
+
+func (c *qualityLazyConn) NeedHandshake() bool         { return !c.written }
+func (c *qualityLazyConn) Write(b []byte) (int, error) { c.written = true; return len(b), nil }
+func TestHoopaQualityUnknownOuterAndTransparentCallbacks(t *testing.T) {
+	qualityEnabled(t)
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	inner := hoopaReadyConn(left, NewBase(BaseOption{Name: "node:direct", Type: C.Direct}), "tcp_connected", "direct_tcp", time.Now(), C.HoopaConnEvidence{}, true)
+	wrapped := callback.NewFirstWriteCallBackConn(callback.NewCloseCallbackConn(inner, func() {}), func(error) {})
+	if C.HoopaEvidenceOf(wrapped).Ref != C.HoopaEvidenceOf(inner).Ref {
+		t.Fatal("transparent wrapper lost exact proof")
+	}
+	lazy := &qualityLazyConn{Conn: wrapped}
+	outer := NewConn(lazy, NewBase(BaseOption{Name: "node:unknown", Type: C.Vmess}))
+	if !N.NeedHandshake(outer) {
+		t.Fatal("fixture not lazy")
+	}
+	n, err := outer.Write([]byte("seven!!"))
+	p := C.HoopaEvidenceOf(outer)
+	if err != nil || n != 7 || N.NeedHandshake(outer) || p.Kind != "ready_unproven" || !p.ReadyAt.IsZero() {
+		t.Fatal("lazy/unknown outer borrowed inner proof")
+	}
+}
