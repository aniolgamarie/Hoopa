+// Inspect the actual compiled startup function rather than infer ordering from
+// a process exit or from a port sampled after that exit. Functional cases above
+// exercise its early returns. No timing claim is made by a missing listener.
+func TestFieldProfileStartupSourceCallOrder(t *testing.T) {
+	file, e := parser.ParseFile(token.NewFileSet(), "hoopa_guard_linux.go", nil, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	positions := map[string]token.Pos{}
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Name.Name != "runHoopaGuard" {
+			continue
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			s, ok := call.Fun.(*ast.SelectorExpr)
+			if ok {
+				if _, exists := positions[s.Sel.Name]; !exists {
+					positions[s.Sel.Name] = call.Pos()
+				}
+			}
+			return true
+		})
+	}
+	for _, pair := range [][2]string{{"ValidateDeclaredIdentity", "Adopt"}, {"Adopt", "FieldProfile"}, {"FieldProfile", "ValidateWithIdentity"}, {"ValidateWithIdentity", "PrepareGuard"}, {"PrepareGuard", "ApplyConfig"}, {"ApplyConfig", "Reserve"}, {"Reserve", "Listen"}} {
+		if positions[pair[0]] == 0 || positions[pair[1]] <= positions[pair[0]] {
+			t.Fatal("startup binding order", pair, positions)
+		}
+	}
+}
