+func TestFieldProfileWriterQualityManifestReopen(t *testing.T) {
+	for _, pending := range []bool{false, true} {
+		t.Run(map[bool]string{false: "complete", true: "pending"}[pending], func(t *testing.T) {
+			t.Setenv("HOOPA_TRACE_PROFILE", "5")
+			s := testSource(t, defaultLimit)
+			proof := fieldIdentity(t)
+			if s.manifest.SchemaVersion != 2 || s.manifest.IdentityProfile != identityprofile.ID {
+				t.Fatal("manifest2 not bound")
+			}
+			f, e := s.begin(testPeer(), testEntry(), "example.test", "", time.Now(), &proof)
+			if e != nil {
+				t.Fatal(e)
+			}
+			proof.FieldProfile.ID = "mutated"
+			proof.Executable.PathText = "mutated"
+			if e = f.Decide("MATCH", "", "DIRECT"); e != nil {
+				t.Fatal(e)
+			}
+			a := f.NewAttempt()
+			c := qualityAttach(t, a, "fields:actual", true)
+			a.FinishConnection(nil, "", c, false)
+			a.Bind("fields:tracker")
+			a.AddUpload(9007199254740993)
+			a.AddDownload(33)
+			if e = f.Checkpoint(); e != nil {
+				t.Fatal(e)
+			}
+			if !pending {
+				f.Close()
+				if e = s.shutdown(); e != nil {
+					t.Fatal(e)
+				}
+			}
+			before := frames(t, s)
+			var quality, closed bool
+			for _, b := range before {
+				event, e := telemetrywire.DecodeSourceEvent(b)
+				if e != nil || event.SchemaVersion != 5 || telemetrywire.ValidateManifestEvent(s.manifest, event) != nil {
+					t.Fatal(e)
+				}
+				if event.Kind == "opened" && (event.FieldProfile.ID != identityprofile.ID || event.Connector.IdentityCapability != "" || event.Executable.PathText != "/bin/python3") {
+					t.Fatal("historical field grant mutated")
+				}
+				quality = quality || event.Quality != nil
+				closed = closed || event.Kind == "closed"
+			}
+			if !quality || closed == pending {
+				t.Fatal("quality/closed")
+			}
+			dir, name := s.root.Name(), filepath.Base(s.file.Name())
+			oldRaw, e := os.ReadFile(filepath.Join(dir, name))
+			if e != nil {
+				t.Fatal(e)
+			}
+			s.close()
+			next, e := openSource(dir, "test-generation", "", "", defaultLimit)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer next.close()
+			snapshots, e := next.sendSnapshots()
+			if e != nil {
+				t.Fatal(e)
+			}
+			found := false
+			for _, snap := range snapshots {
+				if snap.name == name {
+					found = true
+					if !reflect.DeepEqual(before, snap.frames) {
+						t.Fatal("raw changed")
+					}
+				}
+			}
+			if !found {
+				t.Fatal("missing epoch")
+			}
+			again, _ := os.ReadFile(filepath.Join(dir, name))
+			if !bytes.Equal(oldRaw, again) {
+				t.Fatal("original source rewritten")
+			}
+			reports := next.recoveryReports()
+			if len(reports) != 1 {
+				t.Fatal(reports)
+			}
+			if pending && (reports[0].Flows[0].State != "gap" || reports[0].Flows[0].Reason != "epoch_ended_without_final" || reports[0].Flows[0].TailBytes != nil || reports[0].Flows[0].Final != nil) {
+				t.Fatal("exclusive old-writer report changed existing gap/null semantics")
+			}
+			previous := reports[0]
+			next.close()
+			againSource, err := openSource(dir, "test-generation", "", "", defaultLimit)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer againSource.close()
+			stable := false
+			for _, report := range againSource.recoveryReports() {
+				if report.SourceEpoch == previous.SourceEpoch {
+					stable = true
+					if !reflect.DeepEqual(report.Flows, previous.Flows) {
+						t.Fatal("repeated reopen changed derived old flows")
+					}
+				}
+			}
+			if !stable {
+				t.Fatal("old report missing after repeated reopen")
+			}
+		})
+	}
+}
