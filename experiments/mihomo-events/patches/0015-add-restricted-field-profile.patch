+func TestFieldProfileProtectedEntryRejectsBeforeSourceOrListeners(t *testing.T) {
+	for _, tc := range []string{"missing", "comm", "wrong-id", "valid-without-handoff", "legacy-with-new-config"} {
+		t.Run(tc, func(t *testing.T) {
+			identityCleanEnv(t)
+			dir := t.TempDir()
+			os.Chmod(dir, 0700)
+			raw := map[string]any{"mode": "rule", "log-level": "silent", "ipv6": false, "find-process-mode": "off", "external-controller": "127.0.0.1:32003", "secret": strings.Repeat("s", 32), "listeners": []any{map[string]any{"name": "entry", "type": "mixed", "listen": "127.0.0.1", "port": 32002, "udp": false, "users": []any{map[string]string{"username": "user", "password": strings.Repeat("p", 32)}}}}, "proxies": []any{map[string]string{"name": "node:test", "type": "direct"}}, "rules": []string{"MATCH,node:test"}, "profile": map[string]bool{"store-selected": false, "store-fake-ip": false}}
+			if tc != "missing" {
+				r := identityprofile.Requirements{ProfileID: identityprofile.ID, SourceSchemaVersion: 5, RequiredFields: []string{"instance"}}
+				if tc == "comm" {
+					r.RequiredFields = []string{"comm"}
+				}
+				if tc == "wrong-id" {
+					r.ProfileID = "other"
+				}
+				raw["hoopa-identity"] = r
+			}
+			b, _ := json.Marshal(raw)
+			file := filepath.Join(dir, "config.json")
+			os.WriteFile(file, b, 0600)
+			oldHome, oldFile, oldTest := homeDir, configFile, testConfig
+			defer func() { homeDir, configFile, testConfig = oldHome, oldFile, oldTest }()
+			homeDir, configFile, testConfig = dir, file, false
+			sum := sha256.Sum256(b)
+			t.Setenv("HOOPA_GUARD_GENERATION", "generation")
+			t.Setenv("HOOPA_GUARD_CONFIG_SHA256", hex.EncodeToString(sum[:]))
+			t.Setenv("HOOPA_TRACE_PROFILE", "5")
+			t.Setenv("HOOPA_TRACE_INBOUND", "entry")
+			t.Setenv("HOOPA_TRACE_GENERATION", "generation")
+			t.Setenv("HOOPA_TRACE_ROUTE_MAP", filepath.Join(dir, "routes.json"))
+			if tc == "legacy-with-new-config" {
+				t.Setenv("HOOPA_TRACE_PROFILE", "4")
