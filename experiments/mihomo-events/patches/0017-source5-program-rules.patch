+func TestProgramRulesProtectedReadOnlySurface(t *testing.T) {
+	for _, tc := range []struct {
+		name, method, path, remote, auth string
+		program                          string
+		body                             string
+		length                           int64
+		missing, duplicate, chunked      bool
+		want                             int
+	}{
+		{name: "enabled exact body", program: profile.ProgramRuleProfileID, want: 200},
+		{name: "disabled", want: 409},
+		{name: "unknown profile disabled", program: "other", want: 409},
+		{name: "no credentials before unavailable", missing: true, want: 401},
+		{name: "wrong token", program: profile.ProgramRuleProfileID, auth: "Bearer wrong", want: 401},
+		{name: "duplicate token", program: profile.ProgramRuleProfileID, duplicate: true, want: 401},
+		{name: "nonloopback", program: profile.ProgramRuleProfileID, remote: "192.0.2.1:1234", want: 401},
