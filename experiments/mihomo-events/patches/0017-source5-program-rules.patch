+//go:build linux && amd64
+
+package hoopatrace
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/metacubex/mihomo/component/hoopaid"
+)
+
+// Change the original ABI and its projections together, so begin exercises the
+// real opened validator, rather than testing an inconsistent fabricated value.
+func programProof(t *testing.T, path []byte) hoopaid.Identity {
+	t.Helper()
+	p := fieldIdentity(t)
+	raw, err := hex.DecodeString(p.Executable.RawRecord)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 40; i < 296; i++ {
+		raw[i] = 0
+	}
+	binary.LittleEndian.PutUint32(raw[16:], uint32(len(path)+1))
+	copy(raw[40:], path)
+	name := path[bytes.LastIndexByte(path, '/')+1:]
+	p.Executable.RawRecord = hex.EncodeToString(raw)
+	p.Executable.PathRawHex = hex.EncodeToString(path)
+	p.Executable.ProgramNameRawHex = hex.EncodeToString(name)
+	p.Executable.PathTextValid = utf8.Valid(path)
+	p.Executable.ProgramNameTextValid = utf8.Valid(name)
+	p.Executable.PathText, p.Executable.ProgramName = "", ""
+	if p.Executable.PathTextValid {
+		p.Executable.PathText = string(path)
+	}
+	if p.Executable.ProgramNameTextValid {
+		p.Executable.ProgramName = string(name)
+	}
+	return p
+}
+
+func TestConnectorProgramSnapshotUsesOriginalValidatedFlow(t *testing.T) {
+	t.Setenv("HOOPA_TRACE_PROFILE", "5")
+	for _, enabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "no_optin", true: "optin"}[enabled], func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			if enabled {
+				s.programRules = ProgramRuleProfileID
+			}
+			proof := programProof(t, []byte("/bin/Python*"))
+			f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now(), &proof)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer f.Close()
+			proof.Executable.ProgramName = "changed-after-connect"
+			proof.Executable.PathText = "/changed-after-connect"
+			proof.FieldProfile.ID = "changed-after-connect"
+			if f.ProgramRulesEnabled() != enabled {
+				t.Fatal("opt-in boundary")
+			}
+			for _, check := range []struct {
+				field, pattern string
+				want           int8
+			}{
+				{"name", "Python*", 1}, {"name", "python*", 0}, {"name", "PythonX", 0},
+				{"path", "/bin/Python*", 1}, {"path", "/other/Python*", 0}, {"instance", "", -1},
+			} {
+				want := check.want
+				if !enabled {
+					want = -1
+				}
+				if got := f.MatchConnectorProgram(check.field, check.pattern); got != want {
+					t.Fatalf("%s/%q got=%d want=%d", check.field, check.pattern, got, want)
+				}
+			}
+			if f.identity.Status != "unknown" || f.identity.Reason != "legacy_process_fields_unused" || f.MatchProcess("name", "Python*") != -1 {
+				t.Fatal("legacy identity changed")
+			}
+		})
+	}
+}
+
+func TestConnectorProgramUnknownIsFieldSpecific(t *testing.T) {
+	t.Setenv("HOOPA_TRACE_PROFILE", "5")
+	for _, check := range []struct {
+		name               string
+		path               []byte
+		wantName, wantPath int8
+	}{
+		{"invalid_directory", []byte{'/', 0xff, '/', 'p', 'y'}, 1, -1},
+		{"invalid_basename", []byte{'/', 'b', 'i', 'n', '/', 0xff}, -1, -1},
+	} {
+		t.Run(check.name, func(t *testing.T) {
+			s := testSource(t, defaultLimit)
+			s.programRules = ProgramRuleProfileID
+			proof := programProof(t, check.path)
+			f, err := s.begin(testPeer(), testEntry(), "example.test", "", time.Now(), &proof)
+			if err != nil {
+				t.Fatal("valid raw connector must reach opened", err)
+			}
+			defer f.Close()
+			if !f.ProgramRulesEnabled() || f.MatchConnectorProgram("name", "py") != check.wantName || f.MatchConnectorProgram("path", "/bin/py") != check.wantPath {
+				t.Fatal("text unknown collapsed into false or leaked across fields")
+			}
+		})
+	}
+	var absent *Flow
+	if absent.MatchConnectorProgram("name", "py") != -1 || absent.ProgramRulesEnabled() {
+		t.Fatal("nil flow")
+	}
+}
