@@ -0,0 +1,56 @@
+//go:build linux && amd64
+
+package hoopatrace
+
+import "github.com/metacubex/mihomo/component/hoopaid"
+
+const ProgramRuleProfileID = "connect_initiator_exact_program_v1"
+
+type programSnapshot struct {
+	enabled              bool
+	name, path           string
+	nameKnown, pathKnown bool
+}
+
+func snapshotProgram(proof *hoopaid.Identity) programSnapshot {
+	if proof == nil || !proof.HasExecutable || !proof.HasFieldProfile || proof.FieldProfile.Validate(proof.Generation) != nil || proof.Executable.Status != "available" {
+		return programSnapshot{}
+	}
+	return programSnapshot{
+		enabled: true,
+		name:    proof.Executable.ProgramName, path: proof.Executable.PathText,
+		nameKnown: proof.Executable.ProgramNameTextValid,
+		pathKnown: proof.Executable.PathTextValid,
+	}
+}
+
+func (f *Flow) ProgramRulesEnabled() bool {
+	return f != nil && f.program.enabled
+}
+
+// MatchConnectorProgram reads immutable per-flow connector projections. An
+// unavailable text value is unknown, never the empty string or a legacy lookup.
+func (f *Flow) MatchConnectorProgram(field, pattern string) int8 {
+	if !f.ProgramRulesEnabled() {
+		return -1
+	}
+	var value string
+	switch field {
+	case "name":
+		if !f.program.nameKnown {
+			return -1
+		}
+		value = f.program.name
+	case "path":
+		if !f.program.pathKnown {
+			return -1
+		}
+		value = f.program.path
+	default:
+		return -1
+	}
+	if value == pattern {
+		return 1
+	}
+	return 0
+}
