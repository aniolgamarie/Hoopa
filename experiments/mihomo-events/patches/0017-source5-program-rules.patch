+
+const prepareChildCase = "HOOPA_PROGRAM_RULES_PREPARE_CHILD_CASE"
+
+func TestProgramRulesPrepareGuardOnce(t *testing.T) {
+	if mode := os.Getenv(prepareChildCase); mode != "" {
+		programRulesPrepareChild(t, mode)
+		return
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"legacy-then-enabled", "enabled-then-legacy", "legacy-repeat", "enabled-repeat", "changed-profile", "changed-generation", "changed-route-type", "changed-route-set", "bad-profile-before-init", "bad-schema-before-init"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, executable, "-test.run=^TestProgramRulesPrepareGuardOnce$", "-test.count=1", "-test.v")
+			for _, value := range os.Environ() {
+				if !strings.HasPrefix(value, prepareChildCase+"=") {
+					cmd.Env = append(cmd.Env, value)
+				}
+			}
+			cmd.Env = append(cmd.Env, prepareChildCase+"="+mode)
+			output, err := cmd.CombinedOutput()
+			if err != nil || ctx.Err() != nil {
+				t.Fatalf("isolated initialization case %s: %v context=%v\n%s", mode, err, ctx.Err(), output)
+			}
+		})
+	}
+}
+
+func programRulesPrepareChild(t *testing.T, mode string) {
+	t.Helper()
+	if global.s != nil || global.err != nil {
+		t.Fatal("child source was initialized before test")
+	}
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	sourceDir := filepath.Join(dir, "source")
+	if err := os.Mkdir(sourceDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	node := "node:a"
+	mapping := routeMapping{SchemaVersion: 1, ConfigGeneration: "gen:prepare-once", Entries: []routeEntry{{InternalName: node, AdapterType: "Http", NodeID: &node, DisplayAlias: "Node A"}}}
+	raw, err := json.Marshal(mapping)
+	if err != nil {
+		t.Fatal(err)
+	}
+	routeFile := filepath.Join(dir, "routes.json")
+	if err := os.WriteFile(routeFile, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	for key, value := range map[string]string{"HOOPA_TRACE_DIR": sourceDir, "HOOPA_TRACE_GENERATION": mapping.ConfigGeneration, "HOOPA_TRACE_PROFILE": "5", "HOOPA_TRACE_ROUTE_MAP": routeFile, "HOOPA_TRACE_RECEIVER": "", "HOOPA_TRACE_SECRET": "", "HOOPA_TRACE_MAX_BYTES": ""} {
+		t.Setenv(key, value)
+	}
+	t.Cleanup(func() {
+		if global.s != nil {
+			global.s.close()
+		}
+	})
+	expected := map[string]string{node: "Http"}
+	generation := mapping.ConfigGeneration
+	prepare := func(enabled bool) error {
+		if enabled {
+			return PrepareGuardWithProgramRules(generation, expected, ProgramRuleProfileID)
+		}
+		return PrepareGuard(generation, expected)
+	}
+	if mode == "bad-profile-before-init" || mode == "bad-schema-before-init" {
+		if mode == "bad-profile-before-init" {
+			for _, profile := range []string{"", "other", ProgramRuleProfileID + "x"} {
+				if PrepareGuardWithProgramRules(generation, expected, profile) == nil {
+					t.Fatal("invalid profile accepted")
+				}
+			}
+		} else {
+			for _, schema := range []string{"", "1", "2", "3", "4", "05", "6"} {
+				t.Setenv("HOOPA_TRACE_PROFILE", schema)
+				if prepare(true) == nil {
+					t.Fatal("non-source5 schema accepted", schema)
+				}
+			}
+			t.Setenv("HOOPA_TRACE_PROFILE", "5")
+		}
+		entries, err := os.ReadDir(sourceDir)
+		if err != nil || len(entries) != 0 || global.s != nil || global.err != nil {
+			t.Fatal("invalid request consumed initialization or wrote source", entries, err)
+		}
+		if err := prepare(true); err != nil {
+			t.Fatal("pre-init rejection poisoned valid initialization", err)
+		}
+		return
+	}
+	enabled := mode != "legacy-then-enabled" && mode != "legacy-repeat"
+	if err := prepare(enabled); err != nil {
+		t.Fatal("first initialization", err)
+	}
+	original := global.s
+	profile := ""
+	if enabled {
+		profile = ProgramRuleProfileID
+	}
+	if original == nil || original.programRules != profile || original.profile != 5 || original.generation != generation || len(original.routes) != 1 || original.routes[node].AdapterType != "Http" {
+		t.Fatal("source initialization did not bind expected inputs")
+	}
+	epoch := original.epoch
+	var secondErr error
+	switch mode {
+	case "legacy-then-enabled":
+		secondErr = prepare(true)
+	case "enabled-then-legacy":
+		secondErr = prepare(false)
+	case "changed-profile":
+		secondErr = PrepareGuardWithProgramRules(generation, expected, "other")
+	case "changed-generation":
+		t.Setenv("HOOPA_TRACE_GENERATION", "gen:different")
+		secondErr = PrepareGuardWithProgramRules("gen:different", expected, ProgramRuleProfileID)
+	case "changed-route-type":
+		secondErr = PrepareGuardWithProgramRules(generation, map[string]string{node: "Socks5"}, ProgramRuleProfileID)
+	case "changed-route-set":
+		secondErr = PrepareGuardWithProgramRules(generation, map[string]string{}, ProgramRuleProfileID)
+	case "legacy-repeat", "enabled-repeat":
+		if err := prepare(enabled); err != nil {
+			t.Fatal("identical inputs could not reuse initialized source", err)
+		}
+	default:
+		t.Fatal("unknown child case", mode)
+	}
+	if mode != "legacy-repeat" && mode != "enabled-repeat" && secondErr == nil {
+		t.Fatal("conflicting repeat request accepted", mode)
+	}
+	if global.s != original || original.programRules != profile || original.epoch != epoch || original.generation != generation || len(original.routes) != 1 || original.routes[node].AdapterType != "Http" {
+		t.Fatal("repeat changed original source/profile/generation/routes")
+	}
+	// Each isolated child exits with its own once. It is never copied or reset.
+}
