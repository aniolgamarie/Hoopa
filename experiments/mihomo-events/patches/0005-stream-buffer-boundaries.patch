diff --git a/adapter/outbound/http_hoopa_buffer_test.go b/adapter/outbound/http_hoopa_buffer_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/http_hoopa_buffer_test.go
@@ -0,0 +1,75 @@
+package outbound
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	C "github.com/metacubex/mihomo/constant"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+type hoopaLimitedReadConn struct {
+	net.Conn
+	limit int
+}
+
+func (c hoopaLimitedReadConn) Read(p []byte) (int, error) {
+	if len(p) > c.limit {
+		p = p[:c.limit]
+	}
+	return c.Conn.Read(p)
+}
+
+func TestHoopaHTTPConnectPreservesReadAhead(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		payload   []byte
+		readLimit int
+	}{
+		{"empty", nil, 0}, {"same_packet", []byte("payload"), 0}, {"binary_large", bytes.Repeat([]byte{0, 1, 255, 'x'}, 2048), 0}, {"fragmented", []byte("payload"), 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			_ = client.SetDeadline(time.Now().Add(3 * time.Second))
+			_ = server.SetDeadline(time.Now().Add(3 * time.Second))
+			done := make(chan error, 1)
+			go func() {
+				defer server.Close()
+				r := bufio.NewReader(server)
+				for {
+					line, err := r.ReadString('\n')
+					if err != nil {
+						done <- err
+						return
+					}
+					if line == "\r\n" {
+						break
+					}
+				}
+				response := append([]byte("HTTP/1.1 200 Connection Established\r\n\r\n"), tc.payload...)
+				_, err := server.Write(response)
+				done <- err
+			}()
+			var conn net.Conn = client
+			if tc.readLimit > 0 {
+				conn = hoopaLimitedReadConn{client, tc.readLimit}
+			}
+			h := &Http{option: &HttpOption{}}
+			tunneled, err := h.StreamConnContext(context.Background(), conn, &C.Metadata{Host: "example.test", DstPort: 443})
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := io.ReadAll(tunneled)
+			if err != nil || !bytes.Equal(got, tc.payload) {
+				t.Fatalf("tunnel bytes lost: got=%d want=%d err=%v", len(got), len(tc.payload), err)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
