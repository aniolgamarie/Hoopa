diff --git a/tunnel/hoopa_initial_write.go b/tunnel/hoopa_initial_write.go
new file mode 100644
--- /dev/null
+++ b/tunnel/hoopa_initial_write.go
@@ -0,0 +1,18 @@
+package tunnel
+
+import "io"
+
+type hoopaInitialUploadCounter interface {
+	AddUpload(int)
+}
+
+// hoopaWriteInitialPayload counts only the result of this one lazy write. The
+// caller retains the peeked payload on error and decides protocol readiness.
+func hoopaWriteInitialPayload(writer io.Writer, payload []byte, counter hoopaInitialUploadCounter) (int, error) {
+	n, err := writer.Write(payload)
+	counter.AddUpload(n)
+	if err == nil && n != len(payload) {
+		err = io.ErrShortWrite
+	}
+	return n, err
+}
diff --git a/tunnel/hoopa_initial_write_test.go b/tunnel/hoopa_initial_write_test.go
new file mode 100644
--- /dev/null
+++ b/tunnel/hoopa_initial_write_test.go
@@ -0,0 +1,65 @@
+package tunnel
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+)
+
+type hoopaInitialWriter struct {
+	n     int
+	err   error
+	calls int
+	got   []byte
+}
+
+func (w *hoopaInitialWriter) Write(p []byte) (int, error) {
+	w.calls++
+	w.got = append([]byte(nil), p...)
+	return w.n, w.err
+}
+
+type hoopaInitialCounter struct{ counts []int }
+
+func (c *hoopaInitialCounter) AddUpload(n int) { c.counts = append(c.counts, n) }
+
+func TestHoopaInitialPayloadUsesActualWriteResult(t *testing.T) {
+	failure := errors.New("synthetic lazy write failure")
+	payload := []byte("initial application payload")
+	for _, tc := range []struct {
+		name           string
+		payload        []byte
+		n              int
+		err, wantErr   error
+		handshakeAfter bool
+		wantReady      bool
+	}{
+		{"partial_error", payload, 7, failure, failure, false, false},
+		{"zero_error", payload, 0, failure, failure, false, false},
+		{"zero_nil", payload, 0, nil, io.ErrShortWrite, false, false},
+		{"partial_nil", payload, 7, nil, io.ErrShortWrite, false, false},
+		{"full_nil", payload, len(payload), nil, nil, false, true},
+		{"full_error", payload, len(payload), failure, failure, false, false},
+		{"full_handshake_unproven", payload, len(payload), nil, nil, true, false},
+		{"empty_nil", nil, 0, nil, nil, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			writer := &hoopaInitialWriter{n: tc.n, err: tc.err}
+			counter := &hoopaInitialCounter{}
+			n, err := hoopaWriteInitialPayload(writer, tc.payload, counter)
+			if n != tc.n || !errors.Is(err, tc.wantErr) {
+				t.Fatalf("actual write result changed: n=%d err=%v", n, err)
+			}
+			if writer.calls != 1 || !bytes.Equal(writer.got, tc.payload) {
+				t.Fatal("initial payload retried or changed")
+			}
+			if len(counter.counts) != 1 || counter.counts[0] != tc.n {
+				t.Fatalf("counted request length instead of actual n: %v", counter.counts)
+			}
+			if got := hoopaSetupReady(true, tc.handshakeAfter, n, err); got != tc.wantReady {
+				t.Fatalf("failed/short/empty/unproven handshake marked ready: %v", got)
+			}
+		})
+	}
+}
