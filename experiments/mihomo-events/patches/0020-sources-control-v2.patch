diff --git a/adapter/hoopa_probe.go b/adapter/hoopa_probe.go
new file mode 100644
--- /dev/null
+++ b/adapter/hoopa_probe.go
@@ -0,0 +1,59 @@
+package adapter
+
+import (
+	"sync"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type hoopaProbeKey struct{ url, expectedStatus string }
+type hoopaProbeRegistry struct {
+	mu           sync.Mutex
+	observations map[hoopaProbeKey]C.HoopaProbeObservation
+}
+
+// EnableHoopaProbe is idempotent and never resets an existing observation.
+// It only registers the v2 status range; there is no network operation here.
+func (p *Proxy) EnableHoopaProbe(url, expectedStatus string) bool {
+	if p == nil || url == "" || len(url) > 4096 || expectedStatus != C.HoopaProbeAcceptedStatus {
+		return false
+	}
+	p.hoopaProbe.mu.Lock()
+	defer p.hoopaProbe.mu.Unlock()
+	if p.hoopaProbe.observations == nil {
+		p.hoopaProbe.observations = make(map[hoopaProbeKey]C.HoopaProbeObservation)
+	}
+	key := hoopaProbeKey{url, expectedStatus}
+	if _, ok := p.hoopaProbe.observations[key]; !ok {
+		if len(p.hoopaProbe.observations) >= 64 {
+			return false
+		}
+		p.hoopaProbe.observations[key] = C.HoopaProbeObservation{}
+	}
+	return true
+}
+
+func (p *Proxy) HoopaProbeObservation(url, expectedStatus string) C.HoopaProbeObservation {
+	if p == nil {
+		return C.HoopaProbeObservation{}
+	}
+	p.hoopaProbe.mu.Lock()
+	defer p.hoopaProbe.mu.Unlock()
+	return p.hoopaProbe.observations[hoopaProbeKey{url, expectedStatus}]
+}
+
+func (p *Proxy) recordHoopaProbe(url, expectedStatus string, success bool, delay uint16, completed time.Time) {
+	p.hoopaProbe.mu.Lock()
+	defer p.hoopaProbe.mu.Unlock()
+	key := hoopaProbeKey{url, expectedStatus}
+	if _, registered := p.hoopaProbe.observations[key]; !registered {
+		return
+	}
+	if !success {
+		delay = 0
+	}
+	// Strip monotonic data: real suspend elapsed time expires old observations;
+	// clock rollback produces a negative age and is conservatively unavailable.
+	p.hoopaProbe.observations[key] = C.HoopaProbeObservation{Known: true, Success: success, CompletedAt: completed.Round(0).UTC(), DelayMS: delay}
+}
diff --git a/adapter/hoopa_probe_test.go b/adapter/hoopa_probe_test.go
