+++ b/adapter/outboundgroup/hoopa_probe_test.go
@@ -0,0 +1,362 @@
+package outboundgroup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type hoopaTestLeaf struct {
+	C.Proxy
+	name        string
+	kind        C.AdapterType
+	dialer      string
+	mu          sync.Mutex
+	observation C.HoopaProbeObservation
+	sequence    []C.HoopaProbeObservation
+	enabled     bool
+	refuse      bool
+}
+
+func (p *hoopaTestLeaf) Name() string                      { return p.name }
+func (p *hoopaTestLeaf) Type() C.AdapterType               { return p.kind }
+func (p *hoopaTestLeaf) ProxyInfo() C.ProxyInfo            { return C.ProxyInfo{DialerProxy: p.dialer} }
+func (p *hoopaTestLeaf) AliveForTestUrl(string) bool       { return true }
+func (p *hoopaTestLeaf) LastDelayForTestUrl(string) uint16 { return 1 }
+func (p *hoopaTestLeaf) EnableHoopaProbe(url, status string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.refuse {
+		return false
+	}
+	p.enabled = url != "" && status == C.HoopaProbeAcceptedStatus
+	return p.enabled
+}
+func (p *hoopaTestLeaf) HoopaProbeObservation(url, status string) C.HoopaProbeObservation {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.enabled || url != "https://probe.invalid/check" || status != C.HoopaProbeAcceptedStatus {
+		return C.HoopaProbeObservation{}
+	}
+	if len(p.sequence) > 0 {
+		o := p.sequence[0]
+		p.sequence = p.sequence[1:]
+		return o
+	}
+	return p.observation
+}
+func (p *hoopaTestLeaf) publish(o C.HoopaProbeObservation) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.observation = o
+}
+func hoopaLeaf(name string) *hoopaTestLeaf { return &hoopaTestLeaf{name: name, kind: C.Http} }
+func hoopaSuccess(delay uint16) C.HoopaProbeObservation {
+	return C.HoopaProbeObservation{Known: true, Success: true, CompletedAt: time.Now().Round(0).UTC(), DelayMS: delay}
+}
+
+type hoopaTestProvider struct {
+	P.ProxyProvider
+	mu      sync.RWMutex
+	nodes   []C.Proxy
+	version uint32
+	health  C.HoopaHealthCheckPolicy
+	touches int
+}
+
+func (p *hoopaTestProvider) Version() uint32 { p.mu.RLock(); defer p.mu.RUnlock(); return p.version }
+func (p *hoopaTestProvider) Proxies() []C.Proxy {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return append([]C.Proxy{}, p.nodes...)
+}
+func (p *hoopaTestProvider) Touch() { p.mu.Lock(); defer p.mu.Unlock(); p.touches++ }
+func (p *hoopaTestProvider) HoopaHealthCheckPolicy() C.HoopaHealthCheckPolicy {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return p.health
+}
+func (p *hoopaTestProvider) replace(nodes []C.Proxy) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.nodes = append([]C.Proxy{}, nodes...)
+	p.version++
+}
+
+type hoopaNoHealthProvider struct{ P.ProxyProvider }
+type hoopaBareLeaf struct{ C.Proxy }
+
+func (p hoopaBareLeaf) Name() string           { return "node:bare" }
+func (p hoopaBareLeaf) Type() C.AdapterType    { return C.Http }
+func (p hoopaBareLeaf) ProxyInfo() C.ProxyInfo { return C.ProxyInfo{} }
+
+func hoopaFixture(t *testing.T, nodes ...C.Proxy) (*URLTest, *hoopaTestProvider, C.Proxy, C.HoopaProbePolicy) {
+	t.Helper()
+	policy := C.HoopaProbePolicy{URL: "https://probe.invalid/check", IntervalSeconds: 60, TimeoutMS: 1000, ToleranceMS: 0}
+	pd := &hoopaTestProvider{nodes: nodes, version: 1, health: C.HoopaHealthCheckPolicy{URL: policy.URL, ExpectedStatus: C.HoopaProbeAcceptedStatus, IntervalSeconds: policy.IntervalSeconds, TimeoutMS: policy.TimeoutMS}}
+	u := NewURLTest(&GroupCommonOption{Name: "group:auto", URL: policy.URL, ExpectedStatus: C.HoopaProbeAcceptedStatus, TestTimeout: int(policy.TimeoutMS)}, []P.ProxyProvider{pd})
+	reject := adapter.NewProxy(outbound.NewReject())
+	return u, pd, reject, policy
+}
+func hoopaConfigure(t *testing.T, nodes ...C.Proxy) (*URLTest, *hoopaTestProvider, C.Proxy) {
+	t.Helper()
+	u, pd, reject, policy := hoopaFixture(t, nodes...)
+	if err := u.ConfigureHoopaProbe(policy, reject); err != nil {
+		t.Fatal("valid protected policy failed", err)
+	}
+	return u, pd, reject
+}
+func hoopaWantReject(t *testing.T, u *URLTest, reject C.Proxy) {
+	t.Helper()
+	if selected := u.Unwrap(nil, false); selected != reject || selected.Type() != C.Reject {
+		t.Fatal("unqualified selection did not use exact builtin REJECT")
+	}
+	conn, err := reject.DialContext(context.Background(), &C.Metadata{Host: "never-resolved.invalid", DstPort: 443})
+	if err != nil || conn == nil {
+		t.Fatal("builtin REJECT connection unavailable")
+	}
+	defer conn.Close()
+	// Native REJECT returns a nop connection; rejection is EOF on actual IO,
+	// rather than a DialContext error.
+	if n, err := conn.Write([]byte("must-not-forward")); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatal("builtin REJECT allowed application write")
+	}
+	if n, err := conn.Read(make([]byte, 1)); n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatal("builtin REJECT allowed application read")
+	}
+}
