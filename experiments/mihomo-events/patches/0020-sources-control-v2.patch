new file mode 100644
--- /dev/null
+++ b/component/sourceprofile/profile.go
@@ -0,0 +1,324 @@
+// Package sourceprofile validates the finite generated basic-sources profile.
+// It performs no IO and does not grant a binary any capability. Provider input
+// is parsed separately; only fully canonical connection maps are accepted here.
+package sourceprofile
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+
+	wire "github.com/metacubex/mihomo/component/sourcecontrol"
+)
+
+var ErrProfile = errors.New("invalid protected sources profile")
+
+type Config struct {
+	Mode            string            `json:"mode"`
+	LogLevel        string            `json:"log-level"`
+	IPv6            bool              `json:"ipv6"`
+	FindProcessMode string            `json:"find-process-mode"`
+	Controller      string            `json:"external-controller"`
+	Secret          string            `json:"secret"`
+	Listeners       []Entry           `json:"listeners"`
+	Hosts           map[string]string `json:"hosts,omitempty"`
+	Proxies         []map[string]any  `json:"proxies"`
+	Groups          []Group           `json:"proxy-groups"`
+	Rules           []string          `json:"rules"`
+	Profile         CacheProfile      `json:"profile"`
+}
+type Entry struct {
+	Name   string `json:"name"`
+	Type   string `json:"type"`
+	Listen string `json:"listen"`
+	Port   uint16 `json:"port"`
+	UDP    bool   `json:"udp"`
+	Users  []User `json:"users"`
+}
+type User struct {
+	Username string `json:"username"`
+	Password string `json:"password"`
+}
+type CacheProfile struct {
+	StoreSelected bool `json:"store-selected"`
+	StoreFakeIP   bool `json:"store-fake-ip"`
+}
+type Group struct {
+	Name           string   `json:"name"`
+	Type           string   `json:"type"`
+	Proxies        []string `json:"proxies"`
+	URL            string   `json:"url,omitempty"`
+	Interval       uint64   `json:"interval,omitempty"`
+	Timeout        uint64   `json:"timeout,omitempty"`
+	Tolerance      *uint64  `json:"tolerance,omitempty"`
+	Lazy           *bool    `json:"lazy,omitempty"`
+	ExpectedStatus string   `json:"expected-status,omitempty"`
+}
+
+func (g Group) Probe() wire.Probe {
+	p := wire.Probe{URL: g.URL, IntervalSeconds: g.Interval, TimeoutMS: g.Timeout}
+	if g.Tolerance != nil {
+		p.ToleranceMS = *g.Tolerance
+	}
+	return p
+}
+
+func Validate(raw []byte, generation string) (Config, error) {
+	bad := func() (Config, error) { return Config{}, ErrProfile }
+	if len(raw) == 0 || len(raw) > wire.MaxJSONBytes || !validUnicode(raw) || !token(generation) {
+		return bad()
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	v, err := readValue(d, 0)
+	if err != nil {
+		return bad()
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return bad()
+	}
+	root, ok := object(v, "mode log-level ipv6 find-process-mode external-controller secret listeners proxies proxy-groups rules profile", "hosts")
+	if !ok {
+		return bad()
+	}
+	if _, ok = object(root["profile"], "store-selected store-fake-ip", ""); !ok {
+		return bad()
+	}
+	if !sourceShapes(root) {
+		return bad()
+	}
+	var c Config
+	d = json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	if d.Decode(&c) != nil || c.Mode != "rule" || c.LogLevel != "silent" || c.IPv6 || c.FindProcessMode != "off" || c.Profile.StoreSelected || c.Profile.StoreFakeIP || !credential(c.Secret) {
+		return bad()
+	}
+	controller, e := netip.ParseAddrPort(c.Controller)
+	if e != nil || controller.Addr() != netip.MustParseAddr("127.0.0.1") || controller.Port() == 0 || controller.String() != c.Controller {
+		return bad()
+	}
+	endpoints := map[string]bool{c.Controller: true}
+	entries := map[string]bool{}
+	credentials := map[User]bool{}
+	if len(c.Listeners) < 1 || len(c.Listeners) > 4 {
+		return bad()
+	}
+	for _, l := range c.Listeners {
+		ep := net.JoinHostPort(l.Listen, strconv.Itoa(int(l.Port)))
+		if !token(l.Name) || entries[l.Name] || l.Type != "mixed" || l.Listen != "127.0.0.1" || l.Port == 0 || l.UDP || endpoints[ep] || len(l.Users) != 1 {
+			return bad()
+		}
+		u := l.Users[0]
+		if !token(u.Username) || strings.Contains(u.Username, ":") || !credential(u.Password) || u.Password == c.Secret || credentials[u] {
+			return bad()
+		}
+		entries[l.Name], endpoints[ep], credentials[u] = true, true, true
+	}
+	for domain, addr := range c.Hosts {
+		if !domainToken(domain) || addr != "127.0.0.1" {
+			return bad()
+		}
+	}
+	if len(c.Proxies)+len(c.Groups) > 64 {
+		return bad()
+	}
+	refs := map[string]bool{}
+	remote := map[string]bool{}
+	edges := map[string][]string{}
+	for _, n := range c.Proxies {
+		name, _ := n["name"].(string)
+		kind, _ := n["type"].(string)
+		if !id(name, "node:") || refs[name] {
+			return bad()
+		}
+		refs[name] = true
+		if kind == "direct" {
+			if len(n) != 2 {
+				return bad()
+			}
+			continue
+		}
+		if !canonicalConnection(n) {
+			return bad()
+		}
+		server, _ := n["server"].(string)
+		port, _ := n["port"].(json.Number)
+		// A source may expose several credentials for one endpoint. It must not
+		// recurse into our own controller or application listeners.
+		if endpoints[net.JoinHostPort(server, port.String())] {
+			return bad()
+		}
+		// The finite hosts map is known at compilation time. Reject a declared
+		// hostname alias of one of our own endpoints as well as a literal IP.
+		for host, address := range c.Hosts {
+			if strings.EqualFold(server, host) && endpoints[net.JoinHostPort(address, port.String())] {
+				return bad()
+			}
+		}
+		remote[name] = true
+	}
+	for _, g := range c.Groups {
+		if !id(g.Name, "group:") || refs[g.Name] || len(g.Proxies) < 1 || len(g.Proxies) > 64 {
+			return bad()
+		}
+		refs[g.Name] = true
+		edges[g.Name] = g.Proxies
+		if g.Type == "select" {
+			if len(g.Proxies) != 1 {
+				return bad()
+			}
+		} else if g.Type == "url-test" {
+			if g.Probe().Validate() != nil || g.Tolerance == nil || g.Lazy == nil || *g.Lazy || g.ExpectedStatus != "200-299" {
+				return bad()
+			}
+		} else {
+			return bad()
+		}
+		seen := map[string]bool{}
+		for _, member := range g.Proxies {
+			if seen[member] || g.Type == "url-test" && !remote[member] {
+				return bad()
+			}
+			seen[member] = true
+		}
+	}
+	states := map[string]uint8{}
+	depth := map[string]int{}
+	var visit func(string) bool
+	visit = func(name string) bool {
+		if name == "REJECT" {
+			return true
+		}
+		if !refs[name] || states[name] == 1 {
+			return false
+		}
+		if states[name] == 2 {
+			return true
+		}
+		states[name] = 1
+		depth[name] = 1
+		for _, member := range edges[name] {
+			if !visit(member) {
+				return false
+			}
+			if depth[member]+1 > depth[name] {
+				depth[name] = depth[member] + 1
+			}
+		}
+		if depth[name] > 8 {
+			return false
+		}
+		states[name] = 2
+		return true
+	}
+	for name := range refs {
+		if !visit(name) {
+			return bad()
+		}
+	}
+	if len(c.Rules) < 1 || len(c.Rules) > 64 {
+		return bad()
+	}
+	target := func(s string) bool { return s == "REJECT" || refs[s] }
+	for i, r := range c.Rules {
+		if len(r) > wire.MaxPayloadBytes {
+			return bad()
+		}
+		if i == len(c.Rules)-1 {
+			parts := strings.Split(r, ",")
+			if len(parts) != 2 || parts[0] != "MATCH" || !target(parts[1]) {
+				return bad()
+			}
+		} else if !validRule(r, target, entries) {
+			return bad()
+		}
+	}
+	return c, nil
+}
+
+func sourceShapes(root map[string]any) bool {
+	listeners, ok := root["listeners"].([]any)
+	if !ok {
+		return false
+	}
+	for _, v := range listeners {
+		l, ok := object(v, "name type listen port udp users", "")
+		if !ok {
+			return false
+		}
+		users, ok := l["users"].([]any)
+		if !ok {
+			return false
+		}
+		for _, u := range users {
+			if _, ok = object(u, "username password", ""); !ok {
+				return false
+			}
+		}
+	}
+	nodes, ok := root["proxies"].([]any)
+	if !ok {
+		return false
+	}
+	for _, n := range nodes {
+		if _, ok := n.(map[string]any); !ok {
+			return false
+		}
+	}
+	groups, ok := root["proxy-groups"].([]any)
+	if !ok {
+		return false
+	}
+	for _, v := range groups {
+		g, ok := v.(map[string]any)
+		if !ok {
+			return false
+		}
+		extra := ""
+		if g["type"] == "url-test" {
+			extra = "url interval timeout tolerance lazy expected-status"
+		}
+		if _, ok = object(g, "name type proxies "+extra, ""); !ok {
+			return false
+		}
+		for _, key := range []string{"interval", "timeout", "tolerance"} {
+			if x, exists := g[key]; exists {
+				n, ok := x.(json.Number)
+				if !ok {
+					return false
+				}
+				u, e := strconv.ParseUint(n.String(), 10, 64)
+				if e != nil || strconv.FormatUint(u, 10) != n.String() {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+func canonicalConnection(n map[string]any) bool {
+	// The provider parser normalizes absent credentials to an explicit empty
+	// pair. Reconstruct only that absence, then require byte-equivalent maps.
+	in := make(map[string]any, len(n))
+	for k, v := range n {
+		in[k] = v
+	}
+	if n["username"] == "" && n["password"] == "" {
+		delete(in, "username")
+		delete(in, "password")
+	}
+	name, normalized, err := parseConnection(in)
+	if err != nil {
+		return false
+	}
+	normalized["name"] = name
+	a, e1 := json.Marshal(n)
+	b, e2 := json.Marshal(normalized)
+	return e1 == nil && e2 == nil && bytes.Equal(a, b)
+}
diff --git a/component/sourceprofile/syntax.go b/component/sourceprofile/syntax.go
new file mode 100644
--- /dev/null
+++ b/component/sourceprofile/syntax.go
@@ -0,0 +1,256 @@
+package sourceprofile
+
+import (
+	"encoding/json"
+	"net/netip"
+	"strings"
+	"unicode/utf8"
+)
+
+// validUnicode rejects encoding/json's replacement of malformed UTF-8 or lone
+// UTF-16 surrogate escapes. Valid escaped keys are allowed; duplicate detection
+// below compares decoded key values, including equivalent escape spellings.
+func validUnicode(raw []byte) bool {
+	if !utf8.Valid(raw) {
+		return false
+	}
+	hex4 := func(value []byte) (uint16, bool) {
+		if len(value) < 4 {
+			return 0, false
+		}
+		var result uint16
+		for _, c := range value[:4] {
+			result <<= 4
+			switch {
+			case c >= '0' && c <= '9':
+				result |= uint16(c - '0')
+			case c >= 'a' && c <= 'f':
+				result |= uint16(c - 'a' + 10)
+			case c >= 'A' && c <= 'F':
+				result |= uint16(c - 'A' + 10)
+			default:
+				return 0, false
+			}
+		}
+		return result, true
+	}
+	for i := 0; i < len(raw); i++ {
+		if raw[i] != '"' {
+			continue
+		}
+		i++
+		for ; i < len(raw) && raw[i] != '"'; i++ {
+			if raw[i] != '\\' {
+				continue
+			}
+			i++
+			if i >= len(raw) {
+				return false
+			}
+			if raw[i] != 'u' {
+				continue
+			}
+			code, ok := hex4(raw[i+1:])
+			if !ok {
+				return false
+			}
+			i += 4
+			if code >= 0xdc00 && code <= 0xdfff {
+				return false
+			}
+			if code >= 0xd800 && code <= 0xdbff {
+				if i+6 >= len(raw) || raw[i+1] != '\\' || raw[i+2] != 'u' {
+					return false
+				}
+				low, ok := hex4(raw[i+3:])
+				if !ok || low < 0xdc00 || low > 0xdfff {
+					return false
+				}
+				i += 6
+			}
+		}
+		if i >= len(raw) {
+			return false
+		}
+	}
+	return true
+}
+
+// readValue rejects duplicate keys and null at every depth, before Go's normal
+// decoder can silently replace duplicates or convert null to a zero value.
+func readValue(d *json.Decoder, depth int) (any, error) {
+	if depth > 32 {
+		return nil, ErrProfile
+	}
+	t, e := d.Token()
+	if e != nil || t == nil {
+		return nil, ErrProfile
+	}
+	delim, compound := t.(json.Delim)
+	if !compound {
+		return t, nil
+	}
+	switch delim {
+	case '{':
+		v := map[string]any{}
+		for d.More() {
+			k, e := d.Token()
+			if e != nil {
+				return nil, ErrProfile
+			}
+			key, ok := k.(string)
+			if !ok {
+				return nil, ErrProfile
+			}
+			if _, ok = v[key]; ok {
+				return nil, ErrProfile
+			}
+			child, e := readValue(d, depth+1)
+			if e != nil {
+				return nil, e
+			}
+			v[key] = child
+		}
+		end, e := d.Token()
+		if e != nil || end != json.Delim('}') {
+			return nil, ErrProfile
+		}
+		return v, nil
+	case '[':
+		v := []any{}
+		for d.More() {
+			child, e := readValue(d, depth+1)
+			if e != nil {
+				return nil, e
+			}
+			v = append(v, child)
+		}
+		end, e := d.Token()
+		if e != nil || end != json.Delim(']') {
+			return nil, ErrProfile
+		}
+		return v, nil
+	}
+	return nil, ErrProfile
+}
+func object(v any, required, optional string) (map[string]any, bool) {
+	m, ok := v.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	allowed := map[string]bool{}
+	for _, k := range strings.Fields(required) {
+		if !has(m, k) {
+			return nil, false
+		}
+		allowed[k] = true
+	}
+	for _, k := range strings.Fields(optional) {
+		allowed[k] = true
+	}
+	for k := range m {
+		if !allowed[k] {
+			return nil, false
+		}
+	}
+	return m, true
+}
+func has(m map[string]any, k string) bool { _, ok := m[k]; return ok }
+func token(s string) bool {
+	if len(s) == 0 || len(s) > 128 {
+		return false
+	}
+	for i, c := range []byte(s) {
+		alpha := c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+		if !alpha && (i == 0 || !strings.ContainsRune("._:-", rune(c))) {
+			return false
+		}
+	}
+	return true
+}
+func id(s, prefix string) bool {
+	return token(s) && strings.HasPrefix(s, prefix) && token(strings.TrimPrefix(s, prefix))
+}
+func credential(s string) bool {
+	if len(s) < 32 || len(s) > 128 {
+		return false
+	}
+	for _, c := range []byte(s) {
+		if c < 33 || c > 126 || c == ':' {
+			return false
+		}
+	}
+	return true
+}
+func domainToken(s string) bool {
+	if len(s) == 0 || len(s) > 253 {
+		return false
+	}
+	for _, label := range strings.Split(s, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, c := range []byte(label) {
+			if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+func atom(parts []string, entries map[string]bool) bool {
+	if len(parts) < 2 || len(parts) > 3 || parts[1] == "" || strings.ContainsAny(parts[1], ",() \t\n\r\v\f") {
+		return false
+	}
+	switch parts[0] {
+	case "DOMAIN", "DOMAIN-SUFFIX":
+		return len(parts) == 2 && domainToken(parts[1])
+	case "IN-NAME":
+		return len(parts) == 2 && entries[parts[1]]
+	case "IP-CIDR":
+		p, e := netip.ParsePrefix(parts[1])
+		return e == nil && p.Addr().Is4() && (len(parts) == 2 || parts[2] == "no-resolve")
+	}
+	return false
+}
+func validRule(rule string, target func(string) bool, entries map[string]bool) bool {
+	return validRuleWithAtom(rule, target, entries, atom)
+}
+
+func validRuleWithAtom(rule string, target func(string) bool, entries map[string]bool, checkAtom func([]string, map[string]bool) bool) bool {
+	if strings.HasPrefix(rule, "AND,(") {
+		// The grammar is AND,((atom),(atom)),target. Splitting at the
+		// outer close keeps no-resolve inside an IP-CIDR atom intact.
+		end := strings.LastIndex(rule, ")),")
+		if end < 0 || !target(rule[end+3:]) {
+			return false
+		}
+		if !strings.HasPrefix(rule, "AND,((") || end < len("AND,((") {
+			return false
+		}
+		body := rule[len("AND,(("):end]
+		atoms := strings.Split(body, "),(")
+		if len(atoms) < 2 || len(atoms) > 8 {
+			return false
+		}
+		for _, a := range atoms {
+			if !checkAtom(strings.Split(a, ","), entries) {
+				return false
+			}
+		}
+		return true
+	}
+	parts := strings.Split(rule, ",")
+	if len(parts) < 3 {
+		return false
+	}
+	// no-resolve is the sole supported rule option and follows the target.
+	if parts[0] == "IP-CIDR" && len(parts) == 4 {
+		return target(parts[2]) && checkAtom([]string{parts[0], parts[1], parts[3]}, entries)
+	}
+	return len(parts) == 3 && target(parts[2]) && checkAtom(parts[:2], entries)
+}
+
+func boundedText(s string, max int, nonempty bool) bool {
+	return utf8.ValidString(s) && len(s) <= max && (!nonempty || len(s) > 0)
+}
diff --git a/constant/hoopa_probe.go b/constant/hoopa_probe.go
new file mode 100644
--- /dev/null
+++ b/constant/hoopa_probe.go
@@ -0,0 +1,38 @@
+package constant
+
+import "time"
+
+// HoopaProbeObservation is an atomic completion record, not native alive/history
+// guesses. Zero-millisecond success is distinct from missing or failed probes.
+type HoopaProbeObservation struct {
+	Known       bool
+	Success     bool
+	CompletedAt time.Time
+	DelayMS     uint16
+}
+
+// HoopaProbePolicy is configured once before protected core publication.
+// AcceptedStatus is fixed by sourcecontrol-v2, not a provider-controlled default.
+type HoopaProbePolicy struct {
+	URL             string
+	IntervalSeconds uint64
+	TimeoutMS       uint64
+	ToleranceMS     uint64
+}
+
+const HoopaProbeAcceptedStatus = "200-299"
+
+// HoopaProbeSource is deliberately separate from the native Proxy interface.
+// A protected group refuses proxies without atomic qualified observations.
+type HoopaProbeSource interface {
+	EnableHoopaProbe(url, expectedStatus string) bool
+	HoopaProbeObservation(url, expectedStatus string) HoopaProbeObservation
+}
+
+type HoopaHealthCheckPolicy struct {
+	URL             string
+	ExpectedStatus  string
+	IntervalSeconds uint64
+	TimeoutMS       uint64
+	Lazy            bool
+}
diff --git a/hoopa_control_sources_linux.go b/hoopa_control_sources_linux.go
new file mode 100644
--- /dev/null
+++ b/hoopa_control_sources_linux.go
@@ -0,0 +1,279 @@
+//go:build linux && amd64
+
+package main
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"net"
+	"net/http"
+	"os"
+	"os/signal"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	wire "github.com/metacubex/mihomo/component/corecontrol"
+	"github.com/metacubex/mihomo/component/hoopaguard"
+	legacy "github.com/metacubex/mihomo/component/hoopaguard/profile"
+	sources "github.com/metacubex/mihomo/component/sourcecontrol"
+	profile "github.com/metacubex/mihomo/component/sourceprofile"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/metacubex/mihomo/hub/executor"
+	listenerInbound "github.com/metacubex/mihomo/listener/inbound"
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+func hoopaSourceCapabilities() []string {
+	return []string{"authenticated-activate-v1", "closed-start-v1", "immutable-source-snapshot-v2", "probe-qualified-groups-v1"}
+}
+
+func runHoopaControlSources() error {
+	log.SetLevel(log.SILENT)
+	if os.Getenv("HOOPA_CONTROL_PROTOCOL") != "2" || version || testConfig || configString != "" || configFile == "-" || !guardPrivateDir(homeDir) || geodataMode || postUp != "" || postDown != "" || externalUI != "" || externalController != "" || externalControllerUnix != "" || externalControllerPipe != "" || secret != "" || flag.NArg() != 0 {
+		return errHoopaGuard
+	}
+	nonce := os.Getenv("HOOPA_RUN_NONCE")
+	nb, err := hex.DecodeString(nonce)
+	if err != nil || len(nb) != 32 || hex.EncodeToString(nb) != nonce {
+		return errHoopaGuard
+	}
+	for _, kv := range os.Environ() {
+		pair := strings.SplitN(kv, "=", 2)
+		if pair[0] == "HOOPA_IDENTITY_HANDOFF" || pair[0] == "HOOPA_IDENTITY_HANDOFF_SET" || strings.HasPrefix(pair[0], "HOOPA_TRACE_") && pair[1] != "" {
+			return errHoopaGuard
+		}
+	}
+	raw, err := guardReadConfig(configFile)
+	if err != nil {
+		return errHoopaGuard
+	}
+	hash := controlDigest(raw)
+	if hash != os.Getenv("HOOPA_GUARD_CONFIG_SHA256") {
+		return errHoopaGuard
+	}
+	generation, runID := os.Getenv("HOOPA_GUARD_GENERATION"), os.Getenv("HOOPA_RUN_ID")
+	p, err := profile.Validate(raw, generation)
+	if err != nil {
+		return errHoopaGuard
+	}
+	status := sources.Status{SchemaVersion: 2, RunID: runID, ConfigGeneration: generation, ConfigSHA256: hash, BinaryVersion: C.Version, Mode: "basic-sources", Capabilities: hoopaSourceCapabilities(), State: "closed", SnapshotSHA256: hash}
+	if status.Validate() != nil {
+		return errHoopaGuard
+	}
+	C.SetHomeDir(homeDir)
+	C.SetConfig(configFile)
+	cfg, err := executor.ParseWithBytes(raw)
+	if err != nil {
+		return errHoopaGuard
+	}
+	g := cfg.General
+	if g.Port != 0 || g.SocksPort != 0 || g.RedirPort != 0 || g.TProxyPort != 0 || g.MixedPort != 0 || g.Tun.Enable || g.TuicServer.Enable || len(cfg.Tunnels) != 0 || len(cfg.RuleProviders) != 0 || len(cfg.SubRules) != 0 || g.GeoAutoUpdate || len(cfg.Listeners) != len(p.Listeners) {
+		return errHoopaGuard
+	}
+	for _, provider := range cfg.Providers {
+		if provider == nil || provider.VehicleType() != P.Compatible {
+			return errHoopaGuard
+		}
+	}
+	entries := make([]legacy.Entry, 0, len(p.Listeners))
+	for _, entry := range p.Listeners {
+		ln := cfg.Listeners[entry.Name]
+		if ln == nil || ln.Name() != entry.Name || ln.RawAddress() != net.JoinHostPort(entry.Listen, strconv.Itoa(int(entry.Port))) {
+			return errHoopaGuard
+		}
+		o, ok := ln.Config().(*listenerInbound.MixedOption)
+		if !ok || o.UDP || o.SpecialProxy != "" || o.SpecialRules != "" || len(o.Users) != 1 || o.Users[0].Username != entry.Users[0].Username || o.Users[0].Password != entry.Users[0].Password {
+			return errHoopaGuard
+		}
+		entries = append(entries, legacy.Entry{Name: entry.Name, Type: entry.Type, Listen: entry.Listen, Port: entry.Port, UDP: entry.UDP, Users: []legacy.User{{Username: entry.Users[0].Username, Password: entry.Users[0].Password}}})
+	}
+	// Configure protected selection before publishing proxies or starting native
+	// provider health checks. These are immutable inline providers only.
+	for _, group := range p.Groups {
+		proxy := cfg.Proxies[group.Name]
+		if proxy == nil {
+			return errHoopaGuard
+		}
+		if group.Type == "url-test" {
+			u, ok := proxy.Adapter().(*outboundgroup.URLTest)
+			if !ok {
+				return errHoopaGuard
+			}
+			probe := group.Probe()
+			if u.ConfigureHoopaProbe(C.HoopaProbePolicy{URL: probe.URL, IntervalSeconds: probe.IntervalSeconds, TimeoutMS: probe.TimeoutMS, ToleranceMS: probe.ToleranceMS}, cfg.Proxies["REJECT"]) != nil {
+				return errHoopaGuard
+			}
+		}
+	}
+	cfg.Listeners = nil
+	C.HoopaProtected = true
+	executor.ApplyConfig(cfg, true)
+	defer executor.Shutdown()
+	r := &hoopaControlRuntime{sourceMode: true, state: "closed", runID: runID, generation: generation, hash: hash, secret: p.Secret, controllerAddress: p.Controller, declaredEntries: entries, conns: map[net.Conn]bool{}}
+	defer r.stop()
+	snapshot, err := r.readSourceSnapshot()
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.snapshotSHA, err = snapshot.Digest()
+	if err != nil {
+		return errHoopaGuard
+	}
+	for _, entry := range entries {
+		f, err := hoopaguard.Reserve(net.JoinHostPort(entry.Listen, strconv.Itoa(int(entry.Port))))
+		if err != nil {
+			return errHoopaGuard
+		}
+		r.reserved = append(r.reserved, f)
+	}
+	f, err := hoopaguard.Reserve(p.Controller)
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.controller, err = hoopaguard.Listen(f)
+	_ = f.Close()
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.server = &http.Server{Handler: r, ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 3 * time.Second, WriteTimeout: 3 * time.Second, IdleTimeout: 5 * time.Second, MaxHeaderBytes: 8192}
+	terms, hups := make(chan os.Signal, 1), make(chan os.Signal, 1)
+	signal.Notify(terms, syscall.SIGINT, syscall.SIGTERM)
+	signal.Notify(hups, syscall.SIGHUP)
+	defer signal.Stop(terms)
+	defer signal.Stop(hups)
+	served := make(chan error, 1)
+	go func() { served <- r.server.Serve(r.controller) }()
+	for {
+		select {
+		case <-terms:
+			return nil
+		case <-hups:
+		case <-served:
+			return errHoopaGuard
+		}
+	}
+}
+
+func (r *hoopaControlRuntime) controlPrefix() string {
+	if r.sourceMode {
+		return "/hoopa/v2/"
+	}
+	return "/hoopa/v1/"
+}
+func (r *hoopaControlRuntime) decodeMutation(raw []byte) (wire.Mutation, error) {
+	if r.sourceMode {
+		q, e := sources.DecodeMutation(raw)
+		return wire.Mutation(q), e
+	}
+	return wire.DecodeMutation(raw)
+}
+func (r *hoopaControlRuntime) mutationDigest(q wire.Mutation) (string, error) {
+	if r.sourceMode {
+		return sources.Mutation(q).Digest()
+	}
+	return q.Digest()
+}
+func sourceStatus(s wire.Status) (sources.Status, error) {
+	v := sources.Status{SchemaVersion: 2, RunID: s.RunID, ConfigGeneration: s.ConfigGeneration, ConfigSHA256: s.ConfigSHA256, BinaryVersion: s.BinaryVersion, Mode: "basic-sources", Capabilities: hoopaSourceCapabilities(), State: s.State, SnapshotSHA256: s.SnapshotSHA256}
+	if s.Activation != nil {
+		x := sources.Result(*s.Activation)
+		v.Activation = &x
+	}
+	if s.Drain != nil {
+		x := sources.Result(*s.Drain)
+		v.Drain = &x
+	}
+	return v, v.Validate()
+}
+
+// URLTest projection deliberately never calls Now, Touch, or a live probe.
+// Its immutable policy is checked by Configure against native health settings.
+func (r *hoopaControlRuntime) readSourceSnapshot() (sources.Snapshot, error) {
+	s := sources.Snapshot{SchemaVersion: 2, ConfigSHA256: r.hash, Controller: r.controllerAddress, Entries: []sources.Entry{}, Proxies: []sources.Proxy{}, Rules: []sources.Rule{}}
+	for _, e := range r.declaredEntries {
+		users, err := json.Marshal(e.Users)
+		if err != nil {
+			return s, errHoopaGuard
+		}
+		s.Entries = append(s.Entries, sources.Entry{Name: e.Name, Type: e.Type, Address: net.JoinHostPort(e.Listen, strconv.Itoa(int(e.Port))), AuthSHA256: controlDigest(users)})
+	}
+	for name, p := range tunnel.Proxies() {
+		if p == nil || name != p.Name() {
+			return s, errHoopaGuard
+		}
+		x := sources.Proxy{Name: name, Type: p.Type().String(), Address: p.Addr(), DialerProxy: p.ProxyInfo().DialerProxy, Members: []string{}}
+		switch p.Type() {
+		case C.Selector:
+			u, ok := p.Adapter().(*outboundgroup.Selector)
+			if !ok {
+				return s, errHoopaGuard
+			}
+			for _, m := range u.Proxies() {
+				if m == nil {
+					return s, errHoopaGuard
+				}
+				x.Members = append(x.Members, m.Name())
+			}
+			x.Selected = u.Now()
+		case C.URLTest:
+			u, ok := p.Adapter().(*outboundgroup.URLTest)
+			if !ok {
+				return s, errHoopaGuard
+			}
+			policy, ok := u.HoopaProbePolicy()
+			if !ok {
+				return s, errHoopaGuard
+			}
+			x.Probe = &sources.Probe{URL: policy.URL, IntervalSeconds: policy.IntervalSeconds, TimeoutMS: policy.TimeoutMS, ToleranceMS: policy.ToleranceMS}
+			for _, m := range u.Proxies() {
+				if m == nil {
+					return s, errHoopaGuard
+				}
+				x.Members = append(x.Members, m.Name())
+			}
+		}
+		s.Proxies = append(s.Proxies, x)
+	}
+	for _, rule := range tunnel.Rules() {
+		if rule == nil {
+			return s, errHoopaGuard
+		}
+		s.Rules = append(s.Rules, sources.Rule{Type: rule.RuleType().String(), Payload: rule.Payload(), Target: rule.Adapter()})
+	}
+	sort.Slice(s.Entries, func(i, j int) bool { return s.Entries[i].Name < s.Entries[j].Name })
+	sort.Slice(s.Proxies, func(i, j int) bool { return s.Proxies[i].Name < s.Proxies[j].Name })
+	return s, s.Validate()
+}
+
+func (r *hoopaControlRuntime) verifiedProjection() (any, error) {
+	if !r.sourceMode {
+		return r.verifiedSnapshot()
+	}
+	s, err := r.readSourceSnapshot()
+	if err != nil {
+		return nil, err
+	}
+	hash, err := s.Digest()
+	if err != nil || hash != r.snapshotSHA {
+		return nil, errHoopaGuard
+	}
+	if r.state == "open" {
+		if len(r.entries) != len(r.declaredEntries) {
+			return nil, errHoopaGuard
+		}
+		for i, ln := range r.entries {
+			e := r.declaredEntries[i]
+			if ln.Addr().String() != net.JoinHostPort(e.Listen, strconv.Itoa(int(e.Port))) {
+				return nil, errHoopaGuard
+			}
+		}
+	}
+	return s, nil
+}
diff --git a/hoopa_control_v1_linux.go b/hoopa_control_v1_linux.go
--- a/hoopa_control_v1_linux.go
+++ b/hoopa_control_v1_linux.go
@@ -50,6 +50,9 @@
 }
 
 func runHoopaControlV1() error {
+	if os.Getenv("HOOPA_CONTROL_PROTOCOL") == "2" {
+		return runHoopaControlSources()
