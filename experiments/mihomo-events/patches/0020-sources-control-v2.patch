+package sourcecontrol
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// validUnicode rejects encoding/json's replacement of malformed UTF-8 or lone
+// UTF-16 surrogate escapes. Valid escaped keys are allowed; duplicate detection
+// below compares decoded key values, including equivalent escape spellings.
+func validUnicode(raw []byte) bool {
+	if !utf8.Valid(raw) {
+		return false
+	}
+	hex4 := func(value []byte) (uint16, bool) {
+		if len(value) < 4 {
+			return 0, false
+		}
+		var result uint16
+		for _, c := range value[:4] {
+			result <<= 4
+			switch {
+			case c >= '0' && c <= '9':
+				result |= uint16(c - '0')
+			case c >= 'a' && c <= 'f':
+				result |= uint16(c - 'a' + 10)
+			case c >= 'A' && c <= 'F':
+				result |= uint16(c - 'A' + 10)
+			default:
+				return 0, false
+			}
+		}
+		return result, true
+	}
+	for i := 0; i < len(raw); i++ {
+		if raw[i] != '"' {
+			continue
+		}
+		i++
+		for ; i < len(raw) && raw[i] != '"'; i++ {
+			if raw[i] != '\\' {
+				continue
+			}
+			i++
+			if i >= len(raw) {
+				return false
+			}
+			if raw[i] != 'u' {
+				continue
+			}
+			code, ok := hex4(raw[i+1:])
+			if !ok {
+				return false
+			}
+			i += 4
+			if code >= 0xdc00 && code <= 0xdfff {
+				return false
+			}
+			if code >= 0xd800 && code <= 0xdbff {
+				if i+6 >= len(raw) || raw[i+1] != '\\' || raw[i+2] != 'u' {
+					return false
+				}
+				low, ok := hex4(raw[i+3:])
+				if !ok || low < 0xdc00 || low > 0xdfff {
+					return false
+				}
+				i += 6
+			}
+		}
+		if i >= len(raw) {
+			return false
+		}
+	}
+	return true
+}
+
+// wireShape is confined to these wire structs: every field is required except
+// the explicitly omitempty receipt and probe pointers. It never infers requiredness
+// from zero values and rejects ambiguity before encoding/json populates values.
+func wireShape(raw []byte, t reflect.Type) error {
+	raw = bytes.TrimSpace(raw)
+	if bytes.Equal(raw, []byte("null")) {
+		return ErrInvalid
+	}
+	if t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	switch t.Kind() {
+	case reflect.Int:
+		if string(raw) != "2" {
+			return ErrInvalid
+		}
+		return nil
+	case reflect.Uint64:
+		// Probe numbers must be literal canonical unsigned decimal integers, never
+		// floats/exponents/signs. Check safe range before assignment and narrower
+		// profile limits in Probe.Validate after decoding.
+		if len(raw) < 1 || len(raw) > 16 || len(raw) > 1 && raw[0] == '0' {
+			return ErrInvalid
+		}
+		for _, c := range raw {
+			if c < '0' || c > '9' {
+				return ErrInvalid
+			}
+		}
+		value, err := strconv.ParseUint(string(raw), 10, 64)
+		if err != nil || value > 9007199254740991 {
+			return ErrInvalid
+		}
+		return nil
+	case reflect.String:
+		var value string
+		if json.Unmarshal(raw, &value) != nil {
+			return ErrInvalid
+		}
+		return nil
+	case reflect.Struct:
+		fields := map[string]reflect.StructField{}
+		required := map[string]bool{}
+		for i := 0; i < t.NumField(); i++ {
+			field := t.Field(i)
+			tag := strings.Split(field.Tag.Get("json"), ",")
+			fields[tag[0]] = field
+			if len(tag) == 1 {
+				required[tag[0]] = true
+			}
+		}
+		d := json.NewDecoder(bytes.NewReader(raw))
+		token, err := d.Token()
+		if err != nil || token != json.Delim('{') {
+			return ErrInvalid
+		}
+		seen := map[string]bool{}
+		for d.More() {
+			token, err := d.Token()
+			key, ok := token.(string)
+			field, known := fields[key]
+			if err != nil || !ok || !known || seen[key] {
+				return ErrInvalid
+			}
+			seen[key] = true
+			var value json.RawMessage
+			if d.Decode(&value) != nil || wireShape(value, field.Type) != nil {
+				return ErrInvalid
+			}
+		}
+		if token, err = d.Token(); err != nil || token != json.Delim('}') {
+			return ErrInvalid
+		}
+		if _, err = d.Token(); err != io.EOF {
+			return ErrInvalid
+		}
+		for key := range required {
+			if !seen[key] {
+				return ErrInvalid
+			}
+		}
+		return nil
+	case reflect.Slice:
+		d := json.NewDecoder(bytes.NewReader(raw))
+		token, err := d.Token()
+		if err != nil || token != json.Delim('[') {
+			return ErrInvalid
+		}
+		for d.More() {
+			var value json.RawMessage
+			if d.Decode(&value) != nil || wireShape(value, t.Elem()) != nil {
+				return ErrInvalid
+			}
+		}
+		if token, err = d.Token(); err != nil || token != json.Delim(']') {
+			return ErrInvalid
+		}
+		if _, err = d.Token(); err != io.EOF {
+			return ErrInvalid
+		}
+		return nil
+	default:
+		return ErrInvalid
+	}
+}
+func strict(raw []byte, out any) error {
+	if len(raw) == 0 || len(raw) > MaxJSONBytes || !validUnicode(raw) || wireShape(raw, reflect.TypeOf(out).Elem()) != nil || json.Unmarshal(raw, out) != nil {
+		return ErrInvalid
+	}
+	return nil
+}
+func DecodeSnapshot(raw []byte) (Snapshot, error) {
+	var value Snapshot
+	if strict(raw, &value) != nil || value.Validate() != nil {
+		return Snapshot{}, ErrInvalid
+	}
+	return value, nil
+}
+func DecodeStatus(raw []byte) (Status, error) {
+	var value Status
+	if strict(raw, &value) != nil || value.Validate() != nil {
+		return Status{}, ErrInvalid
+	}
+	return value, nil
+}
+func DecodeMutation(raw []byte) (Mutation, error) {
+	var value Mutation
+	if strict(raw, &value) != nil || value.Validate() != nil {
+		return Mutation{}, ErrInvalid
+	}
+	return value, nil
+}
+func DecodeResult(raw []byte) (Result, error) {
+	var value Result
+	if strict(raw, &value) != nil || value.Validate() != nil {
+		return Result{}, ErrInvalid
+	}
+	return value, nil
+}
diff --git a/component/sourcecontrol/types.go b/component/sourcecontrol/types.go
new file mode 100644
--- /dev/null
+++ b/component/sourcecontrol/types.go
@@ -0,0 +1,465 @@
+// Package sourcecontrol defines the candidate basic-sources v2 wire codec only.
+// It grants no core capability and performs no IO, probing or state transitions.
+package sourcecontrol
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const SchemaVersion = 2
+const MaxJSONBytes = 64 << 10
+const MaxPayloadBytes = 4096
+const MaxBinaryVersionBytes = 128
+
+// ErrInvalid never incorporates untrusted configuration or request contents.
+var ErrInvalid = errors.New("invalid basic sources control v2 message")
+
+type Snapshot struct {
+	SchemaVersion int     `json:"schema_version"`
+	ConfigSHA256  string  `json:"config_sha256"`
+	Controller    string  `json:"controller"`
+	Entries       []Entry `json:"entries"`
+	Proxies       []Proxy `json:"proxies"`
+	Rules         []Rule  `json:"rules"`
+}
+type Entry struct {
+	Name       string `json:"name"`
+	Type       string `json:"type"`
+	Address    string `json:"address"`
+	AuthSHA256 string `json:"auth_sha256"`
+}
+type Proxy struct {
+	Name        string   `json:"name"`
+	Type        string   `json:"type"`
+	Address     string   `json:"address"`
+	DialerProxy string   `json:"dialer_proxy"`
+	Members     []string `json:"members"`
+	Selected    string   `json:"selected"`
+	Probe       *Probe   `json:"probe,omitempty"`
+}
+
+// Probe is immutable intent. V2 URLTest qualification requires an observed
+// successful probe with HTTP status 200..299; delay/current-best are not wire
+// fields. Runtime enforcement belongs to the separately integrated core.
+type Probe struct {
+	URL             string `json:"url"`
+	IntervalSeconds uint64 `json:"interval_seconds"`
+	TimeoutMS       uint64 `json:"timeout_ms"`
+	ToleranceMS     uint64 `json:"tolerance_ms"`
+}
+type Rule struct {
+	Type    string `json:"type"`
+	Payload string `json:"payload"`
+	Target  string `json:"target"`
+}
+type Status struct {
+	SchemaVersion    int      `json:"schema_version"`
+	RunID            string   `json:"run_id"`
+	ConfigGeneration string   `json:"config_generation"`
+	ConfigSHA256     string   `json:"config_sha256"`
+	BinaryVersion    string   `json:"binary_version"`
+	Mode             string   `json:"mode"`
+	Capabilities     []string `json:"capabilities"`
+	State            string   `json:"state"`
+	SnapshotSHA256   string   `json:"snapshot_sha256"`
+	Activation       *Result  `json:"activation,omitempty"`
+	Drain            *Result  `json:"drain,omitempty"`
+}
+type Mutation struct {
+	SchemaVersion      int    `json:"schema_version"`
+	Operation          string `json:"operation"`
+	OperationID        string `json:"operation_id"`
+	RunID              string `json:"run_id"`
+	ConfigGeneration   string `json:"config_generation"`
+	ConfigSHA256       string `json:"config_sha256"`
+	SnapshotSHA256     string `json:"snapshot_sha256"`
+	RegistrationSHA256 string `json:"registration_sha256"`
+}
+type Result struct {
+	SchemaVersion int    `json:"schema_version"`
+	OperationID   string `json:"operation_id"`
+	RequestSHA256 string `json:"request_sha256"`
+	RunID         string `json:"run_id"`
+	Result        string `json:"result"`
+}
+
+// IDs use [A-Za-z0-9][A-Za-z0-9._:-]{0,127}, measured in ASCII bytes.
+func validID(value string) bool {
+	if len(value) < 1 || len(value) > 128 {
+		return false
+	}
+	for i, c := range []byte(value) {
+		alnum := c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+		if !alnum && (i == 0 || c != '.' && c != '_' && c != ':' && c != '-') {
+			return false
+		}
+	}
+	return true
+}
+func declared(value, prefix string) bool {
+	return strings.HasPrefix(value, prefix) && validID(value) && validID(strings.TrimPrefix(value, prefix))
+}
+func digestShape(value string) bool {
+	b, err := hex.DecodeString(value)
+	return err == nil && len(b) == 32 && hex.EncodeToString(b) == value
+}
+func endpoint(value string) bool {
+	address, err := netip.ParseAddrPort(value)
+	return err == nil && address.Port() != 0 && address.Addr() == netip.MustParseAddr("127.0.0.1") && address.String() == value
+}
+
+// All free text is bounded UTF-8 without NUL. IDs, enum strings, addresses and
+// digests have stricter shapes; rule payload is a projection, not reparsed AND.
+func text(value string, min, max int) bool {
+	return len(value) >= min && len(value) <= max && utf8.ValidString(value) && !strings.ContainsRune(value, 0)
+}
+func encodedSize(value any) error {
+	raw, err := json.Marshal(value)
+	if err != nil || len(raw) > MaxJSONBytes {
+		return ErrInvalid
+	}
+	return nil
+}
+func hash(value any) (string, error) {
+	raw, err := json.Marshal(value)
+	if err != nil || len(raw) > MaxJSONBytes {
+		return "", ErrInvalid
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func (s Snapshot) Validate() error {
+	if s.SchemaVersion != SchemaVersion || !digestShape(s.ConfigSHA256) || !endpoint(s.Controller) || s.Entries == nil || len(s.Entries) < 1 || len(s.Entries) > 4 || s.Proxies == nil || len(s.Proxies) < 6 || len(s.Proxies) > 70 || s.Rules == nil || len(s.Rules) < 1 || len(s.Rules) > 64 {
+		return ErrInvalid
+	}
+	entries := map[string]bool{}
+	addresses := map[string]bool{s.Controller: true}
+	for i, e := range s.Entries {
+		if !validID(e.Name) || i > 0 && s.Entries[i-1].Name >= e.Name || e.Type != "mixed" || !endpoint(e.Address) || addresses[e.Address] || !digestShape(e.AuthSHA256) {
+			return ErrInvalid
+		}
+		entries[e.Name] = true
+		addresses[e.Address] = true
+	}
+	builtins := map[string]string{"DIRECT": "Direct", "REJECT": "Reject", "REJECT-DROP": "RejectDrop", "COMPATIBLE": "Compatible", "PASS": "Pass", "GLOBAL": "Selector"}
+	proxies := map[string]Proxy{}
+	custom := map[string]bool{}
+	for i, p := range s.Proxies {
+		if !validID(p.Name) || i > 0 && s.Proxies[i-1].Name >= p.Name || p.Members == nil {
+			return ErrInvalid
+		}
+		if kind, ok := builtins[p.Name]; ok {
+			if p.Type != kind {
+				return ErrInvalid
+			}
+		} else {
+			if !(declared(p.Name, "node:") && (p.Type == "Direct" || remoteType(p.Type)) || declared(p.Name, "group:") && (p.Type == "Selector" || p.Type == "URLTest")) {
+				return ErrInvalid
+			}
+			custom[p.Name] = true
+		}
+		if p.DialerProxy != "" {
+			return ErrInvalid
+		}
+		if remoteType(p.Type) {
+			if !remoteEndpoint(p.Address) {
+				return ErrInvalid
+			}
+		} else if p.Address != "" {
+			return ErrInvalid
+		}
+		if p.Type != "Selector" && p.Type != "URLTest" && (len(p.Members) != 0 || p.Selected != "" || p.Probe != nil) {
+			return ErrInvalid
+		}
+		if p.Type == "Selector" && p.Probe != nil {
+			return ErrInvalid
+		}
+		if p.Type == "URLTest" && (p.Selected != "" || p.Probe == nil || p.Probe.Validate() != nil) {
+			return ErrInvalid
+		}
+		proxies[p.Name] = p
+	}
+	for name := range builtins {
+		if _, ok := proxies[name]; !ok {
+			return ErrInvalid
+		}
+	}
+	if len(custom) > 64 {
+		return ErrInvalid
+	}
+	edges := map[string][]string{}
+	for _, p := range s.Proxies {
+		if p.Type != "Selector" && p.Type != "URLTest" {
+			continue
+		}
+		limit := 64
+		if p.Type == "Selector" {
+			limit = 1
+			if p.Name == "GLOBAL" {
+				limit = 66
+			}
+		}
+		if len(p.Members) < 1 || len(p.Members) > limit {
+			return ErrInvalid
+		}
+		seen := map[string]bool{}
+		selected := false
+		for _, member := range p.Members {
+			allowed := custom[member]
+			if p.Type == "URLTest" {
+				allowed = custom[member] && declared(member, "node:") && remoteType(proxies[member].Type)
+			} else {
+				allowed = allowed || member == "REJECT" || p.Name == "GLOBAL" && member == "DIRECT"
+			}
+			if !allowed || seen[member] {
+				return ErrInvalid
+			}
+			seen[member] = true
+			selected = selected || member == p.Selected
+			edges[p.Name] = append(edges[p.Name], member)
+		}
+		if p.Type == "Selector" && !selected {
+			return ErrInvalid
+		}
+	}
+
+	// At most 70 bounded nodes; no artificial depth cap beyond cycle rejection.
+	visited := map[string]uint8{}
+	var visit func(string) bool
+	visit = func(name string) bool {
+		if visited[name] == 1 {
+			return false
+		}
+		if visited[name] == 2 {
+			return true
+		}
+		visited[name] = 1
+		for _, next := range edges[name] {
+			if !visit(next) {
+				return false
+			}
+		}
+		visited[name] = 2
+		return true
+	}
+	for name := range proxies {
+		if !visit(name) {
+			return ErrInvalid
+		}
+	}
+	for i, r := range s.Rules {
+		if !(r.Target == "REJECT" || custom[r.Target]) || !text(r.Payload, 0, MaxPayloadBytes) {
+			return ErrInvalid
+		}
+		switch r.Type {
+		case "Match":
+			if r.Payload != "" || i != len(s.Rules)-1 {
+				return ErrInvalid
+			}
+		case "Domain", "DomainSuffix", "IPCIDR", "AND":
+			if r.Payload == "" {
+				return ErrInvalid
+			}
+		case "InName":
+			if !entries[r.Payload] {
+				return ErrInvalid
+			}
+		default:
+			return ErrInvalid
+		}
+	}
+	if s.Rules[len(s.Rules)-1].Type != "Match" {
+		return ErrInvalid
+	}
+	return encodedSize(s)
+}
+func (s Snapshot) Digest() (string, error) {
+	if s.Validate() != nil {
+		return "", ErrInvalid
+	}
+	return hash(s)
+}
+
+func (s Status) Validate() error {
+	if s.SchemaVersion != SchemaVersion || !validID(s.RunID) || !validID(s.ConfigGeneration) || !digestShape(s.ConfigSHA256) || !text(s.BinaryVersion, 1, MaxBinaryVersionBytes) || s.Mode != "basic-sources" || !digestShape(s.SnapshotSHA256) {
+		return ErrInvalid
+	}
+	expected := []string{"authenticated-activate-v1", "closed-start-v1", "immutable-source-snapshot-v2", "probe-qualified-groups-v1"}
+	if len(s.Capabilities) != len(expected) {
+		return ErrInvalid
+	}
+	for i, c := range s.Capabilities {
+		if c != expected[i] {
+			return ErrInvalid
+		}
+	}
+	if s.State != "closed" && s.State != "open" && s.State != "draining" && s.State != "degraded" {
+		return ErrInvalid
+	}
+	if s.Activation != nil {
+		if s.Activation.Validate() != nil || s.Activation.RunID != s.RunID || s.Activation.Result != "opened" && s.Activation.Result != "failed" {
+			return ErrInvalid
+		}
+	}
+	if s.Drain != nil {
+		if s.Drain.Validate() != nil || s.Drain.RunID != s.RunID || s.Drain.Result != "draining" && s.Drain.Result != "failed" {
+			return ErrInvalid
+		}
+	}
+	if s.Activation != nil && s.Drain != nil && s.Activation.OperationID == s.Drain.OperationID {
+		return ErrInvalid
+	}
+	// Historical receipts must still describe a reachable single-RunID history.
+	activation, drain := "", ""
+	if s.Activation != nil {
+		activation = s.Activation.Result
+	}
+	if s.Drain != nil {
+		drain = s.Drain.Result
+	}
+	valid := false
+	switch s.State {
+	case "closed":
+		valid = activation == "" && drain == ""
+	case "open":
+		valid = activation == "opened" && drain == ""
+	case "draining":
+		valid = (activation == "" || activation == "opened") && drain == "draining"
+	case "degraded":
+		valid = activation == "failed" && drain == "" || activation == "opened" && (drain == "" || drain == "failed") || activation == "" && drain == "failed"
+	}
+	if !valid {
+		return ErrInvalid
+	}
+	return encodedSize(s)
+}
+func (m Mutation) Validate() error {
+	if m.SchemaVersion != SchemaVersion || m.Operation != "activate" && m.Operation != "drain" || !validID(m.OperationID) || !validID(m.RunID) || !validID(m.ConfigGeneration) || !digestShape(m.ConfigSHA256) || !digestShape(m.SnapshotSHA256) || !digestShape(m.RegistrationSHA256) {
+		return ErrInvalid
+	}
+	return encodedSize(m)
+}
+func (m Mutation) Digest() (string, error) {
+	if m.Validate() != nil {
+		return "", ErrInvalid
+	}
+	return hash(m)
+}
+func (r Result) Validate() error {
+	if r.SchemaVersion != SchemaVersion || !validID(r.OperationID) || !validID(r.RunID) || !digestShape(r.RequestSHA256) || r.Result != "opened" && r.Result != "draining" && r.Result != "failed" {
+		return ErrInvalid
+	}
+	return encodedSize(r)
+}
+
+func remoteType(kind string) bool {
+	switch kind {
+	case "Http", "Socks5", "Shadowsocks", "Trojan", "Vmess", "Vless", "Hysteria2":
+		return true
+	}
+	return false
+}
+func canonicalHost(host string) (string, bool) {
+	if addr, err := netip.ParseAddr(host); err == nil {
+		if addr.Zone() != "" {
+			return "", false
+		}
+		return addr.String(), true
+	}
+	host = strings.TrimSuffix(strings.ToLower(host), ".")
+	if len(host) == 0 || len(host) > 253 {
+		return "", false
+	}
+	numericDotted := strings.Contains(host, ".")
+	for _, c := range host {
+		if c != '.' && (c < '0' || c > '9') {
+			numericDotted = false
+			break
+		}
+	}
+	if numericDotted {
+		return "", false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return "", false
+		}
+		for _, c := range []byte(label) {
+			if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+				return "", false
+			}
+		}
+	}
+	return host, true
+}
+func remoteEndpoint(address string) bool {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return false
+	}
+	normalized, ok := canonicalHost(host)
+	if !ok {
+		return false
+	}
+	number, err := strconv.ParseUint(port, 10, 16)
+	return err == nil && number > 0 && address == net.JoinHostPort(normalized, strconv.FormatUint(number, 10))
+}
+func (p Probe) Validate() error {
+	if !probeURL(p.URL) || p.IntervalSeconds < 1 || p.IntervalSeconds > 86400 || p.TimeoutMS < 1 || p.TimeoutMS > 60000 || p.ToleranceMS > 65534 {
+		return ErrInvalid
+	}
+	return nil
+}
+func probeURL(raw string) bool {
+	if !utf8.ValidString(raw) || strings.ContainsAny(raw, "#\\") {
+		return false
+	}
+	for _, c := range raw {
+		if unicode.IsControl(c) || unicode.IsSpace(c) {
+			return false
+		}
+	}
+	u, err := url.Parse(raw)
+	if err != nil || !strings.EqualFold(u.Scheme, "http") && !strings.EqualFold(u.Scheme, "https") || u.Opaque != "" || u.User != nil {
+		return false
+	}
+	host := u.Hostname()
+	if _, ok := canonicalHost(host); !ok {
+		return false
+	}
+	bracketed := strings.HasPrefix(u.Host, "[")
+	addr, ipErr := netip.ParseAddr(host)
+	if bracketed {
+		if ipErr != nil || !addr.Is6() || addr.Zone() != "" {
+			return false
+		}
+	} else if strings.Contains(host, ":") {
+		return false
+	}
+	authority := u.Host
+	if bracketed {
+		end := strings.IndexByte(authority, ']')
+		if end < 0 {
+			return false
+		}
+		authority = authority[end+1:]
+	}
+	if strings.Contains(authority, ":") {
+		number, err := strconv.ParseUint(u.Port(), 10, 16)
+		if err != nil || number == 0 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/component/sourceprofile/connection.go b/component/sourceprofile/connection.go
new file mode 100644
--- /dev/null
+++ b/component/sourceprofile/connection.go
@@ -0,0 +1,486 @@
+// Finite connection parser derived from internal/subscription/protocol.go.
+// It validates canonical generated material; provider parsing remains separate.
+package sourceprofile
+
+import (
+	"encoding/json"
+	"net/netip"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+// A protocol is an explicit finite profile, not an upstream option pass-through.
+// Rendering uses exactly the normalized values used by connection identity.
+func parseConnection(value any) (string, map[string]any, error) {
+	p := nodeParser{}
+	in, ok := value.(map[string]any)
+	if !ok {
+		return "", nil, ErrProfile
+	}
+	kind := p.text(in["type"], 4096, true)
+	options := ""
+	required := ""
+	switch kind {
+	case "socks5":
+		options = "username password udp tls skip-cert-verify"
+	case "http":
+		options = "username password tls sni skip-cert-verify"
+	case "ss":
+		options = "udp"
+		required = "cipher password"
+	case "trojan":
+		options = "network sni alpn skip-cert-verify udp ws-opts"
+		required = "password"
+	case "vmess":
+		options = "network tls servername alpn skip-cert-verify udp ws-opts"
+		required = "uuid cipher alterId"
+	case "vless":
+		options = "network tls servername alpn skip-cert-verify udp ws-opts"
+		required = "uuid"
+	case "hysteria2":
+		options = "sni alpn skip-cert-verify"
+		required = "password"
+	default:
+		if p.err != nil {
+			return "", nil, p.err
+		}
+		return "", nil, ErrProfile
+	}
+	p.object(in, "name type server port "+required, options)
+	name := p.text(in["name"], 1024, true)
+	if hasControl(name) {
+		p.invalid()
+	}
+	server := p.host(in["server"])
+	port := p.integer(in["port"], 1, 65535)
+	out := map[string]any{"type": kind, "server": server, "port": port}
+	if kind == "socks5" || kind == "http" {
+		_, userPresent := in["username"]
+		_, passPresent := in["password"]
+		user, password := "", ""
+		max := 4096
+		if kind == "socks5" {
+			max = 255
+		}
+		if userPresent {
+			user = p.text(in["username"], max, true)
+		}
+		if passPresent {
+			password = p.text(in["password"], max, true)
+		}
+		if userPresent != passPresent {
+			p.invalid()
+		}
+		out["username"] = user
+		out["password"] = password
+	}
+	if kind == "ss" || kind == "trojan" || kind == "hysteria2" {
+		out["password"] = p.text(in["password"], 4096, true)
+	}
+	if kind == "ss" {
+		out["cipher"] = p.choice(in["cipher"], "aes-128-gcm", "aes-192-gcm", "aes-256-gcm", "chacha20-ietf-poly1305")
+	}
+	if kind == "vmess" || kind == "vless" {
+		uuid := p.text(in["uuid"], 36, true)
+		if !uuidForm.MatchString(uuid) {
+			p.invalid()
+		}
+		out["uuid"] = strings.ToLower(uuid)
+	}
+	if kind == "vmess" {
+		out["cipher"] = p.choice(in["cipher"], "auto", "aes-128-gcm", "chacha20-poly1305", "none")
+		alter := p.integer(in["alterId"], 0, 9007199254740991)
+		if alter != 0 {
+			p.unsupported()
+		}
+		out["alterId"] = alter
+	}
+	if kind != "http" && kind != "hysteria2" {
+		out["udp"] = p.optionalBool(in, "udp", false)
+	}
+	network := ""
+	if kind == "trojan" || kind == "vmess" || kind == "vless" {
+		network = "tcp"
+		if value, ok := in["network"]; ok {
+			network = p.choice(value, "tcp", "ws")
+		}
+		out["network"] = network
+		if network == "ws" {
+			out["ws-opts"] = p.websocket(in)
+		} else if _, ok := in["ws-opts"]; ok {
+			p.invalid()
+		}
+	}
+	tls := kind == "trojan" || kind == "hysteria2"
+	if kind == "socks5" || kind == "http" || kind == "vmess" || kind == "vless" {
+		tls = p.optionalBool(in, "tls", false)
+		out["tls"] = tls
+	}
+	if kind == "socks5" {
+		skip := p.optionalBool(in, "skip-cert-verify", false)
+		if skip {
+			p.unsupported()
+		}
+		out["skip-cert-verify"] = false
+	} else if kind != "ss" {
+		sniKey := "sni"
+		if kind == "vmess" || kind == "vless" {
+			sniKey = "servername"
+		}
+		if tls {
+			sni := server
+			if value, ok := in[sniKey]; ok {
+				sni = p.host(value)
+			} else if network == "ws" && (kind == "vmess" || kind == "vless") {
+				// Match native TLS WS fallback: explicit servername, then WS Host,
+				// then server. A Host authority with a port requires explicit SNI.
+				ws, _ := out["ws-opts"].(map[string]any)
+				headers, _ := ws["headers"].(map[string]any)
+				if host, ok := headers["Host"].(string); ok {
+					var hasPort bool
+					sni, hasPort = authorityHostname(host)
+					if hasPort {
+						p.invalid()
+					}
+				}
+			}
+			out[sniKey] = sni
+			skip := p.optionalBool(in, "skip-cert-verify", false)
+			if skip {
+				p.unsupported()
+			}
+			out["skip-cert-verify"] = false
+			if kind != "http" {
+				p.alpn(in, out, kind, network)
+			}
+		} else {
+			for _, key := range []string{sniKey, "alpn", "skip-cert-verify"} {
+				if _, ok := in[key]; ok {
+					p.invalid()
+				}
+			}
+		}
+	}
+
+	if p.err != nil {
+		return "", nil, p.err
+	}
+	return name, out, nil
+}
+
+type nodeParser struct{ err error }
+
+func (p *nodeParser) invalid() {
+	if p.err == nil {
+		p.err = ErrProfile
+	}
+}
+func (p *nodeParser) unsupported() {
+	if p.err == nil {
+		p.err = ErrProfile
+	}
+}
+func (p *nodeParser) object(m map[string]any, required, optional string) {
+	allowed := map[string]bool{}
+	for _, key := range strings.Fields(required) {
+		allowed[key] = true
+		if _, ok := m[key]; !ok {
+			p.invalid()
+		}
+	}
+	for _, key := range strings.Fields(optional) {
+		allowed[key] = true
+	}
+	for key := range m {
+		if !allowed[key] {
+			p.invalid()
+		}
+	}
+}
+func (p *nodeParser) text(v any, max int, nonempty bool) string {
+	s, ok := v.(string)
+	if !ok || !boundedText(s, max, nonempty) || strings.ContainsAny(s, "\x00\r\n") {
+		p.invalid()
+	}
+	return s
+}
+func (p *nodeParser) optionalBool(m map[string]any, key string, fallback bool) bool {
+	v, present := m[key]
+	if !present {
+		return fallback
+	}
+	b, ok := v.(bool)
+	if !ok {
+		p.invalid()
+	}
+	return b
+}
+func (p *nodeParser) choice(v any, values ...string) string {
+	s := p.text(v, 4096, true)
+	for _, value := range values {
+		if s == value {
+			return s
+		}
+	}
+	p.unsupported()
+	return s
+}
+func (p *nodeParser) host(v any) string {
+	s := p.text(v, 4096, true)
+	host, ok := canonicalHost(s)
+	if !ok {
+		p.invalid()
+	}
+	return host
+}
+func (p *nodeParser) integer(v any, min, max uint64) uint64 {
+	n, ok := v.(json.Number)
+	if !ok {
+		p.invalid()
+		return 0
+	}
+	s := n.String()
+	negative := strings.HasPrefix(s, "-")
+	s = strings.TrimPrefix(s, "-")
+	mantissa, exponent, hasExponent := strings.Cut(strings.ToLower(s), "e")
+	fraction := 0
+	if i := strings.IndexByte(mantissa, '.'); i >= 0 {
+		fraction = len(mantissa) - i - 1
+		mantissa = mantissa[:i] + mantissa[i+1:]
+	}
+	digits := strings.TrimLeft(mantissa, "0")
+	if digits == "" {
+		if min > 0 {
+			p.invalid()
+		}
+		return 0
+	}
+	if negative {
+		p.invalid()
+		return 0
+	}
+	exp := int64(0)
+	if hasExponent {
+		var err error
+		exp, err = strconv.ParseInt(exponent, 10, 32)
+		if err != nil {
+			p.invalid()
+			return 0
+		}
+	}
+	scale := exp - int64(fraction)
+	for strings.HasSuffix(digits, "0") {
+		digits = strings.TrimSuffix(digits, "0")
+		scale++
+	}
+	if scale < 0 || scale > 16 || int64(len(digits))+scale > 16 {
+		p.invalid()
+		return 0
+	}
+	result, err := strconv.ParseUint(digits+strings.Repeat("0", int(scale)), 10, 64)
+	if err != nil || result < min || result > max {
+		p.invalid()
+		return 0
+	}
+	return result
+}
+func hasControl(s string) bool {
+	for _, c := range s {
+		if unicode.IsControl(c) {
+			return true
+		}
+	}
+	return false
+}
+
+var uuidForm = regexp.MustCompile(`^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`)
+
+func canonicalHost(s string) (string, bool) {
+	// Brackets and zones are authority syntax, never part of a provider server.
+	if s == "" || strings.ContainsAny(s, "[]%/\\:@ \t\r\n\x00") {
+		if addr, err := netip.ParseAddr(s); err == nil && addr.Zone() == "" {
+			return addr.String(), true
+		}
+		return "", false
+	}
+	s = strings.TrimSuffix(strings.ToLower(s), ".")
+	if addr, err := netip.ParseAddr(s); err == nil && addr.Zone() == "" {
+		return addr.String(), true
+	}
+	if len(s) == 0 || len(s) > 253 {
+		return "", false
+	}
+	numericDotted := strings.Contains(s, ".")
+	for _, c := range s {
+		if c != '.' && (c < '0' || c > '9') {
+			numericDotted = false
+			break
+		}
+	}
+	if numericDotted {
+		return "", false
+	}
+	for _, label := range strings.Split(s, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return "", false
+		}
+		for _, c := range []byte(label) {
+			if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+				return "", false
+			}
+		}
+	}
+	return s, true
+}
+func (p *nodeParser) websocket(in map[string]any) map[string]any {
+	path := "/"
+	headers := map[string]any{}
+	if value, present := in["ws-opts"]; present {
+		m, ok := value.(map[string]any)
+		if !ok {
+			p.invalid()
+			return nil
+		}
+		p.object(m, "", "path headers")
+		if value, present := m["path"]; present {
+			path = p.text(value, 4096, true)
+			p.websocketPath(path)
+		}
+		if value, present := m["headers"]; present {
+			h, ok := value.(map[string]any)
+			if !ok {
+				p.invalid()
+				return nil
+			}
+			p.object(h, "", "Host")
+			if value, present := h["Host"]; present {
+				host := p.text(value, 4096, true)
+				normalized, ok := canonicalAuthority(host)
+				if !ok {
+					p.invalid()
+				}
+				headers["Host"] = normalized
+			}
+		}
+	}
+	return map[string]any{"path": path, "headers": headers}
+}
+func canonicalAuthority(s string) (string, bool) {
+	host, port, hasPort := s, "", false
+	if strings.HasPrefix(s, "[") {
+		end := strings.IndexByte(s, ']')
+		if end < 0 {
+			return "", false
+		}
+		host = s[1:end]
+		rest := s[end+1:]
+		if rest != "" {
+			if !strings.HasPrefix(rest, ":") {
+				return "", false
+			}
+			hasPort = true
+			port = rest[1:]
+		}
+		addr, err := netip.ParseAddr(host)
+		if err != nil || !addr.Is6() || addr.Zone() != "" {
+			return "", false
+		}
+		host = "[" + addr.String() + "]"
+	} else {
+		if strings.Count(s, ":") > 1 {
+			return "", false
+		}
+		if i := strings.IndexByte(s, ':'); i >= 0 {
+			host, port, hasPort = s[:i], s[i+1:], true
+		}
+		var ok bool
+		host, ok = canonicalHost(host)
+		if !ok {
+			return "", false
+		}
+	}
+	if hasPort {
+		value, err := strconv.ParseUint(port, 10, 16)
+		if err != nil || value == 0 {
+			return "", false
+		}
+		host += ":" + strconv.FormatUint(value, 10)
+	}
+	return host, true
+}
+
+// authorityHostname receives only a previously validated normalized authority.
+func authorityHostname(authority string) (string, bool) {
+	if strings.HasPrefix(authority, "[") {
+		end := strings.IndexByte(authority, ']')
+		return authority[1:end], len(authority) > end+1
+	}
+	host, _, hasPort := strings.Cut(authority, ":")
+	return host, hasPort
+}
+func (p *nodeParser) alpn(in, out map[string]any, kind, network string) {
+	tlsWS := network == "ws"
+	allowEmpty := (kind == "vmess" || kind == "vless") && !tlsWS
+	alpn := []any{}
+	if tlsWS {
+		alpn = []any{"http/1.1"}
+	} else if kind == "trojan" {
+		alpn = []any{"h2", "http/1.1"}
+	}
+	value, present := in["alpn"]
+	if present {
+		values, ok := value.([]any)
+		if !ok || len(values) > 16 || len(values) == 0 && !allowEmpty && !tlsWS {
+			p.invalid()
+		}
+		alpn = []any{}
+		for _, value := range values {
+			protocol := p.text(value, 255, true)
+			if hasControl(protocol) {
+				p.invalid()
+			}
+			alpn = append(alpn, protocol)
+		}
+		if tlsWS && (len(alpn) != 1 || alpn[0] != "http/1.1") {
+			p.unsupported()
+		}
+	}
+	// HY2 must preserve nil so its downstream native defaults remain effective.
+	if kind != "hysteria2" || present {
+		out["alpn"] = alpn
+	}
+}
+func (p *nodeParser) websocketPath(path string) {
+	if !strings.HasPrefix(path, "/") || hasControl(path) || strings.Contains(path, "#") {
+		p.invalid()
+		return
+	}
+	u, err := url.Parse(path)
+	if err != nil || u.Scheme != "" || u.Host != "" || u.Opaque != "" || u.Fragment != "" || hasControl(u.Path) {
+		p.invalid()
+		return
+	}
+	query, err := url.ParseQuery(u.RawQuery)
+	if err != nil {
+		p.invalid()
+		return
+	}
+	for key, values := range query {
+		if hasControl(key) {
+			p.invalid()
+		}
+		for _, value := range values {
+			if hasControl(value) {
+				p.invalid()
+			}
+		}
+	}
+	// The pinned core interprets decoded query key ed as early-data settings and
+	// rewrites the path. Reject every occurrence, including escaped key spellings.
+	if _, present := query["ed"]; present {
+		p.unsupported()
+	}
+}
