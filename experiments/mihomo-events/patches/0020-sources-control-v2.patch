+func TestHoopaActualHealthCheckPolicy(t *testing.T) {
+	expected, _ := utils.NewUnsignedRanges[uint16](C.HoopaProbeAcceptedStatus)
+	hc := NewHealthCheck(nil, "https://probe.invalid/check", 1234, 321, true, expected)
+	defer hc.close()
+	base := baseProvider{healthCheck: hc}
+	want := C.HoopaHealthCheckPolicy{URL: "https://probe.invalid/check", ExpectedStatus: C.HoopaProbeAcceptedStatus, IntervalSeconds: 321, TimeoutMS: 1234, Lazy: true}
+	if got := base.HoopaHealthCheckPolicy(); got != want {
+		t.Fatalf("actual immutable health check not projected: %#v", got)
+	}
+	got := base.HoopaHealthCheckPolicy()
+	got.URL = "changed"
+	if base.HoopaHealthCheckPolicy() != want {
+		t.Fatal("getter aliases mutable config")
+	}
+	if !reflect.DeepEqual(hc.lastTouch.Load(), time.Time{}) {
+		t.Fatal("getter touched health check")
+	}
+	var missing *baseProvider
+	if missing.HoopaHealthCheckPolicy() != (C.HoopaHealthCheckPolicy{}) || (&baseProvider{}).HoopaHealthCheckPolicy() != (C.HoopaHealthCheckPolicy{}) {
+		t.Fatal("missing healthcheck policy not empty")
+	}
+	for _, mutate := range []func(*HealthCheck){func(h *HealthCheck) { h.interval = 0 }, func(h *HealthCheck) { h.interval = -time.Second }, func(h *HealthCheck) { h.interval = time.Second + time.Nanosecond }, func(h *HealthCheck) { h.timeout = 0 }, func(h *HealthCheck) { h.timeout = -time.Millisecond }, func(h *HealthCheck) { h.timeout = time.Millisecond + time.Nanosecond }} {
+		h := NewHealthCheck(nil, "https://probe.invalid/", 1000, 60, false, expected)
+		mutate(h)
+		b := baseProvider{healthCheck: h}
+		if b.HoopaHealthCheckPolicy() != (C.HoopaHealthCheckPolicy{}) {
+			t.Fatal("unrepresentable native setting projected")
+		}
+		h.close()
+	}
+	// Native constructor defaults remain actual values, rather than desired input.
+	defaults := NewHealthCheck(nil, "https://probe.invalid/", 0, 60, false, expected)
+	defer defaults.close()
+	b := baseProvider{healthCheck: defaults}
+	if b.HoopaHealthCheckPolicy().TimeoutMS != 5000 {
+		t.Fatal("native timeout default not observed")
+	}
+}
