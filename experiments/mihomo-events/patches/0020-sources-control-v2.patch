+package provider
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"time"
+)
+
+// Configuration fields are immutable after NewHealthCheck. This accessor does
+// not touch a provider, trigger a probe, or read mutable results.
+func (bp *baseProvider) HoopaHealthCheckPolicy() C.HoopaHealthCheckPolicy {
+	if bp == nil || bp.healthCheck == nil {
+		return C.HoopaHealthCheckPolicy{}
+	}
+	h := bp.healthCheck
+	if h.interval <= 0 || h.timeout <= 0 || h.interval%time.Second != 0 || h.timeout%time.Millisecond != 0 {
+		return C.HoopaHealthCheckPolicy{}
+	}
+	return C.HoopaHealthCheckPolicy{URL: h.url, ExpectedStatus: h.expectedStatus.String(), IntervalSeconds: uint64(h.interval / time.Second), TimeoutMS: uint64(h.timeout / time.Millisecond), Lazy: h.lazy}
+}
