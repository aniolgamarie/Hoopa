@@ -0,0 +1,205 @@
+package adapter
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestHoopaProbeRegistryIsolationAndCapacity(t *testing.T) {
+	p := NewProxy(outbound.NewDirect())
+	status := C.HoopaProbeAcceptedStatus
+	url := "http://probe.invalid/one"
+	completed := time.Now()
+	p.recordHoopaProbe(url, status, true, 0, completed)
+	if p.HoopaProbeObservation(url, status).Known {
+		t.Fatal("unregistered observation recorded")
+	}
+	if p.EnableHoopaProbe("", status) || p.EnableHoopaProbe(url, "200") || p.EnableHoopaProbe(fmt.Sprintf("%04097d", 1), status) {
+		t.Fatal("invalid registration accepted")
+	}
+	if !p.EnableHoopaProbe(url, status) {
+		t.Fatal("registration failed")
+	}
+	p.recordHoopaProbe(url, status, true, 0, completed)
+	success := p.HoopaProbeObservation(url, status)
+	if !success.Known || !success.Success || success.DelayMS != 0 || success.CompletedAt != completed.Round(0).UTC() {
+		t.Fatal("zero-ms atomic success lost")
+	}
+	if !p.EnableHoopaProbe(url, status) || p.HoopaProbeObservation(url, status) != success {
+		t.Fatal("idempotent enable reset observation")
+	}
+	p.recordHoopaProbe(url, "200", false, 99, completed)
+	p.recordHoopaProbe(url+"/other", status, false, 99, completed)
+	if p.HoopaProbeObservation(url, status) != success || p.HoopaProbeObservation(url, "200").Known || p.HoopaProbeObservation(url+"/other", status).Known {
+		t.Fatal("URL/status isolation violated")
+	}
+	p.recordHoopaProbe(url, status, false, 65535, completed)
+	failure := p.HoopaProbeObservation(url, status)
+	if !failure.Known || failure.Success || failure.DelayMS != 0 || failure == success {
+		t.Fatal("failure conflated with zero-ms success")
+	}
+	for i := 1; i < 64; i++ {
+		if !p.EnableHoopaProbe(fmt.Sprintf("http://probe.invalid/%d", i), status) {
+			t.Fatal("64-entry capacity rejected")
+		}
+	}
+	if p.EnableHoopaProbe("http://probe.invalid/overflow", status) || !p.EnableHoopaProbe(url, status) {
+		t.Fatal("capacity or full-registry idempotence violated")
+	}
+	var missing *Proxy
+	if missing.EnableHoopaProbe(url, status) || missing.HoopaProbeObservation(url, status).Known {
+		t.Fatal("nil receiver not conservative")
+	}
+}
+func TestHoopaProbeAtomicPublication(t *testing.T) {
+	p := NewProxy(outbound.NewDirect())
+	url := "http://probe.invalid/atomic"
+	status := C.HoopaProbeAcceptedStatus
+	p.EnableHoopaProbe(url, status)
+	first := time.Unix(1000, 123).UTC()
+	second := time.Unix(2000, 456).UTC()
+	p.recordHoopaProbe(url, status, true, 17, first)
+	begin := make(chan struct{})
+	var workers sync.WaitGroup
+	for writer := 0; writer < 2; writer++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-begin
+			for i := 0; i < 3000; i++ {
+				p.recordHoopaProbe(url, status, true, 17, first)
+				p.recordHoopaProbe(url, status, false, 99, second)
+			}
+		}()
+	}
+	for reader := 0; reader < 4; reader++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-begin
+			for i := 0; i < 3000; i++ {
+				o := p.HoopaProbeObservation(url, status)
+				if !o.Known || !(o.Success && o.DelayMS == 17 && o.CompletedAt == first || !o.Success && o.DelayMS == 0 && o.CompletedAt == second) {
+					t.Error("torn atomic observation")
+					return
+				}
+				if !p.EnableHoopaProbe(url, status) {
+					t.Error("idempotent concurrent registration failed")
+					return
+				}
+			}
+		}()
+	}
+	close(begin)
+	workers.Wait()
+}
+func TestHoopaURLTestRealHEADPublication(t *testing.T) {
+	old := UnifiedDelay.Load()
+	UnifiedDelay.Store(false)
+	defer UnifiedDelay.Store(old)
+	methods := make(chan string, 16)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		methods <- r.Method
+		switch r.URL.Path {
+		case "/accepted":
+			w.WriteHeader(299)
+		case "/rejected":
+			w.WriteHeader(503)
+		default:
+			w.WriteHeader(204)
+		}
+	}))
+	defer server.Close()
+	expected, err := utils.NewUnsignedRanges[uint16](C.HoopaProbeAcceptedStatus)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := NewProxy(outbound.NewDirect())
+	if _, err := p.URLTest(context.Background(), server.URL+"/unregistered", expected); err != nil {
+		t.Fatal("local HEAD failed", err)
+	}
+	if p.HoopaProbeObservation(server.URL+"/unregistered", C.HoopaProbeAcceptedStatus).Known {
+		t.Fatal("real but unregistered HEAD recorded")
+	}
+	for _, path := range []string{"/ok", "/accepted", "/rejected"} {
+		url := server.URL + path
+		if !p.EnableHoopaProbe(url, C.HoopaProbeAcceptedStatus) {
+			t.Fatal("registration failed")
+		}
+		started := time.Now()
+		delay, err := p.URLTest(context.Background(), url, expected)
+		if err != nil {
+			t.Fatal("local status response unexpectedly returned transport error", err)
+		}
+		o := p.HoopaProbeObservation(url, C.HoopaProbeAcceptedStatus)
+		if !o.Known || o.CompletedAt.Before(started.Round(0)) || o.CompletedAt.After(time.Now()) || o.Success != (path != "/rejected") {
+			t.Fatal("actual HEAD completion publication mismatch")
+		}
+		if o.Success && o.DelayMS != delay || !o.Success && o.DelayMS != 0 {
+			t.Fatal("actual delay/status mismatch")
+		}
+		if p.HoopaProbeObservation(url, "200").Known {
+			t.Fatal("actual observation crossed status policy")
+		}
+	}
+	for i := 0; i < 4; i++ {
+		if <-methods != http.MethodHead {
+			t.Fatal("URLTest did not issue HEAD")
+		}
+	}
+}
+func TestHoopaURLTestTimeoutAndCancellation(t *testing.T) {
+	for _, timeout := range []bool{false, true} {
+		name := "cancel"
+		if timeout {
+			name = "timeout"
+		}
+		t.Run(name, func(t *testing.T) {
+			entered := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { close(entered); <-r.Context().Done() }))
+			defer server.Close()
+			p := NewProxy(outbound.NewDirect())
+			p.EnableHoopaProbe(server.URL, C.HoopaProbeAcceptedStatus)
+			expected, _ := utils.NewUnsignedRanges[uint16](C.HoopaProbeAcceptedStatus)
+			var ctx context.Context
+			var cancel context.CancelFunc
+			if timeout {
+				ctx, cancel = context.WithTimeout(context.Background(), time.Second)
+			} else {
+				ctx, cancel = context.WithCancel(context.Background())
+			}
+			defer cancel()
+			result := make(chan error, 1)
+			go func() { _, err := p.URLTest(ctx, server.URL, expected); result <- err }()
+			select {
+			case <-entered:
+			case <-time.After(5 * time.Second):
+				t.Fatal("local request never started")
+			}
+			if !timeout {
+				cancel()
+			}
+			select {
+			case err := <-result:
+				if err == nil {
+					t.Fatal("interrupted URLTest succeeded")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("URLTest failed to join after cancellation")
+			}
+			o := p.HoopaProbeObservation(server.URL, C.HoopaProbeAcceptedStatus)
+			if !o.Known || o.Success || o.DelayMS != 0 || o.CompletedAt.IsZero() {
+				t.Fatal("interrupted actual probe not recorded as failure")
+			}
+		})
+	}
+}
diff --git a/adapter/outboundgroup/hoopa_probe.go b/adapter/outboundgroup/hoopa_probe.go
new file mode 100644
--- /dev/null
+++ b/adapter/outboundgroup/hoopa_probe.go
@@ -0,0 +1,145 @@
+package outboundgroup
+
+import (
+	"errors"
+	"strings"
+	"sync"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+var errHoopaProbePolicy = errors.New("protected probe policy invalid")
+
+type hoopaURLTestState struct {
+	mu       sync.Mutex
+	policy   *C.HoopaProbePolicy
+	reject   C.Proxy
+	members  []C.Proxy
+	previous string
+}
+
+// ConfigureHoopaProbe verifies actual immutable native health-check settings,
+// then enables qualified selection once. It performs no probe or other IO.
+func (u *URLTest) ConfigureHoopaProbe(policy C.HoopaProbePolicy, reject C.Proxy) error {
+	if policy.URL == "" || len(policy.URL) > 4096 || policy.IntervalSeconds < 1 || policy.IntervalSeconds > 86400 || policy.TimeoutMS < 1 || policy.TimeoutMS > 60000 || policy.ToleranceMS > 65534 || reject == nil || reject.Name() != "REJECT" || reject.Type() != C.Reject {
+		return errHoopaProbePolicy
+	}
+	u.hoopa.mu.Lock()
+	defer u.hoopa.mu.Unlock()
+	if u.hoopa.policy != nil {
+		if *u.hoopa.policy == policy {
+			return nil
+		}
+		return errHoopaProbePolicy
+	}
+	if u.testUrl != policy.URL || u.expectedStatus != C.HoopaProbeAcceptedStatus || uint64(u.tolerance) != policy.ToleranceMS || u.testTimeout < 0 || uint64(u.testTimeout) != policy.TimeoutMS || len(u.providers) != 1 {
+		return errHoopaProbePolicy
+	}
+	pd, ok := u.providers[0].(interface {
+		HoopaHealthCheckPolicy() C.HoopaHealthCheckPolicy
+	})
+	if !ok {
+		return errHoopaProbePolicy
+	}
+	h := pd.HoopaHealthCheckPolicy()
+	if h.URL != policy.URL || h.ExpectedStatus != C.HoopaProbeAcceptedStatus || h.IntervalSeconds != policy.IntervalSeconds || h.TimeoutMS != policy.TimeoutMS || h.Lazy {
+		return errHoopaProbePolicy
+	}
+	proxies := u.GetProxies(false)
+	if len(proxies) < 1 || len(proxies) > 64 {
+		return errHoopaProbePolicy
+	}
+	seen := map[string]bool{}
+	for _, p := range proxies {
+		if p == nil || !strings.HasPrefix(p.Name(), "node:") || seen[p.Name()] || p.ProxyInfo().DialerProxy != "" {
+			return errHoopaProbePolicy
+		}
+		seen[p.Name()] = true
+		switch p.Type() {
+		case C.Http, C.Socks5, C.Shadowsocks, C.Trojan, C.Vmess, C.Vless, C.Hysteria2:
+		default:
+			return errHoopaProbePolicy
+		}
+		observer, ok := p.(C.HoopaProbeSource)
+		if !ok || !observer.EnableHoopaProbe(policy.URL, C.HoopaProbeAcceptedStatus) {
+			return errHoopaProbePolicy
+		}
+	}
+	copy := policy
+	u.hoopa.policy = &copy
+	u.hoopa.reject = reject
+	// Retain the exact verified leaf objects. Even unexpected provider drift
+	// cannot introduce another route into a protected connection decision.
+	u.hoopa.members = append([]C.Proxy(nil), proxies...)
+	return nil
+}
+
+// HoopaProbePolicy reports only declared settings, never a dynamic best node.
+func (u *URLTest) HoopaProbePolicy() (C.HoopaProbePolicy, bool) {
+	u.hoopa.mu.Lock()
+	defer u.hoopa.mu.Unlock()
+	if u.hoopa.policy == nil {
+		return C.HoopaProbePolicy{}, false
+	}
+	return *u.hoopa.policy, true
+}
+
+func (u *URLTest) hoopaFast(touch bool) (C.Proxy, bool) {
+	u.hoopa.mu.Lock()
+	defer u.hoopa.mu.Unlock()
+	if u.hoopa.policy == nil {
+		return nil, false
+	}
+	policy := *u.hoopa.policy
+	if touch {
+		u.Touch()
+	}
+	proxies := u.hoopa.members
+	now := time.Now().Round(0).UTC()
+	maxAge := time.Duration(2*policy.IntervalSeconds)*time.Second + time.Duration(policy.TimeoutMS)*time.Millisecond
+	var best, previous C.Proxy
+	var bestDelay, previousDelay uint32
+	for _, p := range proxies {
+		observer, ok := p.(C.HoopaProbeSource)
+		if !ok {
+			continue
+		}
+		observation := observer.HoopaProbeObservation(policy.URL, C.HoopaProbeAcceptedStatus)
+		if !qualifiedHoopaProbe(observation, now, maxAge) {
+			continue
+		}
+		delay := uint32(observation.DelayMS)
+		if best == nil || delay < bestDelay {
+			best, bestDelay = p, delay
+		}
+		if p.Name() == u.hoopa.previous {
+			previous, previousDelay = p, delay
+		}
+	}
+	if best == nil {
+		u.hoopa.previous = ""
+		return u.hoopa.reject, true
+	}
+	if previous != nil && previousDelay <= bestDelay+uint32(policy.ToleranceMS) {
+		best = previous
+	}
+	// A probe can complete during the scan. Require a still-qualified atomic
+	// observation at the final chosen-node decision; a concurrent failure causes
+	// conservative rejection, never a first-node or cross-source substitute.
+	observation := best.(C.HoopaProbeSource).HoopaProbeObservation(policy.URL, C.HoopaProbeAcceptedStatus)
+	if !qualifiedHoopaProbe(observation, time.Now().Round(0).UTC(), maxAge) {
+		u.hoopa.previous = ""
+		return u.hoopa.reject, true
+	}
+	u.hoopa.previous = best.Name()
+	return best, true
+}
+
+func qualifiedHoopaProbe(o C.HoopaProbeObservation, now time.Time, maxAge time.Duration) bool {
+	if !o.Known || !o.Success || o.CompletedAt.IsZero() {
+		return false
+	}
+	age := now.Sub(o.CompletedAt)
+	return age >= 0 && age <= maxAge
+}
diff --git a/adapter/outboundgroup/hoopa_probe_test.go b/adapter/outboundgroup/hoopa_probe_test.go
new file mode 100644
