+			}
+			r.mu.Unlock()
+			changed, err := r.readSnapshot()
+			if err != nil {
+				t.Fatal("drift fixture must remain valid:", err)
+			}
+			hash, err := changed.Digest()
+			if err != nil || hash == r.snapshotSHA {
+				t.Fatal("actual mutation not observed")
+			}
+			for _, path := range []string{"/hoopa/v1/status", "/hoopa/v1/snapshot"} {
+				if code, _ := f.request(t, "GET", path, nil); code != 503 {
+					t.Fatal("query accepted drift:", code)
+				}
+			}
+			if result, code := r.mutate(f.mutation("activate")); result != nil || code != 409 {
+				t.Fatal("activation accepted drift")
+			}
+			after, err := r.readSnapshot()
+			if err != nil || !reflect.DeepEqual(after, changed) || r.state != "closed" || r.activation != nil || r.drainReceipt != nil {
+				t.Fatal("readonly drift rejection repaired/mutated state")
+			}
+			r.mu.Lock()
+			if kind == "selector" {
+				selector.Set(initial)
+			} else {
+				tunnel.UpdateRules(f.cfg.Rules, nil, f.cfg.RuleProviders)
+			}
+			r.mu.Unlock()
+			if code, _ := f.request(t, "GET", "/hoopa/v1/snapshot", nil); code != 200 {
+				t.Fatal("original projection not recoverable by fixture restore")
+			}
+		})
+	}
