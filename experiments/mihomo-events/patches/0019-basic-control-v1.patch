+func hoopaControlV1Requested() bool {
+	for _, key := range []string{"HOOPA_CONTROL_PROTOCOL", "HOOPA_RUN_ID", "HOOPA_RUN_NONCE"} {
+		if _, exists := os.LookupEnv(key); exists {
+			return true
+		}
+	}
+	return false
+}
+
+func hoopaControlCapabilities() []string {
+	return []string{"authenticated-activate-v1", "closed-start-v1", "immutable-snapshot-v1"}
+}
+
+func runHoopaControlV1() error {
+	log.SetLevel(log.SILENT)
+	if os.Getenv("HOOPA_CONTROL_PROTOCOL") != "1" || version || testConfig || configString != "" || configFile == "-" || !guardPrivateDir(homeDir) || geodataMode || postUp != "" || postDown != "" || externalUI != "" || externalController != "" || externalControllerUnix != "" || externalControllerPipe != "" || secret != "" || flag.NArg() != 0 {
+		return errHoopaGuard
+	}
+	nonce := os.Getenv("HOOPA_RUN_NONCE")
+	nonceBytes, err := hex.DecodeString(nonce)
+	if err != nil || len(nonceBytes) != 32 || hex.EncodeToString(nonceBytes) != nonce {
+		return errHoopaGuard
+	}
+	for _, kv := range os.Environ() {
+		pair := strings.SplitN(kv, "=", 2)
+		if pair[0] == "HOOPA_IDENTITY_HANDOFF" || pair[0] == "HOOPA_IDENTITY_HANDOFF_SET" || strings.HasPrefix(pair[0], "HOOPA_TRACE_") && pair[1] != "" {
+			return errHoopaGuard
+		}
+	}
+	raw, err := guardReadConfig(configFile)
+	if err != nil {
+		return errHoopaGuard
+	}
+	hash := controlDigest(raw)
+	if hash != os.Getenv("HOOPA_GUARD_CONFIG_SHA256") {
+		return errHoopaGuard
+	}
+	generation, runID := os.Getenv("HOOPA_GUARD_GENERATION"), os.Getenv("HOOPA_RUN_ID")
+	p, err := profile.Validate(raw, generation)
+	if err != nil {
+		return errHoopaGuard
+	}
+	status := wire.Status{SchemaVersion: 1, RunID: runID, ConfigGeneration: generation, ConfigSHA256: hash, BinaryVersion: C.Version, Mode: "basic", Capabilities: hoopaControlCapabilities(), State: "closed", SnapshotSHA256: hash}
+	if status.Validate() != nil {
+		return errHoopaGuard
+	}
+	C.SetHomeDir(homeDir)
+	C.SetConfig(configFile)
+	cfg, err := executor.ParseWithBytes(raw)
+	if err != nil {
+		return errHoopaGuard
+	}
+	g := cfg.General
+	if g.Port != 0 || g.SocksPort != 0 || g.RedirPort != 0 || g.TProxyPort != 0 || g.MixedPort != 0 || g.Tun.Enable || g.TuicServer.Enable || len(cfg.Tunnels) != 0 || len(cfg.RuleProviders) != 0 || g.GeoAutoUpdate || len(cfg.Listeners) != len(p.Listeners) {
+		return errHoopaGuard
+	}
+	// Check the parsed listener objects before deliberately disabling stock I/O.
+	for _, entry := range p.Listeners {
+		ln := cfg.Listeners[entry.Name]
+		if ln == nil || ln.Name() != entry.Name || ln.RawAddress() != net.JoinHostPort(entry.Listen, strconv.Itoa(int(entry.Port))) {
+			return errHoopaGuard
+		}
+		options, ok := ln.Config().(*listenerInbound.MixedOption)
+		if !ok || options.UDP || options.SpecialProxy != "" || options.SpecialRules != "" || len(options.Users) != 1 || options.Users[0].Username != entry.Users[0].Username || options.Users[0].Password != entry.Users[0].Password {
+			return errHoopaGuard
+		}
+	}
+	cfg.Listeners = nil
+	C.HoopaProtected = true
+	executor.ApplyConfig(cfg, true)
+	defer executor.Shutdown()
+	r := &hoopaControlRuntime{state: "closed", runID: runID, generation: generation, hash: hash, secret: p.Secret, controllerAddress: p.Controller, declaredEntries: p.Listeners, conns: map[net.Conn]bool{}}
+	defer r.stop()
+	r.snapshot, err = r.readSnapshot()
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.snapshotSHA, err = r.snapshot.Digest()
+	if err != nil {
+		return errHoopaGuard
+	}
+	// App reservations remain bound but NOT listening until authenticated activate.
+	for _, entry := range p.Listeners {
+		f, err := hoopaguard.Reserve(net.JoinHostPort(entry.Listen, strconv.Itoa(int(entry.Port))))
+		if err != nil {
+			return errHoopaGuard
+		}
+		r.reserved = append(r.reserved, f)
+	}
+	f, err := hoopaguard.Reserve(p.Controller)
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.controller, err = hoopaguard.Listen(f)
+	_ = f.Close()
+	if err != nil {
+		return errHoopaGuard
+	}
+	r.server = &http.Server{Handler: r, ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 3 * time.Second, WriteTimeout: 3 * time.Second, IdleTimeout: 5 * time.Second, MaxHeaderBytes: 8192}
+	terms, hups := make(chan os.Signal, 1), make(chan os.Signal, 1)
+	signal.Notify(terms, syscall.SIGINT, syscall.SIGTERM)
+	signal.Notify(hups, syscall.SIGHUP)
+	defer signal.Stop(terms)
+	defer signal.Stop(hups)
+	served := make(chan error, 1)
+	go func() { served <- r.server.Serve(r.controller) }()
+	for {
+		select {
+		case <-terms:
+			return nil
+		case <-hups: // Immutable process replacement only; never reload in place.
+		case <-served:
+			return errHoopaGuard
+		}
+	}
+}
+
+type hoopaControlRuntime struct {
+	mu                                                  sync.Mutex
+	state, runID, generation, hash, secret, snapshotSHA string
+	controllerAddress                                   string
+	declaredEntries                                     []profile.Entry
+	snapshot                                            wire.Snapshot
+	activation, drainReceipt                            *wire.Result
+	activationRequest, drainRequest                     *wire.Mutation
+	reserved                                            []*os.File
+	entries                                             []net.Listener
+	controller                                          net.Listener
+	server                                              *http.Server
+	conns                                               map[net.Conn]bool
+	accept, workers                                     sync.WaitGroup
+}
+
+func controlDigest(raw []byte) string {
+	h := sha256.Sum256(raw)
+	return hex.EncodeToString(h[:])
+}
+
+// Only the new basic protected path uses these immutable globals. It exposes no
+// reload, group mutation or provider refresh; shutdown runs after r.stop joins.
+func (r *hoopaControlRuntime) readSnapshot() (wire.Snapshot, error) {
+	s := wire.Snapshot{SchemaVersion: 1, ConfigSHA256: r.hash, Controller: r.controllerAddress, Entries: []wire.Entry{}, Proxies: []wire.Proxy{}, Rules: []wire.Rule{}}
+	for _, e := range r.declaredEntries {
+		users, err := json.Marshal(e.Users)
+		if err != nil {
+			return s, errHoopaGuard
+		}
+		s.Entries = append(s.Entries, wire.Entry{Name: e.Name, Type: e.Type, Address: net.JoinHostPort(e.Listen, strconv.Itoa(int(e.Port))), AuthSHA256: controlDigest(users)})
+	}
+	for name, proxy := range tunnel.Proxies() {
+		if proxy == nil || name != proxy.Name() {
+			return s, errHoopaGuard
+		}
+		x := wire.Proxy{Name: name, Type: proxy.Type().String(), Address: proxy.Addr(), DialerProxy: proxy.ProxyInfo().DialerProxy, Members: []string{}}
+		if proxy.Type() == C.Selector {
+			selector, ok := proxy.Adapter().(*outboundgroup.Selector)
+			if !ok {
+				return s, errHoopaGuard
+			}
+			for _, member := range selector.Proxies() {
+				x.Members = append(x.Members, member.Name())
+			}
+			x.Selected = selector.Now()
+		}
+		s.Proxies = append(s.Proxies, x)
+	}
+	for _, rule := range tunnel.Rules() {
+		if rule == nil {
+			return s, errHoopaGuard
+		}
+		s.Rules = append(s.Rules, wire.Rule{Type: rule.RuleType().String(), Payload: rule.Payload(), Target: rule.Adapter()})
+	}
+	sort.Slice(s.Entries, func(i, j int) bool { return s.Entries[i].Name < s.Entries[j].Name })
+	sort.Slice(s.Proxies, func(i, j int) bool { return s.Proxies[i].Name < s.Proxies[j].Name })
+	return s, s.Validate()
+}
+
+// Caller holds mu. Query checks the ACTUAL current projection against the
+// frozen startup projection; it does not publish a new expected configuration.
+func (r *hoopaControlRuntime) verifiedSnapshot() (wire.Snapshot, error) {
+	s, err := r.readSnapshot()
+	if err != nil {
+		return s, err
+	}
+	hash, err := s.Digest()
+	if err != nil || hash != r.snapshotSHA {
+		return s, errHoopaGuard
+	}
+	if r.state == "open" {
+		if len(r.entries) != len(r.declaredEntries) {
+			return s, errHoopaGuard
+		}
+		for i, ln := range r.entries {
+			e := r.declaredEntries[i]
+			if ln.Addr().String() != net.JoinHostPort(e.Listen, strconv.Itoa(int(e.Port))) {
+				return s, errHoopaGuard
+			}
+		}
+	}
+	return s, nil
+}
+
+func (r *hoopaControlRuntime) ServeHTTP(w http.ResponseWriter, q *http.Request) {
+	host, _, err := net.SplitHostPort(q.RemoteAddr)
+	headers := q.Header.Values("Authorization")
+	if err != nil || host != "127.0.0.1" || len(headers) != 1 || subtle.ConstantTimeCompare([]byte(headers[0]), []byte("Bearer "+r.secret)) != 1 {
+		http.Error(w, "unauthorized", 401)
+		return
+	}
+	read := q.Method == "GET" && (q.URL.Path == "/hoopa/v1/status" || q.URL.Path == "/hoopa/v1/snapshot")
+	write := q.Method == "POST" && (q.URL.Path == "/hoopa/v1/activate" || q.URL.Path == "/hoopa/v1/drain")
+	if !read && !write {
+		http.Error(w, "unsupported operation", 409)
+		return
+	}
+	if q.URL.RawQuery != "" || q.URL.ForceQuery || q.URL.RawPath != "" || q.URL.Fragment != "" || q.URL.IsAbs() || q.RequestURI != q.URL.Path || len(q.TransferEncoding) != 0 || len(q.Trailer) != 0 || read && q.ContentLength != 0 {
+		http.Error(w, "invalid request", 400)
+		return
+	}
+	if read {
+		r.mu.Lock()
+		defer r.mu.Unlock()
+		if r.state == "stopped" {
+			http.Error(w, "observation unavailable", 503)
+			return
+		}
+		snapshot, err := r.verifiedSnapshot()
+		if err != nil {
+			http.Error(w, "observation unavailable", 503)
+			return
+		}
+		if q.URL.Path == "/hoopa/v1/snapshot" {
+			controlWriteJSON(w, 200, snapshot)
+			return
+		}
+		status := wire.Status{SchemaVersion: 1, RunID: r.runID, ConfigGeneration: r.generation, ConfigSHA256: r.hash, BinaryVersion: C.Version, Mode: "basic", Capabilities: hoopaControlCapabilities(), State: r.state, SnapshotSHA256: r.snapshotSHA, Activation: r.activation, Drain: r.drainReceipt}
+		if status.Validate() != nil {
+			http.Error(w, "observation unavailable", 503)
+			return
+		}
+		controlWriteJSON(w, 200, status)
+		return
+	}
+	contentType := q.Header.Values("Content-Type")
+	if q.ContentLength <= 0 || q.ContentLength > 4096 || len(contentType) != 1 || contentType[0] != "application/json" {
+		http.Error(w, "invalid request", 400)
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(q.Body, 4097))
+	if err != nil || int64(len(raw)) != q.ContentLength || len(raw) > 4096 {
+		http.Error(w, "invalid request", 400)
+		return
+	}
+	request, err := wire.DecodeMutation(raw)
+	if err != nil || q.URL.Path != "/hoopa/v1/"+request.Operation {
+		http.Error(w, "invalid request", 400)
+		return
+	}
+	result, code := r.mutate(request)
+	if result == nil {
+		http.Error(w, "operation conflict", code)
+		return
+	}
+	controlWriteJSON(w, code, result)
+}
+
+func controlWriteJSON(w http.ResponseWriter, code int, v any) {
+	raw, err := json.Marshal(v)
+	if err != nil || len(raw) > 65536 {
+		http.Error(w, "observation unavailable", 503)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Length", strconv.Itoa(len(raw)))
+	w.WriteHeader(code)
+	_, _ = w.Write(raw)
+}
+
+// All FD transitions, receipts, state and Accept Add operations share mu. No
+// application goroutine exists until EVERY Listen succeeded. Kernel handshakes
+// during the partial Listen window are possible, application forwarding is not.
+func (r *hoopaControlRuntime) mutate(q wire.Mutation) (*wire.Result, int) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	digest, err := q.Digest()
+	if err != nil || r.state == "stopped" || q.RunID != r.runID || q.ConfigGeneration != r.generation || q.ConfigSHA256 != r.hash || q.SnapshotSHA256 != r.snapshotSHA {
+		return nil, 409
+	}
+	request, receipt, other := r.activationRequest, r.activation, r.drainRequest
+	if q.Operation == "drain" {
+		request, receipt, other = r.drainRequest, r.drainReceipt, r.activationRequest
+	}
+	if other != nil && other.OperationID == q.OperationID {
+		return nil, 409
+	}
+	if request != nil {
+		if *request != q || receipt == nil || receipt.RequestSHA256 != digest {
+			return nil, 409
+		}
+		copy := *receipt
+		if copy.Result == "failed" {
+			return &copy, 503
+		}
+		return &copy, 200 // Historical receipt, never changes today's state.
+	}
+	if _, err := r.verifiedSnapshot(); err != nil {
+		return nil, 409
+	}
+	if q.Operation == "activate" && r.state != "closed" || q.Operation == "drain" && r.state != "closed" && r.state != "open" {
+		return nil, 409
+	}
+	result := &wire.Result{SchemaVersion: 1, OperationID: q.OperationID, RequestSHA256: digest, RunID: q.RunID, Result: "failed"}
+	if q.Operation == "activate" {
+		r.activationRequest, r.activation = &q, result
+		for _, f := range r.reserved {
+			ln, err := hoopaguard.Listen(f)
+			if err != nil {
+				r.state = "degraded"
+				r.closeEntries()
+				copy := *result
+				return &copy, 503
+			}
+			r.entries = append(r.entries, ln)
+		}
+		r.reserved = nil // Listen consumed every original reservation FD.
+		r.state, result.Result = "open", "opened"
+		for i, e := range r.declaredEntries {
+			store := authStore.NewAuthStore(auth.NewAuthenticator([]auth.AuthUser{{User: e.Users[0].Username, Pass: e.Users[0].Password}}))
+			r.accept.Add(1)
+			go r.serveEntry(r.entries[i], e.Name, store)
+		}
+	} else {
+		r.drainRequest, r.drainReceipt = &q, result
+		r.state = "draining"
+		if r.closeEntries() {
+			result.Result = "draining"
+		} else {
+			r.state = "degraded"
+		}
+	}
+	copy := *result
+	if copy.Result == "failed" {
+		return &copy, 503
+	}
+	return &copy, 200
+}
+
+// Caller holds mu. Only our descriptors are closed, never an external owner.
+func (r *hoopaControlRuntime) closeEntries() bool {
+	ok := true
+	for _, ln := range r.entries {
+		if err := ln.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+			ok = false
+		}
+	}
+	for _, f := range r.reserved {
+		if err := f.Close(); err != nil && !errors.Is(err, os.ErrClosed) {
+			ok = false
+		}
+	}
+	r.entries, r.reserved = nil, nil
+	return ok
+}
+
+func (r *hoopaControlRuntime) serveEntry(ln net.Listener, name string, store auth.AuthStore) {
+	defer r.accept.Done()
+	for {
+		c, err := ln.Accept()
+		r.mu.Lock()
+		if err != nil {
+			if r.state == "open" {
+				r.state = "degraded"
+				r.closeEntries()
+			}
+			r.mu.Unlock()
+			return
+		}
+		if r.state != "open" {
+			r.mu.Unlock()
+			_ = c.Close()
+			continue
+		}
+		r.conns[c] = true
+		r.workers.Add(1)
+		r.mu.Unlock()
+		go func(c net.Conn) {
+			defer r.workers.Done()
+			defer func() { c.Close(); r.mu.Lock(); delete(r.conns, c); r.mu.Unlock() }()
+			mixed.HandleHoopaConn(c, tunnel.Tunnel, store, inbound.WithInName(name), inbound.WithSpecialRules(""), inbound.WithSpecialProxy(""))
+		}(c)
+	}
+}
+
+func (r *hoopaControlRuntime) stop() {
+	r.mu.Lock()
+	r.state = "stopped" // Prevent any later activate/Add before waiting.
+	r.closeEntries()
+	r.mu.Unlock()
+	if r.server != nil {
+		_ = r.server.Close()
+	} else if r.controller != nil {
+		_ = r.controller.Close()
+	}
+	r.accept.Wait()
+	r.mu.Lock()
+	for c := range r.conns {
+		_ = c.Close()
+	}
+	r.mu.Unlock()
+	done := make(chan struct{})
+	go func() { r.workers.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+	}
+}
