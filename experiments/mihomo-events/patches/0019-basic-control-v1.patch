+func controlTestRefused(t *testing.T, address string) {
+	t.Helper()
+	conn, err := net.DialTimeout("tcp4", address, 200*time.Millisecond)
+	if conn != nil {
+		conn.Close()
+		t.Fatal("unexpected application listener")
