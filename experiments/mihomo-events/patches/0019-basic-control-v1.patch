+func TestControlV1ConcurrentStateTransitions(t *testing.T) {
+	for _, kind := range []string{"identical-activate", "activate-drain", "activate-stop", "identical-activate-drain-stop"} {
+		t.Run(kind, func(t *testing.T) {
+			f := newControlTestFixture(t)
+			r := f.r
+			gate := make(chan struct{})
+			type answer struct {
+				operation string
+				result    *wire.Result
+				code      int
+			}
+			results := make(chan answer, 12)
+			var wg sync.WaitGroup
+			count := 1
+			if strings.HasPrefix(kind, "identical") {
+				count = 8
+			}
+			for i := 0; i < count; i++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					<-gate
+					result, code := r.mutate(f.mutation("activate"))
+					results <- answer{"activate", result, code}
+				}()
+			}
+			if strings.Contains(kind, "drain") {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					<-gate
+					result, code := r.mutate(f.mutation("drain"))
+					results <- answer{"drain", result, code}
+				}()
+			}
+			if strings.Contains(kind, "stop") {
+				wg.Add(1)
+				go func() { defer wg.Done(); <-gate; r.stop() }()
+			}
+			close(gate)
+			finished := make(chan struct{})
+			go func() { wg.Wait(); close(finished) }()
+			select {
+			case <-finished:
+			case <-time.After(5 * time.Second):
+				t.Fatal("transition/WaitGroup race hung")
+			}
+			close(results)
+			for a := range results {
+				if kind == "identical-activate" && a.code != 200 {
+					t.Fatal("identical activation not idempotent")
+				}
+				if a.code != 200 && a.code != 409 {
+					t.Fatal("nonlinear transition outcome:", a.code)
+				}
+				if a.code == 200 && (a.result == nil || a.operation == "activate" && a.result.Result != "opened" || a.operation == "drain" && a.result.Result != "draining") {
+					t.Fatal("successful result mismatch")
+				}
+				if a.code == 409 && a.result != nil {
+					t.Fatal("rejected transition consumed receipt")
+				}
+			}
+			r.mu.Lock()
+			state := r.state
+			entries, reserved := len(r.entries), len(r.reserved)
+			r.mu.Unlock()
+			if strings.Contains(kind, "stop") {
+				if state != "stopped" || entries != 0 || reserved != 0 {
+					t.Fatal("stop lost race:", state, entries, reserved)
+				}
+			} else if strings.Contains(kind, "drain") {
+				if state != "draining" {
+					t.Fatal("drain lost race:", state)
+				}
+			} else if state != "open" {
+				t.Fatal("activation lost:", state)
+			}
+		})
+	}
+}
