+func TestControlV1PartialListenFailureClosesOnlyOwnedSockets(t *testing.T) {
+	f := newControlTestFixture(t)
+	ownedLinks := controlTestAppSocketLinks(t, f.files)
+	r := f.r
+	competitorFile, err := hoopaguard.Reserve(f.addresses[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	competitor, err := hoopaguard.Listen(competitorFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer competitor.Close()
+	competitorDone := make(chan error, 1)
+	go func() {
+		for {
+			conn, err := competitor.Accept()
+			if err != nil {
+				competitorDone <- err
+				return
+			}
+			conn.SetDeadline(time.Now().Add(time.Second))
+			_, err = conn.Write([]byte("external-owner"))
+			conn.Close()
+			if err != nil {
+				competitorDone <- err
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() {
+		competitor.Close()
+		select {
+		case err := <-competitorDone:
+			if !errors.Is(err, net.ErrClosed) {
+				t.Error("competitor:", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Error("competitor not collected")
+		}
+	})
+	began := make(chan struct{})
+	stop := make(chan struct{})
+	probeDone := make(chan struct{})
+	var connected, received atomic.Int32
+	go func() {
+		defer close(probeDone)
+		close(began)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			conn, err := net.DialTimeout("tcp4", f.addresses[0], 30*time.Millisecond)
+			if err != nil {
+				continue
+			}
+			connected.Add(1)
+			conn.SetDeadline(time.Now().Add(30 * time.Millisecond))
+			conn.Write([]byte{5, 1, 2})
+			var b [16]byte
+			n, _ := conn.Read(b[:])
+			received.Add(int32(n))
+			conn.Close()
+		}
+	}()
+	<-began
+	result, code := r.mutate(f.mutation("activate"))
+	close(stop)
+	<-probeDone
+	if code != 503 || result == nil || result.Result != "failed" || r.state != "degraded" {
+		t.Fatal("native second-listen failure was not terminal:", code, result, r.state)
+	}
+	if len(r.entries) != 0 || len(r.reserved) != 0 || len(r.conns) != 0 {
+		t.Fatal("partially opened resources retained")
+	}
+	for _, file := range f.files {
+		if _, err := file.Stat(); !errors.Is(err, os.ErrClosed) {
+			t.Fatal("owned reservation still open")
+		}
+	}
+	controlTestNoAppSocketFDs(t, ownedLinks)
+	controlTestRefused(t, f.addresses[0])
+	if received.Load() != 0 {
+		t.Fatal("partial listener emitted application protocol bytes")
+	}
+	t.Logf("partial-window successful TCP handshakes=%d; application bytes=%d; zero handshakes means narrow window not observed", connected.Load(), received.Load())
+	conn, err := net.DialTimeout("tcp4", f.addresses[1], time.Second)
+	if err != nil {
+		t.Fatal("competitor was stopped:", err)
+	}
+	conn.SetDeadline(time.Now().Add(time.Second))
+	b := make([]byte, len("external-owner"))
+	_, err = io.ReadFull(conn, b)
+	conn.Close()
+	if err != nil || string(b) != "external-owner" {
+		t.Fatal("competitor did not remain live:", err)
+	}
+	retry, retryCode := r.mutate(f.mutation("activate"))
+	if retryCode != 503 || retry == nil || *retry != *result {
+		t.Fatal("failed operation retried Listen")
+	}
+}
