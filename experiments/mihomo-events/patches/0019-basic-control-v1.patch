+func controlTestSocksGreeting(t *testing.T, address string) net.Conn {
+	t.Helper()
+	conn, err := net.DialTimeout("tcp4", address, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	conn.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := conn.Write([]byte{5, 1, 2}); err != nil {
+		t.Fatal(err)
+	}
+	reply := make([]byte, 2)
+	if _, err := io.ReadFull(conn, reply); err != nil || !bytes.Equal(reply, []byte{5, 2}) {
+		t.Fatal("actual SOCKS auth greeting:", reply, err)
+	}
+	return conn
+}
+func controlTestSocksAuth(t *testing.T, conn net.Conn, user profile.User) {
+	t.Helper()
+	packet := []byte{1, byte(len(user.Username))}
+	packet = append(packet, user.Username...)
+	packet = append(packet, byte(len(user.Password)))
+	packet = append(packet, user.Password...)
+	if _, err := conn.Write(packet); err != nil {
+		t.Fatal(err)
+	}
+	reply := make([]byte, 2)
+	if _, err := io.ReadFull(conn, reply); err != nil || !bytes.Equal(reply, []byte{1, 0}) {
+		t.Fatal("existing connection lost across drain:", reply, err)
+	}
+}
