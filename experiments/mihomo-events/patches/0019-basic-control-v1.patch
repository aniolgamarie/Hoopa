+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(snapshot, r.snapshot) {
+		t.Fatal("actual snapshot mismatch")
+	}
+	activation := f.mutation("activate")
+	code, original := f.request(t, "POST", "/hoopa/v1/activate", controlTestJSON(t, activation))
+	if code != 200 {
+		t.Fatal(code, string(original))
+	}
+	result, err := wire.DecodeResult(original)
+	if err != nil || result.Result != "opened" {
+		t.Fatal(err)
+	}
+	for _, file := range f.files {
+		if _, err := file.Stat(); !errors.Is(err, os.ErrClosed) {
+			t.Fatal("Listen left original reservation FD open")
+		}
+	}
+	for _, address := range f.addresses {
+		conn := controlTestSocksGreeting(t, address)
+		conn.Close()
+	}
+	existing := controlTestSocksGreeting(t, f.addresses[0])
+	if code, retry := f.request(t, "POST", "/hoopa/v1/activate", controlTestJSON(t, activation)); code != 200 || !bytes.Equal(retry, original) {
+		t.Fatal("identical activate not historical")
+	}
+	for _, different := range []wire.Mutation{func() wire.Mutation { q := activation; q.OperationID = "operation:another"; return q }(), func() wire.Mutation { q := activation; q.RegistrationSHA256 = strings.Repeat("e", 64); return q }()} {
+		if code, _ := f.request(t, "POST", "/hoopa/v1/activate", controlTestJSON(t, different)); code != 409 {
+			t.Fatal("occupied activation slot replaced:", code)
+		}
+	}
+	drain := f.mutation("drain")
+	bad := drain
+	bad.OperationID = activation.OperationID
+	if code, _ := f.request(t, "POST", "/hoopa/v1/drain", controlTestJSON(t, bad)); code != 409 {
+		t.Fatal("activate/drain reused ID")
+	}
+	code, drained := f.request(t, "POST", "/hoopa/v1/drain", controlTestJSON(t, drain))
+	if code != 200 {
+		t.Fatal(code, string(drained))
+	}
+	for _, address := range f.addresses {
+		controlTestRefused(t, address)
+	}
+	controlTestSocksAuth(t, existing, r.declaredEntries[0].Users[0])
+	existing.Close()
+	if code, retry := f.request(t, "POST", "/hoopa/v1/drain", controlTestJSON(t, drain)); code != 200 || !bytes.Equal(retry, drained) {
+		t.Fatal("identical drain not historical")
+	}
+	if code, retry := f.request(t, "POST", "/hoopa/v1/activate", controlTestJSON(t, activation)); code != 200 || !bytes.Equal(retry, original) {
